# =============================================================================
# Daily Teaching Report - Environment Configuration Template
# Generated automatically from ENV_REGISTRY in services/systemHealthService.js
# Run "npm run env:example" to regenerate.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Group: Database
# ─────────────────────────────────────────────────────────────────────────────

# Required in production. MongoDB connection string (URI). Format: must start with mongodb:// or mongodb+srv://.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DBNAME

# ─────────────────────────────────────────────────────────────────────────────
# Group: Security
# ─────────────────────────────────────────────────────────────────────────────

# Required in production. Session cookie encryption and signing secret. Format: string of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required in production. Bearer token authorizing cron maintenance and backup endpoints. Format: string of at least 16 characters.
CRON_SECRET=replace-with-at-least-16-random-characters

# Optional. Force CSP to report-only mode without blocking resources. Format: boolean ('true', 'false', '1', '0').
CSP_REPORT_ONLY=false

# Optional. Enable Content Security Policy enforcement (blocks violations). Format: boolean ('true', 'false', '1', '0').
CSP_ENFORCE=false

# Optional. Teacher self-registration policy mode. Format: must be 'approval' or 'closed'.
REGISTRATION_MODE=approval

# ─────────────────────────────────────────────────────────────────────────────
# Group: UI / Assets
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Fallback toggle to load Tailwind Play CDN instead of compiled CSS. Format: boolean ('true', 'false', '1', '0').
TAILWIND_CDN=false

# ─────────────────────────────────────────────────────────────────────────────
# Group: Storage (Cloudinary)
# ─────────────────────────────────────────────────────────────────────────────

# Required in production. Cloudinary cloud name for file uploads and database backup archives. Format: non-empty string.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Required in production. Cloudinary API access key. Format: non-empty string.
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Required in production. Cloudinary API access secret. Format: non-empty string.
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─────────────────────────────────────────────────────────────────────────────
# Group: Application
# ─────────────────────────────────────────────────────────────────────────────

# Required in production. Canonical application base URL for absolute links and webhooks. Format: valid URL starting with https://.
APP_BASE_URL=https://your-domain.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Group: AI (Gemini)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Google Gemini API key for AI assistant features. Format: non-empty string.
GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Group: Tunables (Platform)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Execution budget for long-running functions before timeout abort. Format: positive number in milliseconds.
MAX_FUNCTION_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Group: Tunables (Backup)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Retention period for unpinned database backups before deletion. Format: positive integer in days.
BACKUP_RETENTION_DAYS=30

# Optional. Timeout limit for streaming database backup archives to cloud storage. Format: positive number in milliseconds.
BACKUP_UPLOAD_TIMEOUT_MS=120000

# Optional. Prune orphaned Cloudinary backup files not referenced in database. Format: boolean ('true', 'false', '1', '0').
BACKUP_SWEEP_ORPHANS=true

# Optional. Prune legacy unauthenticated backup archives during daily cleanup. Format: boolean ('true', 'false', '1', '0').
BACKUP_SWEEP_LEGACY=true

# ─────────────────────────────────────────────────────────────────────────────
# Group: Tunables (Material)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Maximum allowable file size for teaching material uploads. Format: positive number in megabytes.
MATERIAL_MAX_FILE_MB=10

# Optional. Comma-separated whitelist of allowed file extensions for materials. Format: non-empty comma-separated string.
MATERIAL_ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,jpg,jpeg,png

# Optional. Comma-separated whitelist of formats allowed for signed downloads. Format: non-empty comma-separated string.
MATERIAL_SIGN_ALLOWED_FORMATS=pdf,doc,docx,ppt,pptx,xls,xlsx,jpg,jpeg,png

# ─────────────────────────────────────────────────────────────────────────────
# Group: Tunables (Onboarding)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Launch date used to distinguish new teachers from legacy teachers. Format: valid date string (YYYY-MM-DD).
ONBOARDING_LAUNCH_DATE=2026-01-01

# Optional. Earliest date to begin sending automated onboarding reminder emails. Format: valid date string (YYYY-MM-DD).
ONBOARDING_REMINDERS_START_DATE=2026-01-01

# Optional. Days after registration before sending initial onboarding reminder. Format: positive integer in days.
ONBOARDING_REMINDER_FIRST_AFTER_DAYS=7

# Optional. Interval in days between recurring onboarding reminder notifications. Format: positive integer in days.
ONBOARDING_REMINDER_INTERVAL_DAYS=7

# Optional. Maximum number of onboarding reminders sent per new teacher. Format: positive integer count.
ONBOARDING_REMINDER_MAX=3

# Optional. Interval in days between reminders for legacy teachers. Format: positive integer in days.
ONBOARDING_REMINDER_LEGACY_INTERVAL_DAYS=14

# Optional. Maximum number of onboarding reminders sent to legacy teachers. Format: positive integer count.
ONBOARDING_REMINDER_LEGACY_MAX=2

# ─────────────────────────────────────────────────────────────────────────────
# Group: Tunables (Report Gaps)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Historical window in weeks analyzed to discover teaching patterns. Format: positive number in weeks.
REPORT_GAP_PATTERN_WEEKS=4

# Optional. Minimum occurrences in pattern window to recognize routine schedule. Format: positive number in weeks.
REPORT_GAP_PATTERN_MIN_WEEKS=2

# Optional. Lookback window in days evaluated for missing teaching reports. Format: positive number in days.
REPORT_GAP_LOOKBACK_DAYS=30

# Optional. Consecutive days without reports before flagging teacher or group silent. Format: positive number in days.
REPORT_GAP_SILENT_DAYS=14

# Optional. Minimum lifetime reports before evaluating a teacher for silence. Format: positive integer count.
REPORT_GAP_SILENT_TEACHER_MIN_REPORTS=5

# Optional. Minimum lifetime reports before evaluating a group for silence. Format: positive integer count.
REPORT_GAP_SILENT_GROUP_MIN_REPORTS=3
