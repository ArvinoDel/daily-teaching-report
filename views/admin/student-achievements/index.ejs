<%- include('../../partials/header', { title: 'AC Bonus' }) %>

<style>
  @keyframes sk-shimmer {
    0%   { background-position: -600px 0; }
    100% { background-position:  600px 0; }
  }
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .sk {
    display: block;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 1200px 100%;
    animation: sk-shimmer 1.5s infinite linear;
    border-radius: 6px;
  }
  .group-bucket { animation: fadeSlideIn .25s ease both; }
</style>

<!-- Page Header -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
        </svg>
        AC Bonus
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Student AC Bonus</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Students grouped by class — showing total AC bonus count per student.</p>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Students</p>
    <p class="text-3xl font-bold text-brand-600"><%= totalStudents %></p>
    <p class="text-xs text-slate-400 mt-1">tracked</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total AC</p>
    <p class="text-3xl font-bold text-slate-900"><%= totalAchievements %></p>
    <p class="text-xs text-slate-400 mt-1">bonus given</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Average</p>
    <p class="text-3xl font-bold text-emerald-600"><%= avgCount %></p>
    <p class="text-xs text-slate-400 mt-1">per student</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Top Score</p>
    <p class="text-3xl font-bold text-amber-500"><%= topCount %></p>
    <p class="text-xs text-slate-400 mt-1">highest AC</p>
  </div>
</div>

<!-- Flash message -->
<% if (flashMessage) { %>
  <div id="flash-toast"
    class="fixed top-20 right-4 z-50 bg-brand-600 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 transition-all duration-300">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
    <%= flashMessage %>
  </div>
  <script>
    setTimeout(function () {
      var t = document.getElementById('flash-toast');
      if (t) { t.style.opacity = '0'; t.style.transform = 'translateX(16px)'; }
    }, 3000);
  </script>
<% } %>

<!-- Filters -->
<form method="GET" action="/admin/student-achievements" id="filter-form">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-4 sm:px-5 py-3.5 mb-5">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">

      <!-- Search with autocomplete -->
      <div class="relative flex-1 min-w-[180px]" id="search-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z" />
        </svg>
        <input type="text" name="q" id="search-input" value="<%= searchQuery %>"
          placeholder="Search student or group…" autocomplete="off"
          class="w-full pl-8 pr-3 py-1.5 text-sm rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-300 transition">
        <div id="search-dropdown"
          class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg z-40 max-h-60 overflow-y-auto">
        </div>
      </div>

      <span class="self-stretch w-px bg-slate-100 hidden sm:block"></span>

      <!-- Group filter -->
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Group</span>
        <select name="group_id" onchange="document.getElementById('filter-form').submit()"
          class="text-xs font-semibold rounded-lg border border-slate-200 px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-300 bg-white text-slate-700">
          <option value="">All Groups</option>
          <% allGroups.forEach(function(g) { %>
            <option value="<%= g._id %>" <%= selectedGroupId === String(g._id) ? 'selected' : '' %>>
              <%= g.group_name %><% if (g.level) { %> · <%= g.level %><% } %> (<%= g.type === 'PRIVATE' ? 'Private' : 'Group' %>)
            </option>
          <% }); %>
        </select>
      </div>

      <span class="self-stretch w-px bg-slate-100 hidden sm:block"></span>

      <!-- Sort -->
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Sort</span>
        <select name="sort" onchange="document.getElementById('filter-form').submit()"
          class="text-xs font-semibold rounded-lg border border-slate-200 px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-300 bg-white text-slate-700">
          <option value="count_desc" <%= selectedSort === 'count_desc' ? 'selected' : '' %>>Most AC</option>
          <option value="count_asc"  <%= selectedSort === 'count_asc'  ? 'selected' : '' %>>Fewest AC</option>
          <option value="name_asc"   <%= selectedSort === 'name_asc'   ? 'selected' : '' %>>Name A–Z</option>
          <option value="name_desc"  <%= selectedSort === 'name_desc'  ? 'selected' : '' %>>Name Z–A</option>
          <option value="recent"     <%= selectedSort === 'recent'     ? 'selected' : '' %>>Most recent</option>
        </select>
      </div>

      <div class="flex items-center gap-2 ml-auto">
        <button type="submit"
          class="text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white px-3 py-1.5 rounded-lg transition">
          Search
        </button>
        <% if (searchQuery || selectedGroupId) { %>
          <a href="/admin/student-achievements"
            class="text-xs font-semibold text-slate-400 hover:text-slate-600 transition">Clear</a>
        <% } %>
      </div>

    </div>
  </div>
</form>

<!-- Results meta -->
<p class="text-xs text-slate-400 mb-4">
  Showing <span class="font-semibold text-slate-600"><%= totalStudents %></span> student<%= totalStudents !== 1 ? 's' : '' %>
  <% if (searchQuery || selectedGroupId) { %> matching current filters<% } %>
</p>

<!-- ── Skeleton ──────────────────────────────────────────────── -->
<div id="page-skeleton">
  <% [0,1,2,3].forEach(function() { %>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-5">
    <!-- group header -->
    <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="sk w-8 h-8 rounded-xl inline-block"></span>
        <div>
          <span class="sk h-4 w-28 mb-2 inline-block"></span>
          <span class="sk h-3 w-20 inline-block"></span>
        </div>
      </div>
      <span class="sk h-3 w-14 inline-block"></span>
    </div>
    <!-- student rows -->
    <% [0,1,2,3].forEach(function(_, ri) { %>
    <div class="px-5 py-3 flex items-center gap-4 <%= ri < 3 ? 'border-b border-slate-50' : '' %>">
      <span class="sk w-4 h-4 rounded flex-shrink-0 inline-block"></span>
      <span class="sk w-8 h-8 rounded-full flex-shrink-0 inline-block"></span>
      <div class="flex-1 min-w-0">
        <span class="sk h-4 w-36 mb-2 inline-block"></span>
        <span class="sk h-1.5 w-full inline-block rounded-full"></span>
      </div>
      <span class="sk h-5 w-10 rounded-lg flex-shrink-0 inline-block"></span>
      <span class="sk h-3 w-20 hidden md:inline-block flex-shrink-0"></span>
    </div>
    <% }); %>
  </div>
  <% }); %>
</div>

<!-- ── Real content ──────────────────────────────────────────── -->
<div id="real-content" class="hidden">

<% if (students.length === 0) { %>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm py-16 text-center">
    <div class="w-14 h-14 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
      </svg>
    </div>
    <p class="text-sm font-semibold text-slate-600">No students found</p>
    <p class="text-xs text-slate-400 mt-1">
      <% if (searchQuery || selectedGroupId) { %>Try adjusting your filters.<% } else { %>No AC bonuses have been recorded yet.<% } %>
    </p>
  </div>
<% } else { %>
  <%
    var groupBuckets = {};
    students.forEach(function(s) {
      s.groups.forEach(function(g) {
        var key = g.groupId;
        if (!groupBuckets[key]) {
          groupBuckets[key] = { groupName: g.groupName, type: g.type, level: g.level, students: [] };
        }
        groupBuckets[key].students.push(s);
      });
    });
    Object.keys(groupBuckets).forEach(function(k) {
      groupBuckets[k].students.sort(function(a, b) { return b.count - a.count; });
    });
    var sortedBuckets = Object.values(groupBuckets).sort(function(a, b) {
      return b.students[0].count - a.students[0].count;
    });
  %>

  <% sortedBuckets.forEach(function(bucket) { %>
  <div class="group-bucket hidden bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-5">

    <!-- Group header -->
    <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0
          <%= bucket.type === 'PRIVATE' ? 'bg-purple-100' : 'bg-emerald-100' %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 <%= bucket.type === 'PRIVATE' ? 'text-purple-600' : 'text-emerald-600' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-800"><%= bucket.groupName %></p>
          <div class="flex items-center gap-1.5 mt-0.5">
            <% if (bucket.type === 'PRIVATE') { %>
              <span class="badge-purple text-[11px] font-semibold px-2 py-0.5 rounded-full">Private</span>
            <% } else { %>
              <span class="badge-emerald text-[11px] font-semibold px-2 py-0.5 rounded-full">Group</span>
            <% } %>
            <% if (bucket.level) { %>
              <span class="bg-slate-100 text-slate-600 text-[11px] font-semibold px-2 py-0.5 rounded-full"><%= bucket.level %></span>
            <% } %>
          </div>
        </div>
      </div>
      <span class="text-xs text-slate-400 font-medium"><%= bucket.students.length %> student<%= bucket.students.length !== 1 ? 's' : '' %></span>
    </div>

    <!-- Student rows -->
    <div class="divide-y divide-slate-50">
      <% var bucketTop = bucket.students[0].count; %>
      <% bucket.students.forEach(function(s, idx) { %>
        <%
          var barPct    = bucketTop > 0 ? Math.round((s.count / bucketTop) * 100) : 0;
          var rankColor = idx === 0 ? 'text-amber-500' : idx === 1 ? 'text-slate-400' : idx === 2 ? 'text-orange-400' : 'text-slate-300';
          var barColor  = idx === 0 ? 'bg-amber-400' : idx === 1 ? 'bg-slate-400' : idx === 2 ? 'bg-orange-400' : 'bg-slate-200';
        %>
        <div class="px-5 py-3 flex items-center gap-4 hover:bg-slate-50 transition">
          <span class="w-5 text-center text-xs font-bold <%= rankColor %> flex-shrink-0"><%= idx + 1 %></span>
          <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-600 flex-shrink-0">
            <%= s.name.trim().charAt(0).toUpperCase() %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-slate-800 truncate"><%= s.name %></p>
            <div class="mt-1.5 h-1.5 bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full <%= barColor %>" data-width="<%= barPct %>"></div>
            </div>
          </div>
          <div class="flex-shrink-0 text-right">
            <span class="inline-flex items-center gap-1 text-sm font-bold <%= idx === 0 ? 'text-amber-600' : 'text-slate-700' %>">
              <%= s.count %><span class="text-xs font-normal text-slate-400">AC</span>
            </span>
          </div>
          <div class="hidden md:block flex-shrink-0">
            <span class="text-[11px] text-slate-400"><%= s.lastSeenFormatted %></span>
          </div>
        </div>
      <% }); %>
    </div>

  </div>
  <% }); %>

  <!-- Infinite scroll sentinel -->
  <div id="scroll-sentinel" class="h-1 pointer-events-none"></div>

  <!-- Loading more indicator -->
  <div id="load-indicator" class="hidden py-8 text-center">
    <div class="inline-flex flex-col items-center gap-3">
      <!-- mini skeleton rows to mimic the next card loading -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden w-full max-w-2xl">
        <div class="px-5 py-3.5 border-b border-slate-100 flex items-center gap-2.5">
          <span class="sk w-8 h-8 rounded-xl inline-block"></span>
          <span class="sk h-4 w-32 inline-block"></span>
        </div>
        <% [0,1,2].forEach(function() { %>
        <div class="px-5 py-3 flex items-center gap-4 border-b border-slate-50 last:border-0">
          <span class="sk w-4 h-4 rounded inline-block flex-shrink-0"></span>
          <span class="sk w-8 h-8 rounded-full inline-block flex-shrink-0"></span>
          <div class="flex-1"><span class="sk h-4 w-40 inline-block"></span></div>
          <span class="sk h-5 w-10 rounded-lg inline-block flex-shrink-0"></span>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

<% } %>
</div><!-- /#real-content -->

<!-- JSON data for autocomplete -->
<script id="all-groups-json" type="application/json"><%- allGroupsJson %></script>
<script id="students-json"   type="application/json"><%- studentsJson %></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    /* ── 1. Skeleton → real content ───────────────────────── */
    document.getElementById('page-skeleton').classList.add('hidden');
    document.getElementById('real-content').classList.remove('hidden');

    /* ── 2. Bar fills ─────────────────────────────────────── */
    document.querySelectorAll('[data-width]').forEach(function (el) {
      el.style.width = el.getAttribute('data-width') + '%';
    });

    /* ── 3. Infinite scroll ───────────────────────────────── */
    var PAGE_SIZE = 4;
    var buckets   = Array.from(document.querySelectorAll('.group-bucket'));
    var sentinel  = document.getElementById('scroll-sentinel');
    var indicator = document.getElementById('load-indicator');
    var loaded    = 0;
    var busy      = false;

    function loadMore() {
      if (busy || loaded >= buckets.length) return;
      busy = true;
      if (loaded > 0 && indicator) indicator.classList.remove('hidden');

      setTimeout(function () {
        var batch = buckets.slice(loaded, loaded + PAGE_SIZE);
        batch.forEach(function (el) { el.classList.remove('hidden'); });
        loaded += batch.length;
        busy = false;
        if (indicator) indicator.classList.add('hidden');
        if (loaded >= buckets.length && sentinel) sentinel.remove();
      }, loaded === 0 ? 0 : 380);
    }

    loadMore(); // first batch — no delay

    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) loadMore();
      }, { rootMargin: '160px' }).observe(sentinel);
    } else {
      buckets.forEach(function (el) { el.classList.remove('hidden'); });
    }

    /* ── 4. Autocomplete ──────────────────────────────────── */
    var allGroups   = JSON.parse(document.getElementById('all-groups-json').textContent);
    var studentsArr = JSON.parse(document.getElementById('students-json').textContent);
    var suggestions = [], seen = {};

    studentsArr.forEach(function (s) {
      var k = s.name.toLowerCase();
      if (!seen[k]) { seen[k] = 1; suggestions.push({ label: s.name, type: 'student' }); }
    });
    allGroups.forEach(function (g) {
      var gk = 'g:' + g.group_name.toLowerCase();
      if (!seen[gk]) { seen[gk] = 1; suggestions.push({ label: g.group_name, type: g.type === 'PRIVATE' ? 'private' : 'group' }); }
      (g.students || []).forEach(function (name) {
        var sk = name.toLowerCase();
        if (!seen[sk]) { seen[sk] = 1; suggestions.push({ label: name, type: 'student' }); }
      });
    });

    var input    = document.getElementById('search-input');
    var dropdown = document.getElementById('search-dropdown');
    var form     = document.getElementById('filter-form');
    var active   = -1;

    function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function tag(t) {
      var cls = t === 'group' ? 'badge-emerald' : t === 'private' ? 'badge-purple' : 'bg-slate-100 text-slate-500';
      var lbl = t === 'group' ? 'Group' : t === 'private' ? 'Private' : 'Student';
      return '<span class="' + cls + ' text-[10px] font-semibold px-1.5 py-0.5 rounded-full ml-1.5">' + lbl + '</span>';
    }

    function renderDD(matches) {
      if (!matches.length) { dropdown.classList.add('hidden'); return; }
      dropdown.innerHTML = matches.map(function (m) {
        return '<button type="button" data-label="' + esc(m.label) + '" class="w-full text-left flex items-center px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 transition ac-item">' +
          '<svg class="w-3.5 h-3.5 text-slate-300 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z"/></svg>' +
          esc(m.label) + tag(m.type) + '</button>';
      }).join('');
      dropdown.classList.remove('hidden');
      active = -1;
    }

    input.addEventListener('input', function () {
      var q = this.value.trim().toLowerCase();
      if (!q) { dropdown.classList.add('hidden'); return; }
      renderDD(suggestions.filter(function (s) { return s.label.toLowerCase().includes(q); }).slice(0, 8));
    });

    input.addEventListener('keydown', function (e) {
      var its = dropdown.querySelectorAll('.ac-item');
      if (!its.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, its.length - 1); its.forEach(function (el, i) { el.classList.toggle('bg-slate-50', i === active); }); }
      else if (e.key === 'ArrowUp')  { e.preventDefault(); active = Math.max(active - 1, 0); its.forEach(function (el, i) { el.classList.toggle('bg-slate-50', i === active); }); }
      else if (e.key === 'Enter' && active >= 0 && its[active]) { e.preventDefault(); input.value = its[active].dataset.label; dropdown.classList.add('hidden'); form.submit(); }
      else if (e.key === 'Escape') { dropdown.classList.add('hidden'); }
    });

    dropdown.addEventListener('mousedown', function (e) {
      var btn = e.target.closest('.ac-item');
      if (!btn) return;
      e.preventDefault(); input.value = btn.dataset.label; dropdown.classList.add('hidden'); form.submit();
    });

    document.addEventListener('click', function (e) {
      if (!document.getElementById('search-wrapper').contains(e.target)) dropdown.classList.add('hidden');
    });
  });
</script>

<%- include('../../partials/footer') %>
