<!--
  views/admin/scan-ac/mobile.ejs
  Mobile-first barcode scanner page using the device camera.
  Uses the ZXing JS library for camera-based barcode scanning (no install needed).

  Flow:
  1. Teacher opens /admin/scan-ac/mobile on their phone
  2. Camera viewfinder activates, shows a scan line
  3. Teacher points phone at student's printed barcode card
  4. Student info + AC total pops up
  5. Teacher taps +AC or -AC
  6. Transaction saved, ready for next scan automatically
-->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>AC Scanner — Mobile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%; overflow: hidden;
      font-family: 'Inter', sans-serif;
      background: #0f172a;
      color: #f8fafc;
      -webkit-tap-highlight-color: transparent;
    }

    /* ── Layout ── */
    #app { display: flex; flex-direction: column; height: 100vh; position: relative; }

    /* ── Top bar ── */
    #topbar {
      position: relative; z-index: 10;
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px;
      background: rgba(15, 23, 42, .9);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255,255,255,.07);
    }
    #topbar h1 { font-size: 15px; font-weight: 800; color: #e2e8f0; }
    #topbar .badge {
      font-size: 11px; font-weight: 700;
      background: #6366f1; color: white;
      padding: 3px 10px; border-radius: 999px;
    }
    #topbar a { font-size: 12px; color: #64748b; text-decoration: none; }

    /* ── Camera viewport ── */
    #camera-wrap {
      position: relative; flex: 1;
      overflow: hidden; background: #000;
    }
    #camera-video {
      width: 100%; height: 100%;
      object-fit: cover;
    }
    /* Scan overlay frame */
    #scan-frame {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
    }
    #scan-frame-box {
      width: min(72vw, 260px); height: min(72vw, 260px);
      position: relative;
    }
    /* Corner brackets */
    .corner {
      position: absolute; width: 28px; height: 28px;
      border-color: #6366f1; border-style: solid;
    }
    .corner-tl { top: 0; left: 0;  border-width: 3px 0 0 3px; border-radius: 4px 0 0 0; }
    .corner-tr { top: 0; right: 0; border-width: 3px 3px 0 0; border-radius: 0 4px 0 0; }
    .corner-bl { bottom: 0; left: 0;  border-width: 0 0 3px 3px; border-radius: 0 0 0 4px; }
    .corner-br { bottom: 0; right: 0; border-width: 0 3px 3px 0; border-radius: 0 0 4px 0; }
    /* Scan line */
    #scan-line {
      position: absolute; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, #6366f1, #a5b4fc, #6366f1, transparent);
      border-radius: 2px;
      animation: sweep 2s ease-in-out infinite;
      top: 0;
    }
    @keyframes sweep {
      0%   { top: 4px;   opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { top: calc(100% - 6px); opacity: 0; }
    }
    #scan-hint {
      position: absolute; bottom: calc(50% - min(36vw,130px) - 28px);
      left: 0; right: 0;
      text-align: center; font-size: 12px; color: rgba(255,255,255,.55);
    }

    /* ── Bottom sheet ── */
    #bottom-sheet {
      position: relative; z-index: 20;
      background: #1e293b;
      border-top: 1px solid rgba(255,255,255,.08);
      transition: transform .3s cubic-bezier(.4,0,.2,1);
    }

    /* ── Idle state ── */
    #state-idle {
      padding: 20px 20px 28px;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
    }
    #state-idle p { font-size: 13px; color: #64748b; text-align: center; }

    /* ── Loading ── */
    #state-loading {
      display: none;
      padding: 24px;
      align-items: center; justify-content: center; gap: 12px;
      flex-direction: column;
    }
    .spinner {
      width: 32px; height: 32px;
      border: 3px solid #334155;
      border-top-color: #6366f1;
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Student card ── */
    #state-student { display: none; }

    #student-info {
      display: flex; align-items: center; gap: 14px;
      padding: 16px 20px;
      border-bottom: 1px solid rgba(255,255,255,.06);
    }
    #s-avatar {
      width: 52px; height: 52px;
      border-radius: 16px;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; font-weight: 900; color: white;
      flex-shrink: 0; box-shadow: 0 4px 12px rgba(99,102,241,.4);
    }
    #s-name  { font-size: 18px; font-weight: 800; color: #f1f5f9; }
    #s-grade { font-size: 12px; font-weight: 600; color: #64748b; margin-top: 2px; }
    #s-total-wrap { margin-left: auto; text-align: right; flex-shrink: 0; }
    #s-total-label { font-size: 10px; font-weight: 700; color: #f59e0b; text-transform: uppercase; letter-spacing: .04em; }
    #s-total { font-size: 36px; font-weight: 900; color: #fbbf24; line-height: 1; }

    /* ── Action buttons ── */
    #action-btns {
      display: grid; grid-template-columns: 1fr 1fr;
    }
    .action-btn {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 6px; padding: 18px 12px 22px;
      border: none; cursor: pointer;
      font-family: inherit;
      transition: filter .15s, transform .1s;
      -webkit-tap-highlight-color: transparent;
    }
    .action-btn:active { filter: brightness(.85); transform: scale(.96); }
    #btn-add    { background: #064e3b; border-right: 1px solid rgba(255,255,255,.06); }
    #btn-reduce { background: #450a0a; }
    .action-icon {
      width: 48px; height: 48px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 26px; font-weight: 900;
    }
    #btn-add    .action-icon { background: #10b981; color: white; }
    #btn-reduce .action-icon { background: #ef4444; color: white; }
    .action-label { font-size: 15px; font-weight: 800; }
    #btn-add    .action-label { color: #34d399; }
    #btn-reduce .action-label { color: #fca5a5; }
    .action-sub { font-size: 11px; color: rgba(255,255,255,.35); }

    /* ── Error ── */
    #state-error {
      display: none;
      padding: 20px;
      flex-direction: column; align-items: center; gap: 8px; text-align: center;
    }
    #error-msg { font-size: 14px; font-weight: 600; color: #fca5a5; }
    #btn-try-again {
      font-size: 13px; font-weight: 600; color: #64748b;
      background: none; border: none; cursor: pointer; padding: 6px 12px;
      font-family: inherit;
    }

    /* ── Toast ── */
    #toast {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
      background: #1e293b; border: 1px solid rgba(255,255,255,.1);
      color: #f1f5f9; font-size: 13px; font-weight: 600;
      padding: 10px 20px; border-radius: 999px;
      box-shadow: 0 8px 24px rgba(0,0,0,.4);
      opacity: 0; transition: opacity .2s;
      pointer-events: none; white-space: nowrap; z-index: 100;
    }
    #toast.show { opacity: 1; }

    /* ── Session count pill ── */
    #session-count-wrap {
      padding: 8px 20px;
      display: flex; align-items: center; justify-content: space-between;
      border-top: 1px solid rgba(255,255,255,.06);
    }
    #session-count-wrap p { font-size: 11px; color: #475569; }
    #session-total { font-size: 11px; font-weight: 700; color: #6366f1; }

    /* Camera error overlay */
    #cam-error {
      display: none; position: absolute; inset: 0;
      background: #0f172a; align-items: center; justify-content: center;
      flex-direction: column; gap: 12px; text-align: center; padding: 32px;
      z-index: 5;
    }
    #cam-error p { color: #94a3b8; font-size: 14px; line-height: 1.5; }
    #cam-error strong { color: #f1f5f9; display: block; margin-bottom: 6px; font-size: 16px; }
    #cam-error .cam-err-btn {
      margin-top: 8px; padding: 10px 24px;
      background: #6366f1; color: white; border: none; border-radius: 999px;
      font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer;
    }

    /* Start button overlay (for browsers requiring user activation) */
    #cam-start-overlay {
      display: none; position: absolute; inset: 0;
      background: rgba(15,23,42,.85); align-items: center; justify-content: center;
      flex-direction: column; gap: 16px; z-index: 6;
    }
    #cam-start-overlay p { color: #94a3b8; font-size: 13px; text-align: center; padding: 0 24px; }
    #btn-start-camera {
      padding: 14px 36px; background: #6366f1; color: white;
      border: none; border-radius: 999px;
      font-size: 16px; font-weight: 800; font-family: inherit; cursor: pointer;
      box-shadow: 0 4px 20px rgba(99,102,241,.5);
    }

    /* Manual input drawer */
    #manual-drawer {
      display: none; position: fixed; inset: 0;
      background: rgba(15,23,42,.8); z-index: 50;
      align-items: flex-end; justify-content: center;
    }
    #manual-drawer.open { display: flex; }
    #manual-drawer-inner {
      background: #1e293b; border-radius: 20px 20px 0 0;
      padding: 24px 20px 40px; width: 100%;
    }
    #manual-drawer h3 { font-size: 15px; font-weight: 800; color: #f1f5f9; margin-bottom: 4px; }
    #manual-drawer p { font-size: 12px; color: #64748b; margin-bottom: 16px; }
    #manual-barcode-input {
      width: 100%; padding: 14px 16px;
      background: #0f172a; border: 2px solid #334155; border-radius: 12px;
      font-size: 18px; font-weight: 700; color: #f1f5f9; font-family: monospace;
      letter-spacing: .05em; text-transform: uppercase;
      outline: none; margin-bottom: 12px;
    }
    #manual-barcode-input:focus { border-color: #6366f1; }
    #btn-manual-submit {
      width: 100%; padding: 14px; background: #6366f1; color: white;
      border: none; border-radius: 12px; font-size: 15px; font-weight: 800;
      font-family: inherit; cursor: pointer;
    }
    #btn-manual-cancel {
      display: block; width: 100%; text-align: center; margin-top: 10px;
      font-size: 13px; color: #64748b; background: none; border: none;
      cursor: pointer; font-family: inherit; padding: 6px;
    }

    /* Viewfinder flash on scan */
    @keyframes flash-acquire {
      0%   { opacity: 0.7; }
      100% { opacity: 0; }
    }
    #scan-flash {
      position: absolute; inset: 0;
      background: rgba(99,102,241,.4);
      pointer-events: none; opacity: 0;
      z-index: 4;
    }
    #scan-flash.flash { animation: flash-acquire .35s ease-out forwards; }

    /* Flip camera button */
    #btn-flip-camera {
      position: absolute; top: 12px; right: 12px; z-index: 10;
      width: 36px; height: 36px;
      background: rgba(30,41,59,.8); border: 1px solid rgba(255,255,255,.12);
      border-radius: 50%; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(4px);
    }
    #btn-flip-camera svg { width: 18px; height: 18px; color: #94a3b8; }

    /* Bottom manual-type button */
    #btn-manual-open {
      display: block; width: 100%; text-align: center;
      font-size: 12px; color: #475569;
      background: none; border: none; cursor: pointer;
      font-family: inherit; padding: 8px 0 12px;
      text-decoration: underline;
    }
  </style>
</head>
<body>
<div id="app">

  <!-- Top bar -->
  <div id="topbar">
    <div>
      <h1>📱 AC Scanner</h1>
    </div>
    <span id="scan-badge" class="badge">Ready</span>
    <a href="/admin/scan-ac">💻 Desktop</a>
  </div>

  <!-- Camera -->
  <div id="camera-wrap">
    <video id="camera-video" autoplay playsinline webkit-playsinline muted></video>
    <div id="scan-frame">
      <div id="scan-frame-box">
        <div class="corner corner-tl"></div>
        <div class="corner corner-tr"></div>
        <div class="corner corner-bl"></div>
        <div class="corner corner-br"></div>
        <div id="scan-line"></div>
      </div>
    </div>
    <p id="scan-hint">Point camera at student's barcode</p>

    <!-- Scan acquire flash -->
    <div id="scan-flash"></div>

    <!-- Flip camera button -->
    <button id="btn-flip-camera" title="Flip camera">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 4v6h6"/><path d="M23 20v-6h-6"/>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 0 1 3.51 15"/>
      </svg>
    </button>

    <!-- Start camera overlay (user activation) -->
    <div id="cam-start-overlay">
      <p>Camera access is needed to scan barcodes. Tap the button below to start.</p>
      <button id="btn-start-camera">📷 Start Camera</button>
    </div>

    <!-- Camera error -->
    <div id="cam-error">
      <strong>Camera not available</strong>
      <p>Please allow camera permission and reload.</p>
      <button class="cam-err-btn" onclick="location.reload()">Reload Page</button>
    </div>
  </div>

  <!-- Manual barcode entry drawer -->
  <div id="manual-drawer">
    <div id="manual-drawer-inner">
      <h3>🔢 Type Barcode Manually</h3>
      <p>Type the barcode code printed on the student's card</p>
      <input type="text" id="manual-barcode-input" placeholder="e.g. ACK3F1A007" maxlength="20" autocapitalize="characters" autocomplete="off" />
      <button id="btn-manual-submit">Look Up Student</button>
      <button id="btn-manual-cancel">Cancel</button>
    </div>
  </div>

  <!-- Bottom sheet -->
  <div id="bottom-sheet">

    <!-- Idle -->
    <div id="state-idle">
      <p>Waiting for barcode scan…</p>
      <button id="btn-manual-open">Can't scan? Type barcode manually</button>
    </div>

    <!-- Loading -->
    <div id="state-loading">
      <div class="spinner"></div>
    </div>

    <!-- Student card + actions -->
    <div id="state-student">
      <!-- Inactivity countdown progress bar -->
      <div id="timer-progress-wrap" style="height:3px;background:rgba(255,255,255,.07);overflow:hidden;position:relative;">
        <div id="timer-progress-bar" style="height:100%;width:100%;background:linear-gradient(90deg,#6366f1,#818cf8);transition:width 1s linear;"></div>
      </div>

      <div id="student-info">
        <div id="s-avatar">?</div>
        <div>
          <div id="s-name">—</div>
          <div id="s-grade"></div>
        </div>
        <div id="s-total-wrap">
          <div id="s-total-label">Total AC</div>
          <div id="s-total">0</div>
        </div>
      </div>
      <div id="action-btns">
        <button class="action-btn" id="btn-add">
          <div class="action-icon">+</div>
          <div class="action-label">Give AC</div>
          <div class="action-sub">+1 card</div>
        </button>
        <button class="action-btn" id="btn-reduce">
          <div class="action-icon">−</div>
          <div class="action-label">Take AC</div>
          <div class="action-sub">−1 card</div>
        </button>
      </div>
      <div id="session-count-wrap">
        <p>Session transactions: <span id="session-total">0</span></p>
        <div style="display:flex;align-items:center;gap:10px;">
          <span style="font-size:11px;color:#94a3b8;font-weight:600;">Auto-close in <b id="countdown-secs" style="color:#c7d2fe;font-variant-numeric:tabular-nums;">15s</b></span>
          <button id="btn-scan-next" style="font-size:12px;font-weight:700;color:#6366f1;background:none;border:none;cursor:pointer;font-family:inherit;padding:2px 0;">Scan next →</button>
        </div>
      </div>
    </div>

    <!-- Error -->
    <div id="state-error">
      <p id="error-msg">Student not found.</p>
      <button id="btn-try-again" onclick="resetToIdle()">Try again</button>
    </div>

  </div><!-- /bottom-sheet -->
</div><!-- /app -->

<div id="toast"></div>

<!-- ZXing barcode library — fallback for browsers without native BarcodeDetector -->
<script src="https://unpkg.com/@zxing/library@0.19.1/umd/index.min.js"></script>

<script>
(function () {
  'use strict';

  /* ══════════════════════════════════════════════════════════
     State machine:
       idle → loading → student → idle (loop)
                      → error   → idle
     Scanner engines: native BarcodeDetector (primary) → ZXing (fallback)
  ═════════════════════════════════════════════════════════════ */

  var currentBarcode   = null;
  var sessionCount     = 0;
  var stream           = null;      // active MediaStream
  var scannerEngine    = null;      // 'native' | 'zxing'
  var zxingReader      = null;      // ZXing instance (if used)
  var nativeDetector   = null;      // BarcodeDetector instance (if used)
  var rafId            = null;      // requestAnimationFrame loop ID
  var isScanning       = false;
  var facingMode       = 'environment'; // 'environment' (rear) | 'user' (front)

  /* ── DOM refs ── */
  var video       = document.getElementById('camera-video');
  var scanBadge   = document.getElementById('scan-badge');
  var scanFlash   = document.getElementById('scan-flash');
  var stateIdle   = document.getElementById('state-idle');
  var stateLoad   = document.getElementById('state-loading');
  var stateStud   = document.getElementById('state-student');
  var stateErr    = document.getElementById('state-error');
  var errMsg      = document.getElementById('error-msg');
  var sAvatar     = document.getElementById('s-avatar');
  var sName       = document.getElementById('s-name');
  var sGrade      = document.getElementById('s-grade');
  var sTotal      = document.getElementById('s-total');
  var btnAdd      = document.getElementById('btn-add');
  var btnReduce   = document.getElementById('btn-reduce');
  var btnNext     = document.getElementById('btn-scan-next');
  var sessionTot  = document.getElementById('session-total');
  var timerProgressBar = document.getElementById('timer-progress-bar');
  var countdownSecs    = document.getElementById('countdown-secs');
  var camError    = document.getElementById('cam-error');
  var camOverlay  = document.getElementById('cam-start-overlay');
  var toast       = document.getElementById('toast');
  var manualDrawer      = document.getElementById('manual-drawer');
  var manualInput       = document.getElementById('manual-barcode-input');
  var btnManualSubmit   = document.getElementById('btn-manual-submit');
  var btnManualCancel   = document.getElementById('btn-manual-cancel');
  var btnManualOpen     = document.getElementById('btn-manual-open');
  var btnFlip           = document.getElementById('btn-flip-camera');
  var btnStartCamera    = document.getElementById('btn-start-camera');

  /* ══════════════════════════════════════════════════════════
     PHASE 1 — Secure Context Check
  ══════════════════════════════════════════════════════════ */
  if (location.protocol !== 'https:' && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
    showCamError(
      'Camera access requires a secure connection (HTTPS). ' +
      'Please open this page via your Vercel URL, not a local IP address.'
    );
  } else {
    boot();
  }

  /* ══════════════════════════════════════════════════════════
     PHASE 2 — Constraint-Based Camera Stream
  ══════════════════════════════════════════════════════════ */
  function boot() {
    // Some browsers need a user gesture to start camera; show overlay as safety net
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      showCamError('Your browser does not support camera access. Try Chrome or Safari.');
      return;
    }
    startCamera();
  }

  function startCamera() {
    if (stream) stopStream();

    var constraints = {
      video: {
        facingMode: { ideal: facingMode },
        width:  { ideal: 1280 },
        height: { ideal: 720 },
      },
      audio: false,
    };

    navigator.mediaDevices.getUserMedia(constraints)
      .then(function (s) {
        stream = s;
        video.srcObject = s;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        return video.play();
      })
      .then(function () {
        // Hide start overlay if it was shown
        camOverlay.style.display = 'none';
        startScanEngine();
      })
      .catch(function (err) {
        console.error('getUserMedia error:', err);
        if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
          // Show activation overlay instead of error — user may need to tap
          camOverlay.style.display = 'flex';
        } else if (err.name === 'NotFoundError') {
          showCamError('No camera found on this device.');
        } else {
          showCamError('Camera error: ' + err.message);
        }
      });
  }

  function stopStream() {
    if (stream) {
      stream.getTracks().forEach(function (t) { t.stop(); });
      stream = null;
    }
    video.srcObject = null;
  }

  /* Camera flip */
  btnFlip.addEventListener('click', function () {
    facingMode = facingMode === 'environment' ? 'user' : 'environment';
    stopScanEngine();
    startCamera();
  });

  /* Manual start button (user activation fallback) */
  btnStartCamera.addEventListener('click', function () {
    camOverlay.style.display = 'none';
    startCamera();
  });

  /* ══════════════════════════════════════════════════════════
     PHASE 3 — Hybrid Scanner Engine
  ══════════════════════════════════════════════════════════ */
  function startScanEngine() {
    isScanning = true;
    scanBadge.textContent = 'Scanning…';
    scanBadge.style.background = '#6366f1';

    // Primary: native hardware BarcodeDetector (Android Chrome, Edge, Opera)
    if (window.BarcodeDetector && typeof BarcodeDetector !== 'undefined') {
      BarcodeDetector.getSupportedFormats().then(function (formats) {
        var supported = formats.includes('code_128') || formats.includes('CODE_128');
        if (supported || formats.length > 0) {
          scannerEngine = 'native';
          nativeDetector = new BarcodeDetector({
            formats: ['code_128', 'qr_code', 'code_39', 'ean_13', 'ean_8'].filter(function (f) {
              return formats.includes(f);
            })
          });
          runNativeLoop();
        } else {
          startZxing();
        }
      }).catch(function () {
        startZxing();
      });
    } else {
      startZxing();
    }
  }

  /* ── Native BarcodeDetector loop via requestAnimationFrame ── */
  function runNativeLoop() {
    if (!isScanning) return;
    if (video.readyState < 2) {
      rafId = requestAnimationFrame(runNativeLoop);
      return;
    }
    nativeDetector.detect(video).then(function (barcodes) {
      if (!isScanning) return;
      if (barcodes && barcodes.length > 0) {
        var barcode = barcodes[0].rawValue;
        if (barcode && barcode !== currentBarcode && !isCooldown(barcode)) {
          onBarcodeDetected(barcode);
        }
      }
      rafId = requestAnimationFrame(runNativeLoop);
    }).catch(function () {
      rafId = requestAnimationFrame(runNativeLoop);
    });
  }

  /* ── ZXing fallback (iOS Safari, Firefox) ── */
  function startZxing() {
    if (typeof ZXing === 'undefined') {
      showCamError('Scanner library failed to load. Check your internet connection.');
      return;
    }
    scannerEngine = 'zxing';
    // Create a fresh reader every time to avoid double-loop error
    if (zxingReader) {
      try { zxingReader.reset(); } catch(e) {}
    }
    zxingReader = new ZXing.BrowserMultiFormatReader();

    // Get active deviceId from stream directly — avoids pre-enumeration on iOS
    var videoTrack = stream && stream.getVideoTracks()[0];
    var deviceId = videoTrack ? videoTrack.getSettings().deviceId : undefined;

    zxingReader.decodeFromVideoDevice(deviceId || null, video, function (result) {
      if (!isScanning) return;
      if (result) {
        var barcode = result.getText();
        if (barcode && barcode !== currentBarcode && !isCooldown(barcode)) {
          onBarcodeDetected(barcode);
        }
      }
    });
  }

  /* ── Stop whichever engine is running ── */
  function stopScanEngine() {
    isScanning = false;
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    if (zxingReader) {
      try { zxingReader.reset(); } catch(e) {}
    }
    scanBadge.textContent = 'Paused';
    scanBadge.style.background = '#475569';
  }

  /* ── Restart engine (called on resetToIdle) ── */
  function resumeScanEngine() {
    isScanning = true;
    scanBadge.textContent = 'Scanning…';
    scanBadge.style.background = '#6366f1';
    if (scannerEngine === 'native') {
      if (!rafId) runNativeLoop();
    } else {
      startZxing();
    }
  }

  /* ══════════════════════════════════════════════════════════
     Inactivity Timer (15s auto-refresh on idle)
  ══════════════════════════════════════════════════════════ */
  var INACTIVITY_SECONDS = 15;
  var inactivityTimer    = null;
  var countdownInterval  = null;
  var secondsLeft        = INACTIVITY_SECONDS;

  function startInactivityTimer() {
    clearInactivityTimer();
    secondsLeft = INACTIVITY_SECONDS;
    updateTimerUI();

    countdownInterval = setInterval(function () {
      secondsLeft--;
      if (secondsLeft <= 0) {
        secondsLeft = 0;
        updateTimerUI();
        clearInactivityTimer();
        resetToIdle();
        return;
      }
      updateTimerUI();
    }, 1000);

    inactivityTimer = setTimeout(function () {
      resetToIdle();
    }, INACTIVITY_SECONDS * 1000);
  }

  function resetInactivityTimer() {
    if (stateStud.style.display !== 'none') {
      startInactivityTimer();
    }
  }

  function clearInactivityTimer() {
    if (inactivityTimer)   { clearTimeout(inactivityTimer);   inactivityTimer = null; }
    if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
    if (timerProgressBar)  { timerProgressBar.style.width = '100%'; }
  }

  function updateTimerUI() {
    if (countdownSecs) {
      countdownSecs.textContent = secondsLeft + 's';
    }
    if (timerProgressBar) {
      var pct = Math.max(0, Math.min(100, (secondsLeft / INACTIVITY_SECONDS) * 100));
      timerProgressBar.style.width = pct + '%';
    }
  }

  /* ══════════════════════════════════════════════════════════
     Cooldown (prevents instant re-trigger of same card on timeout)
  ══════════════════════════════════════════════════════════ */
  var lastDismissedBarcode = null;
  var lastDismissedTime    = 0;

  function setCooldown(barcode) {
    lastDismissedBarcode = barcode;
    lastDismissedTime    = Date.now();
  }

  function isCooldown(barcode) {
    if (!lastDismissedBarcode) return false;
    if (barcode === lastDismissedBarcode && (Date.now() - lastDismissedTime < 2500)) {
      return true;
    }
    return false;
  }

  /* ── Extract barcode from raw scan value (handles QR URLs & raw codes) ── */
  function extractBarcode(raw) {
    if (!raw) return '';
    raw = raw.trim();
    // If it looks like a URL (http:// or https://), try to extract the barcode from path
    if (/^https?:\/\//i.test(raw)) {
      try {
        var url  = new URL(raw);
        var path = url.pathname; // e.g. /student-card/AC12345 or /c/AC12345
        var match = path.match(/\/(?:student-card|c)\/([^\/]+)/i);
        if (match && match[1]) {
          return decodeURIComponent(match[1]);
        }
      } catch (e) { /* not a valid URL, fall through */ }
    }
    return raw;
  }

  /* ══════════════════════════════════════════════════════════
     PHASE 3 — Barcode Detected Handler
  ══════════════════════════════════════════════════════════ */
  var currentLookupId = 0;

  function onBarcodeDetected(raw) {
    if (!raw) return;
    var barcode = extractBarcode(raw);
    if (!barcode) return;
    if (barcode === currentBarcode) return;
    if (isCooldown(barcode)) return;

    // Directly switch to the new barcode, don't get stuck on the first one
    currentBarcode = barcode;
    clearInactivityTimer();

    var thisLookupId = ++currentLookupId;
    setState('loading');
    scanBadge.textContent = 'Scanning…';
    scanBadge.style.background = '#6366f1';

    // Haptic feedback
    if (navigator.vibrate) navigator.vibrate(80);

    // Visual flash on viewfinder
    scanFlash.classList.remove('flash');
    void scanFlash.offsetWidth; // reflow to restart animation
    scanFlash.classList.add('flash');

    // Audio beep (Web Audio API)
    playBeep();

    fetch('/admin/scan-ac/lookup?barcode=' + encodeURIComponent(barcode))
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (thisLookupId !== currentLookupId) return; // Stale lookup from previous barcode
        if (!res.ok) {
          showError(res.error || 'Student not found. Barcode: ' + barcode);
          return;
        }
        renderStudent(res.student);
        startInactivityTimer();
      })
      .catch(function () {
        if (thisLookupId !== currentLookupId) return;
        showError('Network error. Check connection and try again.');
      });
  }

  /* ══════════════════════════════════════════════════════════
     PHASE 4 — Web Audio Beep
  ══════════════════════════════════════════════════════════ */
  function playBeep() {
    try {
      var ctx = new (window.AudioContext || window.webkitAudioContext)();
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.value = 1200;
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.15);
    } catch (e) { /* audio not critical */ }
  }

  /* ── Render student card ── */
  function renderStudent(s) {
    sAvatar.textContent = (s.full_name || '?').charAt(0).toUpperCase();
    sName.textContent   = s.full_name || '—';
    sGrade.textContent  = s.grade_school || '';
    sTotal.textContent  = s.acTotal || 0;
    setState('student');
    scanBadge.textContent = 'Scanning…';
    scanBadge.style.background = '#6366f1';
  }

  /* ══════════════════════════════════════════════════════════
     Transact
  ══════════════════════════════════════════════════════════ */
  btnAdd.addEventListener('click',    function () { resetInactivityTimer(); doTransact('add');    });
  btnReduce.addEventListener('click', function () { resetInactivityTimer(); doTransact('reduce'); });
  btnNext.addEventListener('click',   function () { resetToIdle(); });

  // Any user interaction on student sheet resets inactivity timer
  stateStud.addEventListener('pointerdown', function () {
    resetInactivityTimer();
  });

  function doTransact(type) {
    if (!currentBarcode) return;
    var txBarcode = currentBarcode;
    resetInactivityTimer();
    btnAdd.disabled    = true;
    btnReduce.disabled = true;

    var body = 'barcode=' + encodeURIComponent(txBarcode) +
               '&type=' + type +
               '&_csrf=' + encodeURIComponent('<%= csrfToken %>');

    fetch('/admin/scan-ac/transact', {
      method:  'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'x-csrf-token': '<%= csrfToken %>',
      },
      body: body,
    })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        btnAdd.disabled    = false;
        btnReduce.disabled = false;
        if (!res.ok) { showToast('⚠️ ' + (res.error || 'Failed')); return; }
        sessionCount++;
        sessionTot.textContent = sessionCount;
        var delta = type === 'add' ? '+1 AC ✓' : '−1 AC ✓';
        var color = type === 'add' ? '#34d399' : '#fca5a5';
        showToast(delta, color);
        if (currentBarcode === txBarcode) {
          sTotal.textContent = res.acTotal;
          resetInactivityTimer();
        }
      })
      .catch(function () {
        btnAdd.disabled    = false;
        btnReduce.disabled = false;
        showToast('⚠️ Network error');
        if (currentBarcode === txBarcode) {
          resetInactivityTimer();
        }
      });
  }

  /* ══════════════════════════════════════════════════════════
     PHASE 4 — Manual Barcode Input Drawer
  ══════════════════════════════════════════════════════════ */
  btnManualOpen.addEventListener('click', function () {
    manualDrawer.classList.add('open');
    setTimeout(function () { manualInput.focus(); }, 150);
  });
  btnManualCancel.addEventListener('click', function () {
    manualDrawer.classList.remove('open');
    manualInput.value = '';
  });
  btnManualSubmit.addEventListener('click', function () {
    var code = manualInput.value.trim().toUpperCase();
    if (!code) return;
    manualDrawer.classList.remove('open');
    manualInput.value = '';
    lastDismissedBarcode = null;
    currentBarcode = null;
    onBarcodeDetected(code);
  });
  manualInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') btnManualSubmit.click();
  });

  /* ══════════════════════════════════════════════════════════
     State machine helpers
  ══════════════════════════════════════════════════════════ */
  window.resetToIdle = function () {
    clearInactivityTimer();
    if (currentBarcode) {
      setCooldown(currentBarcode);
      currentBarcode = null;
    }
    setState('idle');
    scanBadge.textContent = 'Scanning…';
    scanBadge.style.background = '#6366f1';
    if (!isScanning) {
      resumeScanEngine();
    }
  };

  function setState(s) {
    stateIdle.style.display  = s === 'idle'    ? 'flex'  : 'none';
    stateLoad.style.display  = s === 'loading' ? 'flex'  : 'none';
    stateStud.style.display  = s === 'student' ? 'block' : 'none';
    stateErr.style.display   = s === 'error'   ? 'flex'  : 'none';
  }

  function showError(msg) {
    clearInactivityTimer();
    errMsg.textContent = msg;
    setState('error');
    scanBadge.textContent = 'Not Found';
    scanBadge.style.background = '#ef4444';
    // Auto-resume scanning after 3s on error if no other scan occurred
    var errLookupId = currentLookupId;
    setTimeout(function () {
      if (errLookupId === currentLookupId && stateErr.style.display !== 'none') {
        resetToIdle();
      }
    }, 3000);
  }

  function showCamError(msg) {
    camError.querySelector('p').textContent = msg;
    camError.style.display = 'flex';
  }

  /* ── Toast ── */
  var toastTimer;
  function showToast(msg, color) {
    clearTimeout(toastTimer);
    toast.textContent = msg;
    toast.style.color = color || '#f1f5f9';
    toast.classList.add('show');
    toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 2000);
  }

  /* ── Cleanup on page hide (free camera) ── */
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'hidden') {
      stopScanEngine();
      stopStream();
    } else if (document.visibilityState === 'visible' && !currentBarcode) {
      startCamera();
    }
  });

})();
</script>
</body>
</html>
