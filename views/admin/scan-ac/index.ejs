<%- include('../../partials/header', { title: 'AC Scanner' }) %>

<style>
  /* ── Scanner-specific styles ── */
  @keyframes scan-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(99,102,241,.35); }
    50%       { box-shadow: 0 0 0 10px rgba(99,102,241,0); }
  }
  @keyframes card-pop {
    0%   { opacity: 0; transform: scale(.94) translateY(8px); }
    100% { opacity: 1; transform: scale(1)  translateY(0); }
  }
  @keyframes flash-green {
    0%   { background: #d1fae5; }
    100% { background: transparent; }
  }
  @keyframes flash-red {
    0%   { background: #fee2e2; }
    100% { background: transparent; }
  }
  #scan-input:focus { animation: scan-pulse 1.4s ease infinite; }
  .card-pop  { animation: card-pop .25s ease both; }
  .row-add   { animation: flash-green .8s ease forwards; }
  .row-reduce{ animation: flash-red   .8s ease forwards; }

  /* Print hidden on this page */
  @media print { body { display: none; } }
</style>

<!-- ── Page Header ── -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1.5 bg-indigo-100 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
        </svg>
        AC Scanner
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Achievement Card Scanner</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Scan a student's barcode to give or take an AC card.</p>
  </div>
  <a href="/admin/student-achievements" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-800 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 11.25l-4.5 4.5M4.5 15.75l4.5 4.5M4.5 15.75H19.5" />
    </svg>
    AC Leaderboard
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

  <!-- ══════════════════════════════════════════════════════
       LEFT PANEL — Session context + Scanner input
  ══════════════════════════════════════════════════════════ -->
  <div class="lg:col-span-2 space-y-4">

    <!-- Mobile QR Code Card -->
    <div class="bg-gradient-to-br from-indigo-600 to-indigo-800 rounded-2xl p-5 text-white shadow-lg">
      <p class="text-xs font-bold text-indigo-200 uppercase tracking-wider mb-1">📱 Scan on Phone</p>
      <p class="text-xs text-indigo-300 mb-4">Open the camera scanner on your phone by scanning this QR code.</p>
      <div class="flex items-center gap-4">
        <div id="mobile-qr" class="bg-white rounded-xl p-2 flex-shrink-0"></div>
        <div>
          <p class="text-sm font-bold mb-1">Point your phone camera at this QR code</p>
          <p class="text-xs text-indigo-300 mb-3">The phone camera page lets you scan student barcodes and give/take AC.</p>
          <a id="mobile-link" href="/admin/scan-ac/mobile" target="_blank"
            class="inline-block text-xs font-bold bg-white/20 hover:bg-white/30 text-white px-3 py-1.5 rounded-lg transition">
            Open mobile page ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Session Context Card -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Session Context</p>
      <p class="text-xs text-slate-500 mb-4">Fill once per teaching session. Applied to every scan in this session.</p>

      <div class="space-y-3">
        <div>
          <label for="ctx-subject" class="block text-xs font-semibold text-slate-600 mb-1">Subject</label>
          <input type="text" id="ctx-subject" placeholder="e.g. Mathematics"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:border-indigo-400 transition" />
        </div>
        <div>
          <label for="ctx-class" class="block text-xs font-semibold text-slate-600 mb-1">Class</label>
          <input type="text" id="ctx-class" placeholder="e.g. Class A / 11 SPB"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:border-indigo-400 transition" />
        </div>
      </div>
    </div>

    <!-- Scanner Input Card -->
    <div class="bg-white rounded-2xl border border-indigo-200 shadow-sm p-5">
      <p class="text-xs font-bold text-indigo-600 uppercase tracking-wider mb-3">Barcode Scanner</p>
      <div class="flex items-center gap-3 bg-indigo-50 rounded-xl px-4 py-3 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
        </svg>
        <input type="text" id="scan-input"
          placeholder="Scan or type barcode + Enter…"
          autocomplete="off" spellcheck="false"
          class="flex-1 bg-transparent text-sm font-mono text-slate-800 border-0 outline-none placeholder-indigo-300" />
      </div>
      <p class="text-xs text-slate-400 text-center">Barcode scanners send Enter automatically. Keyboard: just type + Enter.</p>
    </div>

    <!-- Scan Error / Hint -->
    <div id="scan-error" class="hidden bg-red-50 border border-red-200 rounded-2xl px-4 py-3 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
      </svg>
      <p id="scan-error-msg" class="text-sm font-medium text-red-700"></p>
    </div>

  </div><!-- /left panel -->

  <!-- ══════════════════════════════════════════════════════
       RIGHT PANEL — Student card + Session log
  ══════════════════════════════════════════════════════════ -->
  <div class="lg:col-span-3 space-y-4">

    <!-- Student Result Card (hidden until scan) -->
    <div id="student-card" class="hidden bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">

      <!-- Student info -->
      <div class="p-5 flex items-center gap-4">
        <div id="sc-avatar" class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-400 to-indigo-700 flex items-center justify-center text-white text-2xl font-extrabold flex-shrink-0 shadow">?</div>
        <div class="flex-1 min-w-0">
          <h2 id="sc-name" class="text-xl font-extrabold text-slate-900 truncate"></h2>
          <div class="flex items-center gap-2 mt-1 flex-wrap">
            <span id="sc-grade" class="hidden text-xs font-semibold bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full"></span>
            <span id="sc-code" class="text-xs font-mono text-slate-400"></span>
          </div>
        </div>
        <div class="flex-shrink-0 text-right">
          <p class="text-xs font-bold text-amber-500 uppercase tracking-wider">Total AC</p>
          <p id="sc-total" class="text-4xl font-extrabold text-amber-600">0</p>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="grid grid-cols-2 border-t border-slate-100">
        <button id="btn-add"
          class="group flex flex-col items-center justify-center gap-1.5 py-5 bg-emerald-50 hover:bg-emerald-100 active:bg-emerald-200 transition border-r border-slate-100">
          <span class="w-10 h-10 rounded-full bg-emerald-500 group-hover:bg-emerald-600 flex items-center justify-center text-white text-xl font-bold transition shadow">+</span>
          <span class="text-sm font-bold text-emerald-700">Give AC</span>
          <span class="text-xs text-emerald-500">+1 Achievement Card</span>
        </button>
        <button id="btn-reduce"
          class="group flex flex-col items-center justify-center gap-1.5 py-5 bg-red-50 hover:bg-red-100 active:bg-red-200 transition">
          <span class="w-10 h-10 rounded-full bg-red-400 group-hover:bg-red-500 flex items-center justify-center text-white text-xl font-bold transition shadow">−</span>
          <span class="text-sm font-bold text-red-700">Take AC</span>
          <span class="text-xs text-red-400">−1 Achievement Card</span>
        </button>
      </div>

    </div><!-- /student-card -->

    <!-- Idle placeholder (shown when no scan yet) -->
    <div id="idle-placeholder" class="bg-white rounded-2xl border border-slate-100 shadow-sm p-10 text-center">
      <div class="w-16 h-16 rounded-2xl bg-indigo-100 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
        </svg>
      </div>
      <p class="text-slate-500 font-medium">Waiting for scan…</p>
      <p class="text-xs text-slate-400 mt-1">Scan a student's barcode card to get started.</p>
    </div>

    <!-- Session Log -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Session Log</p>
        <span id="log-count" class="text-xs font-semibold bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full">0 scans</span>
      </div>

      <div id="log-empty" class="py-8 text-center text-xs text-slate-400">No transactions yet this session.</div>
      <div id="log-list" class="divide-y divide-slate-50 max-h-72 overflow-y-auto"></div>
    </div>

  </div><!-- /right panel -->
</div>



<!-- QR code for mobile scanner link -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="/js/pages/admin-scan-ac.js"></script>

<%- include('../../partials/footer') %>
