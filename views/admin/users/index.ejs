<%- include('../../partials/header', { title: 'Admin — Users' }) %>

<!-- Header -->
<div class="mb-6 flex items-center gap-3">
  <a href="/admin" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
  </a>
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Users</h1>
    <p class="text-slate-500 text-sm mt-0.5"><%= users.length %> account(s) registered</p>
  </div>
</div>

<!-- Table -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <% if (!users.length) { %>
    <p class="text-center text-slate-400 text-sm py-16">No users found.</p>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <!-- 🟢 Select-all checkbox -->
            <th class="px-4 py-3.5 text-center w-10">
              <input type="checkbox" id="select-all"
                class="w-4 h-4 rounded border-slate-300 text-brand-600 cursor-pointer focus:ring-brand-200">
            </th>
            <th class="px-6 py-3.5 text-left">User</th>
            <th class="px-6 py-3.5 text-center">Status</th>
            <th class="px-6 py-3.5 text-center hidden sm:table-cell">Role</th>
            <th class="px-6 py-3.5 text-center hidden md:table-cell">Reports</th>
            <th class="px-6 py-3.5 text-center hidden lg:table-cell">Started</th>
            <th class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <%
            users.forEach(function(user) {
              const isSelf = typeof currentUser !== 'undefined' && currentUser &&
                             String(currentUser._id) === String(user._id);
          %>
            <tr class="hover:bg-slate-50 transition group">

              <!-- 🟢 Row checkbox (disabled for self and for admins targeting superadmins) -->
              <td class="px-4 py-4 text-center">
                <%
                  const canCheck = !isSelf && !(currentUser && currentUser.role === 'admin' && user.role === 'superadmin');
                %>
                <% if (canCheck) { %>
                  <input type="checkbox" class="row-checkbox w-4 h-4 rounded border-slate-300 text-brand-600 cursor-pointer focus:ring-brand-200"
                    value="<%= user._id %>">
                <% } else { %>
                  <span class="w-4 h-4 inline-block"></span>
                <% } %>
              </td>

              <!-- User info -->
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="relative flex-shrink-0">
                    <% if (user.profilePicture) { %>
                      <img src="<%= user.profilePicture %>" alt=""
                        class="w-9 h-9 rounded-full object-cover border border-slate-100">
                    <% } else { %>
                      <div class="w-9 h-9 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 text-sm font-bold">
                        <%= user.displayName[0].toUpperCase() %>
                      </div>
                    <% } %>
                    <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-white
                      <%= user.isOnline ? 'bg-emerald-400' : 'bg-slate-300' %>"></span>
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <p class="font-semibold text-slate-800 truncate"><%= user.displayName %></p>
                      <% if (isSelf) { %>
                        <span class="text-xs text-slate-400 font-normal">(you)</span>
                      <% } %>
                    </div>
                    <p class="text-xs text-slate-400 truncate">@<%= user.username %></p>
                  </div>
                </div>
              </td>

              <!-- Online status -->
              <td class="px-6 py-4 text-center">
                <% if (user.isOnline) { %>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Online
                  </span>
                <% } else { %>
                  <span class="text-xs text-slate-400">Offline</span>
                <% } %>
              </td>

              <!-- Role -->
              <td class="px-6 py-4 text-center hidden sm:table-cell">
                <% if (user.role === 'superadmin') { %>
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-purple-700 bg-purple-100 px-2.5 py-1 rounded-full animate-pulse">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                    Super Admin
                  </span>
                <% } else if (user.role === 'admin') { %>
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-red-700 bg-red-100 px-2.5 py-1 rounded-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                    Admin
                  </span>
                <% } else { %>
                  <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">Teacher</span>
                <% } %>
              </td>

              <!-- Reports count -->
              <td class="px-6 py-4 text-center hidden md:table-cell">
                <a href="/admin/reports?teacher_id=<%= user._id %>"
                  class="text-sm font-bold text-slate-700 hover:text-brand-600 transition">
                  <%= user.reportCount %>
                </a>
              </td>

              <!-- Started Teaching -->
              <td class="px-6 py-4 text-center hidden lg:table-cell">
                <span class="text-xs font-mono text-slate-400">
                  <%= user.joinDate
                    ? new Date(user.joinDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
                    : '—' %>
                </span>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-1.5">
                  <%
                    const canEdit = !(currentUser && currentUser.role === 'admin' && user.role === 'superadmin');
                    const canDelete = !isSelf && !(currentUser && currentUser.role === 'admin' && user.role === 'superadmin');
                  %>
                  <% if (canEdit) { %>
                    <a href="/admin/users/<%= user._id %>/edit"
                      class="p-1.5 rounded-lg text-slate-400 hover:text-amber-500 hover:bg-amber-50 transition" title="Edit">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                      </svg>
                    </a>
                  <% } else { %>
                    <span class="p-1.5 rounded-lg text-slate-200 cursor-not-allowed" title="Admins cannot edit superadmins">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                      </svg>
                    </span>
                  <% } %>

                  <% if (canDelete) { %>
                    <button
                      data-delete-url="/admin/users/<%= user._id %>"
                      data-name="<%= user.displayName %>"
                      class="js-delete-user p-1.5 rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 transition" title="Delete">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                    </button>
                  <% } else if (isSelf) { %>
                    <span class="w-7 h-7 inline-block"></span>
                  <% } else { %>
                    <span class="p-1.5 rounded-lg text-slate-200 cursor-not-allowed" title="Admins cannot delete superadmins">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                    </span>
                  <% } %>
                </div>
              </td>

            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- 🟢 Floating bulk action bar -->
<div id="bulk-bar"
  class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white rounded-2xl shadow-2xl px-5 py-3 flex items-center gap-4">
  <span class="text-sm font-semibold whitespace-nowrap"><span id="bulk-count">0</span> selected</span>
  <button id="bulk-delete-btn"
    class="bg-red-500 hover:bg-red-600 active:scale-95 text-white text-sm font-semibold px-4 py-1.5 rounded-xl transition whitespace-nowrap">
    Delete Selected
  </button>
  <button onclick="clearSelection()"
    class="text-sm text-slate-400 hover:text-white transition whitespace-nowrap">Cancel</button>
</div>

<script>
  function getCsrfToken() {
    var m = document.querySelector('meta[name="csrf-token"]');
    return m ? m.getAttribute('content') : '';
  }

  // ── Single delete ──────────────────────────────────────────
  document.querySelectorAll('.js-delete-user').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url  = btn.dataset.deleteUrl;
      var name = btn.dataset.name;
      Swal.fire({
        title: 'Delete ' + name + '?',
        html: '<p class="text-sm text-slate-500">This will permanently delete the user and <strong>all their reports</strong>. This cannot be undone.</p>',
        icon: 'warning',
        showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#64748b',
        confirmButtonText: 'Yes, delete', cancelButtonText: 'Cancel',
        reverseButtons: true, focusCancel: true,
        customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl', cancelButton: 'rounded-xl' },
      }).then(function(result) {
        if (!result.isConfirmed) return;
        Swal.fire({ title: 'Deleting…', allowOutsideClick: false, allowEscapeKey: false,
          showConfirmButton: false, didOpen: function() { Swal.showLoading(); } });
        fetch(url, {
          method: 'DELETE',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'x-csrf-token': getCsrfToken() },
        }).then(function(res) {
          if (res.ok) {
            Swal.fire({ title: 'Deleted!', text: name + ' has been removed.', icon: 'success',
              confirmButtonColor: '#16a34a',
              customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' },
              timer: 1500, showConfirmButton: false,
            }).then(function() { window.location.reload(); });
          } else {
            res.json().then(function(data) {
              Swal.fire({ title: 'Error', text: data.error || 'Failed to delete.',
                icon: 'error', confirmButtonColor: '#ef4444',
                customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
            });
          }
        }).catch(function() {
          Swal.fire({ title: 'Network Error', text: 'Could not reach the server.',
            icon: 'error', confirmButtonColor: '#ef4444',
            customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
        });
      });
    });
  });

  // ── 🟢 Bulk delete logic ───────────────────────────────────
  var selectAll = document.getElementById('select-all');
  var bulkBar   = document.getElementById('bulk-bar');
  var bulkCount = document.getElementById('bulk-count');

  function getChecked() {
    return Array.from(document.querySelectorAll('.row-checkbox:checked')).map(function(cb) { return cb.value; });
  }

  function updateBulkBar() {
    var ids = getChecked();
    bulkCount.textContent = ids.length;
    if (ids.length > 0) bulkBar.classList.remove('hidden');
    else                bulkBar.classList.add('hidden');
    if (selectAll) {
      var all = document.querySelectorAll('.row-checkbox');
      selectAll.indeterminate = ids.length > 0 && ids.length < all.length;
      selectAll.checked       = all.length > 0 && ids.length === all.length;
    }
  }

  function clearSelection() {
    document.querySelectorAll('.row-checkbox').forEach(function(cb) { cb.checked = false; });
    if (selectAll) selectAll.checked = false;
    updateBulkBar();
  }

  document.querySelectorAll('.row-checkbox').forEach(function(cb) {
    cb.addEventListener('change', updateBulkBar);
  });

  if (selectAll) {
    selectAll.addEventListener('change', function() {
      document.querySelectorAll('.row-checkbox').forEach(function(cb) { cb.checked = selectAll.checked; });
      updateBulkBar();
    });
  }

  document.getElementById('bulk-delete-btn').addEventListener('click', function() {
    var ids = getChecked();
    if (!ids.length) return;
    Swal.fire({
      title: 'Delete ' + ids.length + ' user(s)?',
      html: '<p class="text-sm text-slate-500">This will also delete <strong>all their reports</strong>. This cannot be undone.</p>',
      icon: 'warning',
      showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, delete all!', cancelButtonText: 'Cancel',
      reverseButtons: true, focusCancel: true,
      customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl', cancelButton: 'rounded-xl' },
    }).then(function(result) {
      if (!result.isConfirmed) return;
      Swal.fire({ title: 'Deleting…', allowOutsideClick: false, allowEscapeKey: false,
        showConfirmButton: false, didOpen: function() { Swal.showLoading(); } });
      fetch('/admin/users/bulk', {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'x-csrf-token': getCsrfToken(),
        },
        body: JSON.stringify({ ids: ids }),
      }).then(function(res) { return res.json(); }).then(function(data) {
        if (data.ok) {
          Swal.fire({ title: 'Deleted!', text: data.deleted + ' user(s) removed.', icon: 'success',
            confirmButtonColor: '#16a34a', timer: 1500, showConfirmButton: false,
            customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' },
          }).then(function() { window.location.reload(); });
        } else {
          Swal.fire({ title: 'Error', text: data.error || 'Failed to delete.', icon: 'error',
            confirmButtonColor: '#ef4444', customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
        }
      }).catch(function() {
        Swal.fire({ title: 'Network Error', text: 'Could not reach the server.', icon: 'error',
          confirmButtonColor: '#ef4444', customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
      });
    });
  });
</script>

<%- include('../../partials/footer') %>
