<%- include('../../partials/header', { title: 'Admin — Edit User' }) %>

<div class="max-w-xl mx-auto">

  <!-- Header -->
  <div class="mb-8 flex items-center gap-3">
    <a href="/admin/users" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Edit User</h1>
      <p class="text-slate-500 text-sm mt-0.5">Modifying <span class="font-semibold text-slate-700"><%= user.displayName %></span></p>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success) { %>
    <div class="mb-6 flex items-center gap-3 bg-brand-50 border border-brand-200 text-brand-700 px-4 py-3 rounded-xl text-sm font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <%= success %>
    </div>
  <% } %>

  <% if (errors.length > 0) { %>
    <div class="mb-6 bg-red-50 border border-red-200 rounded-xl px-4 py-3">
      <% errors.forEach(e => { %>
        <p class="text-sm text-red-600 font-medium flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <%= e %>
        </p>
      <% }) %>
    </div>
  <% } %>

  <form id="edit-user-form" action="/admin/users/<%= user._id %>" method="POST" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Account Info -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5">
      <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Account Info</h2>

      <div>
        <label for="displayName" class="block text-xs font-semibold text-slate-500 mb-1.5">Full Name</label>
        <input type="text" id="displayName" name="displayName" value="<%= user.displayName %>" required
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition">
      </div>

      <div>
        <label for="username" class="block text-xs font-semibold text-slate-500 mb-1.5">Username</label>
        <input type="text" id="username" name="username" value="<%= user.username %>" required
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition">
      </div>

      <!-- Role -->
      <div>
        <label for="role" class="block text-xs font-semibold text-slate-500 mb-1.5">Role</label>
        <% const isSelf = typeof currentUser !== 'undefined' && currentUser && String(currentUser._id) === String(user._id); %>
        <% if (isSelf) { %>
          <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50">
            <span class="inline-flex items-center gap-1 text-xs font-bold text-red-700 bg-red-100 px-2.5 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
              Admin
            </span>
            <span class="text-xs text-slate-400">Cannot change your own role.</span>
          </div>
          <input type="hidden" name="role" value="admin">
        <% } else { %>
          <div class="relative">
            <select id="role" name="role"
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-10">
              <option value="teacher" <%= user.role === 'teacher' ? 'selected' : '' %>>Teacher</option>
              <option value="admin"   <%= user.role === 'admin'   ? 'selected' : '' %>>Admin</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Join Date -->
      <div>
        <label class="block text-xs font-semibold text-slate-500 mb-1.5">
          Started Teaching
          <span class="ml-1 font-normal normal-case text-slate-400">— month &amp; year</span>
        </label>
        <%
          const jd     = user.joinDate ? new Date(user.joinDate) : null;
          const jMonth = jd ? jd.getMonth() + 1 : '';
          const jYear  = jd ? jd.getFullYear()  : '';
        %>
        <div class="grid grid-cols-2 gap-2">
          <div class="relative">
            <select name="joinMonth"
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-8">
              <option value="">Month</option>
              <% ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].forEach((m, i) => { %>
                <option value="<%= i + 1 %>" <%= jMonth === (i + 1) ? 'selected' : '' %>><%= m %></option>
              <% }) %>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </div>
          </div>
          <input type="number" name="joinYear" value="<%= jYear %>" placeholder="Year"
            min="1970" max="<%= currentYear %>"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition font-mono" />
        </div>
        <% if (user.experienceFormatted) { %>
          <p class="text-xs text-brand-600 font-semibold mt-1">Experience: <%= user.experienceFormatted %></p>
        <% } %>
      </div>
    </div>

    <!-- 🟢 Commission Prices — id added for #anchor from commission page -->
    <div id="commission-section" class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5 scroll-mt-6">
      <div>
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Commission per Session</h2>
        <p class="text-xs text-slate-400 mt-1">Set this teacher's earnings per session type (IDR).</p>
      </div>
      <div class="space-y-3">
        <%
          const commissionTypes = [
            { key: 'primeFull',     label: 'Prime Teacher (Full)',     color: 'emerald' },
            { key: 'primeAssisted', label: 'Prime Teacher (Assisted)', color: 'purple'  },
            { key: 'halfPrime',     label: '½ Prime Teacher',          color: 'amber'   },
            { key: 'assistant',     label: 'Assistant Teacher',        color: 'sky'     },
          ];
        %>
        <% commissionTypes.forEach(ct => { %>
          <div class="flex items-center gap-3">
            <span class="badge-<%= ct.color %> text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap w-44 text-center flex-shrink-0"><%= ct.label %></span>
            <div class="relative flex-1">
              <span class="absolute inset-y-0 left-4 flex items-center text-xs text-slate-400 font-medium pointer-events-none">Rp</span>
              <input type="number" name="commission_<%= ct.key %>"
                value="<%= (user.commission && user.commission[ct.key]) || 0 %>"
                min="0" step="500"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-2.5 text-sm font-mono text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition" />
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Change Password -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5">
      <div>
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Reset Password</h2>
        <p class="text-xs text-slate-400 mt-1">Leave blank to keep the current password.</p>
      </div>
      <div>
        <label for="password" class="block text-xs font-semibold text-slate-500 mb-1.5">New Password</label>
        <input type="password" id="password" name="password" minlength="6"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition"
          placeholder="Min. 6 characters">
      </div>
    </div>

    <!-- Submit -->
    <div class="flex gap-3">
      <a href="/admin/users" id="cancel-btn"
        class="flex-1 text-center py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
        Cancel
      </a>
      <button type="submit"
        class="flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition active:scale-95">
        Save Changes
      </button>
    </div>
  </form>

</div>

<!-- 🟢 Auto-scroll to commission section if linked via #anchor -->
<script>
  if (window.location.hash === '#commission-section') {
    var el = document.getElementById('commission-section');
    if (el) setTimeout(function() {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      el.classList.add('ring-2', 'ring-amber-300', 'ring-offset-2');
      setTimeout(function() { el.classList.remove('ring-2', 'ring-amber-300', 'ring-offset-2'); }, 2000);
    }, 150);
  }
</script>

<!-- 🟠 Unsaved changes warning -->
<script>
  (function () {
    var form  = document.getElementById('edit-user-form');
    var dirty = false;

    form.addEventListener('input',  function () { dirty = true; });
    form.addEventListener('change', function () { dirty = true; });
    form.addEventListener('submit', function () { dirty = false; });

    document.getElementById('cancel-btn').addEventListener('click', function (e) {
      if (!dirty) return;
      e.preventDefault();
      Swal.fire({
        title: 'Unsaved changes',
        text: 'You have unsaved changes. Leave anyway?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444', cancelButtonColor: '#64748b',
        confirmButtonText: 'Leave', cancelButtonText: 'Stay',
        reverseButtons: true, focusCancel: true,
        customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl', cancelButton: 'rounded-xl' },
      }).then(function (result) {
        if (result.isConfirmed) window.location.href = '/admin/users';
      });
    });

    window.addEventListener('beforeunload', function (e) {
      if (dirty) { e.preventDefault(); e.returnValue = ''; }
    });
  })();
</script>

<%- include('../../partials/footer') %>
