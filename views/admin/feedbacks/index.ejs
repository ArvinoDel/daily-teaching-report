<%- include('../../partials/header', { title: 'Admin — Feedbacks' }) %>

<!-- Header -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div class="flex items-center gap-3">
    <a href="/admin" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Error Feedbacks</h1>
      <p class="text-slate-500 text-sm mt-0.5"><%= feedbacks.length %> feedback(s) submitted</p>
    </div>
  </div>

  <!-- Client-side filter tabs -->
  <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl w-fit self-start sm:self-auto">
    <button onclick="filterStatus('all')" id="tab-all" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-800 shadow-sm transition">
      All
    </button>
    <button onclick="filterStatus('pending')" id="tab-pending" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-700 transition">
      Pending
    </button>
    <button onclick="filterStatus('resolved')" id="tab-resolved" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-700 transition">
      Resolved
    </button>
    <button onclick="filterStatus('ignored')" id="tab-ignored" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-700 transition">
      Ignored
    </button>
  </div>
</div>

<!-- Stats Counter Grid -->
<%
  let pendingCount = feedbacks.filter(f => f.status === 'pending').length;
  let resolvedCount = feedbacks.filter(f => f.status === 'resolved').length;
  let ignoredCount = feedbacks.filter(f => f.status === 'ignored').length;
%>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-4">
    <div class="w-10 h-10 bg-amber-50 border border-amber-100 rounded-xl flex items-center justify-center text-amber-500">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
      </svg>
    </div>
    <div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pending Issues</p>
      <p class="text-xl font-bold text-amber-600"><%= pendingCount %></p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-4">
    <div class="w-10 h-10 bg-emerald-50 border border-emerald-100 rounded-xl flex items-center justify-center text-emerald-500">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Resolved</p>
      <p class="text-xl font-bold text-emerald-600"><%= resolvedCount %></p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex items-center gap-4">
    <div class="w-10 h-10 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ignored</p>
      <p class="text-xl font-bold text-slate-600"><%= ignoredCount %></p>
    </div>
  </div>
</div>

<!-- Main Table Card -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <% if (!feedbacks.length) { %>
    <div class="text-center py-16 px-4">
      <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
        </svg>
      </div>
      <p class="text-sm font-bold text-slate-800">Tidak ada laporan error</p>
      <p class="text-slate-400 text-xs mt-1">Sistem belum menerima laporan feedback/error apa pun saat ini.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50 border-b border-slate-100">
            <th class="px-6 py-3.5 text-left">Submitter</th>
            <th class="px-6 py-3.5 text-left">Description</th>
            <th class="px-6 py-3.5 text-left">Source Page</th>
            <th class="px-6 py-3.5 text-center">Screenshot</th>
            <th class="px-6 py-3.5 text-center">Status</th>
            <th class="px-6 py-3.5 text-center">Date</th>
            <th class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" id="feedback-table-body">
          <% feedbacks.forEach(function(fb) { %>
            <tr class="feedback-row hover:bg-slate-50 transition group" data-status="<%= fb.status %>">
              
              <!-- Submitter -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (fb.user) { %>
                  <!-- Registered User -->
                  <div class="flex items-center gap-3">
                    <div class="flex-shrink-0">
                      <% if (fb.user.profilePicture) { %>
                        <img src="<%= fb.user.profilePicture %>" alt="" class="w-8 h-8 rounded-full object-cover border border-slate-100" />
                      <% } else { %>
                        <div class="w-8 h-8 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 text-xs font-bold">
                          <%= fb.user.displayName[0].toUpperCase() %>
                        </div>
                      <% } %>
                    </div>
                    <div>
                      <p class="font-semibold text-slate-800 text-xs flex items-center gap-1.5">
                        <%= fb.user.displayName %>
                        <% if (fb.user.role === 'superadmin') { %>
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-purple-500" title="Super Admin"></span>
                        <% } else if (fb.user.role === 'admin') { %>
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-red-500" title="Admin"></span>
                        <% } else { %>
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-400" title="Teacher"></span>
                        <% } %>
                      </p>
                      <p class="text-[10px] text-slate-400">@<%= fb.user.username %></p>
                    </div>
                  </div>
                <% } else { %>
                  <!-- Guest -->
                  <div>
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <span class="inline-flex items-center text-[10px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">GUEST</span>
                      <p class="font-semibold text-slate-800 text-xs"><%= fb.submitterName || 'Anonim' %></p>
                    </div>
                    <% if (fb.submitterEmail) { %>
                      <a href="mailto:<%= fb.submitterEmail %>" class="text-[10px] text-brand-600 hover:underline"><%= fb.submitterEmail %></a>
                    <% } else { %>
                      <p class="text-[10px] text-slate-300 italic">No email</p>
                    <% } %>
                  </div>
                <% } %>
              </td>

              <!-- Description -->
              <td class="px-6 py-4 max-w-xs sm:max-w-md">
                <div class="text-xs text-slate-700 font-medium break-words leading-relaxed whitespace-pre-wrap"><%= fb.description %></div>
              </td>

              <!-- Source Page -->
              <td class="px-6 py-4">
                <% if (fb.pageUrl) { %>
                  <%
                    let displayUrl = fb.pageUrl;
                    try {
                      const urlObj = new URL(fb.pageUrl);
                      displayUrl = urlObj.pathname + urlObj.search;
                    } catch (e) {}
                  %>
                  <a href="<%= fb.pageUrl %>" target="_blank" class="inline-flex items-center gap-1 text-xs text-brand-600 hover:text-brand-700 hover:underline font-mono bg-slate-50 px-2 py-1 rounded border border-slate-100 max-w-[150px] truncate" title="<%= fb.pageUrl %>">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                    </svg>
                    <%= displayUrl %>
                  </a>
                <% } else { %>
                  <span class="text-xs text-slate-300 italic">—</span>
                <% } %>
              </td>

              <!-- Screenshot -->
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (fb.screenshotUrl) { %>
                  <div class="relative inline-block group/img cursor-zoom-in" onclick="openLightbox('<%= fb.screenshotUrl %>')">
                    <img src="<%= fb.screenshotUrl %>" alt="screenshot" class="w-12 h-10 rounded-lg border border-slate-200 object-cover hover:shadow transition group-hover/img:scale-105" />
                    <span class="absolute inset-0 bg-black/40 text-white text-[9px] rounded-lg font-bold flex items-center justify-center opacity-0 group-hover/img:opacity-100 transition duration-150">VIEW</span>
                  </div>
                <% } else { %>
                  <span class="text-xs text-slate-300 italic">No image</span>
                <% } %>
              </td>

              <!-- Status -->
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <% if (fb.status === 'pending') { %>
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-600 bg-amber-50 border border-amber-100 px-2.5 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>Pending
                  </span>
                <% } else if (fb.status === 'resolved') { %>
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 bg-emerald-50 border border-emerald-100 px-2.5 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Resolved
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500 bg-slate-50 border border-slate-100 px-2.5 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>Ignored
                  </span>
                <% } %>
              </td>

              <!-- Date -->
              <td class="px-6 py-4 text-center whitespace-nowrap">
                <span class="font-mono text-xs text-slate-400">
                  <%= fb.createdAt.toLocaleDateString('id-ID', { day: '2-digit', month: 'short' }) %>
                  <span class="text-[10px] text-slate-300"><%= fb.createdAt.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></span>
                </span>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-1.5">
                  
                  <!-- Status toggles -->
                  <% if (fb.status !== 'resolved') { %>
                    <form action="/admin/feedbacks/<%= fb._id %>/status" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="status" value="resolved" />
                      <button type="submit" class="p-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-100 rounded-lg shadow-sm transition hover:scale-105" title="Tandai Selesai">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                      </button>
                    </form>
                  <% } %>

                  <% if (fb.status !== 'ignored') { %>
                    <form action="/admin/feedbacks/<%= fb._id %>/status" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="status" value="ignored" />
                      <button type="submit" class="p-1.5 bg-slate-50 hover:bg-slate-100 text-slate-500 border border-slate-200 rounded-lg shadow-sm transition hover:scale-105" title="Abaikan / Skip">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5" />
                        </svg>
                      </button>
                    </form>
                  <% } else { %>
                    <!-- Reopen/mark pending -->
                    <form action="/admin/feedbacks/<%= fb._id %>/status" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="status" value="pending" />
                      <button type="submit" class="p-1.5 bg-amber-50 hover:bg-amber-100 text-amber-600 border border-amber-100 rounded-lg shadow-sm transition hover:scale-105" title="Buka Kembali">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                      </button>
                    </form>
                  <% } %>

                  <!-- Delete -->
                  <form action="/admin/feedbacks/<%= fb._id %>" method="POST" class="inline" onsubmit="return confirm('Apakah kamu yakin ingin menghapus laporan ini secara permanen?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="_method" value="DELETE" />
                    <button type="submit" class="p-1.5 bg-red-50 hover:bg-red-100 text-red-500 border border-red-100 rounded-lg shadow-sm transition hover:scale-105" title="Hapus Permanen">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                    </button>
                  </form>

                </div>
              </td>

            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Premium Lightbox Modal for Screenshots -->
<div id="lightbox" class="hidden fixed inset-0 z-50 bg-slate-900/90 flex items-center justify-center p-4 backdrop-blur-sm cursor-zoom-out" onclick="closeLightbox()">
  <div class="relative max-w-4xl max-h-[85vh] flex flex-col items-center">
    <button class="absolute -top-10 right-0 text-white hover:text-slate-200 text-sm font-semibold flex items-center gap-1.5" onclick="closeLightbox(event)">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
      Tutup
    </button>
    <img id="lightbox-img" src="" alt="Screenshot Full" class="max-h-[80vh] max-w-full rounded-2xl shadow-2xl border border-white/10 object-contain cursor-default" onclick="event.stopPropagation()" />
  </div>
</div>

<!-- Script block for client-side filtering and lightbox -->
<script>
  function filterStatus(status) {
    // Update active tab styles
    var tabs = document.querySelectorAll('.filter-tab');
    tabs.forEach(function(tab) {
      if (tab.id === 'tab-' + status) {
        tab.className = 'filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-800 shadow-sm transition';
      } else {
        tab.className = 'filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-700 transition';
      }
    });

    // Toggle rows based on status
    var rows = document.querySelectorAll('.feedback-row');
    rows.forEach(function(row) {
      if (status === 'all' || row.getAttribute('data-status') === status) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  // Lightbox functions
  function openLightbox(url) {
    var lightbox = document.getElementById('lightbox');
    var img = document.getElementById('lightbox-img');
    img.src = url;
    lightbox.classList.remove('hidden');
    document.body.classList.add('overflow-hidden'); // Disable scroll
  }

  function closeLightbox(event) {
    if (event) {
      event.stopPropagation();
    }
    var lightbox = document.getElementById('lightbox');
    lightbox.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  // Escape key support to close lightbox
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });
</script>

<%- include('../../partials/footer') %>
