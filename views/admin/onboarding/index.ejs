<%- include('../../partials/header', { title: 'Admin — Onboarding Progress' }) %>

<div class="mb-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
      <a href="/admin/users" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition" title="Back to users" aria-label="Back to users">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Onboarding progress</h1>
        <p class="text-slate-500 text-xs mt-0.5">Track teacher checklist completion, funnel drop-off, and reminder outreach.</p>
      </div>
    </div>
  </div>

  <!-- Three Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Completed</span>
        <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-slate-900"><%= report.summary.completed %></span>
        <span class="text-xs text-slate-400 font-medium">of <%= report.summary.total %> teachers</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Finished all required checklist steps.</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">In progress</span>
        <span class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-slate-900"><%= report.summary.inProgress %></span>
        <span class="text-xs text-slate-400 font-medium">teachers</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Completed at least one step.</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Not started</span>
        <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
        </span>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-slate-900"><%= report.summary.notStarted %></span>
        <span class="text-xs text-slate-400 font-medium">teachers</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">No steps done and none skipped.</p>
    </div>
  </div>

  <!-- Section 1: Checklist Funnel -->
  <div class="mb-10">
    <div class="mb-3">
      <h2 class="text-base font-bold text-slate-900">Step completion funnel</h2>
      <p class="text-xs text-slate-500 mt-0.5">Progression through each step of the getting started checklist.</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="bg-slate-50/75 border-b border-slate-100 text-slate-500 font-semibold uppercase tracking-wider">
              <th class="px-5 py-3.5">Step</th>
              <th class="px-5 py-3.5 text-center">Done</th>
              <th class="px-5 py-3.5 text-center">Skipped</th>
              <th class="px-5 py-3.5 text-center">To do</th>
              <th class="px-5 py-3.5 text-right">Median time to done</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% (report.funnel || []).forEach(function(step) { %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="px-5 py-3.5 font-semibold text-slate-900">
                  <%= step.title %>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                    <%= step.done %>
                  </span>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                    <%= step.skipped %>
                  </span>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200/60">
                    <%= step.todo %>
                  </span>
                </td>
                <td class="px-5 py-3.5 text-right font-mono text-slate-600">
                  <%= step.medianDaysToDone !== null ? step.medianDaysToDone + ' days' : '—' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Section 2: Stuck Teachers Table -->
  <div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
      <div>
        <h2 class="text-base font-bold text-slate-900">Stuck teachers</h2>
        <p class="text-xs text-slate-500 mt-0.5">Teachers who signed up 3 or more days ago and have not completed onboarding.</p>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="toggle-filter-7days"
          class="min-h-[36px] px-3.5 py-1.5 rounded-xl border border-slate-200 hover:border-slate-300 bg-white text-slate-600 text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Stuck for more than 7 days
        </button>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <% if (!report.stuck || report.stuck.length === 0) { %>
        <p class="text-center text-slate-400 text-xs py-14">No teachers are currently stuck.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="stuck-teachers-table">
            <thead>
              <tr class="bg-slate-50/75 border-b border-slate-100 text-slate-500 font-semibold uppercase tracking-wider">
                <th class="px-5 py-3.5">Teacher</th>
                <th class="px-5 py-3.5">Signed up</th>
                <th class="px-5 py-3.5 text-center">Days stuck</th>
                <th class="px-5 py-3.5">Remaining steps</th>
                <th class="px-5 py-3.5">Reminders</th>
                <th class="px-5 py-3.5 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <%
                const nowMs = Date.now();
                const oneDayMs = 24 * 60 * 60 * 1000;
                report.stuck.forEach(function(teacher) {
                  const lastAdminMs = teacher.lastAdminSentAt ? new Date(teacher.lastAdminSentAt).getTime() : 0;
                  const isThrottled = (nowMs - lastAdminMs) < oneDayMs;
              %>
                <tr class="stuck-teacher-row hover:bg-slate-50/50 transition" data-days-since="<%= teacher.daysSince %>" id="stuck-row-<%= teacher.id %>">
                  <td class="px-5 py-4 font-semibold text-slate-900">
                    <a href="/admin/users/<%= teacher.id %>/edit" class="hover:text-brand-600 transition">
                      <%= teacher.name %>
                    </a>
                  </td>
                  <td class="px-5 py-4 text-slate-500">
                    <%= new Date(teacher.signedUpAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </td>
                  <td class="px-5 py-4 text-center">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-bold text-xs <%= teacher.daysSince > 7 ? 'bg-red-50 text-red-700 border border-red-200/60' : 'bg-amber-50 text-amber-700 border border-amber-200/60' %>">
                      <%= teacher.daysSince %> days
                    </span>
                  </td>
                  <td class="px-5 py-4">
                    <div class="flex flex-wrap gap-1 max-w-xs">
                      <% (teacher.remainingSteps || []).forEach(function(title) { %>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium">
                          <%= title %>
                        </span>
                      <% }); %>
                    </div>
                  </td>
                  <td class="px-5 py-4 text-slate-500 space-y-0.5">
                    <div>Sent: <span class="font-semibold text-slate-700 reminder-count"><%= teacher.remindersCount %></span></div>
                    <div class="text-[11px] text-slate-400">
                      Last: <span class="reminder-last"><%= teacher.lastReminderAt ? new Date(teacher.lastReminderAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Never' %></span>
                    </div>
                  </td>
                  <td class="px-5 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button type="button"
                        data-user-id="<%= teacher.id %>"
                        class="btn-send-reminder min-h-[36px] px-3.5 py-1.5 rounded-xl text-xs font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 <%= isThrottled ? 'bg-slate-100 text-slate-400 cursor-not-allowed' : 'bg-brand-600 hover:bg-brand-700 text-white shadow-xs' %>"
                        <%= isThrottled ? 'disabled' : '' %>>
                        <%= isThrottled ? 'Sent today' : 'Send reminder' %>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/pages/admin-onboarding.js"></script>

<%- include('../../partials/footer') %>
