<%- include('../../partials/header', { title: 'Import Groups' }) %>

<style>
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-border {
    0%, 100% { border-color: #6366f1; }
    50%      { border-color: #a5b4fc; }
  }
  .fade-in { animation: fadeSlideIn .3s ease both; }

  .drop-zone {
    transition: all .2s ease;
  }
  .drop-zone.dragover {
    border-color: #6366f1;
    background-color: #eef2ff;
    animation: pulse-border 1.2s ease infinite;
  }
  .drop-zone.has-file {
    border-color: #22c55e;
    background-color: #f0fdf4;
  }

  .spinner {
    display: inline-block;
    width: 16px; height: 16px;
    border: 2.5px solid rgba(255,255,255,.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin .6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .result-card { animation: fadeSlideIn .35s ease both; }
</style>

<!-- Page Header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-rose-100 text-rose-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
        Superadmin Only
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Import Groups from CSV</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Upload roster CSVs to replace all groups. A backup is created automatically before import.</p>
  </div>

  <a href="/admin/groups"
    class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold px-4 py-2.5 rounded-xl transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
    </svg>
    Back to Groups
  </a>
</div>

<!-- Smart Import Banner -->
<div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-0.5 flex-shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
  </svg>
  <div>
    <strong>Smart Non-Destructive Import.</strong>
    New students are added with unique barcodes and student codes. Existing students keep their identity, barcode, and full Achievement Card history — nothing is deleted.
  </div>
</div>

<!-- Upload Form -->
<form id="importForm" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Groups CSV -->
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Groups CSV
        <span class="text-slate-400 font-normal">(group classes)</span>
      </label>
      <div id="dropGroups" class="drop-zone relative flex flex-col items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-white cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30">
        <input type="file" name="groupsCsv" id="groupsCsvInput" accept=".csv" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
        <p id="dropGroupsLabel" class="text-sm text-slate-500 text-center">
          <span class="font-semibold text-indigo-600">Click to upload</span> or drag and drop<br>
          <span class="text-xs text-slate-400">e.g. Groups_-_NEW_ACADEMIC_YEAR.csv</span>
        </p>
      </div>
    </div>

    <!-- Private CSV -->
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Private CSV
        <span class="text-slate-400 font-normal">(private sessions)</span>
      </label>
      <div id="dropPrivate" class="drop-zone relative flex flex-col items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-white cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30">
        <input type="file" name="privateCsv" id="privateCsvInput" accept=".csv" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
        <p id="dropPrivateLabel" class="text-sm text-slate-500 text-center">
          <span class="font-semibold text-indigo-600">Click to upload</span> or drag and drop<br>
          <span class="text-xs text-slate-400">e.g. Private_-_NEW_PRIVATE.csv</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-wrap gap-3">
    <button type="button" id="previewBtn"
      class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      <span id="previewBtnLabel">Preview</span>
    </button>

    <button type="button" id="importBtn" disabled
      class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      <span id="importBtnLabel">Import Now</span>
    </button>
  </div>
</form>

<!-- Results Panel -->
<div id="resultsPanel" class="mt-8 hidden"></div>

<script src="/js/pages/admin-groups-import.js"></script>

<%- include('../../partials/footer') %>
