<%- include('../../partials/header', { title: 'Import Groups' }) %>

<style>
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-border {
    0%, 100% { border-color: #6366f1; }
    50%      { border-color: #a5b4fc; }
  }
  .fade-in { animation: fadeSlideIn .3s ease both; }

  .drop-zone {
    transition: all .2s ease;
  }
  .drop-zone.dragover {
    border-color: #6366f1;
    background-color: #eef2ff;
    animation: pulse-border 1.2s ease infinite;
  }
  .drop-zone.has-file {
    border-color: #22c55e;
    background-color: #f0fdf4;
  }

  .spinner {
    display: inline-block;
    width: 16px; height: 16px;
    border: 2.5px solid rgba(255,255,255,.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin .6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .result-card { animation: fadeSlideIn .35s ease both; }
</style>

<!-- Page Header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-rose-100 text-rose-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
        Superadmin Only
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Import Groups from CSV</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Upload roster CSVs to replace all groups. A backup is created automatically before import.</p>
  </div>

  <a href="/admin/groups"
    class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold px-4 py-2.5 rounded-xl transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
    </svg>
    Back to Groups
  </a>
</div>

<!-- Smart Import Banner -->
<div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-0.5 flex-shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
  </svg>
  <div>
    <strong>Smart Non-Destructive Import.</strong>
    New students are added with unique barcodes and student codes. Existing students keep their identity, barcode, and full Achievement Card history — nothing is deleted.
  </div>
</div>

<!-- Upload Form -->
<form id="importForm" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Groups CSV -->
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Groups CSV
        <span class="text-slate-400 font-normal">(group classes)</span>
      </label>
      <div id="dropGroups" class="drop-zone relative flex flex-col items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-white cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30">
        <input type="file" name="groupsCsv" id="groupsCsvInput" accept=".csv" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
        <p id="dropGroupsLabel" class="text-sm text-slate-500 text-center">
          <span class="font-semibold text-indigo-600">Click to upload</span> or drag and drop<br>
          <span class="text-xs text-slate-400">e.g. Groups_-_NEW_ACADEMIC_YEAR.csv</span>
        </p>
      </div>
    </div>

    <!-- Private CSV -->
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Private CSV
        <span class="text-slate-400 font-normal">(private sessions)</span>
      </label>
      <div id="dropPrivate" class="drop-zone relative flex flex-col items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-white cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30">
        <input type="file" name="privateCsv" id="privateCsvInput" accept=".csv" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
        </svg>
        <p id="dropPrivateLabel" class="text-sm text-slate-500 text-center">
          <span class="font-semibold text-indigo-600">Click to upload</span> or drag and drop<br>
          <span class="text-xs text-slate-400">e.g. Private_-_NEW_PRIVATE.csv</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-wrap gap-3">
    <button type="button" id="previewBtn"
      class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      <span id="previewBtnLabel">Preview</span>
    </button>

    <button type="button" id="importBtn" disabled
      class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      <span id="importBtnLabel">Import Now</span>
    </button>
  </div>
</form>

<!-- Results Panel -->
<div id="resultsPanel" class="mt-8 hidden"></div>

<script>
(function () {
  var form         = document.getElementById('importForm');
  var previewBtn   = document.getElementById('previewBtn');
  var importBtn    = document.getElementById('importBtn');
  var resultsPanel = document.getElementById('resultsPanel');

  var groupsInput  = document.getElementById('groupsCsvInput');
  var privateInput = document.getElementById('privateCsvInput');

  // ── Drop zone UX ──────────────────────────────────────────
  function setupDropZone(zone, input, labelId) {
    var label = document.getElementById(labelId);
    var originalHTML = label.innerHTML;

    ['dragenter', 'dragover'].forEach(function (evt) {
      zone.addEventListener(evt, function (e) { e.preventDefault(); zone.classList.add('dragover'); });
    });
    ['dragleave', 'drop'].forEach(function (evt) {
      zone.addEventListener(evt, function (e) { e.preventDefault(); zone.classList.remove('dragover'); });
    });
    zone.addEventListener('drop', function (e) {
      if (e.dataTransfer.files.length) {
        input.files = e.dataTransfer.files;
        input.dispatchEvent(new Event('change'));
      }
    });
    input.addEventListener('change', function () {
      if (input.files.length) {
        zone.classList.add('has-file');
        label.innerHTML =
          '<span class="font-semibold text-emerald-600">' + escHtml(input.files[0].name) + '</span>' +
          '<br><span class="text-xs text-slate-400">Click or drop to replace</span>';
        importBtn.disabled = true; // require re-preview
      } else {
        zone.classList.remove('has-file');
        label.innerHTML = originalHTML;
      }
    });
  }

  setupDropZone(document.getElementById('dropGroups'),  groupsInput,  'dropGroupsLabel');
  setupDropZone(document.getElementById('dropPrivate'), privateInput, 'dropPrivateLabel');

  function escHtml(s) {
    if (s == null) return '';
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // ── Shared submit ─────────────────────────────────────────
  function submitImport(dryRun, callback, decisions) {
    var data = new FormData(form);
    data.append('dryRun', dryRun ? '1' : '0');
    if (decisions) {
      data.append('decisions', JSON.stringify(decisions));
    }

    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/admin/groups/import', true);
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      var res;
      try { res = JSON.parse(xhr.responseText); } catch (e) {
        return callback({ ok: false, error: 'Invalid server response.' });
      }
      callback(res);
    };
    xhr.onerror = function () { callback({ ok: false, error: 'Network error. Please check your connection.' }); };
    xhr.send(data);
  }

  // Current preview data store
  var currentChangedGroups = [];

  // ── Preview (dry run) ────────────────────────────────────
  previewBtn.addEventListener('click', function () {
    if (!groupsInput.files.length && !privateInput.files.length) {
      return showError('Please upload at least one CSV file.');
    }

    previewBtn.disabled = true;
    document.getElementById('previewBtnLabel').innerHTML = '<span class="spinner"></span> Parsing…';

    submitImport(true, function (res) {
      previewBtn.disabled = false;
      document.getElementById('previewBtnLabel').textContent = 'Preview';

      if (!res.ok) {
        return showError(res.error, res.validationErrors);
      }

      currentChangedGroups = res.changedGroups || [];
      showPreview(res.summary, res.preview, res.changedGroups, res.summaryChips, res.levelOnlyGroups);
      importBtn.disabled = false;
    });
  });

  // ── Import (live) ────────────────────────────────────────
  importBtn.addEventListener('click', function () {
    // Gather admin decisions
    var removals = [];
    document.querySelectorAll('.removal-checkbox:checked').forEach(function (cb) {
      var gId = cb.getAttribute('data-db-group-id');
      if (gId) {
        removals.push({
          groupId:    gId,
          studentId:  cb.getAttribute('data-student-id') || null,
          studentKey: cb.getAttribute('data-student-key'),
        });
      }
    });

    var renames = [];
    document.querySelectorAll('.rename-checkbox:checked').forEach(function (cb) {
      var gId = cb.getAttribute('data-db-group-id');
      var nName = cb.getAttribute('data-new-name');
      if (gId && nName) {
        renames.push({
          groupId: gId,
          newName: nName,
        });
      }
    });

    var confirmedNamesakes = [];
    document.querySelectorAll('.namesake-checkbox:checked').forEach(function (cb) {
      var gName = cb.getAttribute('data-group-name');
      var raw = cb.getAttribute('data-raw-name');
      var norm = cb.getAttribute('data-norm-key');
      var sId = cb.getAttribute('data-student-id');
      if (raw && norm) {
        confirmedNamesakes.push({
          groupName: gName,
          rawName: raw,
          normKey: norm,
          studentId: sId,
        });
      }
    });

    var decisions = { removals: removals, renames: renames, confirmedNamesakes: confirmedNamesakes };

    var confirmMsg = 'This will apply the CSV changes to the database.\n\n'
      + removals.length + ' student removal(s), ' + renames.length + ' group rename(s), and ' + confirmedNamesakes.length + ' confirmed namesake(s) selected.\n\n'
      + 'Proceed with import?';
    if (!confirm(confirmMsg)) return;

    importBtn.disabled = true;
    previewBtn.disabled = true;
    document.getElementById('importBtnLabel').innerHTML = '<span class="spinner"></span> Importing…';

    submitImport(false, function (res) {
      importBtn.disabled = true;
      previewBtn.disabled = false;
      document.getElementById('importBtnLabel').textContent = 'Import Now';

      if (!res.ok) {
        return showError(res.error, res.validationErrors);
      }

      showResult(res.summary);
    }, decisions);
  });

  // ── Render helpers ───────────────────────────────────────
  function showError(msg, validationErrors) {
    var html = '<div class="result-card bg-red-50 border border-red-200 rounded-2xl p-6">'
      + '<div class="flex items-start gap-3">'
      + '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>'
      + '<div>'
      + '<p class="font-semibold text-red-700">' + escHtml(msg) + '</p>';

    if (validationErrors && validationErrors.length) {
      html += '<ul class="mt-2 space-y-0.5 text-xs text-red-600 list-disc list-inside max-h-48 overflow-y-auto">';
      validationErrors.forEach(function (e) {
        html += '<li>' + escHtml(e) + '</li>';
      });
      html += '</ul>';
    }

    html += '</div></div></div>';
    resultsPanel.innerHTML = html;
    resultsPanel.classList.remove('hidden');
  }

  function showPreview(summary, preview, changedGroups, summaryChips, levelOnlyGroups) {
    var html = '<div class="result-card space-y-5">'
      + '<div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-6">'
      + '<h3 class="font-bold text-indigo-900 text-lg mb-4 flex items-center gap-2">'
      + '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>'
      + 'Preview Results</h3>';

    // 1. Original 6 Stats Cards
    html += '<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">';
    html += statCard('Total Groups', summary.totalParsed, 'text-slate-900');
    html += statCard('Group Classes', summary.groupCount, 'text-emerald-600');
    html += statCard('Private', summary.privateCount, 'text-purple-600');
    html += statCard('Student Slots', summary.studentSlots, 'text-indigo-600');
    html += '</div>';

    if (preview) {
      html += '<div class="grid grid-cols-2 gap-3 mb-5">';
      html += statCard('New Students (get barcodes)', preview.wouldCreate, 'text-emerald-600');
      html += statCard('Existing Students (kept)', preview.wouldRetain, 'text-amber-600');
      html += '</div>';
    }

    // 2. Summary Chips
    if (summaryChips) {
      html += '<div class="flex flex-wrap items-center gap-2 mb-5 p-3.5 bg-white/70 rounded-xl border border-indigo-100">'
        + '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800">'
        + '📊 ' + summaryChips.groupsWithChanges + ' groups with changes</span>';

      if (summaryChips.levelOnlyChanges > 0) {
        html += '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-100 text-sky-800 border border-sky-200">'
          + '🏷️ ' + summaryChips.levelOnlyChanges + ' groups will get a new level</span>';
      }

      html += '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">'
        + '➕ ' + summaryChips.newStudents + ' new students</span>'
        + (summaryChips.possibleNamesakes > 0 ? ('<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">⚠️ ' + summaryChips.possibleNamesakes + ' possible namesake(s)</span>') : '')
        + '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">'
        + '↔️ ' + summaryChips.movedStudents + ' moved students</span>'
        + '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">'
        + '➖ ' + summaryChips.notInCsvStudents + ' not in CSV</span>'
        + '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">'
        + '🏷️ ' + summaryChips.possibleRenames + ' possible renames</span>';

      if (summaryChips.inconsistentGroups > 0) {
        html += '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">'
          + '⚠️ ' + summaryChips.inconsistentGroups + ' groups have misaligned student IDs — groups in this CSV will be realigned on save; others need <code>repairGroupStudentIds.js</code></span>';
      }

      if (summaryChips.ghostIds > 0) {
        html += '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">'
          + '👻 ' + summaryChips.ghostIds + ' leftover student IDs in ' + summaryChips.groupsWithGhostIds + ' group(s) (not real students). Run <code>node scripts/repairGroupStudentIds.js</code> to clean.</span>';
      }

      if (summaryChips.untouchedDbGroups > 0) {
        html += '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">'
          + 'ℹ️ ' + summaryChips.untouchedDbGroups + ' DB groups not in CSV</span>';
      }
      html += '</div>';
    }

    // 3. Changed Groups Section & Level-Only Groups
    var hasChangedCards = changedGroups && changedGroups.length > 0;
    var hasLevelOnly = levelOnlyGroups && levelOnlyGroups.length > 0;

    if (hasChangedCards || hasLevelOnly) {
      // Toolbar: Search, Filters, Bulk Checkbox Controls
      html += '<div class="bg-white rounded-2xl border border-indigo-100 p-4 shadow-sm mb-4 space-y-3">'
        + '<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">'
        + '<div class="flex flex-wrap items-center gap-3 flex-1">'
        + '<div class="relative flex-1 min-w-[200px] max-w-xs">'
        + '<input type="text" id="groupFilterSearch" placeholder="Filter by group or student name…" class="w-full pl-9 pr-3 py-2 text-xs border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50/50" />'
        + '<svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>'
        + '</div>'
        + '<label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 cursor-pointer select-none">'
        + '<input type="checkbox" id="onlyMissingFilter" class="rounded text-indigo-600 focus:ring-indigo-500" />'
        + '<span>Only groups with missing students</span>'
        + '</label>'
        + '</div>'
        + '<div class="flex flex-wrap items-center gap-2 text-xs">'
        + '<button type="button" id="selectAllNotInCsvBtn" class="font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition">Select all not-in-CSV</button>'
        + '<button type="button" id="deselectAllNotInCsvBtn" class="font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition">Deselect all</button>'
        + '<button type="button" id="expandAllBtn" class="text-indigo-600 hover:underline px-2 py-1 font-medium">Expand all</button>'
        + '<button type="button" id="collapseAllBtn" class="text-slate-500 hover:underline px-2 py-1 font-medium">Collapse all</button>'
        + '</div>'
        + '</div>'
        + '</div>';

      // Cards container
      html += '<div id="groupsCardsContainer" class="space-y-3.5">';
      if (hasChangedCards) {
        changedGroups.forEach(function (g, idx) {
          html += renderGroupCard(g, idx);
        });
      }
      html += '</div>';

      // Collapsed section at the bottom "Level changes only (N)"
      if (hasLevelOnly) {
        html += '<div id="levelOnlySection" class="mt-4 bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">'
          + '<div id="levelOnlyHeader" class="px-5 py-3.5 bg-slate-50/70 hover:bg-slate-50 cursor-pointer flex items-center justify-between gap-3 border-b border-slate-100 transition-colors select-none">'
          + '<div class="flex items-center gap-2">'
          + '<svg id="levelOnlyChevron" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>'
          + '<h4 class="font-bold text-slate-800 text-sm">Level changes only (' + levelOnlyGroups.length + ')</h4>'
          + '</div>'
          + '<span class="text-2xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">no student changes</span>'
          + '</div>'
          + '<div id="levelOnlyBody" class="p-4 hidden space-y-1.5 max-h-96 overflow-y-auto">';

        levelOnlyGroups.forEach(function (row) {
          var searchStr = [row.name, row.type, row.oldLevel || '', row.newLevel || ''].join(' ').toLowerCase();
          var typeBadge = row.type === 'GROUP'
            ? '<span class="inline-block bg-emerald-50 text-emerald-700 border border-emerald-200 text-2xs font-semibold px-2 py-0.5 rounded-full">GROUP</span>'
            : '<span class="inline-block bg-purple-50 text-purple-700 border border-purple-200 text-2xs font-semibold px-2 py-0.5 rounded-full">PRIVATE</span>';
          var oldLvl = (row.oldLevel && row.oldLevel.trim()) ? escHtml(row.oldLevel.trim()) : '-';
          var newLvl = (row.newLevel && row.newLevel.trim()) ? escHtml(row.newLevel.trim()) : '-';

          html += '<div class="level-only-row flex items-center justify-between gap-3 px-3.5 py-2 rounded-xl bg-slate-50/60 hover:bg-slate-50 border border-slate-100 text-xs" data-search-index="' + escHtml(searchStr) + '">'
            + '<div class="flex items-center gap-2.5 min-w-0">'
            + '<span class="font-semibold text-slate-800 truncate">' + escHtml(row.name) + '</span>'
            + typeBadge
            + '</div>'
            + '<div class="flex items-center gap-1.5 flex-shrink-0 text-slate-600">'
            + '<span class="text-slate-500">' + oldLvl + '</span>'
            + '<span class="text-slate-400">→</span>'
            + '<span class="font-semibold text-indigo-600">' + newLvl + '</span>'
            + '</div>'
            + '</div>';
        });

        html += '</div></div>';
      }
    } else {
      // Empty state
      html += '<div class="p-6 rounded-2xl bg-white/80 border border-indigo-100 text-slate-600 text-sm flex items-center gap-3">'
        + '<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>'
        + '<span><strong>No changes found.</strong> All parsed groups and student rosters match the current database records.</span>'
        + '</div>';
    }

    html += '</div>';

    if (hasChangedCards || hasLevelOnly || (preview && preview.wouldCreate > 0)) {
      html += '<p class="text-sm text-indigo-600 font-medium">✓ Preview looks good — review removals/renames above and click <strong>Import Now</strong> to proceed.</p>';
    } else {
      html += '<p class="text-sm text-slate-500 font-medium">All group and student data is already up to date.</p>';
    }

    html += '</div>';

    resultsPanel.innerHTML = html;
    resultsPanel.classList.remove('hidden');

    attachCardInteractions();
  }

  function renderGroupCard(g, idx) {
    var hasAdditions = g.additions && g.additions.length > 0;
    var hasRemovals = g.removals && g.removals.length > 0;
    var hasRename = Boolean(g.renameCandidate);

    // Never render a card with an empty body
    if (!hasAdditions && !hasRemovals && !hasRename) {
      return '';
    }

    var searchStrings = [g.name, g.level || '', g.type, g.oldLevel || '', g.newLevel || ''];
    (g.additions || []).forEach(function (a) { searchStrings.push(a.rawName); });
    (g.removals || []).forEach(function (r) { searchStrings.push(r.rawName); });
    var searchIndex = searchStrings.join(' ').toLowerCase();

    // Brand new groups without rename candidate start collapsed
    var startCollapsed = g.isNew && !g.renameCandidate;
    var hasRemovalsAttr = hasRemovals ? '1' : '0';

    var statusBadge = g.isNew
      ? '<span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">NEW</span>'
      : '<span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">UPDATED</span>';

    var typeBadge = g.type === 'GROUP'
      ? '<span class="inline-block bg-emerald-50 text-emerald-700 border border-emerald-200 text-2xs font-semibold px-2 py-0.5 rounded-full">GROUP</span>'
      : '<span class="inline-block bg-purple-50 text-purple-700 border border-purple-200 text-2xs font-semibold px-2 py-0.5 rounded-full">PRIVATE</span>';

    var addCount = (g.additions || []).length;
    var remCount = (g.removals || []).length;

    var html = '<div id="card-group-' + idx + '" class="group-card rounded-2xl border border-indigo-100 bg-white shadow-sm transition-all overflow-hidden" '
      + 'data-card-idx="' + idx + '" '
      + 'data-search-index="' + escHtml(searchIndex) + '" '
      + 'data-has-removals="' + hasRemovalsAttr + '">';

    // Card Header
    html += '<div class="card-header px-5 py-3.5 bg-slate-50/50 hover:bg-slate-50 cursor-pointer flex items-center justify-between gap-3 border-b border-slate-100 transition-colors select-none" data-card-idx="' + idx + '">'
      + '<div class="flex items-center gap-2.5 min-w-0">'
      + '<svg class="chevron-icon w-4 h-4 text-slate-400 transition-transform duration-200 ' + (startCollapsed ? '' : 'rotate-180') + '" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>'
      + '<h4 class="card-title font-bold text-slate-800 text-sm truncate">' + escHtml(g.name) + '</h4>'
      + typeBadge
      + '<span class="bg-slate-100 text-slate-600 text-2xs font-semibold px-2 py-0.5 rounded-full">' + escHtml(g.level || '—') + '</span>'
      + statusBadge
      + '</div>'
      + '<div class="header-counts flex items-center gap-2 flex-shrink-0 text-xs font-semibold">'
      + (addCount > 0 ? '<span class="add-count text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full">+' + addCount + '</span>' : '')
      + (remCount > 0 ? '<span class="rem-count text-rose-600 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded-full">-' + remCount + '</span>' : '')
      + '</div>'
      + '</div>';

    // Card Body
    html += '<div class="card-body p-5 ' + (startCollapsed ? 'hidden' : '') + ' space-y-4" data-card-idx="' + idx + '">';

    // Level change line under header if applicable
    if (g.levelChanged) {
      var oldLvl = (g.oldLevel && g.oldLevel.trim()) ? escHtml(g.oldLevel.trim()) : '-';
      var newLvl = (g.newLevel && g.newLevel.trim()) ? escHtml(g.newLevel.trim()) : ((g.level && g.level.trim() && g.level !== '—') ? escHtml(g.level.trim()) : '-');
      html += '<div class="text-xs font-medium text-slate-600 flex items-center gap-1.5 pb-1 border-b border-slate-100">'
        + '<span class="font-semibold text-slate-700">Level:</span> '
        + '<span>' + oldLvl + '</span>'
        + '<span class="text-slate-400">→</span>'
        + '<span class="font-semibold text-indigo-600">' + newLvl + '</span>'
        + '</div>';
    }

    // Rename banner if applicable
    if (g.renameCandidate) {
      var cand = g.renameCandidate;
      html += '<div class="rename-banner p-3.5 bg-amber-50/80 border border-amber-200 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">'
        + '<div>'
        + '<div class="text-xs font-bold text-amber-900 flex flex-wrap items-center gap-1.5">'
        + '<span>⚠️ Possible renamed group:</span>'
        + '<span class="font-semibold text-slate-900 bg-white px-2 py-0.5 rounded border border-amber-200">' + escHtml(cand.oldName) + '</span>'
        + '<span>→</span>'
        + '<span class="font-semibold text-slate-900 bg-white px-2 py-0.5 rounded border border-amber-200">' + escHtml(g.name) + '</span>'
        + '</div>'
        + '<p class="text-xs text-amber-700 mt-1">' + cand.matchCount + ' of ' + cand.totalCsvStudents + ' students match (' + cand.overlapPercent + '%)</p>'
        + '</div>'
        + '<label class="inline-flex items-center gap-2 bg-white px-3 py-1.5 rounded-lg border border-amber-300 text-xs font-bold text-slate-800 cursor-pointer shadow-sm hover:bg-amber-50 select-none flex-shrink-0">'
        + '<input type="checkbox" class="rename-checkbox" data-card-idx="' + idx + '" data-db-group-id="' + escHtml(cand.dbGroupId) + '" data-new-name="' + escHtml(g.name) + '" />'
        + '<span>Treat as the same group (rename)</span>'
        + '</label>'
        + '</div>';
    }

    // Dynamic Lists Container (swapped if renamed)
    html += '<div class="card-lists-container space-y-4" data-card-idx="' + idx + '">';
    html += renderCardStudentLists(g.additions, g.removals, g.dbGroupId, g.name);
    html += '</div>';

    html += '</div></div>';
    return html;
  }

  function renderCardStudentLists(additions, removals, dbGroupId, groupName) {
    var html = '';

    // Additions (➕)
    if (additions && additions.length > 0) {
      html += '<div>'
        + '<h5 class="text-xs font-bold text-emerald-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">'
        + '<span class="w-2 h-2 rounded-full bg-emerald-500"></span>'
        + '<span>Added Students (' + additions.length + ')</span>'
        + '</h5>'
        + '<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">';

      additions.forEach(function (a) {
        // Skip placeholder rows from unresolvable ghost ids
        if (!a.rawName || a.rawName === 'Student') return;

        if (a.namesake && a.namesake.isNamesake) {
          var namesakeDesc = a.namesake.displayText || ('Possible namesake of ' + a.namesake.existingName);
          html += '<div class="col-span-full p-2.5 rounded-xl bg-amber-50/70 border border-amber-200 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2">'
            + '<div class="flex items-center gap-2 min-w-0">'
            + '<span class="font-bold text-slate-800">' + escHtml(a.rawName) + '</span>'
            + '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-2xs font-bold bg-amber-200 text-amber-900 border border-amber-300">'
            + escHtml(namesakeDesc)
            + '</span>'
            + '</div>'
            + '<label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-semibold text-amber-900 flex-shrink-0 select-none">'
            + '<input type="checkbox" class="namesake-checkbox rounded text-amber-600 focus:ring-amber-500" '
            + 'data-group-name="' + escHtml(groupName || '') + '" '
            + 'data-raw-name="' + escHtml(a.rawName) + '" '
            + 'data-norm-key="' + escHtml(a.normKey || '') + '" '
            + 'data-student-id="' + escHtml(a.namesake.existingStudentId || '') + '" />'
            + '<span>Yes, same student</span>'
            + '</label>'
            + '</div>';
          return;
        }

        var badge = '';
        if (a.status === 'NEW') {
          badge = '<span class="text-2xs font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">NEW</span>';
        } else if (a.status === 'MOVED_IN') {
          badge = '<span class="text-2xs font-semibold px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200">moved from ' + escHtml(a.fromGroup) + '</span>';
        } else if (a.note) {
          badge = '<span class="text-2xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-300">' + escHtml(a.note) + '</span>';
        } else {
          badge = '<span class="text-2xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">existing</span>';
        }

        var checkSchoolChip = '';
        if (a.checkSchool && a.checkSchool.isCheckSchool) {
          checkSchoolChip = '<span class="text-2xs font-semibold px-2 py-0.5 rounded-full bg-sky-100 text-sky-800 border border-sky-200 ml-1.5">' + escHtml(a.checkSchool.displayText) + '</span>';
        }

        html += '<div class="flex items-center justify-between p-2 rounded-xl bg-emerald-50/40 border border-emerald-100/70 text-xs">'
          + '<span class="font-medium text-slate-800 truncate pr-2">' + escHtml(a.rawName) + '</span>'
          + '<div class="flex items-center gap-1 flex-shrink-0">'
          + badge
          + checkSchoolChip
          + '</div>'
          + '</div>';
      });

      html += '</div></div>';
    }

    // Removals (➖)
    if (removals && removals.length > 0) {
      html += '<div>'
        + '<div class="flex items-center justify-between mb-2">'
        + '<h5 class="text-xs font-bold text-rose-800 uppercase tracking-wider flex items-center gap-1.5">'
        + '<span class="w-2 h-2 rounded-full bg-rose-500"></span>'
        + '<span>Missing from CSV (' + removals.length + ')</span>'
        + '</h5>'
        + '<button type="button" class="card-select-not-in-csv-btn text-2xs font-semibold text-indigo-600 hover:text-indigo-800 hover:underline">Select all not-in-CSV</button>'
        + '</div>'
        + '<div class="space-y-1.5">';

      removals.forEach(function (r) {
        // Skip placeholder rows — ghost ids must never be shown as removals
        if (!r.rawName || r.rawName === 'Student') return;

        var badge = '';
        if (r.status === 'MOVED_OUT') {
          badge = '<span class="text-2xs font-semibold px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 border border-purple-200">moved to ' + escHtml(r.toGroup) + '</span>';
        } else {
          badge = '<span class="text-2xs font-semibold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-200">not in CSV</span>';
        }

        var isChecked = r.defaultChecked ? 'checked' : '';

        html += '<label class="flex items-center justify-between p-2.5 rounded-xl bg-rose-50/30 hover:bg-rose-50/60 border border-rose-100/80 text-xs cursor-pointer select-none transition-colors">'
          + '<div class="flex items-center gap-2.5 min-w-0 pr-2">'
          + '<input type="checkbox" class="removal-checkbox rounded text-rose-600 focus:ring-rose-500" '
          + 'data-db-group-id="' + escHtml(dbGroupId || '') + '" '
          + 'data-student-id="' + escHtml(r.studentId || '') + '" '
          + 'data-student-key="' + escHtml(r.key || '') + '" '
          + 'data-status="' + escHtml(r.status || '') + '" '
          + isChecked + ' />'
          + '<span class="font-medium text-slate-800 truncate">' + escHtml(r.rawName) + '</span>'
          + '</div>'
          + '<div class="flex items-center gap-2 flex-shrink-0">'
          + badge
          + '<span class="text-2xs text-slate-400">Remove from group</span>'
          + '</div>'
          + '</label>';
      });

      html += '</div></div>';
    }

    return html;
  }

  function attachCardInteractions() {
    // 1. Accordion Header Toggle
    document.querySelectorAll('.card-header').forEach(function (hdr) {
      hdr.addEventListener('click', function (e) {
        var idx = this.getAttribute('data-card-idx');
        var card = document.getElementById('card-group-' + idx);
        if (!card) return;
        var body = card.querySelector('.card-body');
        var chevron = card.querySelector('.chevron-icon');
        if (body.classList.contains('hidden')) {
          body.classList.remove('hidden');
          chevron.classList.add('rotate-180');
        } else {
          body.classList.add('hidden');
          chevron.classList.remove('rotate-180');
        }
      });
    });

    // 2. Expand All & Collapse All
    var expandAllBtn = document.getElementById('expandAllBtn');
    if (expandAllBtn) {
      expandAllBtn.addEventListener('click', function () {
        document.querySelectorAll('.group-card .card-body').forEach(function (b) { b.classList.remove('hidden'); });
        document.querySelectorAll('.group-card .chevron-icon').forEach(function (c) { c.classList.add('rotate-180'); });
        var levelOnlyBody = document.getElementById('levelOnlyBody');
        var levelOnlyChevron = document.getElementById('levelOnlyChevron');
        if (levelOnlyBody) levelOnlyBody.classList.remove('hidden');
        if (levelOnlyChevron) levelOnlyChevron.classList.add('rotate-180');
      });
    }

    var collapseAllBtn = document.getElementById('collapseAllBtn');
    if (collapseAllBtn) {
      collapseAllBtn.addEventListener('click', function () {
        document.querySelectorAll('.group-card .card-body').forEach(function (b) { b.classList.add('hidden'); });
        document.querySelectorAll('.group-card .chevron-icon').forEach(function (c) { c.classList.remove('rotate-180'); });
        var levelOnlyBody = document.getElementById('levelOnlyBody');
        var levelOnlyChevron = document.getElementById('levelOnlyChevron');
        if (levelOnlyBody) levelOnlyBody.classList.add('hidden');
        if (levelOnlyChevron) levelOnlyChevron.classList.remove('rotate-180');
      });
    }

    // Level-only Section Toggle
    var levelOnlyHdr = document.getElementById('levelOnlyHeader');
    if (levelOnlyHdr) {
      levelOnlyHdr.addEventListener('click', function () {
        var body = document.getElementById('levelOnlyBody');
        var chevron = document.getElementById('levelOnlyChevron');
        if (!body) return;
        if (body.classList.contains('hidden')) {
          body.classList.remove('hidden');
          if (chevron) chevron.classList.add('rotate-180');
        } else {
          body.classList.add('hidden');
          if (chevron) chevron.classList.remove('rotate-180');
        }
      });
    }

    // 3. Search & Filter
    var searchInput = document.getElementById('groupFilterSearch');
    var missingToggle = document.getElementById('onlyMissingFilter');

    function filterCards() {
      var query = (searchInput.value || '').trim().toLowerCase();
      var onlyMissing = missingToggle.checked;

      document.querySelectorAll('.group-card').forEach(function (card) {
        var searchIndex = card.getAttribute('data-search-index') || '';
        var hasRemovals = card.getAttribute('data-has-removals') === '1';

        var matchesSearch = !query || searchIndex.indexOf(query) !== -1;
        var matchesMissing = !onlyMissing || hasRemovals;

        if (matchesSearch && matchesMissing) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // Also filter level-only section rows
      var levelOnlySection = document.getElementById('levelOnlySection');
      var levelOnlyBody = document.getElementById('levelOnlyBody');
      var levelOnlyChevron = document.getElementById('levelOnlyChevron');
      var visibleLevelCount = 0;

      document.querySelectorAll('.level-only-row').forEach(function (row) {
        var searchIndex = row.getAttribute('data-search-index') || '';
        var matchesSearch = !query || searchIndex.indexOf(query) !== -1;
        var matchesMissing = !onlyMissing;

        if (matchesSearch && matchesMissing) {
          row.style.display = '';
          visibleLevelCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (levelOnlySection) {
        if (onlyMissing || (query && visibleLevelCount === 0)) {
          levelOnlySection.style.display = 'none';
        } else {
          levelOnlySection.style.display = '';
          if (query && visibleLevelCount > 0 && levelOnlyBody) {
            levelOnlyBody.classList.remove('hidden');
            if (levelOnlyChevron) levelOnlyChevron.classList.add('rotate-180');
          }
        }
      }
    }

    if (searchInput) searchInput.addEventListener('input', filterCards);
    if (missingToggle) missingToggle.addEventListener('change', filterCards);

    // 4. Global Select / Deselect Not-in-CSV
    var selectAllBtn = document.getElementById('selectAllNotInCsvBtn');
    if (selectAllBtn) {
      selectAllBtn.addEventListener('click', function () {
        document.querySelectorAll('.removal-checkbox[data-status="NOT_IN_CSV"]').forEach(function (cb) {
          cb.checked = true;
        });
      });
    }

    var deselectAllBtn = document.getElementById('deselectAllNotInCsvBtn');
    if (deselectAllBtn) {
      deselectAllBtn.addEventListener('click', function () {
        document.querySelectorAll('.removal-checkbox[data-status="NOT_IN_CSV"]').forEach(function (cb) {
          cb.checked = false;
        });
      });
    }

    // 5. Per-card "Select all not-in-CSV"
    document.querySelectorAll('.card-select-not-in-csv-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var card = this.closest('.group-card');
        if (!card) return;
        card.querySelectorAll('.removal-checkbox[data-status="NOT_IN_CSV"]').forEach(function (cb) {
          cb.checked = true;
        });
      });
    });

    // 6. Rename Candidate Toggle
    document.querySelectorAll('.rename-checkbox').forEach(function (chk) {
      chk.addEventListener('change', function (e) {
        e.stopPropagation();
        var idx = parseInt(this.getAttribute('data-card-idx'), 10);
        var g = currentChangedGroups[idx];
        if (!g || !g.renameCandidate) return;

        var card = document.getElementById('card-group-' + idx);
        if (!card) return;

        var statusBadge = card.querySelector('.status-badge');
        var countsContainer = card.querySelector('.header-counts');
        var listsContainer = card.querySelector('.card-lists-container');

        if (this.checked) {
          // Switch to diffAsRename
          var diff = g.diffAsRename;
          statusBadge.className = 'status-badge inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
          statusBadge.textContent = 'UPDATED';

          var addCount = diff.additions.length;
          var remCount = diff.removals.length;
          countsContainer.innerHTML = (addCount > 0 ? '<span class="add-count text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full">+' + addCount + '</span>' : '')
            + (remCount > 0 ? '<span class="rem-count text-rose-600 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded-full">-' + remCount + '</span>' : '');

          card.setAttribute('data-has-removals', remCount > 0 ? '1' : '0');
          listsContainer.innerHTML = renderCardStudentLists(diff.additions, diff.removals, g.renameCandidate.dbGroupId, g.name);
        } else {
          // Switch back to diffAsNew
          var diff = g.diffAsNew;
          statusBadge.className = 'status-badge inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
          statusBadge.textContent = 'NEW';

          var addCount = diff.additions.length;
          countsContainer.innerHTML = (addCount > 0 ? '<span class="add-count text-emerald-600 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full">+' + addCount + '</span>' : '');

          card.setAttribute('data-has-removals', '0');
          listsContainer.innerHTML = renderCardStudentLists(diff.additions, diff.removals, null, g.name);
        }

        // Re-attach per-card helper for newly rendered buttons
        card.querySelectorAll('.card-select-not-in-csv-btn').forEach(function (btn) {
          btn.addEventListener('click', function (ev) {
            ev.stopPropagation();
            card.querySelectorAll('.removal-checkbox[data-status="NOT_IN_CSV"]').forEach(function (cb) {
              cb.checked = true;
            });
          });
        });

        // Trigger filter update in case "Only missing" was active
        filterCards();
      });
    });
  }

  function showResult(summary) {
    var html = '<div class="result-card bg-emerald-50 border border-emerald-200 rounded-2xl p-6">'
      + '<h3 class="font-bold text-emerald-900 text-lg mb-4 flex items-center gap-2">'
      + '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>'
      + 'Import Complete ✓</h3>';

    html += '<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">';
    html += statCard('New Students', summary.newStudentsAdded || 0, 'text-emerald-600');
    html += statCard('Kept Students', summary.existingStudentsKept || 0, 'text-amber-600');
    html += statCard('Groups Created', summary.groupsCreated || 0, 'text-indigo-600');
    html += statCard('Groups Updated', summary.groupsUpdated || 0, 'text-slate-600');
    html += '</div>';

    html += '<div class="grid grid-cols-3 gap-3 mb-4">';
    html += statCard('Removed from Groups', summary.removedFromGroups || 0, 'text-rose-600');
    html += statCard('Students Moved', summary.moved || 0, 'text-blue-600');
    html += statCard('Groups Renamed', summary.renamed || 0, 'text-purple-600');
    html += '</div>';

    if (summary.skippedNamesakes && summary.skippedNamesakes.length > 0) {
      html += '<div class="mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 space-y-2">'
        + '<div class="font-bold flex items-center gap-1.5 text-amber-800">'
        + '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>'
        + 'Skipped ' + summary.skippedNamesakes.length + ' unconfirmed possible namesake row(s):'
        + '</div>'
        + '<p class="text-amber-700">Add a last initial or surname to the name in the CSV and import again.</p>'
        + '<ul class="list-disc list-inside space-y-1 pl-1">';
      summary.skippedNamesakes.forEach(function (sn) {
        var existingInfo = sn.existingName + (sn.existingGradeSchool ? ' ' + sn.existingGradeSchool : '') + (sn.existingGroups && sn.existingGroups.length ? ' in ' + sn.existingGroups.join(', ') : '');
        html += '<li><strong>' + escHtml(sn.rawName) + '</strong> in <em>' + escHtml(sn.groupName) + '</em> (possible namesake of ' + escHtml(existingInfo) + ')</li>';
      });
      html += '</ul></div>';
    }

    html += '<p class="mt-4 text-sm text-emerald-700">'
      + 'Import successful. New students have been assigned unique barcodes and student codes. '
      + 'Existing student identities, barcodes, and Achievement Card histories remain completely intact. '
      + '<a href="/admin/groups" class="underline font-semibold hover:text-emerald-900 ml-1">View Groups →</a></p>';

    html += '</div>';

    resultsPanel.innerHTML = html;
    resultsPanel.classList.remove('hidden');
  }

  function statCard(label, value, color) {
    return '<div class="bg-white/70 rounded-xl p-3 text-center border border-slate-100 shadow-2xs">'
      + '<p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">' + label + '</p>'
      + '<p class="text-2xl font-bold ' + color + '">' + value + '</p>'
      + '</div>';
  }
})();
</script>

