<%- include('../../partials/header', { title: 'Groups' }) %>

<!-- Page Header -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-teal-100 text-teal-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
        </svg>
        Groups
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Student Groups</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Manage group classes and private sessions.</p>
  </div>
  <a href="/admin/groups/new"
    class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    Add Group
  </a>
</div>

<!-- Stats -->
<div class="grid grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total</p>
    <p class="text-3xl font-bold text-slate-900"><%= totalGroups %></p>
    <p class="text-xs text-slate-400 mt-1">all groups</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Group</p>
    <p class="text-3xl font-bold text-emerald-600"><%= totalGroup %></p>
    <p class="text-xs text-slate-400 mt-1">group classes</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Private</p>
    <p class="text-3xl font-bold text-purple-600"><%= totalPrivate %></p>
    <p class="text-xs text-slate-400 mt-1">private classes</p>
  </div>
</div>

<!-- Flash message -->
<% if (flashMessage) { %>
  <div id="flash-toast"
    class="fixed top-20 right-4 z-50 bg-brand-600 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 transition-all duration-300">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
    <%- flashMessage %>
  </div>
  <script>
    setTimeout(function () {
      var t = document.getElementById('flash-toast');
      if (t) { t.style.opacity = '0'; t.style.transform = 'translateX(16px)'; }
    }, 3000);
  </script>
<% } %>

<!-- Filters -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-4 sm:px-5 py-3.5 mb-5">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3">

    <!-- Search -->
    <form method="GET" action="/admin/groups" class="flex items-center gap-2 flex-1 min-w-[160px]">
      <input type="hidden" name="type"  value="<%= selectedType %>">
      <input type="hidden" name="level" value="<%= selectedLevel %>">
      <div class="relative flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z" />
        </svg>
        <input type="text" name="q" value="<%= searchQuery %>" placeholder="Search group name…"
          class="w-full pl-8 pr-3 py-1.5 text-sm rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-300 transition">
      </div>
      <button type="submit" class="text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-600 px-3 py-1.5 rounded-lg transition">Go</button>
      <% if (searchQuery) { %>
        <a href="/admin/groups?type=<%= encodeURIComponent(selectedType) %>&level=<%= encodeURIComponent(selectedLevel) %>"
          class="text-xs text-slate-400 hover:text-slate-600 transition">Clear</a>
      <% } %>
    </form>

    <span class="self-stretch w-px bg-slate-100 hidden sm:block"></span>

    <!-- Type filter -->
    <%
      var bBase = 'px-3 py-1.5 rounded-full text-xs font-semibold transition whitespace-nowrap';
      var bOff  = bBase + ' bg-slate-100 text-slate-500 hover:bg-slate-200';
      function typeUrl(t) {
        return '/admin/groups?q=' + encodeURIComponent(searchQuery) +
               '&type=' + encodeURIComponent(t) +
               '&level=' + encodeURIComponent(selectedLevel);
      }
    %>
    <div class="flex items-center gap-1.5">
      <span class="text-xs font-bold text-slate-300 uppercase tracking-wider mr-0.5">Type</span>
      <a href="<%= typeUrl('') %>"       class="<%= !selectedType              ? bBase + ' bg-slate-800 text-white'   : bOff %>">All</a>
      <a href="<%= typeUrl('GROUP') %>"  class="<%= selectedType === 'GROUP'   ? bBase + ' bg-emerald-600 text-white' : bOff %>">Group</a>
      <a href="<%= typeUrl('PRIVATE') %>"class="<%= selectedType === 'PRIVATE' ? bBase + ' bg-purple-600 text-white'  : bOff %>">Private</a>
    </div>

    <% if (availableLevels.length > 0) { %>
      <span class="self-stretch w-px bg-slate-100 hidden sm:block"></span>
      <!-- Level filter -->
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Level</span>
        <select
          onchange="window.location='/admin/groups?q=<%= encodeURIComponent(searchQuery) %>&type=<%= encodeURIComponent(selectedType) %>&level='+encodeURIComponent(this.value)"
          class="text-xs font-semibold rounded-lg border border-slate-200 px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-300 bg-white text-slate-700">
          <option value="">All Levels</option>
          <% availableLevels.forEach(function(l) { %>
            <option value="<%= l %>" <%= selectedLevel === l ? 'selected' : '' %>>
              <%= l %><% if (LEVEL_LABELS[l]) { %> — <%= LEVEL_LABELS[l] %><% } %>
            </option>
          <% }) %>
        </select>
      </div>
    <% } %>

  </div>
</div>

<!-- Bulk action bar -->
<div id="bulk-bar" class="hidden mb-3 flex items-center gap-3 bg-brand-50 border border-brand-200 rounded-xl px-4 py-2.5">
  <span class="text-sm font-semibold text-brand-700"><span id="bulk-count">0</span> selected</span>
  <button onclick="bulkDelete()"
    class="inline-flex items-center gap-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
    </svg>
    Delete Selected
  </button>
  <button onclick="clearSelection()" class="text-xs font-semibold text-brand-500 hover:text-brand-700 transition">Cancel</button>
</div>

<!-- Table -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <% if (groups.length === 0) { %>
    <div class="py-16 text-center">
      <div class="w-14 h-14 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
        </svg>
      </div>
      <p class="text-sm font-semibold text-slate-600">No groups found</p>
      <p class="text-xs text-slate-400 mt-1">
        <% if (selectedType || selectedLevel || searchQuery) { %>Try adjusting your filters.<% } else { %>Start by adding a group.<% } %>
      </p>
      <a href="/admin/groups/new"
        class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold px-4 py-2 rounded-xl shadow transition mt-4">
        Add Group
      </a>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <th class="px-4 py-3 text-left w-8">
              <input type="checkbox" id="select-all" onchange="toggleAll(this)"
                class="w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 cursor-pointer">
            </th>
            <th class="px-4 py-3 text-left">Group Name</th>
            <th class="px-4 py-3 text-left">Type</th>
            <th class="px-4 py-3 text-left hidden sm:table-cell">Level</th>
            <th class="px-4 py-3 text-center hidden md:table-cell">Students</th>
            <th class="px-4 py-3 text-left">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% groups.forEach(function(g) { %>
            <tr class="hover:bg-slate-50 transition group">
              <td class="px-4 py-3.5">
                <input type="checkbox" class="row-check w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 cursor-pointer"
                  value="<%= g._id %>" onchange="updateBulkBar()">
              </td>

              <!-- Name — click opens student modal -->
              <td class="px-4 py-3.5">
                <button onclick="openModal('<%= g._id %>')"
                  class="font-semibold text-slate-800 hover:text-brand-600 transition text-left">
                  <%= g.group_name %>
                </button>
              </td>

              <!-- Type badge -->
              <td class="px-4 py-3.5">
                <% if (g.type === 'GROUP') { %>
                  <span class="badge-emerald text-xs font-semibold px-2.5 py-1 rounded-full">Group</span>
                <% } else { %>
                  <span class="badge-purple text-xs font-semibold px-2.5 py-1 rounded-full">Private</span>
                <% } %>
              </td>

              <!-- Level -->
              <td class="px-4 py-3.5 hidden sm:table-cell">
                <% if (g.level) { %>
                  <span class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-700 text-xs font-bold px-2.5 py-1 rounded-full">
                    <%= g.level %>
                    <% if (LEVEL_LABELS[g.level]) { %>
                      <span class="font-normal text-slate-400 text-[11px]"><%= LEVEL_LABELS[g.level] %></span>
                    <% } %>
                  </span>
                <% } else { %>
                  <span class="text-slate-300 text-xs">—</span>
                <% } %>
              </td>

              <!-- Student count bubble -->
              <td class="px-4 py-3.5 text-center hidden md:table-cell">
                <button onclick="openModal('<%= g._id %>')"
                  class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 hover:bg-brand-100 text-slate-600 hover:text-brand-700 text-xs font-bold transition"
                  title="View students (<%= g.students.length %>)">
                  <%= g.students.length %>
                </button>
              </td>

              <!-- Actions -->
              <td class="px-4 py-3.5">
                <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition">
                  <!-- View students -->
                  <button onclick="openModal('<%= g._id %>')"
                    class="text-slate-300 hover:text-brand-500 transition" title="View students">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.573-3.007-9.964-7.178Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                  </button>
                  <!-- Edit -->
                  <a href="/admin/groups/<%= g._id %>/edit"
                    class="text-slate-300 hover:text-amber-500 transition" title="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                  </a>
                  <!-- Delete -->
                  <button
                    data-delete-id="<%= g._id %>"
                    data-name="<%= g.group_name.replace(/"/g, '&quot;') %>"
                    onclick="deleteSingle(this)"
                    class="text-slate-300 hover:text-red-500 transition" title="Delete">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ═══ Student Detail Modal ═══════════════════════════════════ -->
<div id="student-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeModal()"></div>

  <!-- Panel -->
  <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-sm max-h-[80vh] flex flex-col">

    <!-- Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-start justify-between flex-shrink-0">
      <div class="flex-1 min-w-0">
        <h3 id="modal-title" class="text-base font-bold text-slate-800 truncate"></h3>
        <div id="modal-meta" class="flex items-center gap-2 mt-1.5 flex-wrap"></div>
      </div>
      <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 transition ml-4 flex-shrink-0 mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body — scrollable -->
    <div class="px-6 py-4 overflow-y-auto flex-1">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">
        <span id="modal-count"></span> Student(s)
      </p>
      <ul id="modal-students" class="space-y-2.5"></ul>
    </div>

    <!-- Footer -->
    <div class="px-6 py-3 border-t border-slate-100 flex items-center justify-between flex-shrink-0">
      <div id="modal-edit-wrap"></div>
      <button onclick="closeModal()" class="text-xs font-semibold text-slate-500 hover:text-slate-700 transition">Close</button>
    </div>

  </div>
</div>

<!-- Embedded groups JSON for modal -->
<script id="groups-json" type="application/json"><%- groupsJson %></script>

<script>
  /* ── Data ─────────────────────────────────────────────────── */
  var groupsData = JSON.parse(document.getElementById('groups-json').textContent);
  var groupsMap  = {};
  groupsData.forEach(function (g) { groupsMap[g._id] = g; });

  function getCsrfToken() {
    var m = document.querySelector('meta[name="csrf-token"]');
    return m ? m.getAttribute('content') : '';
  }
  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Modal ────────────────────────────────────────────────── */
  function openModal(id) {
    var g = groupsMap[id];
    if (!g) return;

    document.getElementById('modal-title').textContent = g.group_name;

    var typeBadge = g.type === 'GROUP'
      ? '<span class="badge-emerald text-xs font-semibold px-2.5 py-1 rounded-full">Group</span>'
      : '<span class="badge-purple text-xs font-semibold px-2.5 py-1 rounded-full">Private</span>';
    var levelBadge = g.level
      ? '<span class="bg-slate-100 text-slate-700 text-xs font-bold px-2.5 py-1 rounded-full">' + escHtml(g.level) + '</span>'
      : '';
    document.getElementById('modal-meta').innerHTML = typeBadge + levelBadge;

    document.getElementById('modal-count').textContent = g.students.length;

    var ul = document.getElementById('modal-students');
    if (g.students.length === 0) {
      ul.innerHTML = '<li class="text-sm text-slate-400 italic text-center py-4">No students listed.</li>';
    } else {
      ul.innerHTML = g.students.map(function (s, i) {
        return '<li class="flex items-center gap-3">' +
          '<span class="w-6 h-6 rounded-full bg-slate-100 text-slate-500 text-[11px] font-bold flex items-center justify-center flex-shrink-0">' + (i + 1) + '</span>' +
          '<span class="text-sm text-slate-700">' + escHtml(s) + '</span>' +
          '</li>';
      }).join('');
    }

    document.getElementById('modal-edit-wrap').innerHTML =
      '<a href="/admin/groups/' + id + '/edit" class="text-xs font-semibold text-brand-600 hover:underline">Edit Group →</a>';

    document.getElementById('student-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('student-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

  /* ── Checkbox / Bulk ──────────────────────────────────────── */
  function toggleAll(cb) {
    document.querySelectorAll('.row-check').forEach(function (c) { c.checked = cb.checked; });
    updateBulkBar();
  }

  function updateBulkBar() {
    var checked = document.querySelectorAll('.row-check:checked').length;
    var total   = document.querySelectorAll('.row-check').length;
    var bar     = document.getElementById('bulk-bar');
    document.getElementById('bulk-count').textContent = checked;
    bar.classList.toggle('hidden', checked === 0);

    var sa = document.getElementById('select-all');
    if (sa) {
      sa.indeterminate = checked > 0 && checked < total;
      sa.checked       = checked > 0 && checked === total;
    }
  }

  function clearSelection() {
    document.querySelectorAll('.row-check').forEach(function (c) { c.checked = false; });
    var sa = document.getElementById('select-all');
    if (sa) { sa.checked = false; sa.indeterminate = false; }
    updateBulkBar();
  }

  /* ── Single delete ────────────────────────────────────────── */
  function deleteSingle(btn) {
    var id   = btn.dataset.deleteId;
    var name = btn.dataset.name;

    Swal.fire({
      title: 'Delete "' + escHtml(name) + '"?',
      text:  'This action cannot be undone.',
      icon:  'warning',
      showCancelButton:    true,
      confirmButtonColor:  '#ef4444',
      cancelButtonColor:   '#64748b',
      confirmButtonText:   'Yes, delete it!',
      cancelButtonText:    'Cancel',
      reverseButtons:      true,
      focusCancel:         true,
      customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl', cancelButton: 'rounded-xl' },
    }).then(function (result) {
      if (!result.isConfirmed) return;
      Swal.fire({ title: 'Deleting…', allowOutsideClick: false, showConfirmButton: false,
        didOpen: function () { Swal.showLoading(); } });

      fetch('/admin/groups/' + id, {
        method: 'DELETE',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'x-csrf-token': getCsrfToken() },
      }).then(function (res) {
        if (res.ok) {
          Swal.fire({ title: 'Deleted!', icon: 'success', timer: 1400, showConfirmButton: false,
            customClass: { popup: 'rounded-2xl' } }).then(function () { window.location.reload(); });
        } else {
          Swal.fire({ title: 'Error', text: 'Failed to delete. Please try again.', icon: 'error',
            confirmButtonColor: '#ef4444', customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
        }
      }).catch(function () {
        Swal.fire({ title: 'Network Error', text: 'Could not reach the server.', icon: 'error',
          confirmButtonColor: '#ef4444', customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
      });
    });
  }

  /* ── Bulk delete ──────────────────────────────────────────── */
  function bulkDelete() {
    var ids = Array.from(document.querySelectorAll('.row-check:checked')).map(function (c) { return c.value; });
    if (ids.length === 0) return;

    Swal.fire({
      title: 'Delete ' + ids.length + ' group(s)?',
      text:  'This action cannot be undone.',
      icon:  'warning',
      showCancelButton:    true,
      confirmButtonColor:  '#ef4444',
      cancelButtonColor:   '#64748b',
      confirmButtonText:   'Yes, delete them!',
      cancelButtonText:    'Cancel',
      reverseButtons:      true,
      focusCancel:         true,
      customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl', cancelButton: 'rounded-xl' },
    }).then(function (result) {
      if (!result.isConfirmed) return;
      Swal.fire({ title: 'Deleting…', allowOutsideClick: false, showConfirmButton: false,
        didOpen: function () { Swal.showLoading(); } });

      fetch('/admin/groups/bulk', {
        method: 'DELETE',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'x-csrf-token':     getCsrfToken(),
          'Content-Type':     'application/json',
        },
        body: JSON.stringify({ ids: ids }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.ok) {
            Swal.fire({ title: 'Deleted!', text: data.deleted + ' group(s) removed.', icon: 'success',
              timer: 1500, showConfirmButton: false, customClass: { popup: 'rounded-2xl' } })
              .then(function () { window.location.reload(); });
          } else {
            Swal.fire({ title: 'Error', text: data.error || 'Failed.', icon: 'error',
              confirmButtonColor: '#ef4444', customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
          }
        })
        .catch(function () {
          Swal.fire({ title: 'Network Error', text: 'Could not reach the server.', icon: 'error',
            confirmButtonColor: '#ef4444', customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' } });
        });
    });
  }
</script>

