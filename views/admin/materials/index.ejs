<%- include('../../partials/header', { title: 'Admin — Materials' }) %>

<style>
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .data-row { animation: fadeSlideIn .2s ease both; }
</style>

<!-- Page Header -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-teal-100 text-teal-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
        </svg>
        Materials
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Teaching Materials</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Manage shared level-aware material autocomplete suggestions.</p>
  </div>
  <div>
    <%
      const recalcMsg = (typeof unlinkedReportsCount !== 'undefined' && unlinkedReportsCount > 0)
        ? (unlinkedReportsCount + ' report' + (unlinkedReportsCount === 1 ? ' is' : 's are') + ' not linked to a material yet. Recalculating usage counts will only count linked reports. Proceed?')
        : 'Recalculate usage counts and last used dates for all materials based on actual reports?';
    %>
    <form method="POST" action="/admin/materials/recalculate-usage" data-action="confirmSubmit" data-confirm="<%= recalcMsg %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-slate-300 shadow-sm transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
        Recalculate Usage
      </button>
    </form>
  </div>
</div>

<% if (typeof unlinkedReportsCount !== 'undefined' && unlinkedReportsCount > 0) { %>
  <!-- Unlinked Reports Warning Chip -->
  <div class="mb-5 bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-center justify-between flex-wrap gap-3">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-200 text-amber-900 font-bold text-xs flex-shrink-0">!</span>
      <p class="text-xs font-semibold text-amber-900">
        <span class="font-bold text-amber-950"><%= unlinkedReportsCount %></span> report<%= unlinkedReportsCount === 1 ? '' : 's' %> are not linked to a material yet. Run <code class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-mono text-[11px] font-semibold">scripts/backfillReportMaterials.js</code>
      </p>
    </div>
  </div>
<% } %>

<!-- Historical Note Disclaimer -->
<div class="mb-6 bg-teal-50 border border-teal-200 rounded-2xl p-4 flex items-start gap-3">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
  </svg>
  <div class="text-xs text-teal-900 leading-relaxed">
    <p class="font-bold mb-0.5">Reliable Material Tracking & Aliases</p>
    <p>Reports are linked directly to materials. Merging and renaming create permanent aliases so corrected or merged names cannot be accidentally resurrected. When editing or merging, you can also update the subject text on existing reports.</p>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total</p>
    <p class="text-3xl font-bold text-slate-900"><%= totalMaterials %></p>
    <p class="text-xs text-slate-400 mt-1">all saved materials</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">With Content</p>
    <p class="text-3xl font-bold text-brand-600"><%= typeof totalWithContent !== 'undefined' ? totalWithContent : 0 %></p>
    <p class="text-xs text-slate-400 mt-1"><%= typeof totalWithContent !== 'undefined' ? totalWithContent : 0 %> of <%= totalMaterials %> have content</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">With Level</p>
    <p class="text-3xl font-bold text-teal-600"><%= totalWithLevel %></p>
    <p class="text-xs text-slate-400 mt-1">level-linked suggestions</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">No Level</p>
    <p class="text-3xl font-bold text-slate-500"><%= totalNoLevel %></p>
    <p class="text-xs text-slate-400 mt-1">private / competition / general</p>
  </div>
</div>

<!-- Flash Messages -->
<% if (flashMessage) { %>
  <div id="flash-toast" class="fixed top-20 right-4 z-50 bg-teal-600 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 transition-all duration-300">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
    <%= flashMessage %>
  </div>
  <script src="/js/pages/admin-materials.js"></script>

<%- include('../../partials/footer') %>
