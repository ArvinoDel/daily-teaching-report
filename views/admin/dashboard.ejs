<%- include('../partials/header', { title: 'Admin' }) %>

<!-- Page Header -->
<div class="mb-8 flex items-center justify-between">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-red-100 text-red-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        Admin Panel
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Overview</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Platform-wide activity at a glance.</p>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Teachers</p>
    <p class="text-3xl font-bold text-brand-600"><%= totalUsers %></p>
    <p class="text-xs text-slate-400 mt-1">registered accounts</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Online Now</p>
    <p class="text-3xl font-bold text-emerald-500"><%= onlineCount %></p>
    <p class="text-xs text-slate-400 mt-1">active in last 5 min</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Reports</p>
    <p class="text-3xl font-bold text-slate-900"><%= totalReports %></p>
    <p class="text-xs text-slate-400 mt-1">all time</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">This Month</p>
    <p class="text-3xl font-bold text-slate-900"><%= monthlyReports %></p>
    <p class="text-xs text-slate-400 mt-1"><%= monthLabel %></p>
  </div>
</div>

<!-- Quick Nav Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">

  <a href="/admin/users"
    class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 hover:border-brand-300 hover:shadow-md transition group flex items-center gap-4">
    <div class="w-11 h-11 bg-brand-100 rounded-xl flex items-center justify-center flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-brand-700 transition">Manage Users</p>
      <p class="text-xs text-slate-400 mt-0.5"><%= totalUsers %> teachers registered</p>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-brand-400 transition ml-auto flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
  </a>

  <a href="/admin/reports"
    class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 hover:border-sky-200 hover:shadow-md transition group flex items-center gap-4">
    <div class="w-11 h-11 bg-sky-100 rounded-xl flex items-center justify-center flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-sky-700 transition">All Reports</p>
      <p class="text-xs text-slate-400 mt-0.5"><%= monthlyReports %> reports this month</p>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-sky-400 transition ml-auto flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
  </a>

  <a href="/admin/commission"
    class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 hover:border-amber-200 hover:shadow-md transition group flex items-center gap-4">
    <div class="w-11 h-11 bg-amber-100 rounded-xl flex items-center justify-center flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-amber-700 transition">Commission</p>
      <p class="text-xs text-slate-400 mt-0.5"><%= monthLabel %></p>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-amber-400 transition ml-auto flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
  </a>

</div>

<!-- Recent Reports -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <h2 class="text-sm font-bold text-slate-800">Recent Reports</h2>
    <a href="/admin/reports" class="text-xs font-semibold text-brand-600 hover:underline transition">View all →</a>
  </div>

  <% if (!recentReports.length) { %>
    <p class="text-center text-slate-400 text-sm py-12">No reports yet.</p>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <th class="px-6 py-3 text-left">Teacher</th>
            <th class="px-6 py-3 text-left">Class</th>
            <th class="px-6 py-3 text-left hidden sm:table-cell">Type</th>
            <th class="px-6 py-3 text-left hidden md:table-cell">Date</th>
            <th class="px-6 py-3 text-left">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% recentReports.forEach(function(r) { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-3.5 font-semibold text-slate-800 whitespace-nowrap">
                <%= r.teacher ? r.teacher.displayName : '—' %>
              </td>
              <td class="px-6 py-3.5 text-slate-600"><%= r.class_name %></td>
              <td class="px-6 py-3.5 hidden sm:table-cell">
                <span class="badge-<%= typeBadgeColor[r.teaching_type] || 'slate' %> text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap">
                  <%= r.teaching_type %>
                </span>
              </td>
              <td class="px-6 py-3.5 font-mono text-xs text-slate-400 hidden md:table-cell whitespace-nowrap">
                <%= r.date.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-3.5">
                <a href="/admin/reports/<%= r._id %>/edit"
                  class="text-slate-300 hover:text-amber-500 transition" title="Edit">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                  </svg>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
