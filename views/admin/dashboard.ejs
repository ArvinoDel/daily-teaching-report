<%- include('../partials/header', { title: 'Admin' }) %>

<!-- Page Header -->
<div class="mb-8 flex items-center justify-between">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-red-100 text-red-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        Admin Panel
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Overview</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Platform-wide activity at a glance.</p>
  </div>
</div>

<% if (typeof pendingTeachersCount !== 'undefined' && pendingTeachersCount > 0) { %>
  <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-2xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0 text-amber-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-bold text-amber-900">
          <%= pendingTeachersCount %> teacher<%= pendingTeachersCount === 1 ? '' : 's' %> waiting for approval
        </p>
        <p class="text-xs text-amber-700 mt-0.5">Review and approve new teacher registrations before they can access the platform.</p>
      </div>
    </div>
    <a href="/admin/users?status=pending" class="inline-flex items-center justify-center px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-xl transition shadow-sm self-start sm:self-auto">
      Review accounts
    </a>
  </div>
<% } %>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Teachers</p>
    <p class="text-3xl font-bold text-brand-600"><%= totalUsers %></p>
    <p class="text-xs text-slate-400 mt-1">registered accounts</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Online Now</p>
    <p class="text-3xl font-bold text-emerald-500"><%= onlineCount %></p>
    <p class="text-xs text-slate-400 mt-1">active in last 5 min</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Reports</p>
    <p class="text-3xl font-bold text-slate-900"><%= totalReports %></p>
    <p class="text-xs text-slate-400 mt-1">all time</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">This Month</p>
    <p class="text-3xl font-bold text-slate-900"><%= monthlyReports %></p>
    <p class="text-xs text-slate-400 mt-1"><%= monthLabel %></p>
  </div>
</div>

<!-- Quick Nav Cards -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4 mb-8">

  <a href="/admin/users"
    class="group bg-white rounded-2xl border border-slate-100 shadow-sm p-4 sm:p-5 hover:border-brand-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3.5">
      <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all duration-150 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-brand-700 transition leading-snug">Manage Users</p>
      <p class="text-xs text-slate-400 mt-1 leading-normal"><%= totalUsers %> teachers registered</p>
    </div>
  </a>

  <a href="/admin/reports"
    class="group bg-white rounded-2xl border border-slate-100 shadow-sm p-4 sm:p-5 hover:border-sky-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3.5">
      <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-sky-500 group-hover:translate-x-0.5 transition-all duration-150 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-sky-700 transition leading-snug">All Reports</p>
      <p class="text-xs text-slate-400 mt-1 leading-normal"><%= monthlyReports %> reports this month</p>
    </div>
  </a>

  <a href="/admin/commission"
    class="group bg-white rounded-2xl border border-slate-100 shadow-sm p-4 sm:p-5 hover:border-amber-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75" />
        </svg>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-amber-500 group-hover:translate-x-0.5 transition-all duration-150 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-amber-700 transition leading-snug">Commission</p>
      <p class="text-xs text-slate-400 mt-1 leading-normal"><%= monthLabel %></p>
    </div>
  </a>

  <!-- 🟢 Audit Log nav card -->
  <a href="/admin/audit-log"
    class="group bg-white rounded-2xl border border-slate-100 shadow-sm p-4 sm:p-5 hover:border-violet-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3.5">
      <div class="w-10 h-10 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
        </svg>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-violet-500 group-hover:translate-x-0.5 transition-all duration-150 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-violet-700 transition leading-snug">Audit Log</p>
      <p class="text-xs text-slate-400 mt-1 leading-normal">Admin activity history</p>
    </div>
  </a>

  <!-- Missing Reports nav card -->
  <a href="/admin/report-gaps"
    class="col-span-2 sm:col-span-1 group bg-white rounded-2xl border border-slate-100 shadow-sm p-4 sm:p-5 hover:border-amber-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 group-hover:text-amber-500 group-hover:translate-x-0.5 transition-all duration-150 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </div>
    <div>
      <p class="text-sm font-bold text-slate-800 group-hover:text-amber-700 transition leading-snug">Missing Reports</p>
      <p class="text-xs text-slate-400 mt-1 leading-normal">Possible report gaps</p>
    </div>
  </a>

</div>

<!-- 🟢 Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

  <!-- Bar chart: reports per teacher -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <h2 class="text-sm font-bold text-slate-700 mb-1">Reports per Teacher
      <span class="font-normal text-slate-400 ml-1"><%= monthLabel %></span>
    </h2>
    <div class="relative" style="height:220px;">
      <canvas id="chartTeachers"></canvas>
      <p id="chartTeachersEmpty" class="hidden absolute inset-0 flex items-center justify-center text-slate-400 text-sm">No reports this month.</p>
    </div>
  </div>

  <!-- Line chart: daily trend -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <h2 class="text-sm font-bold text-slate-700 mb-1">Daily Trend
      <span class="font-normal text-slate-400 ml-1"><%= monthLabel %></span>
    </h2>
    <div class="relative" style="height:220px;">
      <canvas id="chartDailyTrend"></canvas>
      <p id="chartTrendEmpty" class="hidden absolute inset-0 flex items-center justify-center text-slate-400 text-sm">No reports this month.</p>
    </div>
  </div>

</div>

<!-- Recent Reports -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <h2 class="text-sm font-bold text-slate-800">Recent Reports</h2>
    <a href="/admin/reports" class="text-xs font-semibold text-brand-600 hover:underline transition">View all →</a>
  </div>

  <% if (!recentReports.length) { %>
    <p class="text-center text-slate-400 text-sm py-12">No reports yet.</p>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <th class="px-6 py-3 text-left">Teacher</th>
            <th class="px-6 py-3 text-left">Class</th>
            <th class="px-6 py-3 text-left hidden sm:table-cell">Type</th>
            <th class="px-6 py-3 text-left hidden md:table-cell">Date</th>
            <th class="px-6 py-3 text-left">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% recentReports.forEach(function(r) { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-3.5 font-semibold text-slate-800 whitespace-nowrap">
                <%= r.teacher ? r.teacher.displayName : '—' %>
              </td>
              <td class="px-6 py-3.5 text-slate-600"><%= (r.session_type === 'competition' && r.competition_groups && r.competition_groups.length > 0) ? r.competition_groups.join(' vs ') : r.class_name %></td>
              <td class="px-6 py-3.5 hidden sm:table-cell">
                <span class="badge-<%= typeBadgeColor[r.teaching_type] || 'slate' %> text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap">
                  <%= r.teaching_type %>
                </span>
              </td>
              <td class="px-6 py-3.5 font-mono text-xs text-slate-400 hidden md:table-cell whitespace-nowrap">
                <%= r.date.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-3.5">
                <a href="/admin/reports/<%= r._id %>/edit"
                  class="text-slate-300 hover:text-amber-500 transition" title="Edit">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                  </svg>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- 🟢 Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script id="chartTeachersData" type="application/json"><%- chartTeachersJson %></script>
<script id="dailyTrendData" type="application/json"><%- dailyTrendJson %></script>
<script src="/js/pages/admin-dashboard.js"></script>

<%- include('../partials/footer') %>
