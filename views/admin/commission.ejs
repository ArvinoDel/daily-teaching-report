<%- include('../partials/header', { title: 'Admin — Commission' }) %>

<%
  const commBadge = {
    'Prime Teacher (Full)':     'badge-emerald',
    'Prime Teacher (Assisted)': 'badge-purple',
    'Assistant Teacher':        'badge-sky',
    '1/2 Prime Teacher':        'badge-amber',
  };
%>

<!-- Header -->
<div class="mb-6 flex items-center gap-3">
  <a href="/admin" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
  </a>
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Commission</h1>
    <p class="text-slate-500 text-sm mt-0.5">Estimated teacher earnings per month.</p>
  </div>
</div>

<!-- Month Nav -->
<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-2">
    <a href="/admin/commission?month=<%= prevMonth %>"
      class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-slate-200 text-slate-500 hover:bg-slate-50 transition shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
    </a>
    <span class="text-sm font-semibold text-slate-700 min-w-[130px] text-center"><%= monthLabel %></span>
    <% if (!isCurrentMonth) { %>
      <a href="/admin/commission?month=<%= nextMonth %>"
        class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-slate-200 text-slate-500 hover:bg-slate-50 transition shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </a>
    <% } else { %>
      <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </span>
    <% } %>
  </div>

  <!-- Grand Total Badge -->
  <div class="bg-brand-50 border border-brand-200 rounded-xl px-4 py-2 text-right">
    <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Grand Total</p>
    <p class="text-lg font-bold text-brand-700 font-mono"><%= grandTotalFormatted %></p>
  </div>
</div>

<!-- Commission table -->
<% if (!commissionData.length) { %>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm py-16 text-center">
    <p class="text-slate-400 text-sm">No teachers found.</p>
  </div>
<% } else { %>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <th class="px-6 py-3.5 text-left">Teacher</th>
            <th class="px-4 py-3.5 text-center hidden sm:table-cell">Prime (Full)</th>
            <th class="px-4 py-3.5 text-center hidden sm:table-cell">Prime (Assisted)</th>
            <th class="px-4 py-3.5 text-center hidden sm:table-cell">Assistant</th>
            <th class="px-4 py-3.5 text-center hidden sm:table-cell">½ Prime</th>
            <th class="px-4 py-3.5 text-center">Sessions</th>
            <th class="px-6 py-3.5 text-right">Commission</th>
            <!-- 🟢 Set Commission column -->
            <th class="px-4 py-3.5 text-center">Set</th>
            <th class="px-4 py-3.5 text-center">Detail</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% commissionData.forEach(function(d, idx) { %>
            <tr class="hover:bg-slate-50 transition <%= d.totalSessions === 0 ? 'opacity-60' : '' %>">
              <!-- Teacher -->
              <td class="px-6 py-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 text-xs font-bold flex-shrink-0">
                    <%= d.teacher.displayName[0].toUpperCase() %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-slate-800 truncate"><%= d.teacher.displayName %></p>
                    <p class="text-xs text-slate-400">@<%= d.teacher.username %></p>
                  </div>
                </div>
              </td>
              <!-- Per-type session counts -->
              <% d.breakdown.forEach(function(b) { %>
                <td class="px-4 py-4 text-center hidden sm:table-cell">
                  <% if (b.sessions > 0) { %>
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full <%= commBadge[b.type] %> text-xs font-bold"><%= b.sessions %></span>
                  <% } else { %>
                    <span class="text-slate-200 text-xs">—</span>
                  <% } %>
                </td>
              <% }) %>
              <!-- Total sessions -->
              <td class="px-4 py-4 text-center">
                <span class="text-sm font-bold text-slate-700"><%= d.totalSessions %></span>
              </td>
              <!-- Commission total -->
              <td class="px-6 py-4 text-right font-mono text-sm font-bold <%= d.totalCommission > 0 ? 'text-brand-600' : 'text-slate-400' %>">
                <%= d.totalCommissionFormatted %>
              </td>
              <!-- 🟢 Set Commission quick-link -->
              <td class="px-4 py-4 text-center">
                <a href="/admin/users/<%= d.teacher._id %>/edit#commission-section"
                  title="Set commission rates"
                  class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-slate-300 hover:text-amber-500 hover:bg-amber-50 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                </a>
              </td>
              <!-- Expand button -->
              <td class="px-4 py-4 text-center">
                <button onclick="toggleDetail(<%= idx %>)"
                  id="toggle-<%= idx %>"
                  class="text-slate-300 hover:text-brand-500 transition p-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                  </svg>
                </button>
              </td>
            </tr>

            <!-- Expandable breakdown row -->
            <tr id="detail-<%= idx %>" class="hidden bg-slate-50/80">
              <td colspan="9" class="px-6 py-4">
                <div class="flex items-center justify-between mb-3">
                  <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                    Breakdown — <%= d.teacher.displayName %>
                    <% if (!d.hasCommission) { %>
                      <span class="ml-2 font-normal normal-case text-amber-500">⚠ Commission prices not set</span>
                    <% } %>
                  </p>
                  <!-- 🟢 Set Commission button inside breakdown -->
                  <a href="/admin/users/<%= d.teacher._id %>/edit#commission-section"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 hover:text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 px-3 py-1.5 rounded-lg transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                    </svg>
                    Set Commission
                  </a>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="text-slate-400 uppercase tracking-wider font-semibold">
                        <th class="py-1.5 text-left pr-6">Type</th>
                        <th class="py-1.5 text-center px-4">Sessions</th>
                        <th class="py-1.5 text-right px-4">Price / Session</th>
                        <th class="py-1.5 text-right pl-4">Total</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      <% d.breakdown.forEach(function(b) { %>
                        <tr class="<%= b.sessions === 0 ? 'opacity-40' : '' %>">
                          <td class="py-2 pr-6">
                            <span class="<%= commBadge[b.type] %> font-semibold px-2.5 py-1 rounded-full whitespace-nowrap"><%= b.type %></span>
                          </td>
                          <td class="py-2 text-center px-4 font-bold text-slate-700"><%= b.sessions %></td>
                          <td class="py-2 text-right px-4 font-mono text-slate-500"><%= b.priceFormatted %></td>
                          <td class="py-2 text-right pl-4 font-mono font-semibold text-slate-700"><%= b.totalFormatted %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                    <tfoot>
                      <tr class="border-t-2 border-slate-200">
                        <td class="py-2 pr-6 font-bold text-slate-500 text-xs uppercase">Total</td>
                        <td class="py-2 text-center px-4 font-bold text-slate-700"><%= d.totalSessions %></td>
                        <td class="py-2 px-4"></td>
                        <td class="py-2 text-right pl-4 font-mono font-bold text-brand-600"><%= d.totalCommissionFormatted %></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>

        <!-- Grand Total Footer -->
        <tfoot>
          <tr class="border-t-2 border-slate-200 bg-slate-50">
            <td class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider" colspan="5">Grand Total</td>
            <td class="px-4 py-4 text-center font-bold text-slate-700">
              <%= commissionData.reduce(function(s,d){ return s + d.totalSessions; }, 0) %>
            </td>
            <td class="px-6 py-4 text-right font-mono text-base font-bold text-brand-600"><%= grandTotalFormatted %></td>
            <td class="px-4 py-4" colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

<% } %>

<script>
  function toggleDetail(idx) {
    var row    = document.getElementById('detail-' + idx);
    var toggle = document.getElementById('toggle-' + idx);
    var icon   = toggle.querySelector('svg');
    var isOpen = !row.classList.contains('hidden');
    row.classList.toggle('hidden', isOpen);
    icon.style.transform = isOpen ? '' : 'rotate(180deg)';
  }
</script>

<%- include('../partials/footer') %>
