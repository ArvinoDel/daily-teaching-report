<%- include('../../partials/header', { title: 'Admin — Edit Salary' }) %>

<%
  function fmtIDR(n) {
    if (!n || n === 0) return '—';
    return 'Rp\u00a0' + Number(n).toLocaleString('en-US');
  }
  function fmtNum(n) {
    if (n === undefined || n === null || n === '') return '0';
    return Number(n).toLocaleString('en-US');
  }
  const sp = salary;
  const t  = teacher || { displayName: 'Teacher', username: '—' };
%>

<!-- ── Header ── -->
<div class="mb-6 flex items-center gap-3">
  <a href="/admin/salaries?month=<%= sp.year %>-<%= String(sp.month).padStart(2,'0') %>"
    class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
  </a>
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Edit Salary</h1>
    <p class="text-slate-500 text-sm mt-0.5">
      <span class="font-semibold text-slate-700"><%= t.displayName %></span>
      <% if (sp.teacherTenureAtPeriod) { %>
        <span class="ml-2 text-xs bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-medium"><%= sp.teacherTenureAtPeriod %></span>
      <% } %>
      &mdash; <%= sp.periodLabel || (sp.month + '/' + sp.year) %>
    </p>
  </div>
  <!-- View Slip -->
  <a href="/admin/salaries/<%= sp._id %>/slip" target="_blank"
    class="ml-auto inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-sm font-semibold shadow-sm transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
    Preview Slip
  </a>
</div>

<!-- Alert -->
<% if (success) { %>
  <div class="mb-5 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl text-sm font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
    <%= success %>
  </div>
<% } %>

<form id="salary-form" method="POST" action="/admin/salaries/<%= sp._id %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- ══════════════════ LEFT: Period Meta ══════════════════ -->
    <div class="space-y-6">
      <!-- Period settings -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4">
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Pay Period</h2>

        <div>
          <label class="block text-xs font-semibold text-slate-500 mb-1.5">Period Label</label>
          <input type="text" name="periodLabel" value="<%= sp.periodLabel || '' %>" placeholder="e.g. 26 Jul – 25 Aug 2026"
            class="input-std">
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">Period Start</label>
            <input type="date" name="periodStart"
              value="<%= sp.periodStart ? new Date(sp.periodStart).toISOString().substring(0,10) : '' %>"
              class="input-std">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">Period End</label>
            <input type="date" name="periodEnd"
              value="<%= sp.periodEnd ? new Date(sp.periodEnd).toISOString().substring(0,10) : '' %>"
              class="input-std">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">Pay Date</label>
            <input type="date" name="payDate"
              value="<%= sp.payDate ? new Date(sp.payDate).toISOString().substring(0,10) : '' %>"
              class="input-std">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5">Pay Date Label</label>
            <input type="text" name="payDateLabel" value="<%= sp.payDateLabel || '' %>" placeholder="e.g. 26-Aug"
              class="input-std">
          </div>
        </div>
      </div>

      <!-- Notes -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4">
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Notes</h2>
        <textarea name="notes" rows="4" placeholder="Remarks, adjustments..." maxlength="500"
          class="input-std resize-none"><%= sp.notes || '' %></textarea>
      </div>

      <!-- Live Total Card -->
      <div class="bg-brand-50 border border-brand-200 rounded-2xl p-5 sticky top-20">
        <p class="text-xs font-bold text-brand-500 uppercase tracking-wider mb-3">Live Totals</p>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-slate-600">Gross</span><span id="live-gross" class="font-mono font-bold text-slate-800">—</span></div>
          <div class="flex justify-between"><span class="text-slate-600">Deductions</span><span id="live-deduct" class="font-mono font-bold text-red-500">—</span></div>
          <div class="h-px bg-brand-200 my-1"></div>
          <div class="flex justify-between"><span class="text-brand-700 font-bold">Net Salary</span><span id="live-net" class="font-mono font-bold text-brand-700 text-lg">—</span></div>
        </div>
      </div>
    </div>

    <!-- ══════════════════ RIGHT: Salary Sheet ══════════════════ -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Earnings -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4">
        <h2 class="text-sm font-bold text-emerald-700 uppercase tracking-wider flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75"/></svg>
          Earnings
        </h2>

        <!-- Simple money fields -->
        <% const earningFields = [
          { label: '1. Basic Salary',                key: 'basicSalary'        },
          { label: '5. Monthly Incentive',           key: 'monthlyIncentive'   },
          { label: '6. Health Allowance',            key: 'healthAllowance'    },
          { label: '7. Position Allowance',          key: 'positionAllowance'  },
          { label: '8. Loyalty Allowance',           key: 'loyaltyAllowance'   },
          { label: '9. Wife / Child Allowance',      key: 'wifeChildAllowance' },
          { label: '10. Teaching Reward',            key: 'teachingReward'     },
          { label: '11. Game Reward',                key: 'gameReward'         },
          { label: '12. Student Commission',         key: 'studentCommission'  },
          { label: '13. Internet / Electricity',     key: 'internetCompensation'},
          { label: '14. Overtime',                   key: 'overtime'           },
        ]; %>
        <% earningFields.forEach(function(f) { %>
          <div class="flex items-center gap-3">
            <label for="<%= f.key %>" class="text-xs font-medium text-slate-500 w-52 flex-shrink-0 cursor-pointer"><%= f.label %></label>
            <div class="relative flex-1">
              <span class="absolute left-3.5 inset-y-0 flex items-center text-slate-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
              <input type="text" inputmode="numeric" name="<%= f.key %>" id="<%= f.key %>"
                value="<%= fmtNum(sp[f.key]) %>"
                autocomplete="off"
                class="input-money has-prefix w-full earning-field currency-input">
            </div>
          </div>
        <% }); %>

        <!-- Meal Allowance Full (days × rate) -->
        <div class="bg-slate-50/80 rounded-2xl p-4 border border-slate-100 space-y-3">
          <p class="text-xs font-bold text-slate-600 uppercase tracking-wide">2. Meal Allowance (Full)</p>
          <div class="flex items-center gap-3">
            <div class="w-28 flex-shrink-0">
              <label for="mealFullDays" class="text-xs font-medium text-slate-400 mb-1.5 block">Days</label>
              <input type="number" name="mealFullDays" id="mealFullDays" value="<%= sp.mealFullDays || 0 %>" min="0" step="1"
                class="input-money w-full days-input text-center">
            </div>
            <span class="text-slate-400 text-sm mt-5 font-bold">×</span>
            <div class="flex-1">
              <label for="mealFullRate" class="text-xs font-medium text-slate-400 mb-1.5 block">Rate / day</label>
              <div class="relative">
                <span class="absolute left-3.5 inset-y-0 flex items-center text-slate-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
                <input type="text" inputmode="numeric" name="mealFullRate" id="mealFullRate"
                  value="<%= fmtNum(sp.mealFullRate ?? 22500) %>"
                  autocomplete="off"
                  class="input-money has-prefix w-full currency-input">
              </div>
            </div>
            <span class="text-slate-400 text-sm mt-5 font-bold">=</span>
            <div class="w-40 flex-shrink-0">
              <label class="text-xs font-medium text-slate-400 mb-1.5 block">Total</label>
              <p id="mealFullTotal" class="font-mono text-sm font-bold text-emerald-700 px-3 py-2.5 bg-emerald-50 border border-emerald-100/60 rounded-xl text-right">—</p>
            </div>
          </div>
        </div>

        <!-- Meal Allowance Half -->
        <div class="bg-slate-50/80 rounded-2xl p-4 border border-slate-100 space-y-3">
          <p class="text-xs font-bold text-slate-600 uppercase tracking-wide">3. Meal Allowance (Half)</p>
          <div class="flex items-center gap-3">
            <div class="w-28 flex-shrink-0">
              <label for="mealHalfDays" class="text-xs font-medium text-slate-400 mb-1.5 block">Days</label>
              <input type="number" name="mealHalfDays" id="mealHalfDays" value="<%= sp.mealHalfDays || 0 %>" min="0" step="1"
                class="input-money w-full days-input text-center">
            </div>
            <span class="text-slate-400 text-sm mt-5 font-bold">×</span>
            <div class="flex-1">
              <label for="mealHalfRate" class="text-xs font-medium text-slate-400 mb-1.5 block">Rate / day</label>
              <div class="relative">
                <span class="absolute left-3.5 inset-y-0 flex items-center text-slate-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
                <input type="text" inputmode="numeric" name="mealHalfRate" id="mealHalfRate"
                  value="<%= fmtNum(sp.mealHalfRate || 0) %>"
                  autocomplete="off"
                  class="input-money has-prefix w-full currency-input">
              </div>
            </div>
            <span class="text-slate-400 text-sm mt-5 font-bold">=</span>
            <div class="w-40 flex-shrink-0">
              <label class="text-xs font-medium text-slate-400 mb-1.5 block">Total</label>
              <p id="mealHalfTotal" class="font-mono text-sm font-bold text-emerald-700 px-3 py-2.5 bg-emerald-50 border border-emerald-100/60 rounded-xl text-right">—</p>
            </div>
          </div>
        </div>

        <!-- Transport -->
        <div class="bg-slate-50/80 rounded-2xl p-4 border border-slate-100 space-y-3">
          <p class="text-xs font-bold text-slate-600 uppercase tracking-wide">4. Transport Allowance</p>
          <div class="flex items-center gap-3">
            <div class="w-28 flex-shrink-0">
              <label for="transportDays" class="text-xs font-medium text-slate-400 mb-1.5 block">Days</label>
              <input type="number" name="transportDays" id="transportDays" value="<%= sp.transportDays || 0 %>" min="0" step="1"
                class="input-money w-full days-input text-center">
            </div>
            <span class="text-slate-400 text-sm mt-5 font-bold">×</span>
            <div class="flex-1">
              <label for="transportRate" class="text-xs font-medium text-slate-400 mb-1.5 block">Rate / day</label>
              <div class="relative">
                <span class="absolute left-3.5 inset-y-0 flex items-center text-slate-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
                <input type="text" inputmode="numeric" name="transportRate" id="transportRate"
                  value="<%= fmtNum(sp.transportRate ?? 22500) %>"
                  autocomplete="off"
                  class="input-money has-prefix w-full currency-input">
              </div>
            </div>
            <span class="text-slate-400 text-sm mt-5 font-bold">=</span>
            <div class="w-40 flex-shrink-0">
              <label class="text-xs font-medium text-slate-400 mb-1.5 block">Total</label>
              <p id="transportTotal" class="font-mono text-sm font-bold text-emerald-700 px-3 py-2.5 bg-emerald-50 border border-emerald-100/60 rounded-xl text-right">—</p>
            </div>
          </div>
        </div>

        <!-- Dynamic other incomes -->
        <div>
          <p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-2.5">15. Other Incomes</p>
          <div id="other-incomes-list" class="space-y-2.5">
            <% (sp.otherIncomes || []).forEach(function(item) { %>
              <div class="flex gap-2.5 other-income-row items-center">
                <input type="text" name="otherIncomeLabel[]" value="<%= item.label %>" placeholder="Label (e.g. Bonus)"
                  class="input-std flex-1">
                <div class="relative w-44 flex-shrink-0">
                  <span class="absolute left-3.5 inset-y-0 flex items-center text-slate-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
                  <input type="text" inputmode="numeric" name="otherIncomeAmount[]" value="<%= fmtNum(item.amount) %>"
                    placeholder="0" autocomplete="off" class="input-money has-prefix w-full other-income-amt currency-input">
                </div>
                <button type="button" onclick="this.closest('.other-income-row').remove(); recalculate();"
                  class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 transition rounded-xl" title="Remove row">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                </button>
              </div>
            <% }); %>
          </div>
          <button type="button" onclick="addOtherIncome()"
            class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition px-2.5 py-1.5 rounded-lg hover:bg-brand-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add income row
          </button>
        </div>

        <!-- Subtotal Incomes -->
        <div class="flex justify-between items-center border-t border-slate-100 pt-3">
          <span class="text-sm font-bold text-slate-600">Subtotal Earnings</span>
          <span id="subtotal-income" class="font-mono font-bold text-emerald-700 text-base">—</span>
        </div>
      </div>

      <!-- Deductions -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4">
        <h2 class="text-sm font-bold text-red-600 uppercase tracking-wider flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15"/></svg>
          Deductions
        </h2>

        <% const deductFields = [
          { label: '16. Installment',                key: 'instalment'             },
          { label: '17. Miscellaneous Deduction',    key: 'miscellaneousDeduction' },
          { label: '18. BPJS Employment',            key: 'bpjsKetenagakerjaan'    },
          { label: '19. Last Month\'s Tax (PPH)',     key: 'tax'                    },
        ]; %>
        <% deductFields.forEach(function(f) { %>
          <div class="flex items-center gap-3">
            <label for="<%= f.key %>" class="text-xs font-medium text-slate-500 w-52 flex-shrink-0 cursor-pointer"><%= f.label %></label>
            <div class="relative flex-1">
              <span class="absolute left-3.5 inset-y-0 flex items-center text-red-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
              <input type="text" inputmode="numeric" name="<%= f.key %>" id="<%= f.key %>"
                value="<%= fmtNum(sp[f.key]) %>"
                autocomplete="off"
                class="input-money has-prefix w-full deduct-field currency-input">
            </div>
          </div>
        <% }); %>

        <!-- Dynamic other deductions -->
        <div>
          <p class="text-xs font-bold text-slate-500 uppercase tracking-wide mb-2.5">20. Other Deductions</p>
          <div id="other-deductions-list" class="space-y-2.5">
            <% (sp.otherDeductions || []).forEach(function(item) { %>
              <div class="flex gap-2.5 other-deduction-row items-center">
                <input type="text" name="otherDeductionLabel[]" value="<%= item.label %>" placeholder="Label (e.g. Fine)"
                  class="input-std flex-1">
                <div class="relative w-44 flex-shrink-0">
                  <span class="absolute left-3.5 inset-y-0 flex items-center text-red-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
                  <input type="text" inputmode="numeric" name="otherDeductionAmount[]" value="<%= fmtNum(item.amount) %>"
                    placeholder="0" autocomplete="off" class="input-money has-prefix w-full other-deduct-amt currency-input">
                </div>
                <button type="button" onclick="this.closest('.other-deduction-row').remove(); recalculate();"
                  class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 transition rounded-xl" title="Remove row">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                </button>
              </div>
            <% }); %>
          </div>
          <button type="button" onclick="addOtherDeduction()"
            class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-semibold text-red-500 hover:text-red-600 transition px-2.5 py-1.5 rounded-lg hover:bg-red-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add deduction row
          </button>
        </div>

        <!-- Subtotal Deductions -->
        <div class="flex justify-between items-center border-t border-slate-100 pt-3">
          <span class="text-sm font-bold text-slate-600">Subtotal Deductions</span>
          <span id="subtotal-deduct" class="font-mono font-bold text-red-600 text-base">—</span>
        </div>
      </div>

      <!-- Save -->
      <div class="flex justify-end gap-3">
        <a href="/admin/salaries?month=<%= sp.year %>-<%= String(sp.month).padStart(2,'0') %>"
          class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 text-sm font-semibold hover:bg-slate-50 transition">
          Cancel
        </a>
        <button type="submit"
          class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition">
          Save Salary
        </button>
      </div>
    </div>
  </div>
</form>

<style>
  .input-std {
    width: 100%;
    padding: 0.625rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
    font-size: 0.875rem;
    font-weight: 500;
    color: #1e293b;
    background-color: #ffffff;
    outline: none;
    transition: all 0.15s ease-in-out;
  }
  .input-std:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }
  .input-money {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    color: #0f172a;
    outline: none;
    transition: all 0.15s ease-in-out;
  }
  .input-money.has-prefix {
    padding-left: 2.75rem !important;
  }
  .input-money:focus {
    border-color: #10b981;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }
  .deduct-field:focus {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
  }
  .days-input::-webkit-outer-spin-button,
  .days-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .days-input[type=number] {
    -moz-appearance: textfield;
    appearance: textfield;
  }
</style>

<script>
  function parseVal(idOrEl) {
    const el = typeof idOrEl === 'string' ? document.getElementById(idOrEl) : idOrEl;
    if (!el) return 0;
    const clean = String(el.value || '').replace(/,/g, '').trim();
    return parseFloat(clean) || 0;
  }

  function fmt(v) {
    return 'Rp\u00a0' + Math.round(v).toLocaleString('en-US');
  }

  function sumInputsByClass(cls) {
    return Array.from(document.querySelectorAll('.' + cls))
      .reduce((s, el) => s + parseVal(el), 0);
  }

  function recalculate() {
    const mealFullDays  = parseVal('mealFullDays');
    const mealFullRate  = parseVal('mealFullRate');
    const mealHalfDays  = parseVal('mealHalfDays');
    const mealHalfRate  = parseVal('mealHalfRate');
    const transportDays = parseVal('transportDays');
    const transportRate = parseVal('transportRate');

    const mealFull  = mealFullDays * mealFullRate;
    const mealHalf  = mealHalfDays * mealHalfRate;
    const transport = transportDays * transportRate;

    const elMF = document.getElementById('mealFullTotal');
    const elMH = document.getElementById('mealHalfTotal');
    const elTR = document.getElementById('transportTotal');
    if (elMF) elMF.textContent = fmt(mealFull);
    if (elMH) elMH.textContent = fmt(mealHalf);
    if (elTR) elTR.textContent = fmt(transport);

    const fixedEarnings = [
      'basicSalary','monthlyIncentive','healthAllowance','positionAllowance',
      'loyaltyAllowance','wifeChildAllowance','teachingReward','gameReward',
      'studentCommission','internetCompensation','overtime',
    ].reduce((s, k) => s + parseVal(k), 0);

    const otherIncome  = sumInputsByClass('other-income-amt');
    const gross = fixedEarnings + mealFull + mealHalf + transport + otherIncome;

    const otherDeduct = sumInputsByClass('other-deduct-amt');
    const deductions  = ['instalment','miscellaneousDeduction','bpjsKetenagakerjaan','tax']
      .reduce((s, k) => s + parseVal(k), 0) + otherDeduct;

    const net = gross - deductions;

    const elSI = document.getElementById('subtotal-income');
    const elSD = document.getElementById('subtotal-deduct');
    const elLG = document.getElementById('live-gross');
    const elLD = document.getElementById('live-deduct');
    const elLN = document.getElementById('live-net');

    if (elSI) elSI.textContent = fmt(gross);
    if (elSD) elSD.textContent = fmt(deductions);
    if (elLG) elLG.textContent = fmt(gross);
    if (elLD) elLD.textContent = fmt(deductions);
    if (elLN) elLN.textContent = fmt(net);
  }

  // Auto add commas every 3 digits with cursor position preservation
  function formatInputWithCommas(input) {
    const orig = input.value;
    const cursor = input.selectionStart ?? orig.length;
    // Count how many digits existed before the caret
    const digitsBefore = orig.slice(0, cursor).replace(/\D/g, '').length;

    // Strip everything except digits
    const rawDigits = orig.replace(/\D/g, '');
    if (rawDigits === '') {
      input.value = '';
      return;
    }

    // Strip leading zeroes unless it's just '0'
    const normalized = rawDigits.replace(/^0+(?=\d)/, '');
    const formatted = normalized.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    input.value = formatted;

    // Calculate new cursor position based on digits seen
    let newCursor = 0;
    let seen = 0;
    for (let i = 0; i < formatted.length; i++) {
      if (/\d/.test(formatted[i])) seen++;
      if (seen === digitsBefore) {
        newCursor = i + 1;
        break;
      }
    }
    if (digitsBefore === 0) newCursor = 0;
    else if (seen < digitsBefore) newCursor = formatted.length;

    input.setSelectionRange(newCursor, newCursor);
  }

  // Delegated input listener for all currency inputs
  document.addEventListener('input', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('currency-input')) {
      formatInputWithCommas(e.target);
      recalculate();
    } else if (e.target && e.target.classList && e.target.classList.contains('days-input')) {
      recalculate();
    }
  });

  // Select all on focus when input is '0' so user can overwrite directly
  document.addEventListener('focus', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('currency-input')) {
      if (e.target.value === '0') {
        e.target.select();
      }
    }
  }, true);

  // Default to '0' on blur if empty
  document.addEventListener('blur', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('currency-input')) {
      if (e.target.value.trim() === '') {
        e.target.value = '0';
        recalculate();
      }
    }
  }, true);

  function addOtherIncome() {
    const row = document.createElement('div');
    row.className = 'flex gap-2.5 other-income-row items-center';
    row.innerHTML = `
      <input type="text" name="otherIncomeLabel[]" placeholder="Label" class="input-std flex-1">
      <div class="relative w-44 flex-shrink-0">
        <span class="absolute left-3.5 inset-y-0 flex items-center text-slate-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
        <input type="text" inputmode="numeric" name="otherIncomeAmount[]" value="0" placeholder="0" autocomplete="off" class="input-money has-prefix w-full other-income-amt currency-input">
      </div>
      <button type="button" onclick="this.closest('.other-income-row').remove(); recalculate();"
        class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition" title="Remove row">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>`;
    document.getElementById('other-incomes-list').appendChild(row);
    recalculate();
  }

  function addOtherDeduction() {
    const row = document.createElement('div');
    row.className = 'flex gap-2.5 other-deduction-row items-center';
    row.innerHTML = `
      <input type="text" name="otherDeductionLabel[]" placeholder="Label" class="input-std flex-1">
      <div class="relative w-44 flex-shrink-0">
        <span class="absolute left-3.5 inset-y-0 flex items-center text-red-400 text-xs font-semibold select-none pointer-events-none">Rp</span>
        <input type="text" inputmode="numeric" name="otherDeductionAmount[]" value="0" placeholder="0" autocomplete="off" class="input-money has-prefix w-full other-deduct-amt currency-input">
      </div>
      <button type="button" onclick="this.closest('.other-deduction-row').remove(); recalculate();"
        class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition" title="Remove row">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>`;
    document.getElementById('other-deductions-list').appendChild(row);
    recalculate();
  }

  // Strip commas before form submit just to ensure clean numeric payload
  document.getElementById('salary-form')?.addEventListener('submit', function() {
    document.querySelectorAll('.currency-input').forEach(function(input) {
      input.value = input.value.replace(/,/g, '');
    });
  });

  // Run initial calculation
  recalculate();
</script>

