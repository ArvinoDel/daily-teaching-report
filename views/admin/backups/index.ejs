<%- include('../../partials/header', { title: 'Backups' }) %>

<style>
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fade-in { animation: fadeSlideIn .3s ease both; }
  details summary::-webkit-details-marker { display: none; }
</style>

<!-- Page Header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 bg-rose-100 text-rose-700 text-xs font-bold px-2.5 py-1 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
        Superadmin Only
      </span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">Database Backups</h1>
    <p class="text-slate-500 mt-0.5 text-sm">Export all collections to private cloud storage or stream directly to your device.</p>
    <p class="text-xs text-slate-400 mt-1">Note: Backups include all database documents, content revisions, and metadata across 13 collections.</p>
  </div>

  <!-- Action Buttons -->
  <div class="flex items-center gap-2.5 flex-wrap sm:flex-nowrap">

    <!-- Delete Expired Now Button -->
    <button type="button" id="pruneExpiredBtn"
      class="inline-flex items-center gap-2 bg-white hover:bg-rose-50 text-rose-700 hover:text-rose-800 text-sm font-semibold px-3.5 py-2.5 rounded-xl border border-rose-200 shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      </svg>
      Delete Expired Now
    </button>

    <!-- Direct Export Dropdown -->
    <div class="relative" id="exportDropdown">
      <button type="button" id="exportDropdownBtn"
        class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold px-4 py-2.5 rounded-xl border border-slate-200 shadow-sm transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Direct Export
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
      <!-- Dropdown menu -->
      <div id="exportMenu"
        class="hidden absolute right-0 mt-2 w-64 bg-white rounded-2xl border border-slate-100 shadow-xl z-50 overflow-hidden fade-in">
        <div class="px-4 py-2.5 border-b border-slate-100">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Instant Stream</p>
          <p class="text-xs text-slate-400 mt-0.5">Streamed directly, no cloud storage needed</p>
        </div>
        <div class="py-1.5">
          <a href="/admin/backups/export?format=json_gz"
            class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition">
            <span class="w-8 h-8 rounded-lg bg-sky-100 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-slate-800">JSON Gzip <span class="text-slate-400 font-normal">.json.gz</span></p>
              <p class="text-xs text-slate-400 mt-0.5">Compact, best for long-term storage</p>
            </div>
          </a>
          <a href="/admin/backups/export?format=json"
            class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition">
            <span class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-slate-800">Plain JSON <span class="text-slate-400 font-normal">.json</span></p>
              <p class="text-xs text-slate-400 mt-0.5">Human-readable, inspect in any editor</p>
            </div>
          </a>
          <a href="/admin/backups/export?format=bson_gz"
            class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition">
            <span class="w-8 h-8 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-slate-800">BSON Archive <span class="text-slate-400 font-normal">.bson.gz</span></p>
              <p class="text-xs text-slate-400 mt-0.5">Native MongoDB format, restore with <code class="font-mono text-xs bg-slate-100 px-1 rounded">mongorestore</code></p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Cloud Backup Button — opens modal -->
    <button type="button" id="openBackupModalBtn"
      class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
      </svg>
      Cloud Backup
    </button>
  </div>
</div>

<!-- Freshness Alert (if no automated backup succeeded in last 8 days) -->
<% if (!hasRecentAutomated) { %>
  <div class="mb-6 flex items-start gap-3 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <div>
      <p class="font-bold">No Recent Automated Backup Detected</p>
      <p class="text-xs text-amber-800 mt-0.5">No automated backup has completed successfully in the last 8 days. Please inspect your cron execution logs or initiate a manual cloud backup now.</p>
    </div>
  </div>
<% } %>

<!-- Retention Policy Info Banner -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-slate-700 text-xs shadow-sm">
  <div class="flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
    </svg>
    <span><strong>Automated Retention Policy:</strong> Backups older than <strong><%= retentionDays %> days</strong> are automatically deleted from database and cloud storage. Pinned backups and the 2 newest successful backups are always protected.</span>
  </div>
  <% if (expiringSoonCount > 0) { %>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 font-semibold whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      <%= expiringSoonCount %> backup(s) expiring within 7 days
    </span>
  <% } %>
</div>

<!-- Cloud Backup Modal -->
<div id="backupModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden">
  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" id="backupModalOverlay"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md fade-in">
    <div class="px-6 pt-6 pb-2">
      <h2 class="text-lg font-bold text-slate-900">Create Private Cloud Backup</h2>
      <p class="text-sm text-slate-500 mt-1">Choose a format. The backup is streamed privately with SHA-256 verification to Cloudinary.</p>
    </div>

    <form method="POST" action="/admin/backups" id="backupForm" class="px-6 pt-4 pb-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <fieldset class="space-y-2.5 mb-6">
        <legend class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Backup Format</legend>

        <!-- JSON Gzip -->
        <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:border-indigo-300 hover:bg-indigo-50/30 transition has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
          <input type="radio" name="format" value="json_gz" checked class="mt-0.5 accent-indigo-600">
          <div>
            <p class="text-sm font-semibold text-slate-800">JSON Gzip <code class="font-mono text-xs text-slate-400">.json.gz</code></p>
            <p class="text-xs text-slate-400 mt-0.5">Compressed JSON — compact, best for regular backups</p>
          </div>
        </label>

        <!-- Plain JSON -->
        <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:border-emerald-300 hover:bg-emerald-50/30 transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50">
          <input type="radio" name="format" value="json" class="mt-0.5 accent-emerald-600">
          <div>
            <p class="text-sm font-semibold text-slate-800">Plain JSON <code class="font-mono text-xs text-slate-400">.json</code></p>
            <p class="text-xs text-slate-400 mt-0.5">Human-readable — easy to inspect in any text editor</p>
          </div>
        </label>

        <!-- BSON -->
        <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:border-violet-300 hover:bg-violet-50/30 transition has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50">
          <input type="radio" name="format" value="bson_gz" class="mt-0.5 accent-violet-600">
          <div>
            <p class="text-sm font-semibold text-slate-800">BSON Archive <code class="font-mono text-xs text-slate-400">.bson.gz</code></p>
            <p class="text-xs text-slate-400 mt-0.5">Native MongoDB format — preserves ObjectId, Date types exactly</p>
          </div>
        </label>
      </fieldset>

      <div class="flex gap-3">
        <button type="button" id="cancelBackupBtn"
          class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
          Cancel
        </button>
        <button type="submit" id="backupBtn"
          class="flex-1 inline-flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
          </svg>
          <span id="backupBtnLabel">Create Backup</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Flash Message -->
<% if (flashMessage) { %>
  <div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-xl
    <%= flashMessage.startsWith('Backup failed') ? 'bg-red-50 border border-red-200 text-red-700' : 'bg-emerald-50 border border-emerald-200 text-emerald-700' %>
    text-sm font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
    </svg>
    <%= flashMessage %>
  </div>
<% } %>

<!-- Stats Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Backups</p>
    <p class="text-3xl font-bold text-slate-900"><%= totalBackups %></p>
    <p class="text-xs text-slate-400 mt-1"><%= successCount %> successful</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Size Stored</p>
    <p class="text-3xl font-bold text-rose-600"><%= totalSize %></p>
    <p class="text-xs text-slate-400 mt-1">Cloudinary Storage</p>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Last Backup</p>
    <% if (lastBackup) { %>
      <p class="text-base font-bold text-slate-900 mt-1">
        <%= new Date(lastBackup.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
      </p>
      <p class="text-xs text-slate-400 mt-0.5">by <%= lastBackup.initiatedByName %></p>
    <% } else { %>
      <p class="text-sm text-slate-400 mt-2">No backups yet.</p>
    <% } %>
  </div>
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Weekly Automated</p>
    <div class="flex items-center gap-1.5 mt-1.5">
      <span class="w-2.5 h-2.5 rounded-full <%= hasRecentAutomated ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500' %> flex-shrink-0"></span>
      <p class="text-sm font-bold text-slate-950"><%= hasRecentAutomated ? 'Active & Healthy' : 'Schedule Pending' %></p>
    </div>
    <p class="text-xs text-slate-400 mt-1.5 font-medium" title="<%= nextBackupDate.toISOString() %>">
      Next: <%= nextBackupDate.toLocaleDateString('en-US', { timeZone: 'Asia/Jakarta', weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
    </p>
  </div>
</div>

<!-- Backup History Table -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-sm font-bold text-slate-800">Cloud Backup History</h2>
      <p class="text-xs text-slate-400 mt-0.5">All backed-up records across 13 collections. Protected downloads proxy through server.</p>
    </div>
  </div>

  <% if (!backups.length) { %>
    <div class="py-16 text-center text-slate-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
      </svg>
      <p class="text-sm font-medium">No backups yet.</p>
      <p class="text-xs mt-1">Click "Cloud Backup" to start.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <th class="px-6 py-3 text-left">Date & Time</th>
            <th class="px-6 py-3 text-left">Initiated By</th>
            <th class="px-6 py-3 text-left">Format</th>
            <th class="px-6 py-3 text-left">Status & Retention</th>
            <th class="px-6 py-3 text-left hidden md:table-cell">Collections & Records</th>
            <th class="px-6 py-3 text-left hidden sm:table-cell">Size</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% backups.forEach(function(b) { %>
            <tr class="hover:bg-slate-50/60 transition" data-backup-id="<%= b._id %>">

              <!-- Date -->
              <td class="px-6 py-3.5 whitespace-nowrap">
                <p class="font-semibold text-slate-800 text-xs">
                  <%= new Date(b.createdAt).toLocaleDateString('en-US', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' }) %>
                </p>
                <p class="text-slate-400 text-xs font-mono">
                  <%= new Date(b.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                </p>
              </td>

              <!-- Initiated By -->
              <td class="px-6 py-3.5 text-slate-700 font-medium whitespace-nowrap">
                <span class="text-xs"><%= b.initiatedByName %></span>
                <% if (b.cloudinaryType === 'authenticated') { %>
                  <span class="inline-block ml-1 text-[10px] text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200" title="Private Authenticated Cloudinary Storage">Private</span>
                <% } %>
              </td>

              <!-- Format Badge -->
              <td class="px-6 py-3.5">
                <% const fmt = b.format || 'json_gz'; %>
                <span class="inline-flex items-center text-xs font-bold px-2 py-0.5 rounded-full
                  <%= fmt === 'bson_gz' ? 'bg-violet-100 text-violet-700' : fmt === 'json' ? 'bg-emerald-100 text-emerald-700' : 'bg-sky-100 text-sky-700' %>">
                  <%= b.formatLabel || 'JSON Gzip' %>
                </span>
                <% if (b.checksum) { %>
                  <span class="block text-[10px] text-slate-400 font-mono mt-0.5 truncate max-w-[100px]" title="SHA-256: <%= b.checksum %>">
                    #<%= b.checksum.substring(0, 8) %>…
                  </span>
                <% } %>
              </td>

              <!-- Status & Retention -->
              <td class="px-6 py-3.5 whitespace-nowrap">
                <div class="flex flex-col gap-1">
                  <div class="flex items-center gap-1.5">
                    <% if (b.status === 'success') { %>
                      <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 border border-emerald-200 text-xs font-semibold px-2 py-0.5 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        Success
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 text-red-700 bg-red-50 border border-red-200 text-xs font-semibold px-2 py-0.5 rounded-full" title="<%= b.errorMessage || '' %>">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                        Failed
                      </span>
                    <% } %>

                    <!-- Pinned Badge -->
                    <span class="badge-pinned inline-flex items-center gap-0.5 text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200 <%= b.pinned ? '' : 'hidden' %>">
                      📌 Pinned
                    </span>
                  </div>

                  <!-- Retention / Expiry Info -->
                  <% if (b.isPinned) { %>
                    <span class="text-[11px] font-medium text-amber-700">Pinned</span>
                  <% } else if (b.isProtectedLatest) { %>
                    <span class="text-[11px] font-medium text-emerald-700">Kept (newest)</span>
                  <% } else if (b.status === 'success') { %>
                    <span class="text-[11px] <%= b.isExpiringSoon ? 'text-amber-600 font-bold' : 'text-slate-400' %>">
                      <%= b.isExpiringSoon ? '⚠️ Expiring' : 'Expires' %>
                      <%= b.expiresAt.toLocaleDateString('en-US', { day: '2-digit', month: 'short' }) %>
                    </span>
                  <% } else { %>
                    <span class="text-[11px] text-red-400">Pruned after <%= b.expiresAt.toLocaleDateString('en-US', { day: '2-digit', month: 'short' }) %></span>
                  <% } %>
                </div>
              </td>

              <!-- Records (Detailed 13-collection expandable) -->
              <td class="px-6 py-3.5 hidden md:table-cell">
                <% if (b.status === 'success' && b.recordCounts && b.totalRecords > 0) { %>
                  <% const rc = b.recordCounts; %>
                  <details class="group cursor-pointer">
                    <summary class="list-none flex items-center gap-1 text-slate-700 font-semibold text-xs hover:text-indigo-600 transition">
                      <span><%= b.totalRecords.toLocaleString() %> total records</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                      </svg>
                    </summary>
                    <div class="mt-2 p-2.5 bg-slate-50 rounded-xl border border-slate-100 text-[11px] text-slate-600 grid grid-cols-2 gap-x-3 gap-y-1 w-64 shadow-xs">
                      <div>Users: <strong><%= rc.users || 0 %></strong></div>
                      <div>Reports: <strong><%= rc.reports || 0 %></strong></div>
                      <div>Groups: <strong><%= rc.groups || 0 %></strong></div>
                      <div>Audit Logs: <strong><%= rc.auditLogs || 0 %></strong></div>
                      <div>Feedbacks: <strong><%= rc.feedbacks || 0 %></strong></div>
                      <div>Salaries: <strong><%= rc.salaries || 0 %></strong></div>
                      <div>Students: <strong><%= rc.students || 0 %></strong></div>
                      <div>AC Trans: <strong><%= rc.acTransactions || 0 %></strong></div>
                      <div>Notifications: <strong><%= rc.notifications || 0 %></strong></div>
                      <div>Materials: <strong><%= rc.materials || 0 %></strong></div>
                      <div>Aliases: <strong><%= rc.materialAliases || 0 %></strong></div>
                      <div>Contents: <strong><%= rc.materialContents || 0 %></strong></div>
                      <div>Revisions: <strong><%= rc.materialContentRevisions || 0 %></strong></div>
                    </div>
                  </details>
                  <p class="text-slate-400 text-[11px] leading-tight mt-0.5 truncate max-w-[200px]">
                    <%= rc.users || 0 %> users · <%= rc.reports || 0 %> reports · <%= rc.salaries || 0 %> salaries…
                  </p>
                <% } else if (b.status === 'failed') { %>
                  <span class="text-slate-300 text-xs">—</span>
                <% } else { %>
                  <span class="text-slate-400 text-xs"><%= b.totalRecords %> records</span>
                <% } %>
              </td>

              <!-- Size -->
              <td class="px-6 py-3.5 hidden sm:table-cell text-slate-500 text-xs font-mono whitespace-nowrap">
                <% if (b.status === 'success') { %>
                  <%= b.fileSizeFormatted %>
                <% } else { %>
                  —
                <% } %>
              </td>

              <!-- Actions -->
              <td class="px-6 py-3.5 text-right whitespace-nowrap">
                <div class="inline-flex items-center gap-1">
                  <!-- Pin/Unpin Toggle -->
                  <button type="button"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 transition btn-pin-backup"
                    data-id="<%= b._id %>"
                    data-pinned="<%= b.pinned ? 'true' : 'false' %>"
                    title="<%= b.pinned ? 'Unpin (allow auto-expiry)' : 'Pin backup (prevent auto-expiry)' %>">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 <%= b.pinned ? 'text-amber-600 fill-amber-600' : '' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m3 3 1.664 1.664M21 21l-1.5-1.5m-5.485-1.242L12 17.25 4.5 21V8.25m14.25 5.25V5.25A2.25 2.25 0 0 0 16.5 3h-9" />
                    </svg>
                  </button>

                  <% if (b.status === 'success' && (b.fileUrl || b.cloudinaryId)) { %>
                    <a href="/admin/backups/<%= b._id %>/download"
                      title="Download <%= b.formatLabel || 'backup' %> (proxied)"
                      class="p-1.5 rounded-lg text-slate-400 hover:text-sky-500 hover:bg-sky-50 transition">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                      </svg>
                    </a>
                  <% } %>

                  <button type="button"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 transition btn-delete-backup"
                    data-id="<%= b._id %>"
                    title="Delete backup record and storage file">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Info notes footer -->
<div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-3">
  <div class="flex items-start gap-3 bg-sky-50 border border-sky-100 rounded-xl px-4 py-3 text-xs text-sky-700">
    <span class="font-bold whitespace-nowrap">.json.gz</span>
    <span>Gzip compressed JSON envelope. Decompress with <code class="font-mono bg-sky-100 px-1 rounded">gunzip</code> or Node <code class="font-mono bg-sky-100 px-1 rounded">zlib</code>.</span>
  </div>
  <div class="flex items-start gap-3 bg-emerald-50 border border-emerald-100 rounded-xl px-4 py-3 text-xs text-emerald-700">
    <span class="font-bold whitespace-nowrap">.json</span>
    <span>Plain readable JSON covering all 13 collections. Inspect in any editor.</span>
  </div>
  <div class="flex items-start gap-3 bg-violet-50 border border-violet-100 rounded-xl px-4 py-3 text-xs text-violet-700">
    <span class="font-bold whitespace-nowrap">.bson.gz</span>
    <span>MongoDB binary stream preserving exact BSON types. Compatible with <code class="font-mono bg-violet-100 px-1 rounded">mongorestore</code>.</span>
  </div>
</div>

<script>
  // ── Cloud Backup Modal ───────────────────────────────────────────
  var modal        = document.getElementById('backupModal');
  var openBtn      = document.getElementById('openBackupModalBtn');
  var cancelBtn    = document.getElementById('cancelBackupBtn');
  var modalOverlay = document.getElementById('backupModalOverlay');

  if (openBtn) openBtn.addEventListener('click', function () { modal.classList.remove('hidden'); });
  if (cancelBtn) cancelBtn.addEventListener('click', function () { modal.classList.add('hidden'); });
  if (modalOverlay) modalOverlay.addEventListener('click', function () { modal.classList.add('hidden'); });

  var backupForm = document.getElementById('backupForm');
  if (backupForm) {
    backupForm.addEventListener('submit', function () {
      var btn   = document.getElementById('backupBtn');
      var label = document.getElementById('backupBtnLabel');
      if (btn) btn.disabled = true;
      if (label) label.textContent = 'Creating & Uploading…';
    });
  }

  // ── Direct Export Dropdown ───────────────────────────────────────
  var exportMenu = document.getElementById('exportMenu');
  var exportBtn  = document.getElementById('exportDropdownBtn');

  if (exportBtn && exportMenu) {
    exportBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      exportMenu.classList.toggle('hidden');
    });
    document.addEventListener('click', function () { exportMenu.classList.add('hidden'); });
  }

  // ── Pin / Unpin Backup AJAX ──────────────────────────────────────
  document.querySelectorAll('.btn-pin-backup').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var id = this.dataset.id;
      try {
        var res = await fetch('/admin/backups/' + id + '/pin', {
          method:  'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'x-csrf-token':     '<%= csrfToken %>',
          },
        });
        var data = await res.json();
        if (data.ok) {
          this.dataset.pinned = data.pinned ? 'true' : 'false';
          var row = document.querySelector('tr[data-backup-id="' + id + '"]');
          if (row) {
            var badge = row.querySelector('.badge-pinned');
            if (badge) {
              if (data.pinned) badge.classList.remove('hidden');
              else badge.classList.add('hidden');
            }
          }
          this.title = data.pinned ? 'Unpin (allow auto-expiry)' : 'Pin backup (prevent auto-expiry)';
          var icon = this.querySelector('svg');
          if (icon) {
            if (data.pinned) {
              icon.classList.add('text-amber-600', 'fill-amber-600');
            } else {
              icon.classList.remove('text-amber-600', 'fill-amber-600');
            }
          }
        } else {
          Swal.fire('Error', data.error || 'Failed to toggle pin.', 'error');
        }
      } catch (err) {
        Swal.fire('Error', 'Request failed.', 'error');
      }
    });
  });

  // ── Delete Expired Now Button (with Preview Step) ─────────────────
  var pruneBtn = document.getElementById('pruneExpiredBtn');
  if (pruneBtn) {
    pruneBtn.addEventListener('click', async function () {
      Swal.fire({
        title: 'Scanning for Expired Backups...',
        text:  'Checking retention rules and orphan storage files...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); },
      });

      try {
        var prevRes = await fetch('/admin/backups/prune?preview=1&sweepOrphans=1', {
          method:  'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'x-csrf-token':     '<%= csrfToken %>',
          },
        });
        var prevData = await prevRes.json();

        if (!prevData.ok) {
          return Swal.fire('Error', prevData.error || 'Failed to scan for expired backups.', 'error');
        }

        var s = prevData.summary || {};
        var expiredCount = s.expiredCount || 0;
        var orphanCount  = s.orphanCount || 0;

        if (expiredCount === 0 && orphanCount === 0) {
          return Swal.fire({
            title: 'No Items to Delete',
            text:  'No expired backups or orphan storage files currently qualify for deletion under retention rules.',
            icon:  'info',
          });
        }

        var html = '<div class="text-left text-xs space-y-3 max-h-60 overflow-y-auto mt-3 p-3 bg-slate-50 rounded-xl border border-slate-200">';
        html += '<div><p class="font-bold text-slate-800 text-sm mb-1">Expired Backups (' + expiredCount + '):</p>';
        if (expiredCount === 0) {
          html += '<p class="text-slate-400">None</p>';
        } else {
          html += '<ul class="list-disc pl-4 space-y-0.5 text-slate-600">';
          (s.expiredBackups || []).forEach(function (b) {
            var d = b.createdAt ? new Date(b.createdAt).toISOString().split('T')[0] : 'unknown';
            html += '<li>' + d + ' (' + (b.sizeFormatted || '0 B') + ') - ' + b.status + '</li>';
          });
          html += '</ul>';
        }
        html += '</div>';

        html += '<div><p class="font-bold text-slate-800 text-sm mb-1">Orphan Cloudinary Assets (' + orphanCount + '):</p>';
        if (orphanCount === 0) {
          html += '<p class="text-slate-400">' + (s.orphanSkippedReason ? 'Skipped: ' + s.orphanSkippedReason : 'None') + '</p>';
        } else {
          html += '<ul class="list-disc pl-4 space-y-0.5 text-slate-600">';
          (s.orphansToDelete || []).forEach(function (o) {
            var fn = (o.public_id || '').split('/').pop();
            html += '<li>' + fn + ' (' + (o.sizeFormatted || '0 B') + ')</li>';
          });
          html += '</ul>';
          if (s.orphanRemainingCount > 0) {
            html += '<p class="text-amber-600 font-medium mt-1">+' + s.orphanRemainingCount + ' more beyond batch cap</p>';
          }
        }
        html += '</div></div>';

        var confirmed = await Swal.fire({
          title:              'Delete Expired Backups & Orphans?',
          html:               '<p class="text-sm text-slate-600">The following items will be permanently removed from MongoDB and Cloudinary storage:</p>' + html,
          icon:               'warning',
          showCancelButton:   true,
          confirmButtonColor: '#e11d48',
          cancelButtonColor:  '#64748b',
          confirmButtonText:  'Yes, Delete All',
          cancelButtonText:   'Cancel',
          reverseButtons:     true,
        });

        if (!confirmed.isConfirmed) return;

        Swal.fire({
          title: 'Pruning Expired Backups...',
          text:  'Cleaning MongoDB records and removing Cloudinary assets.',
          allowOutsideClick: false,
          didOpen: () => { Swal.showLoading(); },
        });

        var res = await fetch('/admin/backups/prune', {
          method:  'POST',
          headers: {
            'Content-Type':     'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'x-csrf-token':     '<%= csrfToken %>',
          },
          body: JSON.stringify({ sweepOrphans: true }),
        });
        var data = await res.json();
        if (data.ok) {
          var resSummary = data.summary || {};
          await Swal.fire({
            title: 'Cleanup Complete',
            html: '<div class="text-left text-sm space-y-1 mt-2">' +
                  '<p>• Deleted records: <strong>' + (resSummary.deletedCount || 0) + '</strong></p>' +
                  '<p>• Freed storage: <strong>' + (resSummary.freedBytesFormatted || '0 B') + '</strong></p>' +
                  '<p>• Orphan assets removed: <strong>' + (resSummary.orphanDeletedCount || 0) + '</strong></p>' +
                  '</div>',
            icon: 'success',
          });
          window.location.reload();
        } else {
          Swal.fire('Error', data.error || 'Failed to prune backups.', 'error');
        }
      } catch (err) {
        Swal.fire('Error', 'Prune request failed.', 'error');
      }
    });
  }

  // ── Delete Single Backup AJAX ────────────────────────────────────
  document.querySelectorAll('.btn-delete-backup').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var id = this.dataset.id;
      var confirmed = await Swal.fire({
        title:              'Delete this backup?',
        text:               'This will delete the database record and destroy the file in Cloudinary.',
        icon:               'warning',
        showCancelButton:   true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor:  '#64748b',
        confirmButtonText:  'Yes, delete',
        cancelButtonText:   'Cancel',
        reverseButtons:     true,
      });
      if (!confirmed.isConfirmed) return;

      try {
        var res = await fetch('/admin/backups/' + id, {
          method:  'DELETE',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'x-csrf-token':     '<%= csrfToken %>',
          },
        });
        var data = await res.json();
        if (data.ok) {
          var row = document.querySelector('tr[data-backup-id="' + id + '"]');
          if (row) row.remove();
        } else {
          Swal.fire('Error', data.error || 'Failed to delete backup.', 'error');
        }
      } catch (err) {
        Swal.fire('Error', 'Delete request failed.', 'error');
      }
    });
  });
</script>

<%- include('../../partials/footer') %>