<%- include('../partials/header', { title: 'Edit Profile' }) %>

  <div class="max-w-xl mx-auto">

    <!-- Page Header -->
    <div class="mb-8 flex items-center gap-3">
      <a href="/reports" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Edit Profile</h1>
        <p class="text-slate-500 text-sm mt-0.5">Update your account information.</p>
      </div>
    </div>

    <!-- Alerts -->
    <% if (success) { %>
      <div class="mb-6 flex items-center gap-3 bg-brand-50 border border-brand-200 text-brand-700 px-4 py-3 rounded-xl text-sm font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <%= success %>
      </div>
    <% } %>

    <% if (errors.length > 0) { %>
      <div class="mb-6 bg-red-50 border border-red-200 rounded-xl px-4 py-3">
        <% errors.forEach(e => { %>
          <p class="text-sm text-red-600 font-medium flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <%= e %>
          </p>
        <% }) %>
      </div>
    <% } %>

    <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Profile Picture -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-5">Profile Picture</h2>
        <div class="flex items-center gap-5">
          <div class="relative flex-shrink-0">
            <% if (user.profilePicture) { %>
              <img id="avatar-preview" src="<%= user.profilePicture %>" alt="Avatar"
                class="w-20 h-20 rounded-2xl object-cover border-2 border-slate-100 shadow-sm">
            <% } else { %>
              <div id="avatar-initials"
                class="w-20 h-20 rounded-2xl bg-brand-100 flex items-center justify-center border-2 border-slate-100 shadow-sm">
                <span class="text-2xl font-bold text-brand-700"><%= user.displayName[0].toUpperCase() %></span>
              </div>
              <img id="avatar-preview" src="" alt="Avatar"
                class="w-20 h-20 rounded-2xl object-cover border-2 border-slate-100 shadow-sm hidden">
            <% } %>
            <label for="profilePicture"
              class="absolute -bottom-2 -right-2 w-7 h-7 bg-brand-600 hover:bg-brand-700 rounded-lg flex items-center justify-center cursor-pointer shadow transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
              </svg>
            </label>
            <input id="profilePicture" type="file" name="profilePicture"
              accept="image/jpeg,image/png,image/webp" class="hidden" onchange="previewAvatar(this)">
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-700"><%= user.displayName %></p>
            <p class="text-xs text-slate-400 mt-0.5">JPG, PNG or WebP — max 2MB</p>
            <p class="text-xs text-slate-400 mt-1">Click the camera icon to change photo</p>
          </div>
        </div>
      </div>

      <!-- Account Info -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5">
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Account Info</h2>

        <!-- Full Name -->
        <div>
          <label for="displayName" class="block text-xs font-semibold text-slate-500 mb-1.5">Full Name</label>
          <input type="text" id="displayName" name="displayName" value="<%= user.displayName %>" required
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition"
            placeholder="Your full name">
        </div>

        <!-- Username -->
        <div>
          <label for="username" class="block text-xs font-semibold text-slate-500 mb-1.5">Username</label>
          <input type="text" id="username" name="username" value="<%= user.username %>" required
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition"
            placeholder="your_username">
        </div>

        <!-- Join Date -->
        <div>
          <label class="block text-xs font-semibold text-slate-500 mb-1.5">
            Started Teaching
            <span class="ml-1 font-normal normal-case text-slate-400">— month &amp; year</span>
          </label>
          <%
            const jd = user.joinDate ? new Date(user.joinDate) : null;
            const jMonth = jd ? jd.getMonth() + 1 : '';
            const jYear  = jd ? jd.getFullYear()  : '';
          %>
          <div class="grid grid-cols-2 gap-2">
            <div class="relative">
              <select name="joinMonth"
                class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-8">
                <option value="">Month</option>
                <% ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].forEach((m, i) => { %>
                  <option value="<%= i + 1 %>" <%= jMonth === (i + 1) ? 'selected' : '' %>><%= m %></option>
                <% }) %>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
              </div>
            </div>
            <input type="number" name="joinYear"
              value="<%= jYear %>"
              placeholder="Year"
              min="1970" max="<%= currentYear %>"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition font-mono" />
          </div>
          <% if (user.joinDate) { %>
            <%
              const nowD = new Date();
              const totalMos = Math.max(0,
                (nowD.getFullYear() - new Date(user.joinDate).getFullYear()) * 12 +
                (nowD.getMonth()    - new Date(user.joinDate).getMonth())
              );
              const expYrs = Math.floor(totalMos / 12);
              const expMos = totalMos % 12;
              let expStr = expYrs > 0 ? (expMos > 0 ? `${expYrs}yr ${expMos}mo` : `${expYrs}yr`) : (expMos > 0 ? `${expMos}mo` : '< 1 mo');
            %>
            <p class="text-xs text-brand-600 font-semibold mt-1">Experience: <%= expStr %></p>
          <% } %>
        </div>
      </div>

      <!-- Commission Prices -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5">
        <div>
          <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Commission per Session</h2>
          <p class="text-xs text-slate-400 mt-1">Set your earnings per session type. Used to calculate monthly income on the dashboard.</p>
        </div>

        <div class="space-y-3">
          <%
            const commissionTypes = [
              { key: 'primeFull',     label: 'Prime Teacher (Full)',     color: 'emerald' },
              { key: 'primeAssisted', label: 'Prime Teacher (Assisted)', color: 'purple'  },
              { key: 'halfPrime',     label: '½ Prime Teacher',          color: 'amber'   },
              { key: 'assistant',     label: 'Assistant Teacher',        color: 'sky'     },
            ];
          %>
          <% commissionTypes.forEach(ct => { %>
            <div class="flex items-center gap-3">
              <span class="badge-<%= ct.color %> text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap w-44 text-center flex-shrink-0"><%= ct.label %></span>
              <div class="relative flex-1">
                <span class="absolute inset-y-0 left-4 flex items-center text-xs text-slate-400 font-medium pointer-events-none">Rp</span>
                <input type="number" name="commission_<%= ct.key %>"
                  value="<%= (user.commission && user.commission[ct.key]) || 0 %>"
                  min="0" step="500"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-2.5 text-sm font-mono text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition" />
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Change Password -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5">
        <div>
          <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Change Password</h2>
          <p class="text-xs text-slate-400 mt-1">Leave blank to keep your current password.</p>
        </div>
        <div>
          <label for="password" class="block text-xs font-semibold text-slate-500 mb-1.5">New Password</label>
          <input type="password" id="password" name="password" minlength="6"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition"
            placeholder="Min. 6 characters">
        </div>
        <div>
          <label for="password_confirm" class="block text-xs font-semibold text-slate-500 mb-1.5">Confirm New Password</label>
          <input type="password" id="password_confirm" name="password_confirm"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-800 focus:outline-none focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition"
            placeholder="Repeat new password">
        </div>
      </div>

      <!-- Submit -->
      <div class="flex gap-3">
        <a href="/reports"
          class="flex-1 text-center py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
          Cancel
        </a>
        <button type="submit"
          class="flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition active:scale-95">
          Save Changes
        </button>
      </div>

    </form>

    <!-- Toast Notif -->
    <div id="size-toast"
      class="hidden fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-red-500 text-white text-sm font-semibold px-5 py-3 rounded-xl shadow-lg flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
      File too large! Maximum size is 2MB.
    </div>

    <script>
      function showSizeError() {
        const toast = document.getElementById('size-toast');
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
      }

      function previewAvatar(input) {
        if (input.files && input.files[0]) {
          const file = input.files[0];
          if (file.size > 2 * 1024 * 1024) {
            input.value = '';
            showSizeError();
            return;
          }
          const reader = new FileReader();
          reader.onload = (e) => {
            const preview  = document.getElementById('avatar-preview');
            const initials = document.getElementById('avatar-initials');
            preview.src = e.target.result;
            preview.classList.remove('hidden');
            if (initials) initials.classList.add('hidden');
          };
          reader.readAsDataURL(file);
        }
      }
    </script>
  </div>

<%- include('../partials/footer') %>
