<%- include('../partials/header', { title: 'Getting Started' }) %>

<div class="max-w-2xl mx-auto pb-12">

  <!-- Page Header -->
  <div class="mb-6 flex items-center gap-3">
    <a href="/reports" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-slate-900 leading-tight">Getting started</h1>
      <p class="text-slate-500 text-sm mt-0.5">Complete your account setup to start teaching and getting accurate salary slips.</p>
    </div>
  </div>

  <!-- Screen reader live announcement region -->
  <div id="onboarding-live-region" aria-live="polite" class="sr-only"></div>

  <!-- Progress Overview Card -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <div>
        <p class="text-xs font-semibold text-brand-700">Checklist progress</p>
        <p class="text-lg font-bold text-slate-900 mt-0.5"><%= state.doneCount %> of <%= state.totalCount %> steps completed</p>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden"
      role="progressbar"
      aria-valuenow="<%= state.percent %>"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="Getting started progress">
      <div class="bg-brand-600 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
    </div>
  </div>

  <!-- Steps List Card -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
    <div class="divide-y divide-slate-100">
      <% state.steps.forEach(function(s, idx) { %>
        <div class="py-5 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-start gap-3.5 min-w-0">
            <!-- Status Icon -->
            <div class="mt-0.5 flex-shrink-0">
              <% if (s.status === 'done') { %>
                <span class="w-7 h-7 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                </span>
              <% } else if (s.status === 'skipped') { %>
                <span class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center font-bold text-sm" title="Skipped">
                  –
                </span>
              <% } else { %>
                <span class="w-7 h-7 rounded-full border-2 border-slate-300 flex items-center justify-center text-xs font-bold text-slate-500">
                  <%= idx + 1 %>
                </span>
              <% } %>
            </div>

            <!-- Title & description -->
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold <%= s.status === 'done' ? 'text-slate-400 line-through' : 'text-slate-800' %>">
                  <%= s.title %>
                </h3>
                <% if (s.optional) { %>
                  <span class="text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Optional</span>
                <% } %>
                <% if (s.status === 'skipped') { %>
                  <span class="text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Skipped</span>
                <% } %>
              </div>
              <p class="text-xs text-slate-500 mt-1"><%= s.why %></p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-2 self-end sm:self-auto flex-shrink-0">
            <% if (s.status === 'todo') { %>
              <% if (s.optional || s.key === 'rewards') { %>
                <button type="button"
                  data-onboarding-action="skip"
                  data-step-key="<%= s.key %>"
                  class="min-h-[44px] px-3.5 py-2 text-xs font-semibold text-slate-400 hover:text-slate-600 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none rounded-xl transition">
                  Skip
                </button>
              <% } %>
              <a href="<%= s.cta.href %>"
                class="min-h-[44px] inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl shadow-sm focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition active:scale-[0.98]">
                <%= s.cta.label %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            <% } else if (s.status === 'done') { %>
              <span class="text-xs font-semibold text-brand-600 flex items-center gap-1.5 px-3 py-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                Completed
              </span>
            <% } else if (s.status === 'skipped') { %>
              <a href="<%= s.cta.href %>"
                class="min-h-[44px] inline-flex items-center justify-center px-3.5 py-2 text-xs font-semibold text-slate-500 bg-slate-50 hover:bg-slate-100 rounded-xl focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition">
                <%= !s.optional ? 'Do it now' : s.cta.label %>
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Replay Tour Link -->
  <div class="mt-6 flex items-center justify-between px-2">
    <a href="/reports/new?tour=1" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none rounded-lg px-2 py-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
      </svg>
      Replay the report form tour
    </a>
  </div>

</div>

<script src="/js/onboarding.js" defer></script>

<%- include('../partials/footer') %>
