<%# Fullscreen Slideshow & Viewer Modal %>
<style>
  #slide-viewer-modal {
    font-family: inherit;
  }
  #sv-progress-bar {
    transition: width 0.3s ease;
  }
  #sv-image {
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.2, 0, 0, 1);
    transform-origin: center center;
  }
  .sv-thumb-item {
    transition: all 0.15s ease;
  }
</style>

<div id="slide-viewer-modal"
  class="hidden fixed inset-0 z-50 flex flex-col select-none bg-slate-950 text-white"
  role="dialog" aria-modal="true" aria-label="Material Slideshow">

  <%# ── Top Bar ── %>
  <div class="flex-shrink-0 flex items-center justify-between px-4 sm:px-6 h-14 border-b border-slate-800 bg-slate-900/90 backdrop-blur-md">

    <%# Left: counter badge (clickable for grid) + title %>
    <div class="flex items-center gap-3 min-w-0">
      <button type="button" onclick="toggleSlideGrid()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-200 bg-slate-800 hover:bg-slate-700 hover:text-white transition flex-shrink-0 min-h-[36px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="View all slides in a grid (G)">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
        <span id="sv-counter" class="tabular-nums font-mono text-xs">1 / 1</span>
      </button>

      <span class="w-px h-4 bg-slate-800 rounded-full flex-shrink-0"></span>

      <p id="sv-slide-title"
        class="text-sm font-medium text-slate-200 truncate max-w-[140px] sm:max-w-xs md:max-w-md lg:max-w-lg">
        Slideshow
      </p>
    </div>

    <%# Right: controls %>
    <div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">

      <%# Slideshow Play / Pause button %>
      <button type="button" id="sv-btn-play" onclick="toggleAutoPlay()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-200 hover:text-white bg-slate-800 hover:bg-slate-700 transition min-h-[36px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Start slideshow auto-play (P)">
        <svg id="sv-icon-play" class="w-3.5 h-3.5 text-brand-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="sv-icon-pause" class="w-3.5 h-3.5 text-amber-400 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span id="sv-play-text" class="hidden md:inline">Play</span>
      </button>

      <%# Open in new tab %>
      <a id="sv-open-link" href="#" target="_blank" rel="noopener noreferrer"
        class="min-h-[44px] min-w-[44px] p-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition flex items-center justify-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Open full image in new tab">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        <span class="sr-only">Open image</span>
      </a>

      <%# Download %>
      <a id="sv-download-link" href="#"
        class="min-h-[44px] min-w-[44px] p-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition flex items-center justify-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Download image">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="sr-only">Download image</span>
      </a>

      <%# Fullscreen %>
      <button type="button" id="sv-btn-native-fs" onclick="toggleNativeFullscreen()"
        class="min-h-[44px] min-w-[44px] p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Toggle browser fullscreen (F)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
        <span class="sr-only">Fullscreen</span>
      </button>

      <%# Keyboard shortcuts info %>
      <button type="button" onclick="toggleShortcutsHelp()"
        class="min-h-[44px] min-w-[44px] p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Keyboard shortcuts (?)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
        </svg>
        <span class="sr-only">Keyboard shortcuts</span>
      </button>

      <%# Close %>
      <button type="button" onclick="closeSlideViewer()"
        class="min-h-[44px] min-w-[44px] p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Close presentation (Esc)">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
        <span class="sr-only">Close</span>
      </button>
    </div>
  </div>

  <%# ── Progress bar ── %>
  <div class="flex-shrink-0 h-0.5 bg-slate-800 relative overflow-hidden">
    <div id="sv-progress-bar" class="absolute left-0 top-0 h-full bg-brand-500" style="width:0%;"></div>
  </div>

  <%# ── Main Stage ── %>
  <div id="sv-stage"
    class="relative flex-1 min-h-0 w-full flex items-center justify-center overflow-hidden p-2 sm:p-6">

    <%# Prev arrow %>
    <button type="button" id="sv-btn-prev" onclick="prevSlide()"
      class="min-h-[44px] min-w-[44px] absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-20 group flex items-center justify-center w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white border border-slate-700 shadow-md transition active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
      title="Previous slide (←)">
      <svg class="w-5 h-5 text-slate-300 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
      <span class="sr-only">Previous slide</span>
    </button>

    <%# Slide display container %>
    <div id="sv-slide-container" class="relative w-full h-full flex items-center justify-center min-h-0 min-w-0">
      <img id="sv-image" src="" alt="Slide preview"
        class="transition-opacity duration-200"
        style="width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; margin: auto; display: block;" />
    </div>

    <%# Floating Zoom Controls Pill %>
    <div id="sv-zoom-controls"
      class="absolute right-4 bottom-4 z-20 inline-flex items-center rounded-xl bg-slate-900/90 border border-slate-800 shadow-md px-1.5 py-1 text-xs">
      <button type="button" onclick="zoomOut()"
        class="min-h-[36px] min-w-[36px] p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Zoom out (-)">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
        </svg>
        <span class="sr-only">Zoom out</span>
      </button>
      <button type="button" id="sv-zoom-level" onclick="resetZoom()"
        class="px-2.5 py-1 text-xs font-mono font-semibold text-slate-200 hover:text-brand-400 cursor-pointer"
        title="Reset zoom (0)">
        100%
      </button>
      <button type="button" onclick="zoomIn()"
        class="min-h-[36px] min-w-[36px] p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Zoom in (+)">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span class="sr-only">Zoom in</span>
      </button>
    </div>

    <%# Next arrow %>
    <button type="button" id="sv-btn-next" onclick="nextSlide()"
      class="min-h-[44px] min-w-[44px] absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-20 group flex items-center justify-center w-11 h-11 rounded-full bg-slate-900/80 hover:bg-slate-800 text-white border border-slate-700 shadow-md transition active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
      title="Next slide (→)">
      <svg class="w-5 h-5 text-slate-300 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
      <span class="sr-only">Next slide</span>
    </button>
  </div>

  <%# ── Thumbnail strip ── %>
  <div id="sv-thumbnails-strip" class="flex-shrink-0 border-t border-slate-800 bg-slate-900/90 py-2.5 px-4">
    <div id="sv-thumbnails"
      class="flex items-center justify-center gap-2 overflow-x-auto"
      style="scrollbar-width: thin; scrollbar-color: #475569 transparent;">
      <%# Built via DOM APIs %>
    </div>
  </div>

  <%# ── Slide Grid Overview Modal (Overlay) ── %>
  <div id="sv-grid-modal"
    class="hidden absolute inset-0 z-40 bg-slate-950/95 backdrop-blur-md flex flex-col p-6 overflow-hidden">
    <div class="flex items-center justify-between pb-4 border-b border-slate-800">
      <div>
        <h3 class="text-base font-bold text-slate-100">All Slides Overview</h3>
        <p class="text-xs text-slate-400">Click any slide to jump directly</p>
      </div>
      <button type="button" onclick="toggleSlideGrid()"
        class="min-h-[44px] min-w-[44px] p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center justify-center"
        title="Close grid (G or Esc)">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div id="sv-grid-content"
      class="flex-1 overflow-y-auto pt-6 pb-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <%# Built purely via DOM APIs %>
    </div>
  </div>

  <%# ── Keyboard Shortcuts Helper Modal ── %>
  <div id="sv-shortcuts-modal"
    class="hidden absolute inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
    onclick="if(event.target === this) toggleShortcutsHelp();">
    <div class="bg-slate-900 rounded-2xl max-w-sm w-full p-6 shadow-xl border border-slate-800 space-y-4 text-white">
      <div class="flex items-center justify-between pb-2 border-b border-slate-800">
        <h4 class="text-sm font-bold text-slate-100">Keyboard Shortcuts</h4>
        <button type="button" onclick="toggleShortcutsHelp()" class="p-1 rounded-lg text-slate-400 hover:text-white">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="space-y-2 text-xs">
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Next Slide</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">→ / Space</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Previous Slide</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">←</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Slideshow Play / Pause</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">P</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Zoom In / Out</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">+ / -</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Reset Zoom</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">0</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">All Slides Grid</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">G</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Fullscreen</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">F</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-300">Close</span>
          <span class="font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-200">Esc</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    window._slideViewerState = {
      materialId: null,
      slides: [],
      currentIndex: 0,
      isOpen: false,
      zoomLevel: 1.0,
      isAutoPlaying: false,
      autoPlayTimer: null,
    };

    const modal          = document.getElementById('slide-viewer-modal');
    const counterEl      = document.getElementById('sv-counter');
    const titleEl        = document.getElementById('sv-slide-title');
    const openLinkEl     = document.getElementById('sv-open-link');
    const dlLinkEl       = document.getElementById('sv-download-link');
    const imageEl        = document.getElementById('sv-image');
    const thumbsEl       = document.getElementById('sv-thumbnails');
    const progressBar    = document.getElementById('sv-progress-bar');
    const stageEl        = document.getElementById('sv-stage');
    const zoomTextEl     = document.getElementById('sv-zoom-level');
    const gridModal      = document.getElementById('sv-grid-modal');
    const gridContentEl  = document.getElementById('sv-grid-content');
    const shortcutsModal = document.getElementById('sv-shortcuts-modal');
    const iconPlay       = document.getElementById('sv-icon-play');
    const iconPause      = document.getElementById('sv-icon-pause');
    const playText       = document.getElementById('sv-play-text');

    const IMAGE_FORMATS = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'];

    // ── Public API ──────────────────────────────────────────────────────────

    window.initSlideViewer = function (materialId, fileResources) {
      window._slideViewerState.materialId = materialId;
      const rawList = Array.isArray(fileResources) ? fileResources : [];
      // Keep only images for the slideshow
      const imageSlides = rawList.filter(function (r) {
        if (!r) return false;
        if (r.kind && r.kind !== 'file') return false;
        const fmt = ((r.file && r.file.format) || '').toLowerCase().trim();
        return IMAGE_FORMATS.includes(fmt);
      });
      // Fallback: if caller passed list containing images, use them
      window._slideViewerState.slides = imageSlides.length > 0 ? imageSlides : rawList;
      buildThumbnails();
    };

    window.openSlideViewer = function (index) {
      const s = window._slideViewerState;
      if (!s.slides || s.slides.length === 0) return;
      s.currentIndex = (typeof index === 'number' && index >= 0 && index < s.slides.length) ? index : 0;
      s.isOpen = true;
      resetZoom();
      if (modal) modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      renderCurrentSlide(false);
    };

    window.closeSlideViewer = function () {
      stopAutoPlay();
      window._slideViewerState.isOpen = false;
      if (modal) modal.classList.add('hidden');
      if (gridModal) gridModal.classList.add('hidden');
      if (shortcutsModal) shortcutsModal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    window.nextSlide = function () {
      const s = window._slideViewerState;
      if (!s.slides || s.slides.length === 0) return;
      s.currentIndex = (s.currentIndex + 1) % s.slides.length;
      resetZoom();
      renderCurrentSlide(true);
    };

    window.prevSlide = function () {
      const s = window._slideViewerState;
      if (!s.slides || s.slides.length === 0) return;
      s.currentIndex = s.currentIndex === 0 ? s.slides.length - 1 : s.currentIndex - 1;
      resetZoom();
      renderCurrentSlide(true);
    };

    window.goToSlide = function (index) {
      const s = window._slideViewerState;
      if (!s.slides || index < 0 || index >= s.slides.length) return;
      s.currentIndex = index;
      resetZoom();
      renderCurrentSlide(true);
      if (gridModal && !gridModal.classList.contains('hidden')) {
        gridModal.classList.add('hidden');
      }
    };

    window.toggleNativeFullscreen = function () {
      if (!document.fullscreenElement) {
        if (modal && modal.requestFullscreen) modal.requestFullscreen();
        else if (modal && modal.webkitRequestFullscreen) modal.webkitRequestFullscreen();
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      }
    };

    // ── Zoom Feature ────────────────────────────────────────────────────────

    window.zoomIn = function () {
      const s = window._slideViewerState;
      s.zoomLevel = Math.min(3.0, Math.round((s.zoomLevel + 0.25) * 100) / 100);
      applyZoom();
    };

    window.zoomOut = function () {
      const s = window._slideViewerState;
      s.zoomLevel = Math.max(0.75, Math.round((s.zoomLevel - 0.25) * 100) / 100);
      applyZoom();
    };

    window.resetZoom = function () {
      const s = window._slideViewerState;
      s.zoomLevel = 1.0;
      if (imageEl) imageEl.style.transform = '';
      if (zoomTextEl) zoomTextEl.textContent = '100%';
    };

    function applyZoom() {
      const s = window._slideViewerState;
      if (imageEl) {
        imageEl.style.transform = (s.zoomLevel === 1.0) ? '' : `scale(${s.zoomLevel})`;
      }
      if (zoomTextEl) {
        zoomTextEl.textContent = `${Math.round(s.zoomLevel * 100)}%`;
      }
    }

    // ── Auto-Play / Slideshow Feature ───────────────────────────────────────

    window.toggleAutoPlay = function () {
      const s = window._slideViewerState;
      if (s.isAutoPlaying) {
        stopAutoPlay();
      } else {
        startAutoPlay();
      }
    };

    function startAutoPlay() {
      const s = window._slideViewerState;
      s.isAutoPlaying = true;
      if (iconPlay) iconPlay.classList.add('hidden');
      if (iconPause) iconPause.classList.remove('hidden');
      if (playText) playText.textContent = 'Pause';
      clearInterval(s.autoPlayTimer);
      s.autoPlayTimer = setInterval(function () {
        nextSlide();
      }, 4000);
    }

    function stopAutoPlay() {
      const s = window._slideViewerState;
      s.isAutoPlaying = false;
      if (iconPlay) iconPlay.classList.remove('hidden');
      if (iconPause) iconPause.classList.add('hidden');
      if (playText) playText.textContent = 'Play';
      if (s.autoPlayTimer) {
        clearInterval(s.autoPlayTimer);
        s.autoPlayTimer = null;
      }
    }

    // ── Grid & Shortcuts Modal ──────────────────────────────────────────────

    window.toggleSlideGrid = function () {
      if (!gridModal) return;
      const willShow = gridModal.classList.contains('hidden');
      if (willShow) {
        buildGridContent();
        gridModal.classList.remove('hidden');
      } else {
        gridModal.classList.add('hidden');
      }
    };

    window.toggleShortcutsHelp = function () {
      if (!shortcutsModal) return;
      shortcutsModal.classList.toggle('hidden');
    };

    // A2 FIX: Build grid cards purely with DOM APIs — NO user text into innerHTML
    function buildGridContent() {
      const s = window._slideViewerState;
      if (!gridContentEl) return;
      gridContentEl.textContent = ''; // clear safely

      s.slides.forEach(function (slide, idx) {
        const openUrl = '/materials/' + encodeURIComponent(s.materialId) + '/resources/' + encodeURIComponent(slide._id) + '/open';
        const labelText = slide.label || (slide.file && slide.file.originalFilename) || 'Slide ' + (idx + 1);

        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'group flex flex-col rounded-xl overflow-hidden border transition text-left cursor-pointer p-2.5 bg-slate-900/60 hover:bg-slate-800 hover:border-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500';
        if (idx === s.currentIndex) {
          card.classList.add('ring-2', 'ring-brand-500', 'border-brand-500', 'bg-slate-800');
        } else {
          card.classList.add('border-slate-800');
        }

        const mediaBox = document.createElement('div');
        mediaBox.className = 'w-full h-32 flex items-center justify-center bg-black/40 rounded-lg overflow-hidden border border-slate-800/80 mb-2';

        const img = document.createElement('img');
        img.src = openUrl;
        img.alt = labelText;
        img.className = 'max-w-full max-h-full object-contain';
        img.loading = 'lazy';
        mediaBox.appendChild(img);

        const footer = document.createElement('div');
        footer.className = 'flex items-center justify-between text-xs w-full gap-2';

        const numSpan = document.createElement('span');
        numSpan.className = 'font-mono font-bold text-slate-400';
        numSpan.textContent = '#' + (idx + 1);

        const titleSpan = document.createElement('span');
        titleSpan.className = 'truncate font-medium text-slate-200 flex-1 text-right';
        titleSpan.textContent = labelText;

        footer.appendChild(numSpan);
        footer.appendChild(titleSpan);

        card.appendChild(mediaBox);
        card.appendChild(footer);

        card.onclick = function () { goToSlide(idx); };
        gridContentEl.appendChild(card);
      });
    }

    // A2 FIX: Build thumbnails purely with DOM APIs — NO user text into innerHTML
    function buildThumbnails() {
      const s = window._slideViewerState;
      if (!thumbsEl) return;
      thumbsEl.textContent = ''; // safe clear

      const total = s.slides.length;
      if (total <= 1) {
        const strip = document.getElementById('sv-thumbnails-strip');
        if (strip) strip.classList.add('hidden');
        return;
      }

      const strip = document.getElementById('sv-thumbnails-strip');
      if (strip) strip.classList.remove('hidden');

      s.slides.forEach(function (slide, idx) {
        const openUrl = '/materials/' + encodeURIComponent(s.materialId) + '/resources/' + encodeURIComponent(slide._id) + '/open';
        const labelText = slide.label || (slide.file && slide.file.originalFilename) || 'Slide ' + (idx + 1);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sv-thumb-item relative flex-shrink-0 rounded-lg overflow-hidden cursor-pointer flex items-center justify-center border-2 border-slate-800 hover:border-slate-600 bg-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500';
        btn.style.width = '64px';
        btn.style.height = '42px';
        btn.title = (idx + 1) + '. ' + labelText;

        const img = document.createElement('img');
        img.src = openUrl;
        img.alt = labelText;
        img.style.width = '100%';
        img.style.height = '100%';
        img.style.objectFit = 'contain';
        img.style.padding = '2px';
        img.loading = 'lazy';
        btn.appendChild(img);

        const idxBadge = document.createElement('span');
        idxBadge.className = 'absolute bottom-0.5 right-1 text-[9px] font-mono font-bold text-white bg-black/60 px-1 rounded';
        idxBadge.textContent = String(idx + 1);
        btn.appendChild(idxBadge);

        btn.onclick = function () { goToSlide(idx); };
        thumbsEl.appendChild(btn);
      });
    }

    // ── Render Current Slide ─────────────────────────────────────────────────

    function renderCurrentSlide(withFade) {
      const s = window._slideViewerState;
      const total = s.slides.length;
      if (total === 0) return;

      const slide = s.slides[s.currentIndex];
      const openUrl = '/materials/' + encodeURIComponent(s.materialId) + '/resources/' + encodeURIComponent(slide._id) + '/open';
      const dlUrl = openUrl + '?download=1';
      const labelText = slide.label || (slide.file && slide.file.originalFilename) || 'Slide ' + (s.currentIndex + 1);

      if (counterEl) counterEl.textContent = (s.currentIndex + 1) + ' / ' + total;
      if (titleEl) titleEl.textContent = labelText;
      if (openLinkEl) openLinkEl.href = openUrl;
      if (dlLinkEl) dlLinkEl.href = dlUrl;

      if (progressBar) {
        progressBar.style.width = total > 1 ? `${((s.currentIndex + 1) / total) * 100}%` : '100%';
      }

      const doFade = withFade && !!imageEl;
      if (doFade) {
        imageEl.style.opacity = '0';
      }

      const setContent = function () {
        if (imageEl) {
          imageEl.src = openUrl;
          imageEl.alt = labelText;
          if (doFade) {
            requestAnimationFrame(function () {
              imageEl.style.opacity = '1';
            });
          } else {
            imageEl.style.opacity = '1';
          }
        }
      };

      if (doFade) {
        setTimeout(setContent, 150);
      } else {
        setContent();
      }

      // Highlight active thumbnail
      if (thumbsEl) {
        thumbsEl.querySelectorAll('.sv-thumb-item').forEach(function (btn, idx) {
          if (idx === s.currentIndex) {
            btn.classList.add('border-brand-500', 'ring-2', 'ring-brand-500/50');
            btn.classList.remove('border-slate-800');
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            btn.classList.remove('border-brand-500', 'ring-2', 'ring-brand-500/50');
            btn.classList.add('border-slate-800');
          }
        });
      }
    }

    // ── Touch / Swipe Support ────────────────────────────────────────────────

    let _touchStartX = null;
    if (stageEl) {
      stageEl.addEventListener('touchstart', function (e) {
        _touchStartX = e.touches[0].clientX;
      }, { passive: true });
      stageEl.addEventListener('touchend', function (e) {
        if (_touchStartX === null) return;
        const dx = e.changedTouches[0].clientX - _touchStartX;
        if (Math.abs(dx) > 40) {
          dx < 0 ? nextSlide() : prevSlide();
        }
        _touchStartX = null;
      }, { passive: true });
    }

    // ── Keyboard Shortcuts ───────────────────────────────────────────────────

    window.addEventListener('keydown', function (e) {
      if (!window._slideViewerState.isOpen) return;

      if (e.key === 'Escape') {
        if (shortcutsModal && !shortcutsModal.classList.contains('hidden')) {
          e.preventDefault();
          shortcutsModal.classList.add('hidden');
          return;
        }
        if (gridModal && !gridModal.classList.contains('hidden')) {
          e.preventDefault();
          gridModal.classList.add('hidden');
          return;
        }
        e.preventDefault();
        closeSlideViewer();
        return;
      }

      if (e.key === 'ArrowRight' || e.key === ' ') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'f' || e.key === 'F') {
        toggleNativeFullscreen();
      } else if (e.key === 'g' || e.key === 'G') {
        toggleSlideGrid();
      } else if (e.key === 'p' || e.key === 'P') {
        toggleAutoPlay();
      } else if (e.key === '+' || e.key === '=') {
        zoomIn();
      } else if (e.key === '-' || e.key === '_') {
        zoomOut();
      } else if (e.key === '0') {
        resetZoom();
      } else if (e.key === '?') {
        toggleShortcutsHelp();
      }
    });
  })();
</script>
