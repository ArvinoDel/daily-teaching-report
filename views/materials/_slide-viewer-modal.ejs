<%# Fullscreen Presentation & Slide Viewer Modal %>
<style>
  #slide-viewer-modal {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  #sv-progress-bar {
    transition: width 0.3s ease;
  }
  #sv-image {
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.2, 0, 0, 1);
    transform-origin: center center;
  }
  #sv-fallback {
    transition: opacity 0.2s ease;
  }
  .sv-dot {
    width: 6px; height: 6px;
    border-radius: 9999px;
    background: #cbd5e1;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .sv-dot.active {
    background: #4f46e5;
    width: 20px;
  }
  .sv-dot:hover:not(.active) { background: #94a3b8; }
  .sv-thumb-item { transition: all 0.15s ease; }

  @keyframes sv-pulse-soft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .sv-pulse {
    animation: sv-pulse-soft 1.8s infinite;
  }
</style>

<div id="slide-viewer-modal"
  class="hidden fixed inset-0 z-50 flex flex-col select-none"
  style="background:#f8fafc;"
  role="dialog" aria-modal="true" aria-label="Material Slide Presentation">

  <%# ── Top Bar ── %>
  <div class="flex-shrink-0 flex items-center justify-between px-4 sm:px-6 h-13 border-b border-slate-200/80 bg-white"
    style="box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.03);">

    <%# Left: counter badge (clickable for grid) + title %>
    <div class="flex items-center gap-3 min-w-0">
      <button type="button" onclick="toggleSlideGrid()"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 hover:text-indigo-600 transition flex-shrink-0"
        title="View all slides in a grid (G)">
        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
        <span id="sv-counter" class="tabular-nums font-mono text-[11px]">1 / 1</span>
      </button>

      <span class="w-px h-4 bg-slate-200 rounded-full flex-shrink-0"></span>

      <p id="sv-slide-title"
        class="text-sm font-semibold text-slate-800 truncate max-w-[140px] sm:max-w-xs md:max-w-md lg:max-w-lg">
        Loading…
      </p>

      <span id="sv-format-badge"
        class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 hidden sm:inline flex-shrink-0">
        IMAGE
      </span>
    </div>

    <%# Right: controls %>
    <div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">

      <%# Slideshow Play / Pause button %>
      <button type="button" id="sv-btn-play" onclick="toggleAutoPlay()"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 border border-slate-200/90 transition shadow-2xs"
        title="Start slideshow auto-play (P)">
        <svg id="sv-icon-play" class="w-3.5 h-3.5 text-indigo-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="sv-icon-pause" class="w-3.5 h-3.5 text-amber-600 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span id="sv-play-text" class="hidden md:inline">Play</span>
      </button>

      <%# Open in new tab %>
      <a id="sv-open-link" href="#" target="_blank" rel="noopener noreferrer"
        class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center gap-1"
        title="Open file in new tab">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        <span class="hidden lg:inline text-[11px]">Open</span>
      </a>

      <%# Download %>
      <a id="sv-download-link" href="#"
        class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center gap-1"
        title="Download file">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="hidden lg:inline text-[11px]">Download</span>
      </a>

      <div class="w-px h-4 bg-slate-200 mx-1"></div>

      <%# Toggle thumbnails %>
      <button type="button" id="sv-btn-toggle-thumbs" onclick="toggleThumbnailsBar()"
        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition"
        title="Toggle thumbnail strip (T)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <%# Fullscreen %>
      <button type="button" id="sv-btn-native-fs" onclick="toggleNativeFullscreen()"
        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition"
        title="Toggle browser fullscreen (F)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
      </button>

      <%# Keyboard shortcuts info %>
      <button type="button" onclick="toggleShortcutsHelp()"
        class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition"
        title="Keyboard shortcuts (?)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
        </svg>
      </button>

      <%# Close %>
      <button type="button" onclick="closeSlideViewer()"
        class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition ml-1"
        title="Close presentation (Esc)">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <%# ── Progress bar (thin strip under top bar) ── %>
  <div class="flex-shrink-0 h-0.5 bg-slate-100 relative overflow-hidden">
    <div id="sv-progress-bar" class="absolute left-0 top-0 h-full bg-indigo-500" style="width:0%;"></div>
  </div>

  <%# ── Main Stage ── %>
  <div id="sv-stage"
    class="relative flex-1 min-h-0 w-full flex items-center justify-center overflow-hidden p-2 sm:p-4">

    <%# Prev arrow %>
    <button type="button" id="sv-btn-prev" onclick="prevSlide()"
      class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-20 group flex items-center justify-center w-10 h-10 rounded-full bg-white/95 backdrop-blur-sm border border-slate-200/90 hover:border-indigo-300 hover:bg-indigo-50/50 shadow-sm transition-all duration-150 active:scale-90 disabled:opacity-30 disabled:pointer-events-none"
      title="Previous slide (←)">
      <svg class="w-4 h-4 text-slate-600 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
    </button>

    <%# Slide display container %>
    <div id="sv-slide-container"
      class="relative w-full h-full flex items-center justify-center min-h-0 min-w-0">

      <%# Image slide - 100% full uncropped display %>
      <img id="sv-image" src="" alt="Slide preview"
        class="hidden transition-opacity duration-200"
        style="width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; margin: auto; display: block;" />

      <%# Non-image fallback card %>
      <div id="sv-fallback"
        class="hidden flex-col items-center justify-center gap-5 p-8 sm:p-10 rounded-2xl text-center max-w-sm w-full bg-white border border-slate-200/90"
        style="box-shadow: 0 10px 30px -4px rgba(0,0,0,0.06);">
        <div id="sv-fallback-icon"
          class="w-16 h-16 rounded-2xl flex items-center justify-center bg-indigo-50 text-indigo-600">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <div>
          <h4 id="sv-fallback-title" class="text-sm font-bold text-slate-800 mb-1">Document</h4>
          <p id="sv-fallback-meta" class="text-xs text-slate-400 font-mono">PDF</p>
        </div>
        <div class="flex items-center gap-2.5">
          <a id="sv-fallback-open" href="#" target="_blank" rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition shadow-xs">
            Open File
          </a>
          <a id="sv-fallback-dl" href="#"
            class="px-4 py-2 rounded-xl text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 transition">
            Download
          </a>
        </div>
      </div>
    </div>

    <%# Floating Zoom Controls Pill (bottom right of stage) %>
    <div id="sv-zoom-controls"
      class="absolute right-4 bottom-4 z-20 inline-flex items-center rounded-xl bg-white/95 backdrop-blur-sm border border-slate-200 shadow-sm px-1 py-0.5 text-xs">
      <button type="button" onclick="zoomOut()"
        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition"
        title="Zoom out (-)">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
        </svg>
      </button>
      <button type="button" id="sv-zoom-level" onclick="resetZoom()"
        class="px-2 py-1 text-[11px] font-mono font-semibold text-slate-700 hover:text-indigo-600 cursor-pointer"
        title="Click to reset zoom (0)">
        100%
      </button>
      <button type="button" onclick="zoomIn()"
        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition"
        title="Zoom in (+)">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>
    </div>

    <%# Next arrow %>
    <button type="button" id="sv-btn-next" onclick="nextSlide()"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-20 group flex items-center justify-center w-10 h-10 rounded-full bg-white border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/50 shadow-sm transition-all duration-150 active:scale-90 disabled:opacity-30 disabled:pointer-events-none"
      title="Next slide (→)">
      <svg class="w-4 h-4 text-slate-600 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    </button>
  </div>

  <%# ── Dot indicators + Thumbnail strip ── %>
  <div id="sv-thumbnails-strip"
    class="flex-shrink-0 border-t border-slate-200/80 bg-white"
    style="box-shadow: 0 -1px 3px 0 rgba(0, 0, 0, 0.02);">

    <%# Dot indicators row %>
    <div id="sv-dots" class="flex items-center justify-center gap-1.5 pt-2 pb-0.5 px-4">
      <%# Populated by JS %>
    </div>

    <%# Thumbnail strip %>
    <div id="sv-thumbnails"
      class="flex items-end gap-1.5 overflow-x-auto px-4 pb-2 pt-0.5"
      style="scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent;">
      <%# Populated by JS %>
    </div>
  </div>

  <%# ── Slide Grid Overview Modal (Overlay) ── %>
  <div id="sv-grid-modal"
    class="hidden absolute inset-0 z-40 bg-white/95 backdrop-blur-md flex flex-col p-6 overflow-hidden">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <h3 class="text-base font-bold text-slate-800">All Slides Overview</h3>
        <p class="text-xs text-slate-400">Click any slide to jump directly</p>
      </div>
      <button type="button" onclick="toggleSlideGrid()"
        class="p-2 rounded-xl text-slate-400 hover:text-slate-800 hover:bg-slate-100 transition"
        title="Close grid (G or Esc)">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div id="sv-grid-content"
      class="flex-1 overflow-y-auto pt-6 pb-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
      <%# Populated dynamically via JS %>
    </div>
  </div>

  <%# ── Keyboard Shortcuts Helper Modal ── %>
  <div id="sv-shortcuts-modal"
    class="hidden absolute inset-0 z-50 bg-slate-900/30 backdrop-blur-xs flex items-center justify-center p-4"
    onclick="if(event.target === this) toggleShortcutsHelp();">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
          Keyboard Shortcuts
        </h4>
        <button type="button" onclick="toggleShortcutsHelp()" class="p-1 rounded-lg text-slate-400 hover:text-slate-700">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="space-y-2 text-xs">
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Next Slide</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">→ / Space</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Previous Slide</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">←</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Slideshow Play / Pause</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">P</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Zoom In / Out</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">+ / -</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Reset Zoom</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">0</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">All Slides Grid</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">G</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Toggle Thumbnails</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">T</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Fullscreen</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">F</span>
        </div>
        <div class="flex items-center justify-between py-1">
          <span class="text-slate-600">Close</span>
          <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-semibold">Esc</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    window._slideViewerState = {
      materialId: null,
      slides: [],
      currentIndex: 0,
      isOpen: false,
      zoomLevel: 1.0,
      isAutoPlaying: false,
      autoPlayTimer: null,
    };

    const modal           = document.getElementById('slide-viewer-modal');
    const counterEl       = document.getElementById('sv-counter');
    const formatBadge     = document.getElementById('sv-format-badge');
    const titleEl         = document.getElementById('sv-slide-title');
    const openLinkEl      = document.getElementById('sv-open-link');
    const dlLinkEl        = document.getElementById('sv-download-link');
    const imageEl         = document.getElementById('sv-image');
    const fallbackEl      = document.getElementById('sv-fallback');
    const fallbackTitleEl = document.getElementById('sv-fallback-title');
    const fallbackMetaEl  = document.getElementById('sv-fallback-meta');
    const fallbackOpenEl  = document.getElementById('sv-fallback-open');
    const fallbackDlEl    = document.getElementById('sv-fallback-dl');
    const thumbsEl        = document.getElementById('sv-thumbnails');
    const dotsEl          = document.getElementById('sv-dots');
    const progressBar     = document.getElementById('sv-progress-bar');
    const stageEl         = document.getElementById('sv-stage');
    const zoomTextEl      = document.getElementById('sv-zoom-level');
    const zoomControlsEl  = document.getElementById('sv-zoom-controls');
    const gridModal       = document.getElementById('sv-grid-modal');
    const gridContentEl   = document.getElementById('sv-grid-content');
    const shortcutsModal  = document.getElementById('sv-shortcuts-modal');
    const iconPlay        = document.getElementById('sv-icon-play');
    const iconPause       = document.getElementById('sv-icon-pause');
    const playText        = document.getElementById('sv-play-text');

    const IMAGE_FORMATS = ['jpg','jpeg','png','webp','gif','svg'];

    // ── Public API ──────────────────────────────────────────────────────────

    window.initSlideViewer = function (materialId, fileResources) {
      window._slideViewerState.materialId = materialId;
      window._slideViewerState.slides = Array.isArray(fileResources) ? fileResources : [];
      buildThumbnailsAndDots();
    };

    window.openSlideViewer = function (index) {
      const s = window._slideViewerState;
      if (!s.slides || s.slides.length === 0) return;
      s.currentIndex = (typeof index === 'number' && index >= 0 && index < s.slides.length) ? index : 0;
      s.isOpen = true;
      resetZoom();
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      renderCurrentSlide(false);
    };

    window.closeSlideViewer = function () {
      stopAutoPlay();
      window._slideViewerState.isOpen = false;
      modal.classList.add('hidden');
      if (gridModal) gridModal.classList.add('hidden');
      if (shortcutsModal) shortcutsModal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    window.nextSlide = function () {
      const s = window._slideViewerState;
      if (!s.slides || s.slides.length === 0) return;
      s.currentIndex = (s.currentIndex + 1) % s.slides.length;
      resetZoom();
      renderCurrentSlide(true);
    };

    window.prevSlide = function () {
      const s = window._slideViewerState;
      if (!s.slides || s.slides.length === 0) return;
      s.currentIndex = s.currentIndex === 0 ? s.slides.length - 1 : s.currentIndex - 1;
      resetZoom();
      renderCurrentSlide(true);
    };

    window.goToSlide = function (index) {
      const s = window._slideViewerState;
      if (!s.slides || index < 0 || index >= s.slides.length) return;
      s.currentIndex = index;
      resetZoom();
      renderCurrentSlide(true);
      if (gridModal && !gridModal.classList.contains('hidden')) {
        gridModal.classList.add('hidden');
      }
    };

    window.toggleNativeFullscreen = function () {
      if (!document.fullscreenElement) {
        if (modal.requestFullscreen) modal.requestFullscreen();
        else if (modal.webkitRequestFullscreen) modal.webkitRequestFullscreen();
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      }
    };

    window.toggleThumbnailsBar = function () {
      const bar = document.getElementById('sv-thumbnails-strip');
      if (bar) bar.classList.toggle('hidden');
    };

    // ── Zoom Feature ────────────────────────────────────────────────────────

    window.zoomIn = function () {
      const s = window._slideViewerState;
      s.zoomLevel = Math.min(3.0, Math.round((s.zoomLevel + 0.25) * 100) / 100);
      applyZoom();
    };

    window.zoomOut = function () {
      const s = window._slideViewerState;
      s.zoomLevel = Math.max(0.75, Math.round((s.zoomLevel - 0.25) * 100) / 100);
      applyZoom();
    };

    window.resetZoom = function () {
      const s = window._slideViewerState;
      s.zoomLevel = 1.0;
      if (imageEl) imageEl.style.transform = '';
      if (zoomTextEl) zoomTextEl.textContent = '100%';
    };

    function applyZoom() {
      const s = window._slideViewerState;
      if (imageEl) {
        imageEl.style.transform = (s.zoomLevel === 1.0) ? '' : `scale(${s.zoomLevel})`;
      }
      if (zoomTextEl) {
        zoomTextEl.textContent = `${Math.round(s.zoomLevel * 100)}%`;
      }
    }

    // ── Auto-Play / Slideshow Feature ───────────────────────────────────────

    window.toggleAutoPlay = function () {
      const s = window._slideViewerState;
      if (s.isAutoPlaying) {
        stopAutoPlay();
      } else {
        startAutoPlay();
      }
    };

    function startAutoPlay() {
      const s = window._slideViewerState;
      s.isAutoPlaying = true;
      if (iconPlay) iconPlay.classList.add('hidden');
      if (iconPause) iconPause.classList.remove('hidden');
      if (playText) playText.textContent = 'Pause';
      clearInterval(s.autoPlayTimer);
      s.autoPlayTimer = setInterval(function () {
        nextSlide();
      }, 4000);
    }

    function stopAutoPlay() {
      const s = window._slideViewerState;
      s.isAutoPlaying = false;
      if (iconPlay) iconPlay.classList.remove('hidden');
      if (iconPause) iconPause.classList.add('hidden');
      if (playText) playText.textContent = 'Play';
      if (s.autoPlayTimer) {
        clearInterval(s.autoPlayTimer);
        s.autoPlayTimer = null;
      }
    }

    // ── Grid & Shortcuts Modal ──────────────────────────────────────────────

    window.toggleSlideGrid = function () {
      if (!gridModal) return;
      const willShow = gridModal.classList.contains('hidden');
      if (willShow) {
        buildGridContent();
        gridModal.classList.remove('hidden');
      } else {
        gridModal.classList.add('hidden');
      }
    };

    window.toggleShortcutsHelp = function () {
      if (!shortcutsModal) return;
      shortcutsModal.classList.toggle('hidden');
    };

    function buildGridContent() {
      const s = window._slideViewerState;
      if (!gridContentEl) return;
      gridContentEl.innerHTML = '';

      s.slides.forEach(function (slide, idx) {
        const fmt = ((slide.file && slide.file.format) || '').toLowerCase();
        const isImg = IMAGE_FORMATS.includes(fmt);
        const openUrl = `/materials/${s.materialId}/resources/${slide._id}/open`;

        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'group flex flex-col rounded-xl overflow-hidden border transition text-left cursor-pointer p-2.5 bg-slate-50/70 hover:bg-white hover:border-indigo-400 hover:shadow-md';
        if (idx === s.currentIndex) {
          card.classList.add('ring-2', 'ring-indigo-500', 'border-indigo-500', 'bg-indigo-50/40');
        } else {
          card.classList.add('border-slate-200');
        }

        let mediaHtml = '';
        if (isImg) {
          mediaHtml = `<div class="w-full h-32 flex items-center justify-center bg-white rounded-lg overflow-hidden border border-slate-100 mb-2">
            <img src="${openUrl}" alt="" class="max-w-full max-h-full object-contain" loading="lazy">
          </div>`;
        } else {
          mediaHtml = `<div class="w-full h-32 flex flex-col items-center justify-center bg-white rounded-lg border border-slate-100 mb-2 gap-1">
            <span class="text-xs font-mono font-bold uppercase text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">${fmt || 'FILE'}</span>
          </div>`;
        }

        card.innerHTML = `
          ${mediaHtml}
          <div class="flex items-center justify-between text-xs w-full">
            <span class="font-mono font-bold text-slate-500">#${idx + 1}</span>
            <span class="truncate max-w-[120px] font-medium text-slate-700">${slide.label || 'File'}</span>
          </div>
        `;

        card.onclick = function () { goToSlide(idx); };
        gridContentEl.appendChild(card);
      });
    }

    // ── Build Thumbnails & Dots ─────────────────────────────────────────────

    function buildThumbnailsAndDots() {
      const s = window._slideViewerState;
      if (thumbsEl) thumbsEl.innerHTML = '';
      if (dotsEl) dotsEl.innerHTML = '';

      const total = s.slides.length;
      if (total === 0) return;

      // Dots
      const showDots = total <= 14;
      if (dotsEl) {
        if (showDots) {
          s.slides.forEach(function (_, idx) {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'sv-dot' + (idx === 0 ? ' active' : '');
            dot.setAttribute('data-index', idx);
            dot.title = `Slide ${idx + 1}`;
            dot.onclick = function () { goToSlide(idx); };
            dotsEl.appendChild(dot);
          });
        } else {
          dotsEl.innerHTML = `<span class="text-[11px] text-slate-400 font-medium">${total} slides</span>`;
        }
      }

      // Thumbnails (shown when > 1)
      if (thumbsEl && total > 1) {
        s.slides.forEach(function (slide, idx) {
          const fmt = ((slide.file && slide.file.format) || '').toLowerCase();
          const isImg = IMAGE_FORMATS.includes(fmt);
          const openUrl = `/materials/${s.materialId}/resources/${slide._id}/open`;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'sv-thumb-item relative flex-shrink-0 rounded-lg overflow-hidden cursor-pointer flex items-center justify-center';
          btn.style.cssText = 'width:56px;height:38px;border:1.5px solid #e2e8f0;background:#ffffff;';
          btn.title = `${idx + 1}. ${slide.label || 'File'}`;

          if (isImg) {
            btn.innerHTML =
              `<img src="${openUrl}" alt="" style="width:100%;height:100%;object-fit:contain;padding:2px;" loading="lazy">` +
              `<span style="position:absolute;bottom:2px;right:3px;font-size:8px;font-family:monospace;color:#64748b;font-weight:700;">${idx + 1}</span>`;
          } else {
            btn.innerHTML =
              `<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;width:100%;height:100%;">` +
              `<span style="font-size:8px;font-family:monospace;font-weight:800;text-transform:uppercase;color:#4f46e5;">${fmt || 'FILE'}</span>` +
              `<span style="font-size:7px;font-family:monospace;color:#94a3b8;">${idx + 1}</span>` +
              `</div>`;
          }

          btn.onclick = function () { goToSlide(idx); };
          thumbsEl.appendChild(btn);
        });
      }
    }

    // ── Render Slide ────────────────────────────────────────────────────────

    function renderCurrentSlide(withFade) {
      const s = window._slideViewerState;
      const total = s.slides.length;
      if (total === 0) return;

      const slide = s.slides[s.currentIndex];
      const fmt = ((slide.file && slide.file.format) || '').toLowerCase();
      const isImg = IMAGE_FORMATS.includes(fmt);
      const openUrl = `/materials/${s.materialId}/resources/${slide._id}/open`;
      const dlUrl   = openUrl + '?download=1';

      // Header controls
      if (counterEl) counterEl.textContent = `${s.currentIndex + 1} / ${total}`;
      if (formatBadge) formatBadge.textContent = (fmt || 'FILE').toUpperCase();
      if (titleEl) titleEl.textContent = slide.label || (slide.file && slide.file.originalFilename) || 'Attachment';
      if (openLinkEl) openLinkEl.href = openUrl;
      if (dlLinkEl) dlLinkEl.href = dlUrl;

      // Zoom pill visibility (only applicable for images)
      if (zoomControlsEl) {
        if (isImg) zoomControlsEl.classList.remove('hidden');
        else zoomControlsEl.classList.add('hidden');
      }

      // Progress bar
      if (progressBar && total > 1) {
        progressBar.style.width = `${((s.currentIndex + 1) / total) * 100}%`;
      } else if (progressBar) {
        progressBar.style.width = '100%';
      }

      // Fade transition
      const doFade = withFade && !!(imageEl || fallbackEl);
      if (doFade) {
        if (imageEl) imageEl.style.opacity = '0';
        if (fallbackEl && !fallbackEl.classList.contains('hidden')) fallbackEl.style.opacity = '0';
      }

      const setContent = function () {
        if (isImg) {
          if (imageEl) {
            imageEl.src = openUrl;
            imageEl.alt = slide.label || 'Slide';
            imageEl.classList.remove('hidden');
          }
          if (fallbackEl) { fallbackEl.classList.add('hidden'); fallbackEl.style.display = ''; }
        } else {
          if (imageEl) imageEl.classList.add('hidden');
          if (fallbackEl) {
            fallbackEl.classList.remove('hidden');
            fallbackEl.style.display = 'flex';
            if (fallbackTitleEl) fallbackTitleEl.textContent = slide.label || 'Document';
            if (fallbackMetaEl) fallbackMetaEl.textContent = `${(fmt || 'FILE').toUpperCase()} file`;
            if (fallbackOpenEl) fallbackOpenEl.href = openUrl;
            if (fallbackDlEl) fallbackDlEl.href = dlUrl;
          }
        }

        if (doFade) {
          requestAnimationFrame(function () {
            if (imageEl && isImg) imageEl.style.opacity = '1';
            if (fallbackEl && !isImg) fallbackEl.style.opacity = '1';
          });
        }
      };

      if (doFade) {
        setTimeout(setContent, 160);
      } else {
        setContent();
        if (imageEl) imageEl.style.opacity = '1';
        if (fallbackEl) fallbackEl.style.opacity = '1';
      }

      // Dots
      if (dotsEl) {
        dotsEl.querySelectorAll('.sv-dot').forEach(function (dot, idx) {
          dot.classList.toggle('active', idx === s.currentIndex);
        });
      }

      // Thumbnails
      if (thumbsEl) {
        thumbsEl.querySelectorAll('.sv-thumb-item').forEach(function (btn, idx) {
          if (idx === s.currentIndex) {
            btn.style.borderColor = '#4f46e5';
            btn.style.boxShadow = '0 0 0 2px rgba(79,70,229,0.2)';
            btn.style.transform = 'scale(1.08)';
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            btn.style.borderColor = '#e2e8f0';
            btn.style.boxShadow = '';
            btn.style.transform = '';
          }
        });
      }

      // Sync inline carousel
      if (typeof window.updateInlineSlideCarousel === 'function') {
        window.updateInlineSlideCarousel(s.currentIndex);
      }
    }

    // ── Touch/Swipe Support ──────────────────────────────────────────────────

    let _touchStartX = null;
    if (stageEl) {
      stageEl.addEventListener('touchstart', function (e) {
        _touchStartX = e.touches[0].clientX;
      }, { passive: true });
      stageEl.addEventListener('touchend', function (e) {
        if (_touchStartX === null) return;
        const dx = e.changedTouches[0].clientX - _touchStartX;
        if (Math.abs(dx) > 40) {
          dx < 0 ? nextSlide() : prevSlide();
        }
        _touchStartX = null;
      }, { passive: true });
    }

    // ── Keyboard Shortcuts ───────────────────────────────────────────────────

    window.addEventListener('keydown', function (e) {
      if (!window._slideViewerState.isOpen) return;

      // Close modal overlays first if open
      if (e.key === 'Escape') {
        if (shortcutsModal && !shortcutsModal.classList.contains('hidden')) {
          e.preventDefault();
          shortcutsModal.classList.add('hidden');
          return;
        }
        if (gridModal && !gridModal.classList.contains('hidden')) {
          e.preventDefault();
          gridModal.classList.add('hidden');
          return;
        }
        e.preventDefault();
        closeSlideViewer();
        return;
      }

      if (e.key === 'ArrowRight' || e.key === ' ') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'f' || e.key === 'F') {
        toggleNativeFullscreen();
      } else if (e.key === 't' || e.key === 'T') {
        toggleThumbnailsBar();
      } else if (e.key === 'g' || e.key === 'G') {
        toggleSlideGrid();
      } else if (e.key === 'p' || e.key === 'P') {
        toggleAutoPlay();
      } else if (e.key === '+' || e.key === '=') {
        zoomIn();
      } else if (e.key === '-' || e.key === '_') {
        zoomOut();
      } else if (e.key === '0') {
        resetZoom();
      } else if (e.key === '?') {
        toggleShortcutsHelp();
      }
    });
  })();
</script>
