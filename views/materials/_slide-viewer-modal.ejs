<!-- Fullscreen Presentation & Slide Viewer Modal -->
<div id="slide-viewer-modal"
  class="hidden fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md flex flex-col justify-between text-white select-none transition-opacity duration-200"
  role="dialog" aria-modal="true" aria-label="Material Slide Presentation">

  <!-- Top Action Bar -->
  <div class="px-4 sm:px-6 py-3 border-b border-white/10 flex items-center justify-between gap-3 bg-slate-900/50 backdrop-blur-sm z-10 flex-shrink-0">
    <div class="flex items-center gap-3 min-w-0">
      <div class="flex items-center gap-2">
        <span id="sv-counter" class="font-mono text-xs font-bold px-2.5 py-1 rounded-full bg-white/10 text-white/90">
          1 / 1
        </span>
        <span id="sv-format-badge" class="font-mono text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-indigo-500/30 text-indigo-300 border border-indigo-400/30">
          IMAGE
        </span>
      </div>
      <p id="sv-slide-title" class="text-xs sm:text-sm font-semibold truncate text-white/90 max-w-[200px] sm:max-w-md lg:max-w-xl">
        Loading...
      </p>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <a id="sv-open-link" href="#" target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-white/10 hover:bg-white/20 text-white transition"
        title="Open in new tab">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        <span class="hidden sm:inline">Open</span>
      </a>

      <a id="sv-download-link" href="#"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-white/10 hover:bg-white/20 text-white transition"
        title="Download file">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="hidden sm:inline">Download</span>
      </a>

      <!-- Toggle Thumbnails Button -->
      <button type="button" id="sv-btn-toggle-thumbs" onclick="toggleThumbnailsBar()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-white/10 hover:bg-white/20 text-white transition"
        title="Toggle thumbnail strip (T)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <span class="hidden md:inline" id="sv-thumbs-btn-text">Thumbnails</span>
      </button>

      <!-- Fullscreen native toggle -->
      <button type="button" id="sv-btn-native-fs" onclick="toggleNativeFullscreen()"
        class="p-2 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition"
        title="Toggle Fullscreen (F)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
      </button>

      <!-- Close Button -->
      <button type="button" onclick="closeSlideViewer()"
        class="p-2 rounded-xl text-white/70 hover:text-white hover:bg-red-500/20 hover:text-red-300 transition"
        title="Close (Esc)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Center Presentation Stage (Takes 100% remaining height and width) -->
  <div class="relative flex-1 min-h-0 min-w-0 w-full h-full flex items-center justify-center p-2 sm:p-4 overflow-hidden">
    <!-- Prev Arrow (Floating) -->
    <button type="button" id="sv-btn-prev" onclick="prevSlide()"
      class="absolute left-2 sm:left-5 top-1/2 -translate-y-1/2 z-30 p-2.5 sm:p-3.5 rounded-2xl bg-black/60 hover:bg-black/85 active:scale-95 text-white/90 hover:text-white backdrop-blur-md transition disabled:opacity-20 disabled:pointer-events-none group shadow-2xl border border-white/10"
      title="Previous slide (Left Arrow)">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
    </button>

    <!-- Main Slide Display Area -->
    <div id="sv-slide-container" class="relative w-full h-full flex items-center justify-center min-h-0 min-w-0 overflow-hidden"
      style="height: 100%; width: 100%; min-height: 0; min-width: 0;">
      <!-- Image Slide (Unconstrained natural ratio, strictly bounded to 100% of available stage) -->
      <img id="sv-image" src="" alt="Slide preview"
        class="hidden max-h-full max-w-full w-auto h-auto object-contain rounded-xl shadow-2xl transition-all duration-150"
        style="max-height: 100%; max-width: 100%; width: auto; height: auto; object-fit: contain; margin: auto;" />

      <!-- Fallback / Non-image Card -->
      <div id="sv-fallback" class="hidden flex flex-col items-center justify-center p-8 bg-white/5 border border-white/10 rounded-3xl max-w-lg w-full text-center">
        <div id="sv-fallback-icon" class="w-20 h-20 rounded-2xl bg-indigo-500/20 text-indigo-300 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <h4 id="sv-fallback-title" class="text-base font-bold text-white mb-1">Document Attachment</h4>
        <p id="sv-fallback-meta" class="text-xs text-white/60 mb-6 font-mono">PDF Document</p>
        <div class="flex items-center gap-3">
          <a id="sv-fallback-open" href="#" target="_blank" rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg transition">
            Open File in New Tab
          </a>
          <a id="sv-fallback-dl" href="#"
            class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold transition">
            Download
          </a>
        </div>
      </div>
    </div>

    <!-- Next Arrow (Floating) -->
    <button type="button" id="sv-btn-next" onclick="nextSlide()"
      class="absolute right-2 sm:right-5 top-1/2 -translate-y-1/2 z-30 p-2.5 sm:p-3.5 rounded-2xl bg-black/60 hover:bg-black/85 active:scale-95 text-white/90 hover:text-white backdrop-blur-md transition disabled:opacity-20 disabled:pointer-events-none group shadow-2xl border border-white/10"
      title="Next slide (Right Arrow or Space)">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    </button>
  </div>

  <!-- Bottom Thumbnails Strip -->
  <div id="sv-thumbnails-strip" class="px-4 sm:px-6 py-2.5 border-t border-white/10 bg-slate-900/60 backdrop-blur-md flex-shrink-0 transition-all duration-200">
    <div class="flex items-center justify-between mb-1.5 text-[11px] text-white/50">
      <span>Thumbnails (Click to jump · &larr; &rarr;)</span>
      <div class="flex items-center gap-3">
        <span id="sv-kb-hint" class="hidden sm:inline">Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 font-mono text-[10px] text-white/80">Space</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-white/10 font-mono text-[10px] text-white/80">&rarr;</kbd> for next</span>
        <button type="button" onclick="toggleThumbnailsBar()" class="text-white/60 hover:text-white hover:underline text-[10px]">Hide (T)</button>
      </div>
    </div>
    <div id="sv-thumbnails" class="flex items-center gap-2.5 overflow-x-auto pb-1 scrollbar-thin scrollbar-thumb-white/20">
      <!-- Populated dynamically via JS -->
    </div>
  </div>
</div>

<script>
  (function () {
    window._slideViewerState = {
      materialId: null,
      slides: [],
      currentIndex: 0,
      isOpen: false,
    };

    const modal = document.getElementById('slide-viewer-modal');
    const counterEl = document.getElementById('sv-counter');
    const formatBadgeEl = document.getElementById('sv-format-badge');
    const titleEl = document.getElementById('sv-slide-title');
    const openLinkEl = document.getElementById('sv-open-link');
    const downloadLinkEl = document.getElementById('sv-download-link');
    const imageEl = document.getElementById('sv-image');
    const fallbackEl = document.getElementById('sv-fallback');
    const fallbackTitleEl = document.getElementById('sv-fallback-title');
    const fallbackMetaEl = document.getElementById('sv-fallback-meta');
    const fallbackOpenEl = document.getElementById('sv-fallback-open');
    const fallbackDlEl = document.getElementById('sv-fallback-dl');
    const thumbnailsEl = document.getElementById('sv-thumbnails');
    const btnPrev = document.getElementById('sv-btn-prev');
    const btnNext = document.getElementById('sv-btn-next');

    const IMAGE_FORMATS = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'];

    window.initSlideViewer = function (materialId, fileResources) {
      window._slideViewerState.materialId = materialId;
      window._slideViewerState.slides = Array.isArray(fileResources) ? fileResources : [];
      renderThumbnails();
    };

    window.openSlideViewer = function (index) {
      const state = window._slideViewerState;
      if (!state.slides || state.slides.length === 0) return;
      state.currentIndex = typeof index === 'number' && index >= 0 && index < state.slides.length ? index : 0;
      state.isOpen = true;
      if (modal) {
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }
      renderCurrentSlide();
    };

    window.closeSlideViewer = function () {
      const state = window._slideViewerState;
      state.isOpen = false;
      if (modal) {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    };

    window.nextSlide = function () {
      const state = window._slideViewerState;
      if (!state.slides || state.slides.length === 0) return;
      if (state.currentIndex < state.slides.length - 1) {
        state.currentIndex++;
      } else {
        state.currentIndex = 0; // Loop back to start
      }
      renderCurrentSlide();
    };

    window.prevSlide = function () {
      const state = window._slideViewerState;
      if (!state.slides || state.slides.length === 0) return;
      if (state.currentIndex > 0) {
        state.currentIndex--;
      } else {
        state.currentIndex = state.slides.length - 1; // Loop to end
      }
      renderCurrentSlide();
    };

    window.goToSlide = function (index) {
      const state = window._slideViewerState;
      if (!state.slides || index < 0 || index >= state.slides.length) return;
      state.currentIndex = index;
      renderCurrentSlide();
    };

    window.toggleNativeFullscreen = function () {
      if (!document.fullscreenElement) {
        if (modal.requestFullscreen) modal.requestFullscreen();
        else if (modal.webkitRequestFullscreen) modal.webkitRequestFullscreen();
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      }
    };

    function renderThumbnails() {
      if (!thumbnailsEl) return;
      const state = window._slideViewerState;
      thumbnailsEl.innerHTML = '';

      state.slides.forEach(function (slide, idx) {
        const fmt = (slide.file && slide.file.format ? slide.file.format : '').toLowerCase();
        const isImg = IMAGE_FORMATS.includes(fmt);
        const openUrl = `/materials/${state.materialId}/resources/${slide._id}/open`;

        const thumb = document.createElement('button');
        thumb.type = 'button';
        thumb.className = 'sv-thumb-item relative flex-shrink-0 w-16 h-12 rounded-xl overflow-hidden border border-white/20 bg-black/40 hover:border-indigo-400 hover:scale-105 transition-all focus:outline-none flex items-center justify-center';
        thumb.setAttribute('data-index', idx);
        thumb.title = `Slide ${idx + 1}: ${slide.label || 'File'}`;

        if (isImg) {
          thumb.innerHTML = `<img src="${openUrl}" alt="" class="w-full h-full object-contain p-0.5 pointer-events-none" loading="lazy" />` +
            `<span class="absolute bottom-1 right-1 text-[9px] font-mono px-1 rounded bg-black/70 text-white font-bold">${idx + 1}</span>`;
        } else {
          thumb.innerHTML = `<div class="w-full h-full flex flex-col items-center justify-center pointer-events-none">` +
            `<span class="text-[9px] font-mono font-extrabold uppercase text-indigo-300">${fmt || 'FILE'}</span>` +
            `<span class="text-[8px] font-mono text-white/70">${idx + 1}</span>` +
            `</div>`;
        }

        thumb.onclick = function () {
          goToSlide(idx);
        };

        thumbnailsEl.appendChild(thumb);
      });
    }

    function renderCurrentSlide() {
      const state = window._slideViewerState;
      const total = state.slides.length;
      if (total === 0) return;

      const slide = state.slides[state.currentIndex];
      const fmt = (slide.file && slide.file.format ? slide.file.format : '').toLowerCase();
      const isImg = IMAGE_FORMATS.includes(fmt);
      const openUrl = `/materials/${state.materialId}/resources/${slide._id}/open`;
      const dlUrl = `/materials/${state.materialId}/resources/${slide._id}/open?download=1`;

      if (counterEl) counterEl.textContent = `${state.currentIndex + 1} / ${total}`;
      if (formatBadgeEl) formatBadgeEl.textContent = (fmt || 'FILE').toUpperCase();
      if (titleEl) titleEl.textContent = slide.label || (slide.file && slide.file.originalFilename) || 'Attachment';

      if (openLinkEl) openLinkEl.href = openUrl;
      if (downloadLinkEl) downloadLinkEl.href = dlUrl;

      if (isImg) {
        if (imageEl) {
          imageEl.src = openUrl;
          imageEl.alt = slide.label || 'Slide';
          imageEl.classList.remove('hidden');
        }
        if (fallbackEl) fallbackEl.classList.add('hidden');
      } else {
        if (imageEl) imageEl.classList.add('hidden');
        if (fallbackEl) {
          fallbackEl.classList.remove('hidden');
          if (fallbackTitleEl) fallbackTitleEl.textContent = slide.label || 'Attached Document';
          if (fallbackMetaEl) fallbackMetaEl.textContent = `${(fmt || 'FILE').toUpperCase()} file`;
          if (fallbackOpenEl) fallbackOpenEl.href = openUrl;
          if (fallbackDlEl) fallbackDlEl.href = dlUrl;
        }
      }

      // Update thumbnail highlights & scroll active into view
      const thumbBtns = thumbnailsEl ? thumbnailsEl.querySelectorAll('.sv-thumb-item') : [];
      thumbBtns.forEach(function (btn, idx) {
        if (idx === state.currentIndex) {
          btn.classList.add('ring-2', 'ring-indigo-400', 'border-indigo-400', 'bg-indigo-900/50', 'scale-105');
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          btn.classList.remove('ring-2', 'ring-indigo-400', 'border-indigo-400', 'bg-indigo-900/50', 'scale-105');
        }
      });

      // Update inline carousel in show.ejs if present
      if (typeof window.updateInlineSlideCarousel === 'function') {
        window.updateInlineSlideCarousel(state.currentIndex);
      }
    }

    window.toggleThumbnailsBar = function () {
      const bar = document.getElementById('sv-thumbnails-strip');
      const textSpan = document.getElementById('sv-thumbs-btn-text');
      if (!bar) return;
      bar.classList.toggle('hidden');
      if (textSpan) {
        textSpan.textContent = bar.classList.contains('hidden') ? 'Show' : 'Thumbnails';
      }
    };

    // Keyboard listener
    window.addEventListener('keydown', function (e) {
      const state = window._slideViewerState;
      if (!state.isOpen) return;

      if (e.key === 'ArrowRight' || e.key === ' ') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeSlideViewer();
      } else if (e.key === 'f' || e.key === 'F') {
        toggleNativeFullscreen();
      } else if (e.key === 't' || e.key === 'T') {
        toggleThumbnailsBar();
      }
    });
  })();
</script>
