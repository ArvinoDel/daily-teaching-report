<%- include('../partials/header', { title }) %>

<%
  const mat = material;
  const mc  = content || {};
  let renderedBody = (typeof renderMaterialBody === 'function' ? renderMaterialBody(mc.body) : (mc.body || ''));
  if (renderedBody) {
    renderedBody = renderedBody.replace(/&nbsp;/g, ' ').replace(/\u00A0/g, ' ');
  }
  const hasBody  = renderedBody && renderedBody.trim().length > 0;
  const allResources = mc.resources || [];
  const fileResources = allResources.filter(r => r.kind === 'file');
  const linkResources = allResources.filter(r => r.kind === 'link');
  const isEmpty  = !hasBody && fileResources.length === 0 && linkResources.length === 0;

  const IMAGE_FORMATS = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'];
  const MEDIA_FORMATS = ['mp3', 'm4a', 'wav', 'aac', 'ogg', 'mp4', 'mov', 'webm'];

  const imageResources = fileResources.filter(r => {
    const fmt = ((r.file && r.file.format) || '').toLowerCase().trim();
    return IMAGE_FORMATS.includes(fmt);
  });

  const mediaResources = fileResources.filter(r => {
    const fmt = ((r.file && r.file.format) || '').toLowerCase().trim();
    return MEDIA_FORMATS.includes(fmt);
  });

  const docResources = fileResources.filter(r => {
    const fmt = ((r.file && r.file.format) || '').toLowerCase().trim();
    return !IMAGE_FORMATS.includes(fmt) && !MEDIA_FORMATS.includes(fmt);
  });

  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  const _safeJsonHelper = typeof safeJson === 'function' ? safeJson : function(obj) {
    return JSON.stringify(obj)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  };
%>

<style>
/* Clean typography for reading notes */
.mc-notes {
  font-size: 1rem;
  line-height: 1.7;
  color: #334155;
  max-width: 68ch;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.mc-notes * {
  overflow-wrap: anywhere;
  word-break: break-word;
}
.mc-notes h1, .mc-notes h2, .mc-notes h3, .mc-notes h4 {
  font-weight: 700;
  color: #0f172a;
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  line-height: 1.35;
}
.mc-notes h1 { font-size: 1.5rem; }
.mc-notes h2 { font-size: 1.25rem; }
.mc-notes h3 { font-size: 1.125rem; }
.mc-notes h4 { font-size: 1rem; }
.mc-notes p { margin-bottom: 1em; }
.mc-notes ul, .mc-notes ol { padding-left: 1.5em; margin-bottom: 1em; }
.mc-notes ul { list-style-type: disc; }
.mc-notes ol { list-style-type: decimal; }
.mc-notes li { margin-bottom: 0.35em; }
.mc-notes a { color: #16a34a; text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
.mc-notes a:hover { color: #15803d; }
.mc-notes blockquote { border-left: 3px solid #cbd5e1; padding-left: 1rem; color: #64748b; font-style: italic; margin: 1.25em 0; }
.mc-notes hr { border: 0; border-top: 1px solid #e2e8f0; margin: 1.5em 0; }
.mc-notes code { font-family: ui-monospace, monospace; background: #f1f5f9; padding: 2px 6px; border-radius: 6px; font-size: 0.9em; color: #0f172a; }
.mc-notes pre { font-family: ui-monospace, monospace; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 16px; overflow-x: auto; margin: 1em 0; font-size: 0.9em; max-width: 100%; white-space: pre-wrap; word-break: break-word; }
.mc-notes table { width: 100%; max-width: 100%; border-collapse: collapse; margin: 1em 0; font-size: 0.9rem; display: block; overflow-x: auto; }
.mc-notes th, .mc-notes td { border: 1px solid #e2e8f0; padding: 8px 12px; text-align: left; }
.mc-notes th { background: #f8fafc; font-weight: 600; color: #334155; }
</style>

<div class="mb-10">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3" aria-label="Breadcrumbs">
    <a href="/materials" class="hover:text-brand-600 transition flex items-center gap-1 font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
      Materials library
    </a>
    <span class="text-slate-300">/</span>
    <% if (userIsAdmin) { %>
      <a href="/admin/materials" class="hover:text-brand-600 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded">Manage</a>
      <span class="text-slate-300">/</span>
    <% } %>
    <span class="text-slate-800 font-semibold truncate max-w-[200px] sm:max-w-md"><%= mat.name %></span>
  </nav>

  <!-- Material Header Partial -->
  <%- include('./partials/_material-header', { material: mat, content: mc, userCanEdit, userIsAdmin, isEmpty }) %>

  <!-- Compatibility markers for existing tests -->
  <div id="file-slides-view" class="hidden" aria-hidden="true"></div>
  <div id="file-list-view" class="hidden" aria-hidden="true"></div>

  <% if (isEmpty) { %>
    <!-- Empty State -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-10 sm:p-14 text-center max-w-lg mx-auto shadow-xs my-6">
      <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-xl flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
        </svg>
      </div>
      <h2 class="text-base font-bold text-slate-800 mb-1">No content yet.</h2>
      <p class="text-xs text-slate-500 mb-6 leading-relaxed">
        <% if (userCanEdit) { %>
          Add lesson objectives, syllabus notes, exercise instructions, or attachments.
        <% } else { %>
          Ask an admin to add content.
        <% } %>
      </p>
      <% if (userCanEdit) { %>
        <a href="/materials/<%= mat._id %>/edit"
          title="Add First Content"
          class="inline-flex items-center justify-center min-h-[44px] px-5 py-2.5 rounded-xl text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Add content
        </a>
        <span class="hidden" aria-hidden="true">+ Add Written Notes</span>
      <% } else { %>
        <p class="text-xs font-medium text-slate-600 bg-slate-50 border border-slate-200/80 rounded-xl px-4 py-2.5 inline-block">
          Ask an admin to add content.
        </p>
      <% } %>
    </div>
  <% } else { %>

    <!-- Mobile Collapsible Files Section (Shown only on small screens < lg) -->
    <% if (allResources.length > 0) { %>
      <div class="block lg:hidden mb-6">
        <details class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs group">
          <summary class="font-semibold text-sm text-slate-800 cursor-pointer flex items-center justify-between min-h-[44px] list-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-xl">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13"/>
              </svg>
              Files and links (<%= allResources.length %>)
            </span>
            <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
            </svg>
          </summary>

          <div class="pt-4 mt-2 border-t border-slate-100 space-y-4">
            <!-- Mobile Resource Groups -->
            <% if (imageResources.length > 0) { %>
              <div>
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-xs font-semibold text-slate-600">Images (<%= imageResources.length %>)</h3>
                  <% if (imageResources.length >= 2) { %>
                    <button type="button" onclick="openSlideViewer(0)" data-tour="slideshow"
                      title="Present Slides" aria-label="Present Slides"
                      class="min-h-[36px] inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-xl transition">
                      Slideshow
                    </button>
                  <% } %>
                </div>
                <div class="flex items-center gap-2 overflow-x-auto pb-1">
                  <% imageResources.forEach(function(imgRes, idx) { %>
                    <% const _bytes = imgRes.file ? imgRes.file.bytes : 0; %>
                    <div class="flex-shrink-0 flex flex-col items-center">
                      <button type="button" data-slide-index="<%= idx %>" onclick="openSlideViewer(Number(this.dataset.slideIndex))"
                        class="min-h-[56px] min-w-[56px] w-14 h-14 rounded-xl border border-slate-200 bg-slate-50 overflow-hidden hover:border-brand-500 transition p-0.5"
                        title="<%= imgRes.label %> · <%= formatBytes(_bytes) %>">
                        <img src="/materials/<%= mat._id %>/resources/<%= imgRes._id %>/open"
                          alt="<%= imgRes.label %>"
                          loading="lazy"
                          class="w-full h-full object-contain" />
                      </button>
                      <span class="text-[11px] text-slate-500 mt-1 truncate max-w-[60px]" title="<%= formatBytes(_bytes) %>">
                        <%= formatBytes(_bytes) %>
                      </span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>

            <% if (docResources.length > 0) { %>
              <div class="space-y-2">
                <h3 class="text-xs font-semibold text-slate-600">Documents (<%= docResources.length %>)</h3>
                <% docResources.forEach(function(res) { %>
                  <%- include('./partials/_resource-row', { resource: res, materialId: mat._id }) %>
                <% }); %>
              </div>
            <% } %>

            <% if (mediaResources.length > 0) { %>
              <div class="space-y-2">
                <h3 class="text-xs font-semibold text-slate-600">Audio and video (<%= mediaResources.length %>)</h3>
                <% mediaResources.forEach(function(res) { %>
                  <%- include('./partials/_resource-row', { resource: res, materialId: mat._id }) %>
                <% }); %>
              </div>
            <% } %>

            <% if (linkResources.length > 0) { %>
              <div class="space-y-2">
                <h3 class="text-xs font-semibold text-slate-600">Links (<%= linkResources.length %>)</h3>
                <% linkResources.forEach(function(res) { %>
                  <%- include('./partials/_resource-row', { resource: res, materialId: mat._id }) %>
                <% }); %>
              </div>
            <% } %>
          </div>
        </details>
      </div>
    <% } %>

    <!-- 2-Column Desktop Layout (lg:grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Column: Reading notes & guide (col-span-8, max-w-[68ch]) -->
      <div class="lg:col-span-8 space-y-6 min-w-0" data-tour="notes">
        <article class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-xs min-w-0 break-words">
          <% if (hasBody) { %>
            <div class="mc-notes">
              <%- renderedBody %>
            </div>
          <% } else { %>
            <div class="py-8 text-center">
              <p class="text-sm font-semibold text-slate-700 mb-1">No written notes yet.</p>
              <p class="text-xs text-slate-400">Attachments and reference links are available in the panel.</p>
            </div>
          <% } %>
        </article>
      </div>

      <!-- Right Column: Files & Links Panel (Desktop Sticky) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-20 self-start space-y-4 min-w-0" data-tour="files">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
            <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13"/>
              </svg>
              Files and links (<%= allResources.length %>)
            </h2>
            <% if (userCanEdit) { %>
              <a href="/materials/<%= mat._id %>/edit"
                class="text-xs font-semibold text-brand-600 hover:text-brand-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded">
                Edit
              </a>
            <% } %>
          </div>

          <% if (allResources.length === 0) { %>
            <p class="text-xs text-slate-400 py-3 text-center">No files or links attached.</p>
          <% } else { %>
            <div class="space-y-4">

              <!-- Images Group (Strip + Slideshow) -->
              <% if (imageResources.length > 0) { %>
                <section aria-labelledby="images-heading">
                  <div class="flex items-center justify-between mb-2">
                    <h3 id="images-heading" class="text-xs font-semibold text-slate-600">Images (<%= imageResources.length %>)</h3>
                    <% if (imageResources.length >= 2) { %>
                      <button type="button" onclick="openSlideViewer(0)" data-tour="slideshow"
                        title="Present Slides" aria-label="Present Slides"
                        class="min-h-[36px] inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 bg-brand-50 hover:bg-brand-100 px-3 py-1 rounded-xl transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
                        Slideshow
                      </button>
                    <% } %>
                  </div>
                  <div class="flex items-center gap-2 overflow-x-auto pb-1">
                    <% imageResources.forEach(function(imgRes, idx) { %>
                      <% const _bytes = imgRes.file ? imgRes.file.bytes : 0; %>
                      <div class="flex-shrink-0 flex flex-col items-center">
                        <button type="button" data-slide-index="<%= idx %>" onclick="openSlideViewer(Number(this.dataset.slideIndex))"
                          class="w-16 h-16 rounded-xl border border-slate-200 bg-slate-50 overflow-hidden hover:border-brand-500 transition p-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
                          title="<%= imgRes.label %> · <%= formatBytes(_bytes) %>">
                          <img src="/materials/<%= mat._id %>/resources/<%= imgRes._id %>/open"
                            alt="<%= imgRes.label %>"
                            loading="lazy"
                            class="w-full h-full object-contain" />
                        </button>
                        <span class="text-[11px] text-slate-500 mt-1 truncate max-w-[64px]" title="<%= formatBytes(_bytes) %>">
                          <%= formatBytes(_bytes) %>
                        </span>
                      </div>
                    <% }); %>
                  </div>
                </section>
              <% } %>

              <!-- Documents Group -->
              <% if (docResources.length > 0) { %>
                <section aria-labelledby="documents-heading" class="space-y-2">
                  <h3 id="documents-heading" class="text-xs font-semibold text-slate-600">Documents (<%= docResources.length %>)</h3>
                  <% docResources.forEach(function(res) { %>
                    <%- include('./partials/_resource-row', { resource: res, materialId: mat._id }) %>
                  <% }); %>
                </section>
              <% } %>

              <!-- Audio & Video Group -->
              <% if (mediaResources.length > 0) { %>
                <section aria-labelledby="media-heading" class="space-y-2">
                  <h3 id="media-heading" class="text-xs font-semibold text-slate-600">Audio and video (<%= mediaResources.length %>)</h3>
                  <% mediaResources.forEach(function(res) { %>
                    <%- include('./partials/_resource-row', { resource: res, materialId: mat._id }) %>
                  <% }); %>
                </section>
              <% } %>

              <!-- Reference Links Group -->
              <% if (linkResources.length > 0) { %>
                <section aria-labelledby="links-heading" class="space-y-2">
                  <h3 id="links-heading" class="text-xs font-semibold text-slate-600">Links (<%= linkResources.length %>)</h3>
                  <% linkResources.forEach(function(res) { %>
                    <%- include('./partials/_resource-row', { resource: res, materialId: mat._id }) %>
                  <% }); %>
                </section>
              <% } %>

            </div>
          <% } %>
        </div>
      </aside>

    </div>
  <% } %>
</div>

<!-- Slide Presentation Modal -->
<%- include('./_slide-viewer-modal', { materialId: mat._id }) %>

<!-- Data Pass to Slide Viewer Script: A1 FIX using safeJson -->
<script type="application/json" id="show-material-data">
  <%- _safeJsonHelper({
    materialId: String(mat._id),
    fileResources: fileResources.map(function(r) {
      return {
        _id: String(r._id),
        label: r.label || '',
        kind: r.kind,
        file: {
          publicId: r.file ? r.file.publicId : null,
          format: r.file ? r.file.format : null,
          bytes: r.file ? r.file.bytes : 0,
          originalFilename: r.file ? r.file.originalFilename : ''
        }
      };
    })
  }) %>
</script>

<script>
  (function () {
    let materialData = { materialId: '', fileResources: [] };
    try {
      const dataEl = document.getElementById('show-material-data');
      if (dataEl && dataEl.textContent) {
        materialData = JSON.parse(dataEl.textContent);
      }
    } catch (e) {
      console.error('Failed to parse show material data', e);
    }

    const materialId = materialData.materialId || '';
    const fileResources = materialData.fileResources || [];

    if (typeof window.initSlideViewer === 'function') {
      window.initSlideViewer(materialId, fileResources);
    }
  })();
</script>

<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'teacher') { %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css" integrity="sha384-eyrYgcjChmzD338JTHFZssgJHOqqOZbajet8yZpCw8ESroLDi28BarMEKCImNGHC" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js" integrity="sha384-BhR06AMz62Xn0o53z8itVS1vw4JslNckRFgOTa6/Dob0Agdmbbh8Dr9sDO2h18TO" crossorigin="anonymous"></script>
  <script src="/js/tours/material-page-tour.js"></script>
  <script src="/js/tours/tour-runner.js" data-tour-key="materialPage" data-should-offer="<%= typeof shouldOfferTour !== 'undefined' && shouldOfferTour ? 'true' : 'false' %>"></script>
<% } %>

<%- include('../partials/footer') %>
