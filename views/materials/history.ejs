<%- include('../partials/header', { title }) %>

<%
  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }
%>

<div class="mb-10 max-w-4xl mx-auto">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-slate-400 mb-3">
    <a href="/materials" class="hover:text-brand-600 transition flex items-center gap-1 font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
      Materials Library
    </a>
    <span>/</span>
    <a href="/materials/<%= material._id %>" class="hover:text-brand-600 transition truncate max-w-[200px]"><%= material.name %></a>
    <span>/</span>
    <span class="text-slate-700 font-semibold">Revision History</span>
  </nav>

  <!-- Header -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5 mb-1">
        <h1 class="text-xl font-bold text-slate-900"><%= material.name %></h1>
        <% if (material.level) { %>
          <span class="inline-flex items-center text-xs font-bold px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-100">
            <%= material.level %>
          </span>
        <% } %>
      </div>
      <p class="text-xs text-slate-500">History stores up to the latest 30 revisions. Restoring a version creates a new snapshot without rewriting past history.</p>
    </div>

    <div>
      <a href="/materials/<%= material._id %>" class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
        Back to Material
      </a>
    </div>
  </div>

  <!-- Revisions List -->
  <% if (revisions && revisions.length > 0) { %>
    <div class="space-y-4">
      <% revisions.forEach(function(rev, idx) { %>
        <%
          const isCurrent = rev.version === currentVersion;
          const revResources = Array.isArray(rev.resources) ? rev.resources : [];
          const revFiles = revResources.filter(r => r.kind === 'file');
          const revLinks = revResources.filter(r => r.kind === 'link');
          const revImages = revFiles.filter(r => ['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(((r.file && r.file.format) || '').toLowerCase()));
          const resCount = revResources.length;
          const renderedRevBody = (typeof renderMaterialBody === 'function' ? renderMaterialBody(rev.body) : (rev.body || ''));
          const hasBody = renderedRevBody && renderedRevBody.trim().length > 0;
        %>
        <div class="bg-white rounded-2xl border <%= isCurrent ? 'border-brand-300 ring-2 ring-brand-100' : 'border-slate-100' %> shadow-sm p-5 sm:p-6 transition">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex items-center px-2.5 py-1 rounded-xl text-xs font-extrabold font-mono <%= isCurrent ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-700' %>">
                v<%= rev.version %>
              </span>

              <% if (isCurrent) { %>
                <span class="text-xs font-bold text-brand-600 bg-brand-50 px-2.5 py-0.5 rounded-full">
                  Current Active Version
                </span>
              <% } %>

              <span class="text-xs text-slate-400">·</span>
              <span class="text-xs font-semibold text-slate-700">
                <%= rev.editedByName || 'User' %>
              </span>
              <span class="text-xs text-slate-400">·</span>
              <span class="text-xs text-slate-400">
                <%= new Date(rev.editedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </span>
            </div>

            <!-- Restore Action -->
            <% if (!isCurrent) { %>
              <form method="POST" action="/materials/<%= material._id %>/history/<%= rev.version %>/restore"
                onsubmit="return confirm('Restore version <%= rev.version %>? A new active version will be created with this content.');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-700 transition">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg>
                  Restore this version
                </button>
              </form>
            <% } %>
          </div>

          <!-- Note & Summary -->
          <div class="pt-3">
            <% if (rev.note) { %>
              <p class="text-xs font-medium text-slate-800 bg-slate-50 rounded-xl px-3 py-2 mb-3 inline-block">
                <span class="font-bold text-slate-500">Note:</span> <%= rev.note %>
              </p>
            <% } %>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 mb-3">
              <span><%= revFiles.length %> attached file<%= revFiles.length === 1 ? '' : 's' %></span>
              <span>·</span>
              <span><%= revLinks.length %> link<%= revLinks.length === 1 ? '' : 's' %></span>
              <span>·</span>
              <span><%= hasBody ? 'Has written guide' : 'No written guide' %></span>
            </div>

            <!-- Image Quick Thumbnails on Card -->
            <% if (revImages.length > 0) { %>
              <div class="flex items-center gap-2 mb-3 overflow-x-auto pb-1">
                <% revImages.forEach(function(imgRes) { %>
                  <a href="/materials/<%= material._id %>/resources/<%= imgRes._id %>/open" target="_blank" rel="noopener noreferrer"
                    class="flex items-center justify-center w-14 h-14 rounded-xl overflow-hidden border border-slate-200 bg-slate-50 flex-shrink-0 hover:ring-2 hover:ring-brand-500 transition shadow-xs group p-0.5"
                    title="<%= imgRes.label %>">
                    <img src="/materials/<%= material._id %>/resources/<%= imgRes._id %>/open"
                      alt="<%= imgRes.label %>"
                      loading="lazy"
                      class="w-full h-full object-contain group-hover:scale-105 transition" />
                  </a>
                <% }); %>
              </div>
            <% } %>

            <!-- Expandable Preview -->
            <details class="text-xs group" <%= isCurrent ? 'open' : '' %>>
              <summary class="font-semibold text-brand-600 hover:text-brand-700 cursor-pointer select-none inline-flex items-center gap-1.5 py-1">
                <span>View snapshot preview & attachments</span>
                <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="mt-3 p-4 sm:p-5 rounded-2xl border border-slate-100 bg-slate-50/80 space-y-4">

                <!-- Written Guide Snapshot -->
                <% if (hasBody) { %>
                  <div>
                    <h4 class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                      </svg>
                      Teaching Notes & Guide
                    </h4>
                    <div class="prose prose-xs max-w-none text-slate-700 bg-white p-4 rounded-xl border border-slate-100">
                      <%- renderedRevBody %>
                    </div>
                  </div>
                <% } %>

                <!-- Attached Files & Pictures -->
                <% if (revFiles.length > 0) { %>
                  <div>
                    <h4 class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13"/>
                      </svg>
                      Attached Files (<%= revFiles.length %>)
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <% revFiles.forEach(function(res) { %>
                        <%
                          const f = res.file || {};
                          const fmt = (f.format || '').toLowerCase();
                          const isPdf = fmt === 'pdf';
                          const isDoc = ['doc', 'docx'].includes(fmt);
                          const isSheet = ['xls', 'xlsx', 'csv'].includes(fmt);
                          const isImage = ['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(fmt);
                        %>
                        <div class="p-3 rounded-xl border border-slate-200/80 bg-white hover:border-indigo-200 transition flex flex-col gap-2">
                          <div class="flex items-start justify-between gap-2.5">
                            <div class="flex items-start gap-2 min-w-0">
                              <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5
                                <%= isPdf ? 'bg-red-100 text-red-600' : (isDoc ? 'bg-blue-100 text-blue-600' : (isSheet ? 'bg-emerald-100 text-emerald-600' : (isImage ? 'bg-purple-100 text-purple-600' : 'bg-slate-200 text-slate-600'))) %>">
                                <span class="text-[9px] font-extrabold uppercase font-mono"><%= fmt || 'FILE' %></span>
                              </div>
                              <div class="min-w-0">
                                <p class="text-xs font-bold text-slate-800 truncate" title="<%= res.label %>">
                                  <%= res.label %>
                                </p>
                                <p class="text-[10px] text-slate-400">
                                  <%= formatBytes(f.bytes) %>
                                </p>
                              </div>
                            </div>

                            <div class="flex items-center gap-1 flex-shrink-0">
                              <a href="/materials/<%= material._id %>/resources/<%= res._id %>/open"
                                target="_blank" rel="noopener noreferrer"
                                class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition"
                                title="Open full image">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
                              </a>
                              <a href="/materials/<%= material._id %>/resources/<%= res._id %>/open?download=1"
                                class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition"
                                title="Download file">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                              </a>
                            </div>
                          </div>

                          <% if (isImage) { %>
                            <div class="overflow-hidden rounded-lg border border-slate-100 bg-slate-50 mt-1">
                              <a href="/materials/<%= material._id %>/resources/<%= res._id %>/open" target="_blank" rel="noopener noreferrer" title="Click to view full image">
                                <img src="/materials/<%= material._id %>/resources/<%= res._id %>/open"
                                  alt="<%= res.label %>"
                                  loading="lazy"
                                  class="w-full h-auto max-h-56 object-contain mx-auto hover:opacity-95 transition" />
                              </a>
                            </div>
                          <% } %>
                        </div>
                      <% }); %>
                    </div>
                  </div>
                <% } %>

                <!-- Reference Links -->
                <% if (revLinks.length > 0) { %>
                  <div>
                    <h4 class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                      </svg>
                      Reference Links (<%= revLinks.length %>)
                    </h4>
                    <div class="space-y-1.5">
                      <% revLinks.forEach(function(res) { %>
                        <a href="<%= res.url %>" target="_blank" rel="noopener noreferrer"
                          class="flex items-center justify-between p-2.5 rounded-xl border border-slate-200/80 bg-white hover:border-teal-200 transition group">
                          <div class="min-w-0 pr-2">
                            <p class="text-xs font-semibold text-slate-800 group-hover:text-teal-600 transition truncate"><%= res.label %></p>
                            <p class="text-[10px] text-slate-400 font-mono truncate mt-0.5"><%= res.url %></p>
                          </div>
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-300 group-hover:text-teal-600 flex-shrink-0 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                          </svg>
                        </a>
                      <% }); %>
                    </div>
                  </div>
                <% } %>

                <!-- Empty state if neither guide nor resources -->
                <% if (!hasBody && revResources.length === 0) { %>
                  <p class="text-slate-400 italic text-center py-4">No written content or attachments in this revision snapshot.</p>
                <% } %>

              </div>
            </details>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center shadow-sm">
      <p class="text-sm font-semibold text-slate-600 mb-1">No revision history found</p>
      <p class="text-xs text-slate-400">Revisions will appear here automatically when content is saved or updated.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
