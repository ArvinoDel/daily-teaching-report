<%- include('../partials/header', { title }) %>

<%
  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }
%>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-slate-500">
    <a href="/materials" class="hover:text-brand transition flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
      Materials
    </a>
    <span class="text-slate-300">/</span>
    <a href="/materials/<%= material._id %>" class="hover:text-brand transition truncate max-w-[200px]"><%= material.name %></a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-800 font-medium">History</span>
  </nav>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-slate-200">
    <div>
      <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900"><%= material.name %></h1>
        <% if (material.level) { %>
          <span class="inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
            <%= material.level %>
          </span>
        <% } %>
      </div>
      <p class="text-xs text-slate-500">
        History stores up to 30 revisions. Restoring a version creates a new snapshot without rewriting history.
      </p>
    </div>

    <div>
      <a href="/materials/<%= material._id %>" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-lg border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-1 transition shadow-sm">
        Back to material
      </a>
    </div>
  </div>

  <!-- Main Content: Timeline on left, Preview on right -->
  <% if (revisions && revisions.length > 0) { %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left Column: Timeline list -->
      <div class="lg:col-span-5 space-y-3">
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Version timeline</h2>
        <div id="timeline-list" class="space-y-2">
          <% revisions.forEach(function(rev, idx) { %>
            <%
              const isCurrent = rev.version === currentVersion;
              const revResources = Array.isArray(rev.resources) ? rev.resources : [];
              const revFiles = revResources.filter(r => r.kind === 'file');
              const revLinks = revResources.filter(r => r.kind === 'link');
            %>
            <div class="rev-timeline-item cursor-pointer p-4 rounded-xl border transition <%= idx === 0 ? 'border-brand bg-brand/5 ring-1 ring-brand' : 'border-slate-200 bg-white hover:border-slate-300' %>"
                 data-version="<%= rev.version %>"
                 tabindex="0"
                 role="button"
                 aria-label="View version <%= rev.version %>">
              <div class="flex items-center justify-between gap-2 mb-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-slate-900">Version <%= rev.version %></span>
                  <% if (isCurrent) { %>
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">Current</span>
                  <% } %>
                </div>
                <span class="text-[11px] text-slate-400">
                  <%= new Date(rev.editedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
              </div>
              <div class="text-xs text-slate-600 mb-1">
                Edited by <%= rev.editedByName || 'User' %>
              </div>
              <div class="flex items-center gap-3 text-[11px] text-slate-400">
                <span><%= revFiles.length %> attached file<%= revFiles.length === 1 ? '' : 's' %></span>
                <span>·</span>
                <span><%= revLinks.length %> link<%= revLinks.length === 1 ? '' : 's' %></span>
              </div>
              <% if (rev.note) { %>
                <div class="mt-2 text-xs text-slate-700 bg-slate-100/70 rounded-md px-2.5 py-1.5">
                  <span class="font-medium text-slate-500">Note:</span> <%= rev.note %>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Right Column: Selected version preview -->
      <div class="lg:col-span-7">
        <% revisions.forEach(function(rev, idx) { %>
          <%
            const isCurrent = rev.version === currentVersion;
            const revResources = Array.isArray(rev.resources) ? rev.resources : [];
            const docExts = ['pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx'];
            const imageExts = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'];
            const audioExts = ['mp3', 'wav', 'ogg', 'm4a', 'aac'];
            const videoExts = ['mp4', 'webm', 'mov', 'ogv'];

            const revDocs = revResources.filter(r => r.kind === 'file' && docExts.includes(((r.file && r.file.format) || '').toLowerCase()));
            const revMedia = revResources.filter(r => r.kind === 'file' && (audioExts.includes(((r.file && r.file.format) || '').toLowerCase()) || videoExts.includes(((r.file && r.file.format) || '').toLowerCase())));
            const revImages = revResources.filter(r => r.kind === 'file' && imageExts.includes(((r.file && r.file.format) || '').toLowerCase()));
            const revOtherFiles = revResources.filter(r => r.kind === 'file' && !docExts.includes(((r.file && r.file.format) || '').toLowerCase()) && !imageExts.includes(((r.file && r.file.format) || '').toLowerCase()) && !audioExts.includes(((r.file && r.file.format) || '').toLowerCase()) && !videoExts.includes(((r.file && r.file.format) || '').toLowerCase()));
            const allDocFiles = [...revDocs, ...revOtherFiles];
            const revLinks = revResources.filter(r => r.kind === 'link');

            const renderedRevBody = (typeof renderMaterialBody === 'function' ? renderMaterialBody(rev.body) : (rev.body || ''));
            const hasBody = renderedRevBody && renderedRevBody.trim().length > 0;
          %>
          <div id="rev-preview-<%= rev.version %>" class="rev-preview-pane bg-white rounded-xl border border-slate-200 p-5 sm:p-6 space-y-6 <%= idx === 0 ? '' : 'hidden' %>">
            <!-- Top bar -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-slate-200">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-base font-bold text-slate-900">Version <%= rev.version %> snapshot</h3>
                  <% if (isCurrent) { %>
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">Current active</span>
                  <% } %>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">
                  Edited by <%= rev.editedByName || 'User' %> on <%= new Date(rev.editedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </p>
              </div>

              <% if (!isCurrent) { %>
                <form method="POST" action="/materials/<%= material._id %>/history/<%= rev.version %>/restore"
                      onsubmit="return confirm('Restore version <%= rev.version %>? This will create a new current version with this content.');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit"
                          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-lg bg-brand text-white hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-1 transition shadow-sm">
                    Restore this version
                  </button>
                </form>
              <% } %>
            </div>

            <!-- Note if present -->
            <% if (rev.note) { %>
              <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 text-xs">
                <span class="font-semibold text-slate-700">Revision note:</span>
                <span class="text-slate-600 ml-1"><%= rev.note %></span>
              </div>
            <% } %>

            <!-- Teaching notes -->
            <div>
              <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Teaching notes</h4>
              <% if (hasBody) { %>
                <div class="mc-notes text-sm text-slate-700 max-w-[68ch] leading-relaxed p-4 rounded-lg bg-slate-50/50 border border-slate-100">
                  <%- renderedRevBody %>
                </div>
              <% } else { %>
                <p class="text-xs text-slate-400 italic">No notes written in this version.</p>
              <% } %>
            </div>

            <!-- Attached resources -->
            <div class="space-y-4">
              <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Files and links (<%= revResources.length %>)</h4>

              <% if (revResources.length === 0) { %>
                <p class="text-xs text-slate-400 italic">No files or links in this version.</p>
              <% } else { %>
                <!-- Documents -->
                <% if (allDocFiles.length > 0) { %>
                  <div class="space-y-2">
                    <p class="text-xs font-medium text-slate-700">Documents</p>
                    <div class="space-y-1.5">
                      <% allDocFiles.forEach(function(res) { %>
                        <%- include('partials/_resource-row', { resource: res, materialId: material._id }) %>
                      <% }); %>
                    </div>
                  </div>
                <% } %>

                <!-- Audio and Video -->
                <% if (revMedia.length > 0) { %>
                  <div class="space-y-2">
                    <p class="text-xs font-medium text-slate-700">Audio and video</p>
                    <div class="space-y-1.5">
                      <% revMedia.forEach(function(res) { %>
                        <%- include('partials/_resource-row', { resource: res, materialId: material._id }) %>
                      <% }); %>
                    </div>
                  </div>
                <% } %>

                <!-- Images -->
                <% if (revImages.length > 0) { %>
                  <div class="space-y-2">
                    <p class="text-xs font-medium text-slate-700">Images</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <% revImages.forEach(function(imgRes) { %>
                        <% const f = imgRes.file || {}; %>
                        <div class="p-3 rounded-lg border border-slate-200 bg-white hover:border-slate-300 transition flex flex-col gap-2">
                          <div class="flex items-start justify-between gap-2.5">
                            <div class="flex items-center gap-2 min-w-0 flex-1">
                              <div class="w-8 h-8 rounded-md bg-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600">
                                <%- include('partials/_file-icon', { kind: 'file', format: f.format || 'img', className: 'w-4 h-4' }) %>
                              </div>
                              <div class="min-w-0 flex-1">
                                <p class="text-xs font-semibold text-slate-800 truncate" title="<%= imgRes.label %>"><%= imgRes.label %></p>
                                <p class="text-[11px] text-slate-400"><%= formatBytes(f.bytes) %></p>
                              </div>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                              <a href="/materials/<%= material._id %>/resources/<%= imgRes._id %>/open" target="_blank" rel="noopener noreferrer" class="p-1 rounded text-slate-400 hover:text-slate-700 transition" title="Open full image">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
                              </a>
                              <a href="/materials/<%= material._id %>/resources/<%= imgRes._id %>/open?download=1" class="p-1 rounded text-slate-400 hover:text-slate-700 transition" title="Download">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                              </a>
                            </div>
                          </div>
                          <div class="overflow-hidden rounded-md border border-slate-100 bg-slate-50 mt-1 max-h-48 flex items-center justify-center p-1">
                            <a href="/materials/<%= material._id %>/resources/<%= imgRes._id %>/open" target="_blank" rel="noopener noreferrer">
                              <img src="/materials/<%= material._id %>/resources/<%= imgRes._id %>/open" alt="<%= imgRes.label %>" loading="lazy" class="max-h-44 object-contain mx-auto" />
                            </a>
                          </div>
                        </div>
                      <% }); %>
                    </div>
                  </div>
                <% } %>

                <!-- Links -->
                <% if (revLinks.length > 0) { %>
                  <div class="space-y-2">
                    <p class="text-xs font-medium text-slate-700">Links</p>
                    <div class="space-y-1.5">
                      <% revLinks.forEach(function(res) { %>
                        <%- include('partials/_resource-row', { resource: res, materialId: material._id }) %>
                      <% }); %>
                    </div>
                  </div>
                <% } %>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } else { %>
    <div class="bg-white rounded-xl border border-slate-200 p-12 text-center">
      <p class="text-sm font-semibold text-slate-700 mb-1">No revision history yet</p>
      <p class="text-xs text-slate-500">Revisions will appear here automatically when content is saved or updated.</p>
    </div>
  <% } %>
</div>

<script>
  (function() {
    const items = document.querySelectorAll('.rev-timeline-item');
    const panes = document.querySelectorAll('.rev-preview-pane');

    function selectVersion(v) {
      items.forEach(function(el) {
        const matches = el.getAttribute('data-version') === String(v);
        if (matches) {
          el.classList.add('border-brand', 'bg-brand/5', 'ring-1', 'ring-brand');
          el.classList.remove('border-slate-200', 'bg-white');
        } else {
          el.classList.remove('border-brand', 'bg-brand/5', 'ring-1', 'ring-brand');
          el.classList.add('border-slate-200', 'bg-white');
        }
      });
      panes.forEach(function(pane) {
        if (pane.id === 'rev-preview-' + v) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });
    }

    items.forEach(function(item) {
      const v = item.getAttribute('data-version');
      item.addEventListener('click', function() { selectVersion(v); });
      item.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectVersion(v);
        }
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
