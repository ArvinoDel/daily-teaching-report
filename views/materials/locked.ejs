<%- include('../partials/header', { title }) %>

<div class="max-w-md mx-auto my-12">
  <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-xs text-center">
    <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center mx-auto mb-4 border border-amber-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
      </svg>
    </div>

    <h1 class="text-lg font-bold text-slate-800 mb-1"><%= material.name %></h1>
    <% if (material.level) { %>
      <span class="inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 mb-3">
        <%= material.level %>
      </span>
    <% } %>

    <p class="text-sm text-slate-600 mb-6 leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'This material is locked. Ask an admin to add content.' %>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5">
      <a href="/materials/<%= material._id %>"
        class="w-full sm:w-auto inline-flex items-center justify-center min-h-[44px] px-4 py-2 text-xs font-semibold rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
        View material
      </a>
      <a href="/materials"
        class="w-full sm:w-auto inline-flex items-center justify-center min-h-[44px] px-4 py-2 text-xs font-semibold rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
        Materials library
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
