<%- include('../partials/header', { title }) %>

<div class="mb-10">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Materials library</h1>
      <p class="text-slate-500 text-sm mt-0.5">Lesson notes, curriculum documents, and teaching attachments.</p>
    </div>

    <div class="flex items-center gap-2 flex-shrink-0">
      <% if (userIsAdmin) { %>
        <a href="/admin/materials"
          class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-xl text-xs font-semibold border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Manage suggestions
        </a>
      <% } %>
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'teacher') { %>
        <button type="button" id="tour-help-btn" data-tour="help"
          class="w-9 h-9 rounded-xl border border-slate-200 text-slate-500 hover:text-brand-600 hover:border-brand-200 hover:bg-brand-50 flex items-center justify-center font-bold text-sm transition focus-visible:ring-2 focus-visible:ring-brand-500"
          title="Take a tour of materials library" aria-label="Take a tour of materials library">
          ?
        </button>
      <% } %>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white rounded-2xl border border-slate-200/80 p-4 mb-5 shadow-xs">
    <form method="GET" action="/materials" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <% if (status && status !== 'all') { %>
        <input type="hidden" name="status" value="<%= status %>">
      <% } %>

      <!-- Search input -->
      <div class="relative flex-1">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z" />
        </svg>
        <input
          type="text"
          name="q"
          data-tour="search"
          value="<%= searchQuery %>"
          placeholder="Search materials by name…"
          autocomplete="off"
          class="w-full pl-10 pr-3 py-2 text-sm rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition min-h-[44px]">
      </div>

      <!-- Level filter -->
      <div class="flex items-center gap-2">
        <div class="relative min-w-[140px] flex-1 sm:flex-initial">
          <select
            name="level"
            data-tour="level"
            onchange="this.form.submit()"
            class="w-full text-xs font-semibold rounded-xl border border-slate-200 bg-slate-50/50 focus:bg-white px-3 py-2.5 appearance-none focus:outline-none focus:ring-2 focus:ring-brand-500 pr-8 text-slate-700 cursor-pointer min-h-[44px]">
            <option value="" <%= !selectedLevel ? 'selected' : '' %>>All levels</option>
            <% (availableLevels || []).forEach(function(lvl) { %>
              <option value="<%= lvl %>" <%= selectedLevel === lvl ? 'selected' : '' %>><%= lvl %></option>
            <% }); %>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-2.5 flex items-center text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
          </div>
        </div>

        <button type="submit"
          class="min-h-[44px] px-4 py-2 text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-xs transition active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Filter
        </button>

        <% if (searchQuery || selectedLevel || (status && status !== 'all')) { %>
          <a href="/materials"
            class="min-h-[44px] px-3 inline-flex items-center text-xs font-medium text-slate-500 hover:text-slate-800 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-xl">
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Segmented Control: All (n) | Has content (n) | Needs content (n) -->
  <div data-tour="status" class="inline-flex rounded-xl bg-slate-200/70 p-1 mb-5 max-w-full overflow-x-auto" role="tablist" aria-label="Material content status">
    <a href="/materials?q=<%= encodeURIComponent(searchQuery) %>&level=<%= encodeURIComponent(selectedLevel) %>&status=all"
      role="tab"
      title="All Materials"
      aria-label="All Materials"
      aria-selected="<%= (!status || status === 'all') ? 'true' : 'false' %>"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap min-h-[36px] <%= (!status || status === 'all') ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
      <span>All</span>
      <span class="text-[11px] font-mono opacity-80">(<%= countAll || 0 %>)</span>
      <span class="sr-only">All Materials</span>
    </a>
    <a href="/materials?q=<%= encodeURIComponent(searchQuery) %>&level=<%= encodeURIComponent(selectedLevel) %>&status=has_content"
      role="tab"
      title="With Content"
      aria-label="With Content"
      aria-selected="<%= (status === 'has_content') ? 'true' : 'false' %>"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap min-h-[36px] <%= (status === 'has_content') ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
      <span>Has content</span>
      <span class="text-[11px] font-mono opacity-80">(<%= countWithContent || 0 %>)</span>
      <span class="sr-only">With Content</span>
    </a>
    <a href="/materials?q=<%= encodeURIComponent(searchQuery) %>&level=<%= encodeURIComponent(selectedLevel) %>&status=no_content"
      role="tab"
      title="Needs Content"
      aria-label="Needs Content"
      aria-selected="<%= (status === 'no_content') ? 'true' : 'false' %>"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition whitespace-nowrap min-h-[36px] <%= (status === 'no_content') ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
      <span>Needs content</span>
      <span class="text-[11px] font-mono opacity-80">(<%= countNoContent || 0 %>)</span>
    </a>
  </div>

  <!-- List Rows Container -->
  <% if (materials && materials.length > 0) { %>
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden divide-y divide-slate-100">
      <% materials.forEach(function(mat) { %>
        <%
          const cInfo = (contentMap && contentMap[String(mat._id)]) || { fileCount: 0, linkCount: 0, hasNotes: false, updatedAt: mat.contentUpdatedAt };
          const fileCount = cInfo.fileCount || 0;
          const linkCount = cInfo.linkCount || 0;
          const hasNotes = Boolean(cInfo.hasNotes);
          const hasContent = Boolean(mat.hasContent);
          const updatedDate = cInfo.updatedAt || mat.contentUpdatedAt || mat.updatedAt;
        %>
        <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:bg-slate-50/70 transition group">
          <!-- Left: Name, Level, Indicators, Edited Date -->
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <h2 class="text-base font-semibold text-slate-900 group-hover:text-brand-600 transition">
                <a href="/materials/<%= mat._id %>" class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded">
                  <%= mat.name %>
                </a>
              </h2>

              <% if (mat.level) { %>
                <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700">
                  <%= mat.level %>
                </span>
              <% } %>

              <% if (!hasContent) { %>
                <span class="inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200/60" title="No Content">
                  No content
                </span>
              <% } %>
            </div>

            <!-- Indicators Row -->
            <div class="flex items-center gap-3 text-xs text-slate-500 flex-wrap">
              <% if (hasNotes) { %>
                <span class="inline-flex items-center gap-1 text-slate-600" title="Has written lesson guide">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                  </svg>
                  <span>Notes</span>
                </span>
              <% } %>

              <% if (fileCount > 0) { %>
                <span class="inline-flex items-center gap-1 text-slate-600">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13"/>
                  </svg>
                  <span><%= fileCount %> file<%= fileCount === 1 ? '' : 's' %></span>
                </span>
              <% } %>

              <% if (linkCount > 0) { %>
                <span class="inline-flex items-center gap-1 text-slate-600">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                  </svg>
                  <span><%= linkCount %> link<%= linkCount === 1 ? '' : 's' %></span>
                </span>
              <% } %>

              <% if (hasContent && updatedDate) { %>
                <span class="text-slate-400">
                  Edited <%= new Date(updatedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
              <% } else { %>
                <span class="text-slate-400">No content yet</span>
              <% } %>
            </div>
          </div>

          <!-- Right: Action Button -->
          <div class="flex items-center gap-2 flex-shrink-0 self-start sm:self-center" data-tour="row-action">
            <% if (hasContent) { %>
              <a href="/materials/<%= mat._id %>"
                class="min-h-[44px] px-4 py-2 inline-flex items-center justify-center text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                Open
              </a>
            <% } else { %>
              <a href="/materials/<%= mat._id %>/edit"
                title="+ Add Content"
                aria-label="+ Add Content"
                class="min-h-[44px] px-4 py-2 inline-flex items-center justify-center text-xs font-semibold rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
                Add content
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <nav class="mt-6 flex items-center justify-between text-xs text-slate-600" aria-label="Pagination">
        <div>
          Page <span class="font-bold text-slate-800"><%= page %></span> of <span class="font-bold text-slate-800"><%= totalPages %></span>
        </div>
        <div class="flex items-center gap-2">
          <% if (page > 1) { %>
            <a href="/materials?q=<%= encodeURIComponent(searchQuery) %>&level=<%= encodeURIComponent(selectedLevel) %>&status=<%= encodeURIComponent(status || 'all') %>&page=<%= page - 1 %>"
              class="min-h-[44px] px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 font-semibold text-slate-700 transition inline-flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
              Previous
            </a>
          <% } %>
          <% if (page < totalPages) { %>
            <a href="/materials?q=<%= encodeURIComponent(searchQuery) %>&level=<%= encodeURIComponent(selectedLevel) %>&status=<%= encodeURIComponent(status || 'all') %>&page=<%= page + 1 %>"
              class="min-h-[44px] px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 font-semibold text-slate-700 transition inline-flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
              Next
            </a>
          <% } %>
        </div>
      </nav>
    <% } %>

  <% } else { %>
    <!-- Empty State -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-10 sm:p-14 text-center max-w-lg mx-auto shadow-xs my-6">
      <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-xl flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h2 class="text-base font-bold text-slate-800 mb-1">
        <% if (searchQuery || selectedLevel) { %>
          No materials match "<%= searchQuery %>". Clear filters.
        <% } else if (status === 'no_content') { %>
          All materials have content.
        <% } else { %>
          No materials recorded yet.
        <% } %>
      </h2>
      <p class="text-xs text-slate-500 mb-6 leading-relaxed">
        <% if (searchQuery || selectedLevel) { %>
          Try searching with a different term or clearing level filters.
        <% } else { %>
          Materials are recorded when lessons and class reports are submitted.
        <% } %>
      </p>
      <% if (searchQuery || selectedLevel || (status && status !== 'all')) { %>
        <a href="/materials"
          class="min-h-[44px] inline-flex items-center justify-center px-4 py-2 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Clear filters
        </a>
      <% } else if (userIsAdmin) { %>
        <a href="/admin/materials"
          class="min-h-[44px] inline-flex items-center justify-center px-4 py-2 text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Manage suggestions
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'teacher') { %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css" integrity="sha384-eyrYgcjChmzD338JTHFZssgJHOqqOZbajet8yZpCw8ESroLDi28BarMEKCImNGHC" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js" integrity="sha384-BhR06AMz62Xn0o53z8itVS1vw4JslNckRFgOTa6/Dob0Agdmbbh8Dr9sDO2h18TO" crossorigin="anonymous"></script>
  <script src="/js/tours/materials-tour.js"></script>
  <script src="/js/tours/tour-runner.js" data-tour-key="materials" data-should-offer="<%= typeof shouldOfferTour !== 'undefined' && shouldOfferTour ? 'true' : 'false' %>"></script>
<% } %>

<%- include('../partials/footer') %>
