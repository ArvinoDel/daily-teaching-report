<%- include('../partials/header', { title }) %>

<!-- Pinned Quill 2.x from cdn.jsdelivr.net -->
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<style>
/* Quill Toolbar & Editor Styling with Clean Tokens */
.ql-toolbar.ql-snow {
  border-top-left-radius: 1rem;
  border-top-right-radius: 1rem;
  border-color: #e2e8f0;
  background-color: #ffffff;
  padding: 0.75rem 1rem;
  position: sticky;
  top: 3.5rem;
  z-index: 20;
}
.ql-container.ql-snow {
  border-bottom-left-radius: 1rem;
  border-bottom-right-radius: 1rem;
  border-color: #e2e8f0;
  font-family: inherit;
  font-size: 0.95rem;
  min-height: 380px;
  background: #ffffff;
}
.ql-editor {
  min-height: 360px;
  line-height: 1.7;
  max-width: 68ch;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.ql-editor p { margin-bottom: 0.85em; }
.ql-editor h1, .ql-editor h2, .ql-editor h3, .ql-editor h4 {
  font-weight: 700;
  margin-top: 1.25em;
  margin-bottom: 0.5em;
}

/* Notes preview styling */
.mc-notes-preview {
  font-size: 1rem;
  line-height: 1.7;
  color: #334155;
  max-width: 68ch;
  min-height: 380px;
  padding: 1.25rem;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.mc-notes-preview * {
  overflow-wrap: anywhere;
  word-break: break-word;
}
.mc-notes-preview h1, .mc-notes-preview h2, .mc-notes-preview h3, .mc-notes-preview h4 {
  font-weight: 700;
  color: #0f172a;
  margin-top: 1.25em;
  margin-bottom: 0.5em;
}
.mc-notes-preview h1 { font-size: 1.5rem; }
.mc-notes-preview h2 { font-size: 1.25rem; }
.mc-notes-preview h3 { font-size: 1.125rem; }
.mc-notes-preview p { margin-bottom: 0.85em; }
.mc-notes-preview ul, .mc-notes-preview ol { padding-left: 1.5em; margin-bottom: 0.85em; }
.mc-notes-preview ul { list-style-type: disc; }
.mc-notes-preview ol { list-style-type: decimal; }
.mc-notes-preview a { color: #16a34a; text-decoration: underline; }
.mc-notes-preview blockquote { border-left: 3px solid #cbd5e1; padding-left: 1rem; color: #64748b; font-style: italic; margin: 1em 0; }
</style>

<div class="mb-10">
  <!-- Sticky Top Bar -->
  <header class="sticky top-14 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 -mx-4 px-4 sm:-mx-6 sm:px-6 py-3 mb-6 shadow-2xs">
    <div class="max-w-6xl mx-auto flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-3 min-w-0">
        <a href="/materials/<%= material._id %>"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 transition min-h-[44px] px-2 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
          </svg>
          <span>Back to material</span>
        </a>

        <span class="w-px h-4 bg-slate-200 hidden sm:inline-block"></span>

        <h1 class="text-sm sm:text-base font-bold text-slate-900 truncate max-w-[140px] sm:max-w-xs md:max-w-md">
          <%= material.name %>
        </h1>

        <% if (material.level) { %>
          <span class="hidden sm:inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700">
            <%= material.level %>
          </span>
        <% } %>
      </div>

      <div class="flex items-center gap-2.5 flex-shrink-0">
        <span id="save-status" aria-live="polite" class="text-xs font-medium text-slate-400">All changes saved</span>

        <button type="button" id="btn-toggle-preview"
          class="min-h-[44px] px-3.5 py-2 rounded-xl text-xs font-semibold border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          Preview
        </button>

        <button id="btn-save-content" type="button"
          class="min-h-[44px] inline-flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold bg-brand-600 hover:bg-brand-700 active:scale-95 text-white shadow-xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          <svg id="save-spinner" class="hidden animate-spin -ml-1 mr-1.5 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Save changes</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Tabs (Visible only on < lg screens) -->
  <div class="flex lg:hidden mb-5 border-b border-slate-200" role="tablist" aria-label="Editor sections">
    <button type="button" id="tab-btn-notes"
      role="tab" aria-selected="true"
      class="flex-1 py-3 text-xs font-semibold border-b-2 border-brand-600 text-brand-600 min-h-[44px] transition">
      Notes
    </button>
    <button type="button" id="tab-btn-files"
      role="tab" aria-selected="false"
      class="flex-1 py-3 text-xs font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 min-h-[44px] transition">
      Files (<span id="mobile-tab-count">0</span>)
    </button>
  </div>

  <!-- Main 2-Column Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Left Column: Notes Editor & Revision Note (lg:col-span-8) -->
    <div id="col-notes" class="lg:col-span-8 space-y-4 min-w-0">
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6">
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2.5">
          Teaching notes & lesson material
        </label>

        <!-- Quill editor view -->
        <div id="quill-editor-wrap">
          <div id="quill-editor" class="bg-white"><%- (typeof renderMaterialBody === 'function' ? renderMaterialBody(content.body || '') : (content.body || '')) %></div>
        </div>

        <!-- Rendered preview view (hidden by default) -->
        <div id="quill-preview-wrap" class="hidden">
          <div id="quill-preview" class="mc-notes-preview bg-slate-50/70 border border-slate-200 rounded-2xl"></div>
        </div>

        <!-- Revision Note input -->
        <div class="mt-4 pt-4 border-t border-slate-100">
          <label for="revision-note" class="block text-xs font-semibold text-slate-700 mb-1">
            Revision note (optional)
          </label>
          <input
            type="text"
            id="revision-note"
            maxlength="200"
            placeholder="e.g. Added vocabulary section and exercises"
            class="w-full text-xs rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition min-h-[44px]" />
        </div>
      </div>
    </div>

    <!-- Right Column: Files & Links (lg:col-span-4) -->
    <div id="col-files" class="hidden lg:block lg:col-span-4 space-y-5 min-w-0">
      <div id="resources-card" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 relative">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
          <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
            Resources (<span id="resource-count">0</span>/20)
          </h2>
          <div class="flex items-center gap-2">
            <button type="button" id="btn-preview-slides" data-action="openEditorSlides"
              class="hidden inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
              title="Preview attached files as slides">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
              Slides (<span id="slide-count">0</span>)
            </button>
          </div>
        </div>

        <!-- Add Actions -->
        <div class="grid grid-cols-2 gap-2 mb-4">
          <button type="button" id="btn-show-add-file"
            class="min-h-[44px] inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Attach file
          </button>
          <button type="button" id="btn-show-add-link"
            class="min-h-[44px] inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add link
          </button>
        </div>

        <!-- Cloudinary Upload Dropzone -->
        <div id="upload-panel" class="hidden mb-4 p-4 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 hover:bg-slate-100/70 hover:border-brand-500 transition-all text-center relative overflow-hidden group cursor-pointer">
          <input type="file" id="file-input" class="hidden" multiple>

          <div id="dropzone-default-content" class="flex flex-col items-center">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-600 flex items-center justify-center mb-2 group-hover:text-brand-600 transition">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
              </svg>
            </div>
            <p class="text-xs font-bold text-slate-800 mb-0.5">Drag & drop files here</p>
            <p class="text-[11px] text-slate-500 mb-3">Allowed: <%= allowedExtensions.join(', ') %> (Max <%= maxFileMb %> MB)</p>
            <button type="button" id="btn-browse-file"
              class="min-h-[36px] px-4 py-1.5 rounded-xl text-xs font-semibold bg-white border border-slate-200 hover:border-slate-300 text-slate-700 shadow-2xs transition">
              Choose file
            </button>
          </div>

          <!-- Active Drag-Over Overlay -->
          <div id="dropzone-active-state" class="hidden pointer-events-none absolute inset-0 rounded-2xl bg-brand-500/10 backdrop-blur-[1px] border-2 border-dashed border-brand-600 flex flex-col items-center justify-center">
            <div class="w-11 h-11 rounded-2xl bg-brand-600 text-white flex items-center justify-center mb-1.5 shadow-md scale-110 transition">
              <svg class="w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
              </svg>
            </div>
            <p class="text-xs font-bold text-brand-700">Drop files to upload</p>
          </div>

          <!-- Upload progress indicator -->
          <div id="upload-progress-wrap" class="hidden mt-3 text-left">
            <div class="flex items-center justify-between text-xs text-slate-700 mb-1">
              <span id="upload-filename" class="truncate max-w-[150px]">Uploading…</span>
              <span id="upload-percent" class="font-mono">0%</span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
              <div id="upload-progress-bar" class="bg-brand-600 h-1.5 rounded-full transition-all duration-150" style="width: 0%"></div>
            </div>
          </div>

          <div id="upload-error" class="hidden mt-2 text-xs font-medium text-rose-600 text-left"></div>
        </div>

        <!-- Add Link Form -->
        <div id="link-panel" class="hidden mb-4 p-3.5 rounded-xl border border-slate-200 bg-slate-50 space-y-2.5">
          <div>
            <label for="link-url" class="block text-xs font-semibold text-slate-700 mb-1">URL (http/https)</label>
            <input type="url" id="link-url" placeholder="https://example.com/resource"
              class="w-full text-xs rounded-lg border border-slate-200 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500 min-h-[36px]">
          </div>
          <div>
            <label for="link-label" class="block text-xs font-semibold text-slate-700 mb-1">Label (optional)</label>
            <input type="text" id="link-label" placeholder="e.g. Reference video or slides"
              class="w-full text-xs rounded-lg border border-slate-200 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500 min-h-[36px]">
          </div>
          <div class="flex items-center justify-end gap-2 pt-1">
            <button type="button" id="btn-cancel-link" class="min-h-[36px] text-xs font-medium text-slate-600 hover:text-slate-800 px-3 py-1.5">Cancel</button>
            <button type="button" id="btn-submit-link" class="min-h-[36px] text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white px-4 py-1.5 rounded-lg transition">Add</button>
          </div>
          <div id="link-error" class="hidden text-xs font-medium text-rose-600"></div>
        </div>

        <!-- Resources List Container -->
        <div id="resources-container" class="space-y-2">
          <!-- Populated dynamically via JS -->
        </div>

        <!-- Empty state -->
        <div id="resources-empty" class="hidden py-8 text-center text-xs text-slate-400">
          No attachments or links added yet.
        </div>

        <!-- Admin Settings Disclosure -->
        <% if (userIsAdmin) { %>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <details class="group rounded-xl border border-slate-200/80 bg-slate-50/70 p-3.5">
              <summary class="font-semibold text-xs text-slate-700 cursor-pointer flex items-center justify-between select-none list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                  <span>Settings</span>
                </span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
              </summary>

              <div class="pt-3 mt-2 border-t border-slate-200/80 space-y-3">
                <form method="POST" action="/materials/<%= material._id %>/lock" class="flex items-center justify-between gap-2">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <span class="text-xs text-slate-600">Lock for teachers</span>
                  <button type="submit"
                    class="text-xs font-semibold px-2.5 py-1 rounded-lg border transition <%= content.locked ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50' %>">
                    <%= content.locked ? 'Locked (click to unlock)' : 'Unlocked (click to lock)' %>
                  </button>
                </form>

                <div class="flex items-center justify-between gap-2 pt-1">
                  <span class="text-xs text-slate-600">Revision history</span>
                  <a href="/materials/<%= material._id %>/history"
                    class="text-xs font-semibold text-brand-600 hover:underline">
                    View history
                  </a>
                </div>
              </div>
            </details>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>

<!-- Version Conflict Modal -->
<div id="conflict-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs" role="dialog" aria-modal="true">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200">
    <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center mb-4 border border-amber-100">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
      </svg>
    </div>
    <h3 class="text-base font-bold text-slate-900 mb-2">Edit conflict detected</h3>
    <p class="text-xs text-slate-600 leading-relaxed mb-6">
      Someone else has updated this material since you opened the editor. To prevent overwriting their updates, please copy your latest changes below before reloading.
    </p>
    <div class="flex items-center justify-end gap-2.5">
      <button type="button" id="btn-copy-content"
        class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
        Copy my text
      </button>
      <button type="button" data-action="reloadPage"
        class="min-h-[44px] px-4 py-2 rounded-xl text-xs font-bold bg-brand-600 hover:bg-brand-700 text-white transition">
        Reload page
      </button>
    </div>
  </div>
</div>

<!-- Initial Data Pass to Client Script (safeJson escaping) -->
<%
  const _safeJsonHelper = typeof safeJson === 'function' ? safeJson : function(obj) {
    return JSON.stringify(obj)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  };
%>
<script type="application/json" id="material-editor-data">
  <%- _safeJsonHelper({
    materialId: String(material._id),
    baseVersion: content.version || 1,
    resources: content.resources || [],
    maxFileMb: maxFileMb,
    allowedExtensions: allowedExtensions,
    csrfToken: csrfToken
  }) %>
</script>

<!-- Slide Presentation Modal -->
<%- include('./_slide-viewer-modal', { materialId: material._id }) %>

<!-- External Client Script -->
<script src="/js/material-editor.js?v=3.0"></script>

<%- include('../partials/footer') %>
