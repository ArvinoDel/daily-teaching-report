<%
  const _mat = material || {};
  const _mc  = content || {};
  const _userCanEdit = typeof userCanEdit !== 'undefined' ? userCanEdit : false;
  const _userIsAdmin = typeof userIsAdmin !== 'undefined' ? userIsAdmin : false;
  const _isEmpty = typeof isEmpty !== 'undefined' ? isEmpty : false;

  let _editedLine = 'Version ' + (_mc.version || 1);
  if (_mc.updatedByName && _mc.updatedAt) {
    const _d = new Date(_mc.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    _editedLine = 'Edited by ' + _mc.updatedByName + ' on ' + _d + ', version ' + (_mc.version || 1);
  } else if (_mc.updatedAt) {
    const _d = new Date(_mc.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    _editedLine = 'Edited on ' + _d + ', version ' + (_mc.version || 1);
  } else if (_mat.createdAt) {
    const _d = new Date(_mat.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    _editedLine = 'Created on ' + _d + ', version 1';
  }
%>

<header class="bg-white rounded-2xl border border-slate-200/80 p-5 sm:p-6 mb-6 shadow-xs">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 flex-wrap mb-1.5">
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight truncate max-w-full">
          <%= _mat.name %>
        </h1>
        <% if (_mat.level) { %>
          <span class="inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
            <%= _mat.level %>
          </span>
        <% } %>
        <% if (_mc.locked) { %>
          <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200/70" title="Editing is restricted to admins">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
            Locked
          </span>
        <% } %>
      </div>

      <p class="text-xs text-slate-500">
        <%= _editedLine %>
      </p>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 flex-shrink-0 self-start">
      <% if (_userCanEdit) { %>
        <a href="/materials/<%= _mat._id %>/edit"
          data-tour="edit"
          title="<%= _isEmpty ? 'Add First Content' : 'Edit content' %>"
          class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-xl text-xs font-semibold border border-slate-300 hover:border-slate-400 bg-white hover:bg-slate-50 text-slate-700 shadow-2xs transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
          <%= _isEmpty ? 'Add content' : 'Edit content' %>
        </a>
      <% } %>

      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'teacher') { %>
        <button type="button" id="tour-help-btn" data-tour="help"
          class="w-9 h-9 rounded-xl border border-slate-200 text-slate-500 hover:text-brand-600 hover:border-brand-200 hover:bg-brand-50 flex items-center justify-center font-bold text-sm transition focus-visible:ring-2 focus-visible:ring-brand-500"
          title="Take a tour of the material page" aria-label="Take a tour of the material page">
          ?
        </button>
      <% } %>

      <% if (_userIsAdmin) { %>
        <!-- Admin More Menu -->
        <div class="relative" id="admin-more-wrap">
          <button type="button" id="admin-more-btn"
            aria-haspopup="true" aria-expanded="false"
            class="inline-flex items-center justify-center min-h-[44px] px-3 py-2 rounded-xl text-xs font-semibold border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-600 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
            title="More actions">
            <span>More</span>
            <svg class="w-3.5 h-3.5 ml-1 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <div id="admin-more-menu"
            class="hidden absolute right-0 mt-1 w-44 rounded-xl bg-white border border-slate-200/90 shadow-lg py-1 z-30 text-xs text-slate-700">
            <a href="/materials/<%= _mat._id %>/history"
              class="flex items-center gap-2 px-3.5 py-2.5 hover:bg-slate-50 transition">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <span>History</span>
            </a>

            <form method="POST" action="/materials/<%= _mat._id %>/lock" class="block border-t border-slate-100">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit"
                class="w-full text-left flex items-center gap-2 px-3.5 py-2.5 hover:bg-slate-50 transition text-slate-700">
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                <span><%= _mc.locked ? 'Unlock material' : 'Lock for teachers' %></span>
              </button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</header>

<script>
  (function () {
    const moreBtn = document.getElementById('admin-more-btn');
    const moreMenu = document.getElementById('admin-more-menu');
    if (moreBtn && moreMenu) {
      moreBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const willOpen = moreMenu.classList.contains('hidden');
        moreMenu.classList.toggle('hidden');
        moreBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });

      document.addEventListener('click', function (e) {
        if (!moreMenu.contains(e.target) && !moreBtn.contains(e.target)) {
          moreMenu.classList.add('hidden');
          moreBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
