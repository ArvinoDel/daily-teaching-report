<%
  const _res = typeof resource !== 'undefined' ? resource : (typeof res !== 'undefined' ? res : {});
  const _matId = materialId;
  const _f = _res.file || {};
  const _fmt = (_f.format || '').toLowerCase();
  const _openUrl = '/materials/' + encodeURIComponent(_matId) + '/resources/' + encodeURIComponent(_res._id) + '/open';
  const _dlUrl = _openUrl + '?download=1';

  function _formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  const _isLink = _res.kind === 'link';
  const _isAudio = ['mp3', 'm4a', 'wav', 'aac', 'ogg'].includes(_fmt);
  const _isVideo = ['mp4', 'mov', 'webm'].includes(_fmt);
%>

<% if (_isLink) { %>
  <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-slate-200/70 bg-white hover:border-slate-300 transition">
    <div class="flex items-center gap-2.5 min-w-0 flex-1">
      <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600">
        <%- include('./_file-icon', { kind: 'link', format: '', className: 'w-4 h-4' }) %>
      </div>
      <div class="min-w-0 flex-1">
        <a href="<%= _res.url %>" target="_blank" rel="noopener noreferrer"
          class="text-xs font-semibold text-slate-800 hover:text-brand-600 transition truncate block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded"
          title="<%= _res.label %>">
          <%= _res.label %>
        </a>
        <p class="text-[11px] text-slate-400 truncate mt-0.5"><%= _res.url %></p>
      </div>
    </div>

    <a href="<%= _res.url %>" target="_blank" rel="noopener noreferrer"
      class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-medium text-slate-500 hover:text-brand-600 p-2 rounded-lg hover:bg-slate-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
      title="Open link in new tab">
      <span class="sr-only">Open <%= _res.label %></span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
      </svg>
    </a>
  </div>
<% } else if (_isAudio || _isVideo) { %>
  <div class="p-3.5 rounded-xl border border-slate-200/70 bg-white space-y-2.5">
    <div class="flex items-center justify-between gap-2.5 min-w-0">
      <div class="flex items-center gap-2.5 min-w-0 flex-1">
        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600">
          <%- include('./_file-icon', { kind: 'file', format: _fmt, className: 'w-4 h-4' }) %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold text-slate-800 truncate" title="<%= _res.label %>">
            <%= _res.label %>
          </p>
          <p class="text-[11px] text-slate-400 mt-0.5">
            <%= _formatBytes(_f.bytes) %>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-1 flex-shrink-0">
        <a href="<%= _openUrl %>" target="_blank" rel="noopener noreferrer"
          class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-semibold text-slate-600 hover:text-brand-600 p-2 rounded-lg hover:bg-slate-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          title="Open in new tab">
          Open
        </a>
        <a href="<%= _dlUrl %>"
          class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-semibold text-slate-600 hover:text-brand-600 p-2 rounded-lg hover:bg-slate-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          title="Download file">
          Download
        </a>
      </div>
    </div>

    <% if (_isAudio) { %>
      <audio controls preload="metadata" class="w-full h-9 rounded-lg" style="outline:none;">
        <source src="<%= _openUrl %>" type="audio/<%= _fmt === 'mp3' ? 'mpeg' : _fmt %>">
        Your browser does not support the audio element.
      </audio>
    <% } else { %>
      <video controls preload="metadata" class="w-full rounded-lg bg-black max-h-56 object-contain">
        <source src="<%= _openUrl %>" type="video/mp4">
        Your browser does not support the video element.
      </video>
    <% } %>
  </div>
<% } else { %>
  <!-- Document / General File Row -->
  <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-slate-200/70 bg-white hover:border-slate-300 transition">
    <div class="flex items-center gap-2.5 min-w-0 flex-1">
      <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600">
        <%- include('./_file-icon', { kind: 'file', format: _fmt, className: 'w-4 h-4' }) %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold text-slate-800 truncate" title="<%= _res.label %>">
          <%= _res.label %>
        </p>
        <p class="text-[11px] text-slate-400 mt-0.5">
          <%= _formatBytes(_f.bytes) %>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-1 flex-shrink-0">
      <a href="<%= _openUrl %>" target="_blank" rel="noopener noreferrer"
        class="min-h-[44px] px-3 inline-flex items-center justify-center text-xs font-semibold text-slate-600 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Open file">
        Open
      </a>
      <a href="<%= _dlUrl %>"
        class="min-h-[44px] px-3 inline-flex items-center justify-center text-xs font-semibold text-slate-600 hover:text-brand-600 rounded-lg hover:bg-slate-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        title="Download file">
        Download
      </a>
    </div>
  </div>
<% } %>
