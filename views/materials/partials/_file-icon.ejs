<%
  const _fmt = (typeof format === 'string' ? format : '').toLowerCase().trim();
  const _kind = (typeof kind === 'string' ? kind : 'file').toLowerCase();
  const _cls = typeof className !== 'undefined' ? className : 'w-4 h-4 text-slate-500';

  const isDoc = ['doc', 'docx', 'rtf', 'txt', 'odt'].includes(_fmt);
  const isPdf = _fmt === 'pdf';
  const isSheet = ['xls', 'xlsx', 'csv', 'ods'].includes(_fmt);
  const isPpt = ['ppt', 'pptx', 'odp'].includes(_fmt);
  const isAudio = ['mp3', 'm4a', 'wav', 'aac', 'ogg'].includes(_fmt);
  const isVideo = ['mp4', 'mov', 'webm', 'mkv'].includes(_fmt);
  const isImage = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'].includes(_fmt);
%>

<% if (_kind === 'link') { %>
  <svg class="<%= _cls %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
