<%- include('../partials/header', { title: 'Notifikasi' }) %>

<!-- ── Page Header ── -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2.5">
      <h1 class="text-2xl font-bold text-slate-900 leading-tight">Notifikasi</h1>
      <% if (unreadCount > 0) { %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-100 text-brand-700 border border-brand-200">
          <%= unreadCount %> belum dibaca
        </span>
      <% } %>
    </div>
    <p class="text-slate-500 text-sm mt-0.5">Pemberitahuan terkini seputar slip gaji dan aktivitas akun Anda.</p>
  </div>

  <!-- Mark all as read button -->
  <% if (unreadCount > 0) { %>
    <form action="/notifications/mark-all-read" method="POST" class="flex-shrink-0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 active:scale-95 text-slate-700 text-xs font-semibold shadow-sm transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        Tandai Semua Dibaca
      </button>
    </form>
  <% } %>
</div>

<!-- ── Flash Message ── -->
<% if (typeof flash !== 'undefined' && flash) { %>
  <div id="notif-flash" class="mb-5 flex items-center justify-between gap-3 <%= flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-red-50 border-red-200 text-red-700' %> border px-4 py-3 rounded-xl text-sm font-medium">
    <span><%= flash.msg %></span>
    <button onclick="document.getElementById('notif-flash').remove()" class="opacity-60 hover:opacity-100 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
<% } %>

<!-- ── Filter Tabs ── -->
<div class="flex items-center gap-2 mb-5 border-b border-slate-200 pb-3">
  <a href="/notifications?filter=all"
    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition <%= currentFilter === 'all' ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
    Semua
    <span class="px-1.5 py-0.2 rounded-full text-[11px] <%= currentFilter === 'all' ? 'bg-slate-800 text-slate-200' : 'bg-slate-100 text-slate-500' %>">
      <%= total %>
    </span>
  </a>
  <a href="/notifications?filter=unread"
    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition <%= currentFilter === 'unread' ? 'bg-brand-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100' %>">
    Belum Dibaca
    <% if (unreadCount > 0) { %>
      <span class="px-1.5 py-0.2 rounded-full text-[11px] <%= currentFilter === 'unread' ? 'bg-brand-700 text-white' : 'bg-brand-100 text-brand-700 font-bold' %>">
        <%= unreadCount %>
      </span>
    <% } %>
  </a>
</div>

<!-- ── Notification Cards List ── -->
<% if (!notifications || notifications.length === 0) { %>
  <!-- Empty State -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm py-20 text-center px-4">
    <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-slate-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
      </svg>
    </div>
    <h2 class="text-base font-bold text-slate-800 mb-1">
      <%= currentFilter === 'unread' ? 'Semua notifikasi sudah dibaca' : 'Belum ada notifikasi' %>
    </h2>
    <p class="text-xs text-slate-400 max-w-sm mx-auto">
      <%= currentFilter === 'unread'
        ? 'Bagus sekali! Tidak ada notifikasi baru yang perlu diperiksa saat ini.'
        : 'Pemberitahuan seperti slip gaji baru atau informasi penting lainnya akan muncul di sini.' %>
    </p>
    <% if (currentFilter === 'unread' && total > 0) { %>
      <a href="/notifications?filter=all"
        class="inline-flex items-center gap-1.5 mt-4 text-xs font-semibold text-brand-600 hover:text-brand-700 transition">
        Lihat semua notifikasi sebelumnya &rarr;
      </a>
    <% } %>
  </div>

<% } else { %>

  <div class="space-y-3">
    <% notifications.forEach(function(item) { %>
      <%
        const isSalary = item.category === 'salary' || item.type === 'salary_published';
        const isReport = item.category === 'report';
        const isAnnouncement = item.category === 'announcement';
      %>

      <div class="group relative bg-white rounded-2xl border transition-all duration-200 p-4 sm:p-5 flex flex-col sm:flex-row items-start justify-between gap-4
        <%= !item.isRead ? 'border-brand-300 bg-brand-50/20 shadow-sm' : 'border-slate-100 hover:border-slate-200 shadow-sm' %>">

        <!-- Left: Category Icon & Content -->
        <div class="flex items-start gap-3.5 min-w-0 w-full">

          <!-- Category Icon Badge -->
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0
            <%= isSalary ? 'bg-emerald-100 text-emerald-700' : isReport ? 'bg-sky-100 text-sky-700' : isAnnouncement ? 'bg-amber-100 text-amber-700' : 'bg-brand-100 text-brand-700' %>">
            <% if (isSalary) { %>
              <!-- Salary Slip / Cash Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75" />
              </svg>
            <% } else if (isReport) { %>
              <!-- Document Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
            <% } else { %>
              <!-- Bell Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
              </svg>
            <% } %>
          </div>

          <!-- Body -->
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <h3 class="text-sm font-bold text-slate-800 <%= !item.isRead ? 'text-slate-900 font-extrabold' : '' %>">
                <%= item.title %>
              </h3>
              <% if (!item.isRead) { %>
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 ring-4 ring-emerald-100 flex-shrink-0" title="Belum dibaca"></span>
              <% } %>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
              <%= item.message %>
            </p>

            <!-- Metadata & Action link -->
            <div class="flex items-center gap-3 flex-wrap">
              <!-- Relative Timestamp -->
              <span class="inline-flex items-center gap-1 text-xs text-slate-400 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <%= item.relativeTime %>
              </span>

              <!-- Target Link Button (e.g. View Payslip) -->
              <% if (item.link) { %>
                <a href="<%= item.link %>"
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-brand-50 hover:bg-brand-100 text-brand-700 transition">
                  <% if (isSalary) { %>
                    Lihat Slip Gaji
                  <% } else { %>
                    Buka Halaman
                  <% } %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </a>
              <% } %>
            </div>
          </div>

        </div>

        <!-- Right: Actions (Mark read, Delete) -->
        <div class="flex sm:flex-col items-center gap-1 self-end sm:self-center flex-shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 w-full sm:w-auto justify-end">
          <% if (!item.isRead) { %>
            <form action="/notifications/<%= item._id %>/read" method="POST" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" title="Tandai sudah dibaca"
                class="inline-flex items-center gap-1 px-2.5 py-1 sm:p-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span class="sm:hidden">Tandai Dibaca</span>
              </button>
            </form>
          <% } %>

          <form action="/notifications/<%= item._id %>/delete" method="POST" class="inline"
            onsubmit="return confirm('Hapus notifikasi ini?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" title="Hapus notifikasi"
              class="inline-flex items-center gap-1 px-2.5 py-1 sm:p-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-red-500 hover:bg-red-50 transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
              <span class="sm:hidden">Hapus</span>
            </button>
          </form>
        </div>

      </div>
    <% }); %>
  </div>

<% } %>

<%- include('../partials/footer') %>
