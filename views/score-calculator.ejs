<%- include('./partials/header', { title: 'RP Score Calculator' }) %>

    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">RP Score Calculator</h1>
            <p class="text-slate-500 mt-1 text-sm">Calculate student scores based on the number of mistakes per topic.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left: Calculator -->
        <div class="lg:col-span-2 space-y-4">
            <div id="students-container"></div>
            <button onclick="addStudent()"
                class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-sm font-semibold text-slate-400 hover:border-brand-400 hover:text-brand-600 hover:bg-brand-50 transition flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Add Student
            </button>
        </div>

        <!-- Right: Reference Table + Legend -->
        <div class="space-y-4">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100">
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Reference Table</p>
                </div>
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
                            <th class="px-5 py-2.5 text-center">Mistakes</th>
                            <th class="px-5 py-2.5 text-center">Score</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-center font-mono text-slate-700">0</td>
                            <td class="px-5 py-3 text-center"><span
                                    class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">10</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-center font-mono text-slate-700">1 – 5</td>
                            <td class="px-5 py-3 text-center"><span
                                    class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">9</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-center font-mono text-slate-700">6 – 10</td>
                            <td class="px-5 py-3 text-center"><span
                                    class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">8</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-center font-mono text-slate-700">11 – 15</td>
                            <td class="px-5 py-3 text-center"><span
                                    class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">7</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-center font-mono text-slate-700">16 – 20</td>
                            <td class="px-5 py-3 text-center"><span
                                    class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">6</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-3 text-center font-mono text-slate-700">21 – 25</td>
                            <td class="px-5 py-3 text-center"><span
                                    class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">5</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 space-y-2">
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Grade Description</p>
                <div class="flex items-center gap-2"><span
                        class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">9.0
                        – 10.0</span><span class="text-sm text-slate-500">Excellent</span></div>
                <div class="flex items-center gap-2"><span
                        class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">7.0 –
                        8.9</span><span class="text-sm text-slate-500">Good</span></div>
                <div class="flex items-center gap-2"><span
                        class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">6.0
                        – 6.9</span><span class="text-sm text-slate-500">Fair</span></div>
                <div class="flex items-center gap-2"><span
                        class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">≤
                        5.9</span><span class="text-sm text-slate-500">Below standard</span></div>
            </div>
        </div>
    </div>

    <!-- Templates -->
    <template id="student-tpl">
        <div class="student-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
                <div
                    class="avatar w-9 h-9 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 text-sm font-bold flex-shrink-0">
                    ?</div>
                <input type="text" placeholder="Student's Name..."
                    class="name-input flex-1 text-sm font-semibold text-slate-800 placeholder-slate-300 bg-transparent border-none outline-none" />
                <button class="remove-student-btn text-slate-300 hover:text-red-400 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="px-6 py-4">
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Topics — How many mistakes
                </p>
                <div class="topics-list flex flex-wrap gap-2 mb-4"></div>
                <button
                    class="add-topic-btn inline-flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-brand-600 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Add Topic
                </button>
            </div>
            <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4">
                <span class="calc-string font-mono text-xs text-slate-400 flex-1 truncate">—</span>
                <div class="flex items-center gap-2">
                    <span class="final-score text-2xl font-bold text-slate-900">—</span>
                    <span class="grade-badge text-xs font-semibold px-2.5 py-1 rounded-full hidden"></span>
                </div>
            </div>
        </div>
    </template>

    <template id="topic-tpl">
        <div class="topic-pill flex items-center gap-1.5 bg-slate-100 rounded-xl px-3 py-2">
            <span class="topic-label text-xs text-slate-400 font-semibold"></span>
            <input type="number" min="0" max="99" placeholder="0"
                class="topic-input w-10 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
            <span class="topic-score text-xs font-semibold text-brand-600 w-8 text-center"></span>
            <button class="remove-topic-btn text-slate-300 hover:text-red-400 transition ml-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </template>

    <script>
        function mistakesToScore(m) {
            if (m === 0) return 10;
            if (m <= 5) return 9;
            if (m <= 10) return 8;
            if (m <= 15) return 7;
            if (m <= 20) return 6;
            if (m <= 25) return 5;
            return 4;
        }

        function gradeInfo(avg) {
            if (avg >= 9) return { label: 'Excellent', cls: 'bg-emerald-100 text-emerald-700' };
            if (avg >= 7) return { label: 'Good', cls: 'bg-sky-100 text-sky-700' };
            if (avg >= 6) return { label: 'Fair', cls: 'bg-amber-100 text-amber-700' };
            return { label: 'Below', cls: 'bg-red-100 text-red-600' };
        }

        function addTopic(card) {
            const pill = document.getElementById('topic-tpl').content.cloneNode(true).querySelector('.topic-pill');
            const list = card.querySelector('.topics-list');

            function relabel() {
                list.querySelectorAll('.topic-label').forEach((el, i) => el.textContent = 'T' + (i + 1));
            }

            pill.querySelector('.remove-topic-btn').addEventListener('click', () => {
                pill.remove(); relabel(); recalc(card);
            });

            const input = pill.querySelector('.topic-input');
            const scoreSpan = pill.querySelector('.topic-score');
            input.addEventListener('input', () => {
                const v = input.value.trim();
                scoreSpan.textContent = v !== '' && !isNaN(+v) ? '→ ' + mistakesToScore(+v) : '';
                recalc(card);
            });

            list.appendChild(pill);
            relabel();
        }

        function recalc(card) {
            const scores = [], mistakes = [];
            card.querySelectorAll('.topic-input').forEach(inp => {
                const v = inp.value.trim();
                if (v !== '' && !isNaN(+v)) { mistakes.push(+v); scores.push(mistakesToScore(+v)); }
            });

            const calcEl = card.querySelector('.calc-string');
            const scoreEl = card.querySelector('.final-score');
            const badgeEl = card.querySelector('.grade-badge');

            if (!scores.length) {
                calcEl.textContent = '—'; scoreEl.textContent = '—';
                badgeEl.classList.add('hidden'); return;
            }

            const sum = scores.reduce((a, b) => a + b, 0);
            const avg = sum / scores.length;
            const rounded = Math.round(avg * 10) / 10;

            calcEl.textContent = scores.length === 1
                ? mistakes[0] + ' mistakes → ' + scores[0].toFixed(1)
                : mistakes.join(' + ') + ' = ' + scores.map(s => s.toFixed(1)).join(' + ') + ' = ' + sum + '/' + scores.length + ' = ' + rounded.toFixed(1);

            scoreEl.textContent = rounded.toFixed(1);
            const { label, cls } = gradeInfo(rounded);
            badgeEl.textContent = label;
            badgeEl.className = 'grade-badge text-xs font-semibold px-2.5 py-1 rounded-full ' + cls;
            badgeEl.classList.remove('hidden');
        }

        function addStudent() {
            const card = document.getElementById('student-tpl').content.cloneNode(true).querySelector('.student-card');
            const avatar = card.querySelector('.avatar');
            const nameInput = card.querySelector('.name-input');

            nameInput.addEventListener('input', () => {
                avatar.textContent = nameInput.value.trim() ? nameInput.value.trim()[0].toUpperCase() : '?';
            });
            card.querySelector('.remove-student-btn').addEventListener('click', () => card.remove());
            card.querySelector('.add-topic-btn').addEventListener('click', () => addTopic(card));

            document.getElementById('students-container').appendChild(card);
            addTopic(card);
            addTopic(card);
            nameInput.focus();
        }

        addStudent();
    </script>

    <%- include('./partials/footer') %>