<%- include('./partials/header', { title: 'RP Score Calculator' }) %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Calculator</h1>
  <p class="text-slate-500 mt-1 text-sm">RP Score · General Score · IELTS Band</p>
</div>

<!-- ── Segmented Tab Control ─────────────────────────────────── -->
<div class="inline-flex items-center gap-1 bg-slate-100 rounded-xl p-1 mb-8">

  <button onclick="switchTab('rp')" id="tab-rp"
    class="tab-btn bg-white shadow-sm text-slate-800 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>
    </svg>
    RP Score
  </button>

  <button onclick="switchTab('general')" id="tab-general"
    class="tab-btn text-slate-500 hover:text-slate-700 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm2.498-2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm2.504-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm.75-5.25h.008v.008h-.008v-.008Zm-7.5 0h.008v.008H8.25v-.008ZM12 6v.008M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Z" />
    </svg>
    General Score
  </button>

  <button onclick="switchTab('ielts')" id="tab-ielts"
    class="tab-btn text-slate-500 hover:text-slate-700 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-1.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
    </svg>
    IELTS Band
  </button>

</div>


<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Panel: RP Score                                            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div id="panel-rp" class="panel">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-4">
      <div id="rp-students-container"></div>
      <button onclick="addRpStudent()"
        class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-sm font-semibold text-slate-400 hover:border-brand-400 hover:text-brand-600 hover:bg-brand-50 transition flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Student
      </button>
    </div>

    <div class="space-y-4">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Reference Table</p>
        </div>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-5 py-2.5 text-center">Mistakes</th>
              <th class="px-5 py-2.5 text-center">Score</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <tr class="hover:bg-slate-50"><td class="px-5 py-3 text-center font-mono text-slate-700">0</td><td class="px-5 py-3 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">10</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-5 py-3 text-center font-mono text-slate-700">1 – 5</td><td class="px-5 py-3 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">9</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-5 py-3 text-center font-mono text-slate-700">6 – 10</td><td class="px-5 py-3 text-center"><span class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">8</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-5 py-3 text-center font-mono text-slate-700">11 – 15</td><td class="px-5 py-3 text-center"><span class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">7</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-5 py-3 text-center font-mono text-slate-700">16 – 20</td><td class="px-5 py-3 text-center"><span class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">6</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-5 py-3 text-center font-mono text-slate-700">21 – 25</td><td class="px-5 py-3 text-center"><span class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">5</span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 space-y-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Grade</p>
        <div class="flex items-center gap-2"><span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">9.0 – 10</span><span class="text-sm text-slate-500">Excellent</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">7.0 – 8.9</span><span class="text-sm text-slate-500">Good</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">6.0 – 6.9</span><span class="text-sm text-slate-500">Fair</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">≤ 5.9</span><span class="text-sm text-slate-500">Below standard</span></div>
      </div>
    </div>

  </div>
</div>


<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Panel: General Score                                       -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div id="panel-general" class="panel hidden">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-4">
      <div id="gen-students-container"></div>
      <button onclick="addGenStudent()"
        class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-sm font-semibold text-slate-400 hover:border-purple-400 hover:text-purple-600 hover:bg-purple-50 transition flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Student
      </button>
    </div>

    <div class="space-y-4">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">How it works</p>
        <p class="text-sm text-slate-600">Enter <span class="font-semibold">correct answers</span> and <span class="font-semibold">total questions</span> per topic.</p>
        <div class="mt-3 bg-slate-50 rounded-xl px-4 py-3 font-mono text-xs text-slate-500 text-center">
          (correct ÷ total) × 10 = score
        </div>
        <p class="text-xs text-slate-400 mt-3">Example: 20 / 25 → <span class="font-bold text-purple-600">8.0</span></p>
        <p class="text-xs text-slate-400 mt-1">Multiple topics → averaged.</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 space-y-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Grade</p>
        <div class="flex items-center gap-2"><span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">9.0 – 10</span><span class="text-sm text-slate-500">Excellent</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">7.0 – 8.9</span><span class="text-sm text-slate-500">Good</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">6.0 – 6.9</span><span class="text-sm text-slate-500">Fair</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">≤ 5.9</span><span class="text-sm text-slate-500">Below standard</span></div>
      </div>
    </div>

  </div>
</div>


<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Panel: IELTS Band                                          -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div id="panel-ielts" class="panel hidden">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-4">
      <div id="ielts-students-container"></div>
      <button onclick="addIeltsStudent()"
        class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-sm font-semibold text-slate-400 hover:border-sky-400 hover:text-sky-600 hover:bg-sky-50 transition flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Student
      </button>
    </div>

    <div class="space-y-4">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Band Score Table</p>
          <p class="text-xs text-slate-400 mt-0.5">Correct answers out of 40</p>
        </div>
        <table class="w-full">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-4 py-2.5 text-center">Correct</th>
              <th class="px-4 py-2.5 text-center">Band</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50 text-xs">
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">40</td><td class="px-4 py-2 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full">9.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">39</td><td class="px-4 py-2 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full">8.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">37–38</td><td class="px-4 py-2 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full">8.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">36</td><td class="px-4 py-2 text-center"><span class="inline-block bg-sky-100 text-sky-700 font-bold px-2 py-0.5 rounded-full">7.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">34–35</td><td class="px-4 py-2 text-center"><span class="inline-block bg-sky-100 text-sky-700 font-bold px-2 py-0.5 rounded-full">7.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">32–33</td><td class="px-4 py-2 text-center"><span class="inline-block bg-sky-100 text-sky-700 font-bold px-2 py-0.5 rounded-full">6.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">30–31</td><td class="px-4 py-2 text-center"><span class="inline-block bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">6.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">27–29</td><td class="px-4 py-2 text-center"><span class="inline-block bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">5.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">23–26</td><td class="px-4 py-2 text-center"><span class="inline-block bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">5.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">19–22</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">4.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">15–18</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">4.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">12–14</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">3.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">9–11</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">3.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">6–8</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">2.5</span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 space-y-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Band Level</p>
        <div class="flex items-center gap-2"><span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">8.0 – 9.0</span><span class="text-sm text-slate-500">Expert</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">6.5 – 7.5</span><span class="text-sm text-slate-500">Good User</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">5.0 – 6.0</span><span class="text-sm text-slate-500">Modest</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">≤ 4.5</span><span class="text-sm text-slate-500">Limited</span></div>
      </div>
    </div>

  </div>
</div>


<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Templates                                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->

<!-- RP: Student Card -->
<template id="rp-student-tpl">
  <div class="student-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
      <div class="avatar w-9 h-9 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 text-sm font-bold flex-shrink-0">?</div>
      <input type="text" placeholder="Student's Name..."
        class="name-input flex-1 text-sm font-semibold text-slate-800 placeholder-slate-300 bg-transparent border-none outline-none" />
      <button class="remove-btn text-slate-300 hover:text-red-400 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-6 py-4">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Topics — Mistakes per topic</p>
      <div class="topics-list flex flex-wrap gap-2 mb-4"></div>
      <button class="add-topic-btn inline-flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-brand-600 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Topic
      </button>
    </div>
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4">
      <span class="calc-string font-mono text-xs text-slate-400 flex-1 truncate">—</span>
      <div class="flex items-center gap-2">
        <span class="final-score text-2xl font-bold text-slate-900">—</span>
        <span class="grade-badge text-xs font-semibold px-2.5 py-1 rounded-full hidden"></span>
      </div>
    </div>
  </div>
</template>

<!-- RP: Topic Pill -->
<template id="rp-topic-tpl">
  <div class="topic-pill flex items-center gap-1.5 bg-slate-100 rounded-xl px-3 py-2">
    <span class="topic-label text-xs text-slate-400 font-semibold"></span>
    <input type="number" min="0" max="99" placeholder="0"
      class="topic-input w-10 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
    <span class="topic-score text-xs font-semibold text-brand-600 w-8 text-center"></span>
    <button class="remove-topic-btn text-slate-300 hover:text-red-400 transition ml-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>
  </div>
</template>

<!-- General: Student Card -->
<template id="gen-student-tpl">
  <div class="student-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
      <div class="avatar w-9 h-9 rounded-full bg-violet-100 flex items-center justify-center text-violet-700 text-sm font-bold flex-shrink-0">?</div>
      <input type="text" placeholder="Student's Name..."
        class="name-input flex-1 text-sm font-semibold text-slate-800 placeholder-slate-300 bg-transparent border-none outline-none" />
      <button class="remove-btn text-slate-300 hover:text-red-400 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-6 py-4">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Topics — Correct / Total</p>
      <div class="topics-list flex flex-wrap gap-2 mb-4"></div>
      <button class="add-topic-btn inline-flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-violet-600 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Topic
      </button>
    </div>
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4">
      <span class="calc-string font-mono text-xs text-slate-400 flex-1 truncate">—</span>
      <div class="flex items-center gap-2">
        <span class="final-score text-2xl font-bold text-slate-900">—</span>
        <span class="grade-badge text-xs font-semibold px-2.5 py-1 rounded-full hidden"></span>
      </div>
    </div>
  </div>
</template>

<!-- General: Topic Pill -->
<template id="gen-topic-tpl">
  <div class="topic-pill flex items-center gap-1.5 bg-slate-100 rounded-xl px-3 py-2">
    <span class="topic-label text-xs text-slate-400 font-semibold"></span>
    <input type="number" min="0" placeholder="correct"
      class="correct-input w-14 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
    <span class="text-xs text-slate-400 font-bold">/</span>
    <input type="number" min="1" placeholder="total"
      class="total-input w-14 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
    <span class="topic-score text-xs font-semibold text-violet-600 w-10 text-center"></span>
    <button class="remove-topic-btn text-slate-300 hover:text-red-400 transition ml-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>
  </div>
</template>

<!-- IELTS: Student Card -->
<template id="ielts-student-tpl">
  <div class="student-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
      <div class="avatar w-9 h-9 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 text-sm font-bold flex-shrink-0">?</div>
      <input type="text" placeholder="Student's Name..."
        class="name-input flex-1 text-sm font-semibold text-slate-800 placeholder-slate-300 bg-transparent border-none outline-none" />
      <button class="remove-btn text-slate-300 hover:text-red-400 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-6 py-4">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Sections — Correct answers (out of 40)</p>
      <div class="topics-list flex flex-wrap gap-2 mb-4"></div>
      <button class="add-topic-btn inline-flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-sky-600 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Section
      </button>
    </div>
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4">
      <span class="calc-string font-mono text-xs text-slate-400 flex-1 truncate">—</span>
      <div class="flex items-center gap-2">
        <span class="final-score text-2xl font-bold text-slate-900">—</span>
        <span class="grade-badge text-xs font-semibold px-2.5 py-1 rounded-full hidden"></span>
      </div>
    </div>
  </div>
</template>

<!-- IELTS: Section Pill -->
<template id="ielts-section-tpl">
  <div class="topic-pill flex items-center gap-1.5 bg-slate-100 rounded-xl px-3 py-2">
    <span class="topic-label text-xs text-slate-400 font-semibold"></span>
    <input type="number" min="0" max="40" placeholder="0"
      class="topic-input w-12 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
    <span class="text-xs text-slate-400">/40</span>
    <span class="topic-score text-xs font-semibold text-sky-600 w-10 text-center"></span>
    <button class="remove-topic-btn text-slate-300 hover:text-red-400 transition ml-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>
  </div>
</template>


<script>
  /* ── Tab Switching ─────────────────────────────────────────── */
  function switchTab(tab) {
    document.querySelectorAll('.panel').forEach(function(p) { p.classList.add('hidden'); });
    document.querySelectorAll('.tab-btn').forEach(function(b) {
      b.classList.remove('bg-white', 'shadow-sm', 'text-slate-800');
      b.classList.add('text-slate-500');
    });
    document.getElementById('panel-' + tab).classList.remove('hidden');
    var btn = document.getElementById('tab-' + tab);
    btn.classList.add('bg-white', 'shadow-sm', 'text-slate-800');
    btn.classList.remove('text-slate-500');
  }

  /* ══════════════════════════════════════════════════════════ */
  /* RP Score                                                   */
  /* ══════════════════════════════════════════════════════════ */
  function mistakesToScore(m) {
    if (m === 0)  return 10;
    if (m <= 5)   return 9;
    if (m <= 10)  return 8;
    if (m <= 15)  return 7;
    if (m <= 20)  return 6;
    if (m <= 25)  return 5;
    return 4;
  }

  function rpGradeInfo(avg) {
    if (avg >= 9) return { label: 'Excellent', cls: 'bg-emerald-100 text-emerald-700' };
    if (avg >= 7) return { label: 'Good',      cls: 'bg-sky-100 text-sky-700' };
    if (avg >= 6) return { label: 'Fair',      cls: 'bg-amber-100 text-amber-700' };
    return              { label: 'Below',      cls: 'bg-red-100 text-red-600' };
  }

  function addRpTopic(card) {
    var pill = document.getElementById('rp-topic-tpl').content.cloneNode(true).querySelector('.topic-pill');
    var list = card.querySelector('.topics-list');

    function relabel() {
      list.querySelectorAll('.topic-label').forEach(function(el, i) { el.textContent = 'T' + (i + 1); });
    }
    pill.querySelector('.remove-topic-btn').addEventListener('click', function() {
      pill.remove(); relabel(); rpRecalc(card);
    });
    var input     = pill.querySelector('.topic-input');
    var scoreSpan = pill.querySelector('.topic-score');
    input.addEventListener('input', function() {
      var v = input.value.trim();
      scoreSpan.textContent = (v !== '' && !isNaN(+v)) ? '→ ' + mistakesToScore(+v) : '';
      rpRecalc(card);
    });
    list.appendChild(pill);
    relabel();
  }

  function rpRecalc(card) {
    var scores = [], mistakes = [];
    card.querySelectorAll('.topic-input').forEach(function(inp) {
      var v = inp.value.trim();
      if (v !== '' && !isNaN(+v)) { mistakes.push(+v); scores.push(mistakesToScore(+v)); }
    });
    var calcEl  = card.querySelector('.calc-string');
    var scoreEl = card.querySelector('.final-score');
    var badgeEl = card.querySelector('.grade-badge');
    if (!scores.length) {
      calcEl.textContent = '—'; scoreEl.textContent = '—';
      badgeEl.classList.add('hidden'); return;
    }
    var sum     = scores.reduce(function(a, b) { return a + b; }, 0);
    var avg     = sum / scores.length;
    var rounded = Math.round(avg * 10) / 10;
    calcEl.textContent = scores.length === 1
      ? mistakes[0] + ' mistakes → ' + scores[0].toFixed(1)
      : mistakes.join(' + ') + ' → ' + scores.map(function(s) { return s.toFixed(0); }).join(' + ') + ' = ' + sum + ' ÷ ' + scores.length + ' = ' + rounded.toFixed(1);
    scoreEl.textContent = rounded.toFixed(1);
    var g = rpGradeInfo(rounded);
    badgeEl.textContent = g.label;
    badgeEl.className   = 'grade-badge text-xs font-semibold px-2.5 py-1 rounded-full ' + g.cls;
    badgeEl.classList.remove('hidden');
  }

  function addRpStudent() {
    var card      = document.getElementById('rp-student-tpl').content.cloneNode(true).querySelector('.student-card');
    var avatar    = card.querySelector('.avatar');
    var nameInput = card.querySelector('.name-input');
    nameInput.addEventListener('input', function() {
      avatar.textContent = nameInput.value.trim() ? nameInput.value.trim()[0].toUpperCase() : '?';
    });
    card.querySelector('.remove-btn').addEventListener('click', function() { card.remove(); });
    card.querySelector('.add-topic-btn').addEventListener('click', function() { addRpTopic(card); });
    document.getElementById('rp-students-container').appendChild(card);
    addRpTopic(card); addRpTopic(card);
    nameInput.focus();
  }


  /* ══════════════════════════════════════════════════════════ */
  /* General Score                                              */
  /* ══════════════════════════════════════════════════════════ */
  function generalGradeInfo(score) {
    if (score >= 9) return { label: 'Excellent', cls: 'bg-emerald-100 text-emerald-700' };
    if (score >= 7) return { label: 'Good',      cls: 'bg-sky-100 text-sky-700' };
    if (score >= 6) return { label: 'Fair',      cls: 'bg-amber-100 text-amber-700' };
    return              { label: 'Below',        cls: 'bg-red-100 text-red-600' };
  }

  function addGenTopic(card) {
    var pill = document.getElementById('gen-topic-tpl').content.cloneNode(true).querySelector('.topic-pill');
    var list = card.querySelector('.topics-list');

    function relabel() {
      list.querySelectorAll('.topic-label').forEach(function(el, i) { el.textContent = 'T' + (i + 1); });
    }
    pill.querySelector('.remove-topic-btn').addEventListener('click', function() {
      pill.remove(); relabel(); genRecalc(card);
    });
    var correctInput = pill.querySelector('.correct-input');
    var totalInput   = pill.querySelector('.total-input');
    var scoreSpan    = pill.querySelector('.topic-score');
    function updateScore() {
      var c = parseFloat(correctInput.value);
      var t = parseFloat(totalInput.value);
      scoreSpan.textContent = (!isNaN(c) && !isNaN(t) && t > 0) ? '→ ' + ((c / t) * 10).toFixed(1) : '';
      genRecalc(card);
    }
    correctInput.addEventListener('input', updateScore);
    totalInput.addEventListener('input', updateScore);
    list.appendChild(pill);
    relabel();
  }

  function genRecalc(card) {
    var scores = [], parts = [];
    card.querySelectorAll('.topic-pill').forEach(function(pill) {
      var c = parseFloat(pill.querySelector('.correct-input').value);
      var t = parseFloat(pill.querySelector('.total-input').value);
      if (!isNaN(c) && !isNaN(t) && t > 0) {
        var s = (c / t) * 10;
        scores.push(s);
        parts.push(c + '/' + t + ' → ' + s.toFixed(1));
      }
    });
    var calcEl  = card.querySelector('.calc-string');
    var scoreEl = card.querySelector('.final-score');
    var badgeEl = card.querySelector('.grade-badge');
    if (!scores.length) {
      calcEl.textContent = '—'; scoreEl.textContent = '—';
      badgeEl.classList.add('hidden'); return;
    }
    var sum     = scores.reduce(function(a, b) { return a + b; }, 0);
    var avg     = sum / scores.length;
    var rounded = Math.round(avg * 10) / 10;
    calcEl.textContent = scores.length === 1 ? parts[0] : parts.join(',  ') + '  =  avg ' + rounded.toFixed(1);
    scoreEl.textContent = rounded.toFixed(1);
    var g = generalGradeInfo(rounded);
    badgeEl.textContent = g.label;
    badgeEl.className   = 'grade-badge text-xs font-semibold px-2.5 py-1 rounded-full ' + g.cls;
    badgeEl.classList.remove('hidden');
  }

  function addGenStudent() {
    var card      = document.getElementById('gen-student-tpl').content.cloneNode(true).querySelector('.student-card');
    var avatar    = card.querySelector('.avatar');
    var nameInput = card.querySelector('.name-input');
    nameInput.addEventListener('input', function() {
      avatar.textContent = nameInput.value.trim() ? nameInput.value.trim()[0].toUpperCase() : '?';
    });
    card.querySelector('.remove-btn').addEventListener('click', function() { card.remove(); });
    card.querySelector('.add-topic-btn').addEventListener('click', function() { addGenTopic(card); });
    document.getElementById('gen-students-container').appendChild(card);
    addGenTopic(card); addGenTopic(card);
    nameInput.focus();
  }


  /* ══════════════════════════════════════════════════════════ */
  /* IELTS Band                                                 */
  /* ══════════════════════════════════════════════════════════ */
  function correctAnswersToBand(n) {
    var v = Math.round(n);
    if (v >= 40) return 9.0;
    if (v >= 39) return 8.5;
    if (v >= 37) return 8.0;
    if (v >= 36) return 7.5;
    if (v >= 34) return 7.0;
    if (v >= 32) return 6.5;
    if (v >= 30) return 6.0;
    if (v >= 27) return 5.5;
    if (v >= 23) return 5.0;
    if (v >= 19) return 4.5;
    if (v >= 15) return 4.0;
    if (v >= 12) return 3.5;
    if (v >= 9)  return 3.0;
    if (v >= 6)  return 2.5;
    return null; // below 6
  }

  function ieltsBandInfo(band) {
    if (band >= 8.0) return { label: 'Expert',    cls: 'bg-emerald-100 text-emerald-700' };
    if (band >= 6.5) return { label: 'Good User', cls: 'bg-sky-100 text-sky-700' };
    if (band >= 5.0) return { label: 'Modest',    cls: 'bg-amber-100 text-amber-700' };
    return               { label: 'Limited',      cls: 'bg-red-100 text-red-600' };
  }

  function addIeltsSection(card) {
    var pill = document.getElementById('ielts-section-tpl').content.cloneNode(true).querySelector('.topic-pill');
    var list = card.querySelector('.topics-list');

    function relabel() {
      list.querySelectorAll('.topic-label').forEach(function(el, i) { el.textContent = 'S' + (i + 1); });
    }
    pill.querySelector('.remove-topic-btn').addEventListener('click', function() {
      pill.remove(); relabel(); ieltsRecalc(card);
    });
    var input     = pill.querySelector('.topic-input');
    var scoreSpan = pill.querySelector('.topic-score');
    input.addEventListener('input', function() {
      var v    = parseInt(input.value, 10);
      var band = (!isNaN(v) && v >= 0 && v <= 40) ? correctAnswersToBand(v) : null;
      scoreSpan.textContent = band !== null ? '→ ' + band.toFixed(1) : (input.value !== '' ? '→ ?' : '');
      ieltsRecalc(card);
    });
    list.appendChild(pill);
    relabel();
  }

  function ieltsRecalc(card) {
    var bands = [], parts = [];
    card.querySelectorAll('.topic-pill').forEach(function(pill) {
      var v = parseInt(pill.querySelector('.topic-input').value, 10);
      if (!isNaN(v) && v >= 0 && v <= 40) {
        var band = correctAnswersToBand(v);
        if (band !== null) { bands.push(band); parts.push(v + ' → ' + band.toFixed(1)); }
      }
    });
    var calcEl  = card.querySelector('.calc-string');
    var scoreEl = card.querySelector('.final-score');
    var badgeEl = card.querySelector('.grade-badge');
    if (!bands.length) {
      calcEl.textContent = '—'; scoreEl.textContent = '—';
      badgeEl.classList.add('hidden'); return;
    }
    var sum     = bands.reduce(function(a, b) { return a + b; }, 0);
    var avg     = sum / bands.length;
    /* IELTS official rounding: round to nearest 0.5 */
    var rounded = Math.round(avg * 2) / 2;
    calcEl.textContent  = bands.length === 1 ? parts[0] : parts.join(',  ') + '  =  band ' + rounded.toFixed(1);
    scoreEl.textContent = rounded.toFixed(1);
    var g = ieltsBandInfo(rounded);
    badgeEl.textContent = g.label;
    badgeEl.className   = 'grade-badge text-xs font-semibold px-2.5 py-1 rounded-full ' + g.cls;
    badgeEl.classList.remove('hidden');
  }

  function addIeltsStudent() {
    var card      = document.getElementById('ielts-student-tpl').content.cloneNode(true).querySelector('.student-card');
    var avatar    = card.querySelector('.avatar');
    var nameInput = card.querySelector('.name-input');
    nameInput.addEventListener('input', function() {
      avatar.textContent = nameInput.value.trim() ? nameInput.value.trim()[0].toUpperCase() : '?';
    });
    card.querySelector('.remove-btn').addEventListener('click', function() { card.remove(); });
    card.querySelector('.add-topic-btn').addEventListener('click', function() { addIeltsSection(card); });
    document.getElementById('ielts-students-container').appendChild(card);
    addIeltsSection(card); addIeltsSection(card);
    nameInput.focus();
  }


  /* ── Init ──────────────────────────────────────────────────── */
  addRpStudent();
  addGenStudent();
  addIeltsStudent();
</script>

<%- include('./partials/footer') %>
