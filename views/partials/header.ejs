<%- include('./nav/head',          { title }) %>

<body class="bg-slate-50 min-h-screen text-slate-800">

<%
  let _expStr = null;
  if (typeof currentUser !== 'undefined' && currentUser && currentUser.joinDate) {
    const _now      = new Date();
    const _jd       = new Date(currentUser.joinDate);
    const _totalMos = Math.max(0,
      (_now.getFullYear() - _jd.getFullYear()) * 12 +
      (_now.getMonth()    - _jd.getMonth())
    );
    const _yrs = Math.floor(_totalMos / 12);
    const _mos = _totalMos % 12;
    if      (_totalMos === 0) _expStr = '< 1 mo';
    else if (_yrs === 0)      _expStr = _mos + 'mo';
    else if (_mos === 0)      _expStr = _yrs + 'yr';
    else                      _expStr = _yrs + 'yr ' + _mos + 'mo';
  }

  
  const _isOnline = typeof currentUser !== 'undefined' && currentUser &&
    currentUser.lastActiveAt &&
    (Date.now() - new Date(currentUser.lastActiveAt).getTime()) < 5 * 60 * 1000;
%>

<nav class="bg-white/80 backdrop-blur-md border-b border-slate-100 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-4">

    <%- include('./nav/logo') %>
    <%- include('./nav/nav-links',         { title }) %>
    <%- include('./nav/nav-right',         { title, _expStr, _isOnline }) %>

  </div>
  <%- include('./nav/mobile-menu',         { title, _expStr }) %>
</nav>

<%- include('./nav/nav-scripts') %>

<main class="max-w-6xl mx-auto px-4 py-8">