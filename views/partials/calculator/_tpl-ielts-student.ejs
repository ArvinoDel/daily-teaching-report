<template id="ielts-student-tpl">
  <div class="student-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
      <div class="avatar w-9 h-9 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 text-sm font-bold flex-shrink-0">?</div>
      <input type="text" placeholder="Student's Name..."
        class="name-input flex-1 text-sm font-semibold text-slate-800 placeholder-slate-300 bg-transparent border-none outline-none" />
      <button type="button" class="remove-btn text-slate-300 hover:text-red-400 transition" aria-label="Remove student">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-6 py-4">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Skills — Listening & Reading (raw out of 40), Writing & Speaking (band)</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-2">
        <!-- Listening -->
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
            <span class="text-xs text-slate-500 font-semibold w-16">Listening</span>
            <input type="number" min="0" max="40" placeholder="0" data-skill="listening"
              class="skill-input listening-input w-12 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
            <span class="text-xs text-slate-400">/40</span>
            <span data-skill-display="listening" class="text-xs font-semibold text-sky-600 min-w-10 text-center ml-auto"></span>
          </div>
          <span data-below-table="listening" class="text-[11px] text-amber-600 italic px-1 hidden"></span>
        </div>

        <!-- Reading -->
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
            <span class="text-xs text-slate-500 font-semibold w-16">Reading</span>
            <input type="number" min="0" max="40" placeholder="0" data-skill="reading"
              class="skill-input reading-input w-12 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
            <span class="text-xs text-slate-400">/40</span>
            <span data-skill-display="reading" class="text-xs font-semibold text-sky-600 min-w-10 text-center ml-auto"></span>
          </div>
          <span data-below-table="reading" class="text-[11px] text-amber-600 italic px-1 hidden"></span>
        </div>

        <!-- Writing -->
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
            <span class="text-xs text-slate-500 font-semibold w-16">Writing</span>
            <input type="number" min="0" max="9" step="0.5" placeholder="band" data-skill="writing"
              class="skill-input writing-input w-14 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
            <span class="text-xs text-slate-400">band</span>
            <span data-skill-display="writing" class="text-xs font-semibold text-sky-600 min-w-10 text-center ml-auto"></span>
          </div>
        </div>

        <!-- Speaking -->
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
            <span class="text-xs text-slate-500 font-semibold w-16">Speaking</span>
            <input type="number" min="0" max="9" step="0.5" placeholder="band" data-skill="speaking"
              class="skill-input speaking-input w-14 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
            <span class="text-xs text-slate-400">band</span>
            <span data-skill-display="speaking" class="text-xs font-semibold text-sky-600 min-w-10 text-center ml-auto"></span>
          </div>
        </div>
      </div>
    </div>
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4">
      <span class="calc-string font-mono text-xs text-slate-400 flex-1 truncate">—</span>
      <div class="flex items-center gap-2">
        <span class="final-score text-2xl font-bold text-slate-900">—</span>
        <span class="grade-badge text-xs font-semibold px-2.5 py-1 rounded-full hidden"></span>
      </div>
    </div>
  </div>
</template>
