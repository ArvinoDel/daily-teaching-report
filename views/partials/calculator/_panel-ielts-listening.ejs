<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Panel: IELTS Listening                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div id="panel-ielts-listening" class="panel hidden">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-4">
      <div id="ielts-listening-students-container"></div>
      <button onclick="addIeltsListeningStudent()"
        class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-sm font-semibold text-slate-400 hover:border-teal-400 hover:text-teal-600 hover:bg-teal-50 transition flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Student
      </button>
    </div>

    <div class="space-y-4">
      <!-- Reference Table -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Listening Band Scores</p>
          <p class="text-xs text-slate-400 mt-0.5">Correct answers out of 40</p>
        </div>
        <table class="w-full">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-4 py-2.5 text-center">Correct</th>
              <th class="px-4 py-2.5 text-center">Band</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50 text-xs">
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">39 – 40</td><td class="px-4 py-2 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full">9.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">37 – 38</td><td class="px-4 py-2 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full">8.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">35 – 36</td><td class="px-4 py-2 text-center"><span class="inline-block bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full">8.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">32 – 34</td><td class="px-4 py-2 text-center"><span class="inline-block bg-sky-100 text-sky-700 font-bold px-2 py-0.5 rounded-full">7.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">30 – 31</td><td class="px-4 py-2 text-center"><span class="inline-block bg-sky-100 text-sky-700 font-bold px-2 py-0.5 rounded-full">7.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">26 – 29</td><td class="px-4 py-2 text-center"><span class="inline-block bg-sky-100 text-sky-700 font-bold px-2 py-0.5 rounded-full">6.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">23 – 25</td><td class="px-4 py-2 text-center"><span class="inline-block bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">6.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">18 – 22</td><td class="px-4 py-2 text-center"><span class="inline-block bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">5.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">16 – 17</td><td class="px-4 py-2 text-center"><span class="inline-block bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">5.0</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">13 – 15</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">4.5</span></td></tr>
            <tr class="hover:bg-slate-50"><td class="px-4 py-2 text-center font-mono text-slate-700">10 – 12</td><td class="px-4 py-2 text-center"><span class="inline-block bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded-full">4.0</span></td></tr>
          </tbody>
        </table>
      </div>

      <!-- Band Level Guide -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 space-y-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Band Level</p>
        <div class="flex items-center gap-2"><span class="inline-block bg-emerald-100 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-full">8.0 – 9.0</span><span class="text-sm text-slate-500">Expert</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-sky-100 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-full">6.5 – 7.5</span><span class="text-sm text-slate-500">Good User</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">5.0 – 6.0</span><span class="text-sm text-slate-500">Modest</span></div>
        <div class="flex items-center gap-2"><span class="inline-block bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">≤ 4.5</span><span class="text-sm text-slate-500">Limited</span></div>
      </div>
    </div>

  </div>
</div>
