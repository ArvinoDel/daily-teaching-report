<template id="toefl-itp-student-tpl">
  <div class="student-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
      <div class="avatar w-9 h-9 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 text-sm font-bold flex-shrink-0">?</div>
      <input type="text" placeholder="Student's Name..."
        class="name-input flex-1 text-sm font-semibold text-slate-800 placeholder-slate-300 bg-transparent border-none outline-none" />
      <button type="button" class="remove-btn text-slate-300 hover:text-red-400 transition" aria-label="Remove student">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="px-6 py-4">
      <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Sections (Scaled Scores)</p>
        <div class="flex items-center gap-1.5 text-xs">
          <span class="px-2 py-0.5 rounded-md bg-indigo-100 text-indigo-700 font-semibold">Scaled scores</span>
          <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-400 font-medium cursor-not-allowed opacity-75" title="No test forms loaded in tables/toefl-itp.js">Raw scores (disabled)</span>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-2">
        <!-- Listening -->
        <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
          <span class="text-xs text-slate-500 font-semibold flex-1">Listening</span>
          <input type="number" min="31" max="68" placeholder="31–68" data-toefl-section="listening"
            class="toefl-input w-16 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
        </div>

        <!-- Structure -->
        <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
          <span class="text-xs text-slate-500 font-semibold flex-1">Structure</span>
          <input type="number" min="31" max="68" placeholder="31–68" data-toefl-section="structure"
            class="toefl-input w-16 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
        </div>

        <!-- Reading -->
        <div class="flex items-center gap-2 bg-slate-100 rounded-xl px-3 py-2">
          <span class="text-xs text-slate-500 font-semibold flex-1">Reading</span>
          <input type="number" min="31" max="67" placeholder="31–67" data-toefl-section="reading"
            class="toefl-input w-16 text-sm font-bold text-slate-800 bg-transparent border-none outline-none text-center placeholder-slate-300" />
        </div>
      </div>
    </div>
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-4">
      <span class="calc-string font-mono text-xs text-slate-400 flex-1 truncate">—</span>
      <div class="flex items-center gap-2">
        <span class="final-score text-2xl font-bold text-slate-900">—</span>
        <span class="grade-badge text-xs font-semibold px-2.5 py-1 rounded-full hidden"></span>
      </div>
    </div>
  </div>
</template>

