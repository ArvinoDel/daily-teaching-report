<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Panel: TOEFL ITP                                           -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div id="panel-toefl-itp" class="panel hidden">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-4">
      <div id="toefl-itp-students-container"></div>
      <button type="button" data-add-student="toefl-itp"
        class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-sm font-semibold text-slate-400 hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50 transition flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Add Student
      </button>
    </div>

    <div class="space-y-4">
      <!-- Reference Table -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Score Structure</p>
          <span class="text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full">Goal: 550</span>
        </div>
        <table class="w-full text-xs">
          <thead>
            <tr class="text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-5 py-2.5 text-left font-semibold">Section</th>
              <th class="px-5 py-2.5 text-center font-semibold">Scaled Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50 text-slate-700">
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-2.5 font-medium">Listening Comprehension</td>
              <td class="px-5 py-2.5 text-center font-mono">31 – 68</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-2.5 font-medium">Structure & Written Expression</td>
              <td class="px-5 py-2.5 text-center font-mono">31 – 68</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-2.5 font-medium">Reading Comprehension</td>
              <td class="px-5 py-2.5 text-center font-mono">31 – 67</td>
            </tr>
            <tr class="hover:bg-slate-50 bg-slate-50/50 font-semibold text-slate-900">
              <td class="px-5 py-2.5">Total Score</td>
              <td class="px-5 py-2.5 text-center font-mono text-indigo-600">310 – 677</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- How it Works Card -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Calculation Formula</p>
        <div class="bg-slate-50 rounded-xl px-4 py-3 font-mono text-xs text-slate-600 text-center">
          Total = roundHalfUp((L + S + R) × 10 ÷ 3)
        </div>
        <p class="text-xs text-slate-500 mt-3">
          Example: 55 + 55 + 55 = 165 × 10 ÷ 3 = <span class="font-bold text-indigo-600">550</span>
        </p>
        <div class="mt-3 pt-3 border-t border-slate-100 text-xs text-slate-400">
          <span class="font-semibold text-slate-500">Center Goal:</span> 550 points. The gap to goal will be shown automatically on each student card.
        </div>
      </div>
    </div>

  </div>
</div>

