var formEl = document.getElementById('report-form');

/* Duration hint */
var durationEl = document.getElementById('duration');
if (durationEl) {
  durationEl.addEventListener('input', function() {
    var v = parseInt(this.value), h = document.getElementById('duration-hint');
    if (!h) return;
    if (!isNaN(v) && v > 0) {
      var hrs = Math.floor(v/60), min = v%60, parts = [];
      if (hrs > 0) parts.push(hrs + ' hour(s)');
      if (min > 0) parts.push(min + ' minute(s)');
      h.textContent = '= ' + parts.join(' ');
    } else { h.textContent = ''; }
  });
  // Trigger on load if value exists
  if (durationEl.value) durationEl.dispatchEvent(new Event('input'));
}

/* Char counter */
var notesEl = document.getElementById('notes');
var charCnt = document.getElementById('char-count');
if (notesEl && charCnt) {
  notesEl.addEventListener('input', function() {
    charCnt.textContent = this.value.length;
    charCnt.classList.toggle('text-red-400', this.value.length > 900);
  });
  // Trigger on load
  charCnt.textContent = notesEl.value.length;
}

/* ═══════════════════════════════════════════════════════════════
   Tag input — returns controller { reset, getTags }
   ═══════════════════════════════════════════════════════════════ */
function initTagInput({ inputId, boxId, hiddenId, countId, tagCls, allowDuplicates }) {
  var input   = document.getElementById(inputId);
  var box     = document.getElementById(boxId);
  var hidden  = document.getElementById(hiddenId);
  var countEl = document.getElementById(countId);
  if (!input || !box || !hidden || !countEl) return null;
  var tags    = hidden.value ? hidden.value.split(',').map(function(s){return s.trim();}).filter(Boolean) : [];

  function render() {
    box.innerHTML = '';
    tags.forEach(function(tag, i) {
      var pill = document.createElement('span');
      pill.className = 'inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ' + tagCls;
      pill.innerHTML = escHtml(tag) + ' <button type="button" class="ml-0.5 leading-none opacity-60 hover:opacity-100 transition text-sm" data-i="'+i+'">×</button>';
      pill.querySelector('button').addEventListener('click', function() { tags.splice(i, 1); render(); });
      box.appendChild(pill);
    });
    var unique = [];
    tags.forEach(function(t) { if (unique.indexOf(t) === -1) unique.push(t); });
    countEl.textContent = unique.length;
    hidden.value = tags.join(',');
  }
  function tryAdd() {
    var val = input.value.replace(/,/g,'').trim();
    if (val && (allowDuplicates || tags.indexOf(val) === -1)) tags.push(val);
    input.value = ''; render();
  }
  input.addEventListener('keydown', function(e) {
    if (e.key==='Enter')     { e.preventDefault(); tryAdd(); }
    else if (e.key===',')    { e.preventDefault(); tryAdd(); }
    else if (e.key==='Backspace' && input.value==='' && tags.length) { tags.pop(); render(); }
  });
  input.addEventListener('blur', function() { if (input.value.trim()) tryAdd(); });
  render();

  return {
    reset: function(newTags) { tags = newTags.slice(); render(); },
    getTags: function() { return tags.slice(); }
  };
}

var acCtrl, absentCtrl;

/* ═══════════════════════════════════════════════════════════════
   Groups Autocomplete
   ═══════════════════════════════════════════════════════════════ */
var groupsData    = JSON.parse(document.getElementById('groups-json').textContent);
var selectedGroup = null;
var studentStates = {};

var classInput    = document.getElementById('class_name');
var groupDropdown = document.getElementById('group-dropdown');
var clearBtn      = document.getElementById('btn-clear-group');
var groupHint     = document.getElementById('group-hint');
var rosterPanel   = document.getElementById('student-roster');
var manualSection = document.getElementById('manual-students-section');

function renderDropdown(groups) {
  groupDropdown.innerHTML = groups.slice(0, 8).map(function(g) {
    var tcls = g.type === 'GROUP' ? 'bg-emerald-100 text-emerald-700' : 'bg-purple-100 text-purple-700';
    var tlbl = g.type === 'GROUP' ? 'Group' : 'Private';
    return '<button type="button" onclick="selectGroup(\''+escHtml(g._id)+'\')" '+
      'class="w-full text-left px-4 py-3 hover:bg-brand-50 transition flex items-center justify-between gap-3">' +
      '<div class="flex-1 min-w-0">' +
        '<p class="text-sm font-semibold text-slate-800 truncate">' + escHtml(g.group_name) + '</p>' +
        '<div class="flex items-center gap-1.5 mt-0.5">' +
          '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full '+tcls+'">' + tlbl + '</span>' +
          (g.level ? '<span class="text-[10px] font-mono text-slate-400">'+escHtml(g.level)+'</span>' : '') +
        '</div>' +
      '</div>' +
      '<span class="text-xs text-slate-400 flex-shrink-0">'+g.students.length+' student(s)</span>' +
    '</button>';
  }).join('');
  groupDropdown.classList.remove('hidden');
}

function hideDropdown() { groupDropdown.classList.add('hidden'); }

function setGroupHintDefault() {
  groupHint.textContent = 'Type a name or select from your groups list.';
  groupHint.className = 'text-xs text-slate-400';
}
function setGroupHintSelected() {
  groupHint.innerHTML = '<span class="inline-flex items-center gap-1 text-brand-600 font-semibold">' +
    '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>' +
    'Group selected — mark students below</span>';
  groupHint.className = 'text-xs';
}

if (classInput) {
  classInput.addEventListener('focus', function() {
    if (document.getElementById('session_type_input').value === 'competition') return;
    var q = this.value.trim().toLowerCase();
    var list = q ? groupsData.filter(function(g){return g.group_name.toLowerCase().includes(q);}) : groupsData;
    if (list.length) renderDropdown(list);
  });

  classInput.addEventListener('input', function() {
    if (document.getElementById('session_type_input').value === 'competition') return;
    var q = this.value.trim().toLowerCase();
    if (selectedGroup && this.value !== selectedGroup.group_name) {
      selectedGroup = null; studentStates = {};
      hideRoster(); if (clearBtn) clearBtn.classList.add('hidden');
      setGroupHintDefault();
    }
    if (!q) { hideDropdown(); return; }
    var list = groupsData.filter(function(g){return g.group_name.toLowerCase().includes(q);});
    list.length ? renderDropdown(list) : hideDropdown();
  });

  classInput.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Tab') hideDropdown();
  });
}

/* ═══════════════════════════════════════════════════════════════
   Private Autocomplete (searches PRIVATE-type groups only)
   ═══════════════════════════════════════════════════════════════ */
var privateDropdown  = document.getElementById('private-dropdown');
var clearPrivateBtn  = document.getElementById('btn-clear-private');
var privateNameInput = document.getElementById('private_name_input');

function renderPrivateDropdown(groups) {
  if (!privateDropdown) return;
  var filtered = groups.filter(function(g) { return g.type === 'PRIVATE'; });
  if (filtered.length === 0) { privateDropdown.classList.add('hidden'); return; }
  privateDropdown.innerHTML = filtered.slice(0, 8).map(function(g) {
    return '<button type="button" onclick="selectGroup(\'' + escHtml(g._id) + '\')" ' +
      'class="w-full text-left px-4 py-3 hover:bg-purple-50 transition flex items-center justify-between gap-3">' +
      '<div class="flex-1 min-w-0">' +
        '<p class="text-sm font-semibold text-slate-800 truncate">' + escHtml(g.group_name) + '</p>' +
        '<div class="flex items-center gap-1.5 mt-0.5">' +
          '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-purple-100 text-purple-700">Private</span>' +
          (g.level ? '<span class="text-[10px] font-mono text-slate-400">' + escHtml(g.level) + '</span>' : '') +
        '</div>' +
      '</div>' +
      '<span class="text-xs text-slate-400 flex-shrink-0">' + g.students.length + ' student(s)</span>' +
    '</button>';
  }).join('');
  privateDropdown.classList.remove('hidden');
}

function hidePrivateDropdown() {
  if (privateDropdown) privateDropdown.classList.add('hidden');
}

function clearPrivateSelection() {
  selectedGroup = null; studentStates = {};
  if (privateNameInput) { privateNameInput.value = ''; privateNameInput.focus(); }
  if (clearPrivateBtn) clearPrivateBtn.classList.add('hidden');
  hidePrivateDropdown();
  hideRoster();
  if (acCtrl) acCtrl.reset([]);
  if (absentCtrl) absentCtrl.reset([]);
}

if (privateNameInput) {
  privateNameInput.addEventListener('focus', function() {
    var q = this.value.trim().toLowerCase();
    var list = q
      ? groupsData.filter(function(g) { return g.type === 'PRIVATE' && g.group_name.toLowerCase().includes(q); })
      : groupsData.filter(function(g) { return g.type === 'PRIVATE'; });
    if (list.length) renderPrivateDropdown(list);
  });

  privateNameInput.addEventListener('input', function() {
    var q = this.value.trim().toLowerCase();
    // If user edits away from a selected private group, deselect it
    if (selectedGroup && selectedGroup.type === 'PRIVATE' && this.value !== selectedGroup.group_name) {
      selectedGroup = null; studentStates = {};
      hideRoster();
      if (clearPrivateBtn) clearPrivateBtn.classList.add('hidden');
    }
    if (!q) { hidePrivateDropdown(); return; }
    var list = groupsData.filter(function(g) { return g.type === 'PRIVATE' && g.group_name.toLowerCase().includes(q); });
    list.length ? renderPrivateDropdown(list) : hidePrivateDropdown();
  });

  privateNameInput.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Tab') hidePrivateDropdown();
  });
}

document.addEventListener('click', function(e) {
  if (!e.target.closest('#group-ac-wrap')) hideDropdown();
  if (!e.target.closest('#competition-group-wrap')) {
    var cd = document.getElementById('competition-dropdown');
    if (cd) cd.classList.add('hidden');
  }
  if (!e.target.closest('#private-ac-wrap')) hidePrivateDropdown();
});

/* ═══════════════════════════════════════════════════════════════
   Group Selection (single group mode)
   ═══════════════════════════════════════════════════════════════ */
function selectGroup(id, opts) {
  selectedGroup = groupsData.find(function(g){return g._id === id;});
  if (!selectedGroup) return;

  if (classInput) classInput.value = selectedGroup.group_name;
  hideDropdown();

  setSessionType(selectedGroup.type === 'PRIVATE' ? 'private' : 'group');

  // Sync the private name input when a PRIVATE group is selected
  if (selectedGroup.type === 'PRIVATE') {
    var pvInput = document.getElementById('private_name_input');
    if (pvInput) pvInput.value = selectedGroup.group_name;
    if (clearPrivateBtn) clearPrivateBtn.classList.remove('hidden');
    hidePrivateDropdown();
  } else {
    if (clearBtn) clearBtn.classList.remove('hidden');
  }

  // Reset states
  studentStates = {};
  selectedGroup.students.forEach(function(s) { studentStates[s] = { state: null, acCount: 0 }; });

  // Pre-fill from existing report ac/absent data
  if (opts && opts.preAc) {
    var acCounts = {};
    opts.preAc.forEach(function(s) { acCounts[s] = (acCounts[s] || 0) + 1; });
    Object.keys(acCounts).forEach(function(s) {
      if (studentStates[s] !== undefined) {
        studentStates[s] = { state: 'ac', acCount: acCounts[s] };
      }
    });
  }
  if (opts && opts.preAbsent) {
    opts.preAbsent.forEach(function(s) {
      if (studentStates[s] !== undefined) studentStates[s] = { state: 'absent', acCount: 0 };
    });
  }

  var rosterNameEl = document.getElementById('roster-group-name');
  if (rosterNameEl) rosterNameEl.textContent = selectedGroup.group_name;
  renderRoster();
  if (rosterPanel) rosterPanel.classList.remove('hidden');
  if (manualSection) manualSection.classList.add('hidden');
  // clearBtn is for group mode; clearPrivateBtn is already shown above for private mode
  if (selectedGroup.type !== 'PRIVATE' && clearBtn) clearBtn.classList.remove('hidden');
  if (selectedGroup.type === 'GROUP') setGroupHintSelected();
  updateHiddenInputs();
}

function clearGroupSelection() {
  selectedGroup = null; studentStates = {};
  if (classInput) { classInput.value = ''; classInput.focus(); }
  // Also clear private input in case we were in private mode
  var pvInput = document.getElementById('private_name_input');
  if (pvInput) pvInput.value = '';
  if (clearPrivateBtn) clearPrivateBtn.classList.add('hidden');
  hideRoster();
  if (clearBtn) clearBtn.classList.add('hidden');
  if (acCtrl) acCtrl.reset([]);
  if (absentCtrl) absentCtrl.reset([]);
  setGroupHintDefault();
}

/* ═══════════════════════════════════════════════════════════════
   Competition: Multi-Group Selection
   ═══════════════════════════════════════════════════════════════ */
var competitionSelectedIds = [];
var competitionSearchInput = document.getElementById('competition-search');
var competitionDropdown    = document.getElementById('competition-dropdown');

function renderCompetitionDropdown(groups) {
  var filtered = groups.filter(function(g) {
    return competitionSelectedIds.indexOf(g._id) === -1;
  });
  if (filtered.length === 0) {
    competitionDropdown.classList.add('hidden');
    return;
  }
  competitionDropdown.innerHTML = filtered.slice(0, 8).map(function(g) {
    var tcls  = g.type === 'GROUP' ? 'bg-emerald-100 text-emerald-700' : 'bg-purple-100 text-purple-700';
    var tlbl  = g.type === 'GROUP' ? 'Group' : 'Private';
    return '<button type="button" onclick="addCompetitionGroup(\''+escHtml(g._id)+'\')" '+
      'class="w-full text-left px-4 py-3 hover:bg-orange-50 transition flex items-center justify-between gap-3">' +
      '<div class="flex-1 min-w-0">' +
        '<p class="text-sm font-semibold text-slate-800 truncate">' + escHtml(g.group_name) + '</p>' +
        '<div class="flex items-center gap-1.5 mt-0.5">' +
          '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full '+tcls+'">' + tlbl + '</span>' +
          (g.level ? '<span class="text-[10px] font-mono text-slate-400">'+escHtml(g.level)+'</span>' : '') +
        '</div>' +
      '</div>' +
      '<span class="text-xs text-slate-400 flex-shrink-0">'+g.students.length+' student(s)</span>' +
    '</button>';
  }).join('');
  competitionDropdown.classList.remove('hidden');
}

if (competitionSearchInput) {
  competitionSearchInput.addEventListener('focus', function() {
    var q = this.value.trim().toLowerCase();
    var list = q ? groupsData.filter(function(g){return g.group_name.toLowerCase().includes(q);}) : groupsData;
    if (list.length) renderCompetitionDropdown(list);
  });

  competitionSearchInput.addEventListener('input', function() {
    var q = this.value.trim().toLowerCase();
    if (!q) { competitionDropdown.classList.add('hidden'); return; }
    var list = groupsData.filter(function(g){return g.group_name.toLowerCase().includes(q);});
    list.length ? renderCompetitionDropdown(list) : competitionDropdown.classList.add('hidden');
  });

  competitionSearchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Tab') competitionDropdown.classList.add('hidden');
  });
}

function addCompetitionGroup(id) {
  if (competitionSelectedIds.indexOf(id) === -1) {
    competitionSelectedIds.push(id);
  }
  if (competitionSearchInput) competitionSearchInput.value = '';
  if (competitionDropdown) competitionDropdown.classList.add('hidden');
  renderCompetitionTags();
  renderCompetitionRoster();
}

function removeCompetitionGroup(id) {
  competitionSelectedIds = competitionSelectedIds.filter(function(x) { return x !== id; });
  renderCompetitionTags();
  renderCompetitionRoster();
}

function renderCompetitionTags() {
  var container = document.getElementById('competition-selected-tags');
  if (!container) return;
  container.innerHTML = competitionSelectedIds.map(function(id) {
    var g = groupsData.find(function(x) { return x._id === id; });
    if (!g) return '';
    return '<span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-orange-100 text-orange-700">' +
      escHtml(g.group_name) +
      ' <button type="button" class="ml-0.5 leading-none opacity-60 hover:opacity-100 transition text-sm" onclick="removeCompetitionGroup(\''+escHtml(id)+'\')">×</button>' +
    '</span>';
  }).join('');
  
  var countEl = document.getElementById('comp-group-count');
  if (countEl) countEl.textContent = competitionSelectedIds.length;

  var names = competitionSelectedIds.map(function(id) {
    var g = groupsData.find(function(x) { return x._id === id; });
    return g ? g.group_name : '';
  }).filter(Boolean);

  var hiddenClassName = document.querySelector('input[name="class_name"]');
  if (!hiddenClassName && competitionSelectedIds.length > 0) {
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'class_name'; inp.id = 'comp-class-name-hidden';
    formEl.appendChild(inp);
    hiddenClassName = inp;
  }
  if (hiddenClassName) hiddenClassName.value = names.join(', ');

  var compGroupsHidden = document.getElementById('competition_groups_hidden');
  if (compGroupsHidden) compGroupsHidden.value = names.join(',');
}

function renderCompetitionRoster() {
  if (competitionSelectedIds.length === 0) {
    hideRoster();
    return;
  }

  var allStudents = [];
  var groupLabels = [];
  competitionSelectedIds.forEach(function(id) {
    var g = groupsData.find(function(x) { return x._id === id; });
    if (g) {
      groupLabels.push(g.group_name);
      g.students.forEach(function(s) {
        if (allStudents.indexOf(s) === -1) allStudents.push(s);
      });
    }
  });

  var newStates = {};
  allStudents.forEach(function(s) {
    newStates[s] = studentStates[s] || { state: null, acCount: 0 };
  });
  studentStates = newStates;

  var rosterNameEl = document.getElementById('roster-group-name');
  if (rosterNameEl) rosterNameEl.textContent = groupLabels.join(' vs ');
  selectedGroup = { group_name: groupLabels.join(' vs '), students: allStudents };
  renderGroupedRoster();
  if (rosterPanel) rosterPanel.classList.remove('hidden');
  if (manualSection) manualSection.classList.add('hidden');
  updateHiddenInputs();
}

/* ═══════════════════════════════════════════════════════════════
   Student Roster — helpers
   ═══════════════════════════════════════════════════════════════ */
function hideRoster()  {
  if (rosterPanel) rosterPanel.classList.add('hidden');
  if (manualSection) manualSection.classList.remove('hidden');
}

function renderStudentRow(student) {
  var stObj  = studentStates[student] || { state: null, acCount: 0 };
  var state  = stObj.state;
  var acCount = stObj.acCount || 0;

  var rowCls = 'flex items-center justify-between py-2.5 px-3 rounded-xl border transition-all duration-200 ';
  rowCls += state === 'ac'     ? 'bg-gradient-to-r from-emerald-50 to-teal-50 border-emerald-200 shadow-sm shadow-emerald-100/50' :
            state === 'absent' ? 'bg-red-50 border-red-200' :
            'bg-white border-slate-100 hover:border-slate-200';

  var nameCls = 'text-sm ' + (state === 'ac' ? 'text-emerald-800 font-semibold' : state === 'absent' ? 'text-red-700 font-medium' : 'text-slate-700');

  var statusIcon = '';
  if (state === 'ac') {
    statusIcon = '<span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500 text-white flex-shrink-0">' +
      '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"/></svg>' +
    '</span>';
  } else if (state === 'absent') {
    statusIcon = '<span class="flex items-center justify-center w-5 h-5 rounded-full bg-red-100 text-red-500 flex-shrink-0">' +
      '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>' +
    '</span>';
  } else {
    statusIcon = '<span class="flex items-center justify-center w-5 h-5 rounded-full bg-slate-100 text-slate-400 flex-shrink-0">' +
      '<span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>' +
    '</span>';
  }

  var acHtml = '';
  if (state === 'ac') {
    var canRemove = acCount > 1;
    var canAdd    = acCount < MAX_AC_COUNT;
    acHtml = '<div class="inline-flex items-center rounded-full bg-emerald-500 shadow-sm overflow-hidden">' +
      '<button type="button" ' + (canRemove ? '' : 'disabled ') +
        'class="w-7 h-7 flex items-center justify-center text-sm font-bold transition-colors ' +
        (canRemove ? 'text-white/90 hover:bg-emerald-600 active:bg-emerald-700' : 'text-emerald-300 cursor-not-allowed') +
        '" data-student="'+escHtml(student)+'" data-role="remove">&minus;</button>' +
      '<span class="px-1.5 text-[11px] font-bold text-white tracking-wide select-none border-x border-emerald-400/40 min-w-[38px] text-center leading-7">' + acCount + ' AC</span>' +
      '<button type="button" ' + (canAdd ? '' : 'disabled ') +
        'class="w-7 h-7 flex items-center justify-center text-sm font-bold transition-colors ' +
        (canAdd ? 'text-white/90 hover:bg-emerald-600 active:bg-emerald-700' : 'text-emerald-300 cursor-not-allowed') +
        '" data-student="'+escHtml(student)+'" data-role="add">+</button>' +
    '</div>' +
    '<button type="button" class="w-7 h-7 flex items-center justify-center rounded-full text-slate-400 hover:bg-red-50 hover:text-red-500 transition-colors" data-student="'+escHtml(student)+'" data-role="clear-ac" title="Remove AC">' +
      '<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>' +
    '</button>';
  } else {
    acHtml = '<button type="button" class="inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200 border border-emerald-200 bg-white text-emerald-600 hover:bg-emerald-500 hover:text-white hover:border-emerald-500 hover:shadow-sm active:scale-95" data-student="'+escHtml(student)+'" data-role="ac">' +
      '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"/></svg>' +
      'AC</button>';
  }

  var absCls = 'inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200 ' +
    (state === 'absent' ? 'bg-red-500 text-white shadow-sm border border-red-500' :
     'border border-slate-200 bg-white text-slate-400 hover:border-red-300 hover:text-red-500 active:scale-95');

  return '<div class="'+rowCls+'">' +
    '<div class="flex items-center gap-2 min-w-0">' +
      statusIcon +
      '<span class="'+nameCls+' truncate">' + escHtml(student) + '</span>' +
    '</div>' +
    '<div class="flex items-center gap-1.5 flex-shrink-0">' +
      acHtml +
      '<button type="button" class="'+absCls+'" data-student="'+escHtml(student)+'" data-role="absent">Absent</button>' +
    '</div>' +
  '</div>';
}

function renderRoster() {
  var container = document.getElementById('roster-students');
  if (!container) return;
  var actionsEl = document.getElementById('global-roster-actions');
  if (actionsEl) actionsEl.classList.remove('hidden');
  if (!selectedGroup || selectedGroup.students.length === 0) {
    container.innerHTML = '<p class="text-sm text-slate-400 italic py-2 text-center">No students in this group.</p>';
    return;
  }
  container.innerHTML = selectedGroup.students.map(renderStudentRow).join('');
  updateRosterSummary();
}

function renderGroupedRoster() {
  var container = document.getElementById('roster-students');
  if (!container) return;
  var actionsEl = document.getElementById('global-roster-actions');
  if (actionsEl) actionsEl.classList.add('hidden');
  var html = '';

  competitionSelectedIds.forEach(function(id, idx) {
    var g = groupsData.find(function(x) { return x._id === id; });
    if (!g) return;

    var gAc = 0, gAbs = 0;
    g.students.forEach(function(s) {
      var st = studentStates[s];
      if (st && st.state === 'ac') gAc++;
      if (st && st.state === 'absent') gAbs++;
    });
    var statsParts = [];
    if (gAc  > 0) statsParts.push('<span class="text-emerald-600 font-semibold">' + gAc + ' AC</span>');
    if (gAbs > 0) statsParts.push('<span class="text-red-500 font-semibold">' + gAbs + ' Absent</span>');

    if (idx > 0) {
      html += '<div class="border-t-2 border-dashed border-orange-200 my-3"></div>';
    }

    html += '<div class="flex items-center justify-between py-2 px-1 mb-1.5">' +
      '<div class="flex items-center gap-2 min-w-0">' +
        '<span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full bg-orange-100 text-orange-700 whitespace-nowrap">' +
          '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/></svg>' +
          escHtml(g.group_name) +
        '</span>' +
        '<span class="text-[10px] text-slate-400">' + g.students.length + ' student(s)</span>' +
        (statsParts.length ? '<span class="text-[10px]">' + statsParts.join(' · ') + '</span>' : '') +
      '</div>' +
      '<div class="flex items-center gap-1 flex-shrink-0">' +
        '<button type="button" onclick="markAllInGroup(\'' + escHtml(id) + '\', \'ac\')" class="text-[10px] font-semibold bg-emerald-100 hover:bg-emerald-200 text-emerald-700 px-2 py-1 rounded-md transition">All AC</button>' +
        '<button type="button" onclick="markAllInGroup(\'' + escHtml(id) + '\', \'absent\')" class="text-[10px] font-semibold bg-red-100 hover:bg-red-200 text-red-600 px-2 py-1 rounded-md transition">All Absent</button>' +
        '<button type="button" onclick="markAllInGroup(\'' + escHtml(id) + '\', \'clear\')" class="text-[10px] font-semibold bg-white hover:bg-slate-100 text-slate-500 border border-slate-200 px-2 py-1 rounded-md transition">Clear</button>' +
      '</div>' +
    '</div>';

    html += '<div class="space-y-1.5">';
    g.students.forEach(function(student) {
      html += renderStudentRow(student);
    });
    html += '</div>';
  });

  container.innerHTML = html;
  updateRosterSummary();
}

function rerender() {
  if (document.getElementById('session_type_input').value === 'competition') {
    renderGroupedRoster();
  } else {
    renderRoster();
  }
}

function toggleStudent(name, role) {
  var st = studentStates[name] || { state: null, acCount: 0 };

  if (role === 'ac') {
    st.state = 'ac';
    st.acCount = 1;
  } else if (role === 'add') {
    if (st.state === 'ac' && st.acCount < MAX_AC_COUNT) {
      st.acCount++;
    }
  } else if (role === 'remove') {
    if (st.state === 'ac' && st.acCount > 1) {
      st.acCount--;
    }
  } else if (role === 'clear-ac') {
    st.state = null;
    st.acCount = 0;
  } else if (role === 'absent') {
    if (st.state === 'absent') {
      st.state = null;
      st.acCount = 0;
    } else {
      st.state = 'absent';
      st.acCount = 0;
    }
  }

  studentStates[name] = st;
  rerender();
  updateHiddenInputs();
}

function markAll(role) {
  if (!selectedGroup) return;
  selectedGroup.students.forEach(function(s) {
    if (role === 'clear') {
      studentStates[s] = { state: null, acCount: 0 };
    } else if (role === 'ac') {
      studentStates[s] = { state: 'ac', acCount: 1 };
    } else if (role === 'absent') {
      studentStates[s] = { state: 'absent', acCount: 0 };
    }
  });
  rerender();
  updateHiddenInputs();
}

function markAllInGroup(groupId, role) {
  var g = groupsData.find(function(x) { return x._id === groupId; });
  if (!g) return;
  g.students.forEach(function(s) {
    if (role === 'clear') {
      studentStates[s] = { state: null, acCount: 0 };
    } else if (role === 'ac') {
      studentStates[s] = { state: 'ac', acCount: 1 };
    } else if (role === 'absent') {
      studentStates[s] = { state: 'absent', acCount: 0 };
    }
  });
  rerender();
  updateHiddenInputs();
}

function updateRosterSummary() {
  var vals   = Object.values(studentStates);
  var acCnt  = vals.filter(function(v){return v.state==='ac';}).length;
  var totalAc = vals.reduce(function(s, v){return s + (v.state==='ac' ? v.acCount : 0);}, 0);
  var absCnt = vals.filter(function(v){return v.state==='absent';}).length;
  var el     = document.getElementById('roster-summary');
  if (!el) return;
  var parts  = [];
  if (acCnt  > 0) {
    var acText = acCnt + ' AC';
    if (totalAc > acCnt) acText += ' (' + totalAc + ' total)';
    parts.push('<span class="text-emerald-600 font-semibold">' + acText + '</span>');
  }
  if (absCnt > 0) parts.push('<span class="text-red-500 font-semibold">'+absCnt+' Absent</span>');
  el.innerHTML = parts.length ? parts.join(' · ') : '<span class="text-slate-400">No marks yet</span>';
}

function updateHiddenInputs() {
  var acList = [], absList = [];
  Object.keys(studentStates).forEach(function(s) {
    var st = studentStates[s];
    if (st.state === 'ac') {
      for (var i = 0; i < st.acCount; i++) {
        acList.push(s);
      }
    }
    if (st.state === 'absent') absList.push(s);
  });
  if (acCtrl)     acCtrl.reset(acList);
  if (absentCtrl) absentCtrl.reset(absList);
}

/* ═══════════════════════════════════════════════════════════════
   Init tag inputs
   ═══════════════════════════════════════════════════════════════ */
acCtrl     = initTagInput({ inputId:'ac-input',     boxId:'ac-tag-box',     hiddenId:'ac-hidden',     countId:'ac-count',     tagCls:'bg-emerald-100 text-emerald-700', allowDuplicates: true });
absentCtrl = initTagInput({ inputId:'absent-input', boxId:'absent-tag-box', hiddenId:'absent-hidden', countId:'absent-count', tagCls:'bg-red-100 text-red-600', allowDuplicates: false });

/* ═══════════════════════════════════════════════════════════════
   Auto-detect & pre-select group / setup page states on page load
   ═══════════════════════════════════════════════════════════════ */
(function autoSelectGroup() {
  var initSessionType     = formEl.dataset.sessionType || 'group';
  var initSessionMode     = formEl.dataset.sessionMode || 'offline';
  var initClassName       = formEl.dataset.className || '';
  var initAc              = formEl.dataset.acStudents ? formEl.dataset.acStudents.split(',').filter(Boolean) : [];
  var initAbsent          = formEl.dataset.absentStudents ? formEl.dataset.absentStudents.split(',').filter(Boolean) : [];
  var initCompGroups      = formEl.dataset.competitionGroups ? formEl.dataset.competitionGroups.split(',').map(function(s){return s.trim();}).filter(Boolean) : [];

  setSessionType(initSessionType);
  setMode(initSessionMode);
  if (formEl.dataset.usesPersonalInternet === 'true') {
    var pic = document.getElementById('personal_internet_check');
    if (pic) pic.checked = true;
  }

  if (initSessionType === 'competition') {
    initCompGroups.forEach(function(name) {
      var g = groupsData.find(function(x) { return x.group_name === name; });
      if (g && competitionSelectedIds.indexOf(g._id) === -1) {
        competitionSelectedIds.push(g._id);
      }
    });
    renderCompetitionTags();

    var allStudents = [];
    competitionSelectedIds.forEach(function(id) {
      var g = groupsData.find(function(x) { return x._id === id; });
      if (g) g.students.forEach(function(s) { if (allStudents.indexOf(s) === -1) allStudents.push(s); });
    });
    studentStates = {};
    allStudents.forEach(function(s) { studentStates[s] = { state: null, acCount: 0 }; });

    var acCounts = {};
    initAc.forEach(function(s) { acCounts[s] = (acCounts[s] || 0) + 1; });
    Object.keys(acCounts).forEach(function(s) {
      if (studentStates[s] !== undefined) {
        studentStates[s] = { state: 'ac', acCount: acCounts[s] };
      }
    });
    initAbsent.forEach(function(s) {
      if (studentStates[s] !== undefined) studentStates[s] = { state: 'absent', acCount: 0 };
    });

    renderCompetitionRoster();
    return;
  }

  var match = groupsData.find(function(g) { return g.group_name === initClassName; });
  if (match) {
    selectGroup(match._id, { preAc: initAc, preAbsent: initAbsent });
  } else if (initSessionType === 'private') {
    var privateInput = document.getElementById('private_name_input');
    if (privateInput) privateInput.value = initClassName;
  }
})();

// Event delegation for student roster buttons
var rosterStudentsEl = document.getElementById('roster-students');
if (rosterStudentsEl) {
  rosterStudentsEl.addEventListener('click', function(e) {
    var btn = e.target.closest('button');
    if (!btn || btn.disabled) return;
    var student = btn.getAttribute('data-student');
    var role = btn.getAttribute('data-role');
    if (student && role) {
      toggleStudent(student, role);
    }
  });
}
</script>

<!-- 🟠 Unsaved changes warning -->
<script>
  (function () {
    var form  = document.getElementById('report-form');
    var dirty = false;

    form.addEventListener('input',  function () { dirty = true; });
    form.addEventListener('change', function () { dirty = true; });

    form.querySelectorAll('button[type="button"]').forEach(function (btn) {
      btn.addEventListener('click', function () { dirty = true; });
    });

    form.addEventListener('submit', function () { dirty = false; });

    var cancelBtn = document.getElementById('cancel-btn');
    var backLink  = document.getElementById('back-link');

    function guardNav(e, href) {
      if (!dirty) return;
      e.preventDefault();
      Swal.fire({
        title: 'Unsaved changes',
        text: 'You have unsaved changes. Leave anyway?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444', cancelButtonColor: '#64748b',
        confirmButtonText: 'Leave', cancelButtonText: 'Stay',
        reverseButtons: true, focusCancel: true,
        customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl', cancelButton: 'rounded-xl' },
      }).then(function (result) {
        if (result.isConfirmed) window.location.href = href;
      });
    }

    if (cancelBtn) cancelBtn.addEventListener('click', function (e) { guardNav(e, '<%= _cancelUrl %>'); });
    if (backLink)  backLink.addEventListener('click',  function (e) { guardNav(e, '<%= _cancelUrl %>'); });

    window.addEventListener('beforeunload', function (e) {
      if (dirty && !window.__bulkSubmitting) { e.preventDefault(); e.returnValue = ''; }
    });
  })();
</script>

<% if (!_isEdit) { %>
<script id="bulk-teaching-types-json" type="application/json"><%- JSON.stringify(typeof teachingTypes !== 'undefined' ? teachingTypes : []) %></script>
<script id="bulk-is-admin-json" type="application/json"><%- JSON.stringify((_isAdmin) || false) %></script>
<script id="bulk-teachers-json" type="application/json"><%- JSON.stringify((typeof teachers !== 'undefined' && Array.isArray(teachers) && teachers.length > 0) ? teachers.map(function(t){ return { _id: String(t._id), displayName: t.displayName, username: t.username }; }) : []) %></script>
<script>
/* ═══════════════════════════════════════════════════════════════════════
   BULK ADD: Multi-Class Entry Management
   Each extra card is a fully independent report entry.
   ═══════════════════════════════════════════════════════════════════════ */

// Server-side data injected for use in dynamically-built cards
var _bulkTeachingTypes = JSON.parse(document.getElementById('bulk-teaching-types-json').textContent);
var _bulkIsAdmin       = JSON.parse(document.getElementById('bulk-is-admin-json').textContent);
var _bulkTeachers      = JSON.parse(document.getElementById('bulk-teachers-json').textContent);
var _bulkToday         = '<%= new Date().toISOString().substring(0,10) %>';

var _bulkIdCounter = 0;
var _bulkIds       = []; // ordered list of active entry IDs
var _bulkStates    = {}; // { id: { sessionType, sessionMode, selectedGroup, studentStates, acTags, absentTags } }

/* ─── Add / Remove entries ──────────────────────────────────────────── */
function addBulkEntry() {
  var id  = ++_bulkIdCounter;
  var num = _bulkIds.length + 2; // +2 because entry #1 is the main form
  _bulkIds.push(id);
  _bulkStates[id] = { sessionType: 'group', sessionMode: 'offline', selectedGroup: null, studentStates: {}, acTags: [], absentTags: [] };

  var container = document.getElementById('bulk-extra-entries');
  var wrapper   = document.createElement('div');
  wrapper.innerHTML = _buildEntryHtml(id, num);
  container.appendChild(wrapper.firstElementChild);

  _initBulkEntry(id);
  _updateBulkUI();

  // Smooth scroll to new entry
  document.getElementById('bulk-entry-' + id).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function removeBulkEntry(id) {
  var el = document.getElementById('bulk-entry-' + id);
  if (el) { el.style.opacity = '0'; el.style.transform = 'scale(0.97)'; el.style.transition = 'all 0.15s'; setTimeout(function() { el.remove(); }, 150); }
  _bulkIds     = _bulkIds.filter(function(x) { return x !== id; });
  delete _bulkStates[id];
  setTimeout(function() { _renumberEntries(); _updateBulkUI(); }, 160);
}

function _renumberEntries() {
  _bulkIds.forEach(function(id, idx) {
    var numEl   = document.getElementById('bulk-entry-' + id + '-num');
    var titleEl = document.getElementById('bulk-entry-' + id + '-title');
    var st      = _bulkStates[id];
    var newNum  = idx + 2;
    if (numEl) numEl.textContent = newNum;
    if (titleEl && !(st && st.selectedGroup)) titleEl.textContent = 'Class ' + newNum;
  });
}

/* ─── UI update (button text, submit bar) ───────────────────────────── */
function _updateBulkUI() {
  var total       = 1 + _bulkIds.length;
  var submitBar   = document.getElementById('bulk-submit-bar');
  var countEl     = document.getElementById('bulk-total-count');
  var bulkBtnText = document.getElementById('bulk-submit-text');
  var mainBtnText = document.getElementById('btn-submit-text');

  if (_bulkIds.length > 0) {
    if (submitBar)   submitBar.classList.remove('hidden');
    if (countEl)     countEl.textContent     = total;
    if (bulkBtnText) bulkBtnText.textContent = 'Save ' + total + ' Reports';
    if (mainBtnText) mainBtnText.textContent = 'Save ' + total + ' Reports';
  } else {
    if (submitBar)   submitBar.classList.add('hidden');
    if (mainBtnText) mainBtnText.textContent = '<%= _submitText %>';
  }
}

/* ─── Session Type ──────────────────────────────────────────────────── */
function setEntrySessionType(id, type) {
  var st = _bulkStates[id]; if (!st) return;
  st.sessionType = type;
  var inact = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
  var btnG = document.getElementById('bulk-entry-' + id + '-btn-group');
  var btnP = document.getElementById('bulk-entry-' + id + '-btn-private');
  var btnC = document.getElementById('bulk-entry-' + id + '-btn-competition');
  if (btnG) btnG.className = inact;
  if (btnP) btnP.className = inact;
  if (btnC) btnC.className = inact;
  if (type === 'group'       && btnG) btnG.className = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-brand-500 bg-brand-50 text-brand-700';
  if (type === 'private'     && btnP) btnP.className = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-purple-400 bg-purple-50 text-purple-700';
  if (type === 'competition' && btnC) btnC.className = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-orange-500 bg-orange-50 text-orange-700';
}

/* ─── Session Mode ──────────────────────────────────────────────────── */
function setEntryMode(id, mode) {
  var st = _bulkStates[id]; if (!st) return;
  st.sessionMode = mode;
  var inact  = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
  var btnOff = document.getElementById('bulk-entry-' + id + '-btn-offline');
  var btnOn  = document.getElementById('bulk-entry-' + id + '-btn-online');
  var piWrap = document.getElementById('bulk-entry-' + id + '-pi-wrap');
  if (mode === 'online') {
    if (btnOn)  btnOn.className  = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-blue-500 bg-blue-50 text-blue-700';
    if (btnOff) btnOff.className = inact;
    if (piWrap) piWrap.classList.remove('hidden');
  } else {
    if (btnOff) btnOff.className = 'flex-1 py-2 rounded-xl border-2 text-xs font-semibold transition border-slate-700 bg-slate-700 text-white';
    if (btnOn)  btnOn.className  = inact;
    if (piWrap) piWrap.classList.add('hidden');
    var pic = document.getElementById('bulk-entry-' + id + '-pi-check');
    if (pic) pic.checked = false;
  }
}

/* ─── Autocomplete ──────────────────────────────────────────────────── */
function _entryClassFocus(id) {
  var inp  = document.getElementById('bulk-entry-' + id + '-class-name'); if (!inp) return;
  var q    = inp.value.trim().toLowerCase();
  var list = q ? groupsData.filter(function(g){ return g.group_name.toLowerCase().includes(q); }) : groupsData;
  if (list.length) _renderEntryDropdown(id, list);
}

function _entryClassInput(id, val) {
  var st = _bulkStates[id]; if (!st) return;
  if (st.selectedGroup && val !== st.selectedGroup.group_name) {
    st.selectedGroup = null; st.studentStates = {};
    _hideEntryRoster(id);
    var cb = document.getElementById('bulk-entry-' + id + '-clear-btn');
    if (cb) cb.classList.add('hidden');
    _entryHintDefault(id);
  }
  if (!val.trim()) { _hideEntryDropdown(id); return; }
  var list = groupsData.filter(function(g){ return g.group_name.toLowerCase().includes(val.trim().toLowerCase()); });
  list.length ? _renderEntryDropdown(id, list) : _hideEntryDropdown(id);
}

function _renderEntryDropdown(id, groups) {
  var dd = document.getElementById('bulk-entry-' + id + '-dropdown'); if (!dd) return;
  dd.innerHTML = groups.slice(0, 8).map(function(g) {
    var tcls = g.type === 'GROUP' ? 'bg-emerald-100 text-emerald-700' : 'bg-purple-100 text-purple-700';
    var tlbl = g.type === 'GROUP' ? 'Group' : 'Private';
    return '<button type="button" onclick="selectEntryGroup(' + id + ',\'' + escHtml(g._id) + '\')" class="w-full text-left px-4 py-3 hover:bg-brand-50 transition flex items-center justify-between gap-3">' +
      '<div class="flex-1 min-w-0"><p class="text-sm font-semibold text-slate-800 truncate">' + escHtml(g.group_name) + '</p>' +
      '<div class="flex items-center gap-1.5 mt-0.5"><span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full ' + tcls + '">' + tlbl + '</span>' +
      (g.level ? '<span class="text-[10px] font-mono text-slate-400">' + escHtml(g.level) + '</span>' : '') + '</div></div>' +
      '<span class="text-xs text-slate-400 flex-shrink-0">' + g.students.length + ' student(s)</span></button>';
  }).join('');
  dd.classList.remove('hidden');
}

function _hideEntryDropdown(id) {
  var dd = document.getElementById('bulk-entry-' + id + '-dropdown');
  if (dd) dd.classList.add('hidden');
}

function selectEntryGroup(id, groupId) {
  var st = _bulkStates[id]; if (!st) return;
  var g  = groupsData.find(function(x){ return x._id === groupId; }); if (!g) return;

  st.selectedGroup  = g;
  st.studentStates  = {};
  g.students.forEach(function(s){ st.studentStates[s] = { state: null, acCount: 0 }; });

  var inp = document.getElementById('bulk-entry-' + id + '-class-name');
  if (inp) inp.value = g.group_name;
  _hideEntryDropdown(id);

  var cb = document.getElementById('bulk-entry-' + id + '-clear-btn');
  if (cb) cb.classList.remove('hidden');

  var rn = document.getElementById('bulk-entry-' + id + '-roster-name');
  if (rn) rn.textContent = g.group_name;

  var titleEl = document.getElementById('bulk-entry-' + id + '-title');
  if (titleEl) titleEl.textContent = g.group_name;

  setEntrySessionType(id, g.type === 'PRIVATE' ? 'private' : 'group');
  _renderEntryRoster(id);
  _showEntryRoster(id);
  _entryHintSelected(id);
}

function clearEntryGroup(id) {
  var st = _bulkStates[id]; if (!st) return;
  st.selectedGroup = null; st.studentStates = {}; st.acTags = []; st.absentTags = [];
  var inp = document.getElementById('bulk-entry-' + id + '-class-name');
  if (inp) { inp.value = ''; inp.focus(); }
  var cb = document.getElementById('bulk-entry-' + id + '-clear-btn');
  if (cb) cb.classList.add('hidden');
  _hideEntryRoster(id);
  _renderEntryTagBox(id, 'ac');
  _renderEntryTagBox(id, 'absent');
  _entryHintDefault(id);
  var idx     = _bulkIds.indexOf(id);
  var titleEl = document.getElementById('bulk-entry-' + id + '-title');
  if (titleEl) titleEl.textContent = 'Class ' + (idx + 2);
}

function _showEntryRoster(id) {
  var r = document.getElementById('bulk-entry-' + id + '-roster');
  var m = document.getElementById('bulk-entry-' + id + '-manual');
  if (r) r.classList.remove('hidden');
  if (m) m.classList.add('hidden');
}
function _hideEntryRoster(id) {
  var r = document.getElementById('bulk-entry-' + id + '-roster');
  var m = document.getElementById('bulk-entry-' + id + '-manual');
  if (r) r.classList.add('hidden');
  if (m) m.classList.remove('hidden');
}
function _entryHintDefault(id) {
  var h = document.getElementById('bulk-entry-' + id + '-hint');
  if (h) { h.textContent = 'Type a name or select from your groups list.'; h.className = 'text-xs text-slate-400'; }
}
function _entryHintSelected(id) {
  var h = document.getElementById('bulk-entry-' + id + '-hint');
  if (h) {
    h.innerHTML = '<span class="inline-flex items-center gap-1 text-brand-600 font-semibold"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>Group selected — mark students below</span>';
    h.className = 'text-xs';
  }
}

/* ─── Student Roster ────────────────────────────────────────────────── */
function _renderEntryRoster(id) {
  var st = _bulkStates[id]; if (!st || !st.selectedGroup) return;
  var c  = document.getElementById('bulk-entry-' + id + '-roster-students'); if (!c) return;
  c.innerHTML = st.selectedGroup.students.map(function(s){ return _renderEntryStudentRow(id, s); }).join('');
  _updateEntryRosterSummary(id);
}

function _renderEntryStudentRow(id, student) {
  var st     = _bulkStates[id];
  var stObj  = (st && st.studentStates[student]) || { state: null, acCount: 0 };
  var state  = stObj.state;
  var acCnt  = stObj.acCount || 0;
  var MAX_AC = 10;

  var rowCls = 'flex items-center justify-between py-2.5 px-3 rounded-xl border transition-all duration-200 ' +
    (state === 'ac' ? 'bg-gradient-to-r from-emerald-50 to-teal-50 border-emerald-200 shadow-sm shadow-emerald-100/50' :
     state === 'absent' ? 'bg-red-50 border-red-200' : 'bg-white border-slate-100 hover:border-slate-200');

  var nameCls = 'text-sm ' + (state === 'ac' ? 'text-emerald-800 font-semibold' : state === 'absent' ? 'text-red-700 font-medium' : 'text-slate-700');

  var icon = state === 'ac'
    ? '<span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500 text-white flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"/></svg></span>'
    : state === 'absent'
    ? '<span class="flex items-center justify-center w-5 h-5 rounded-full bg-red-100 text-red-500 flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg></span>'
    : '<span class="flex items-center justify-center w-5 h-5 rounded-full bg-slate-100 flex-shrink-0"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span></span>';

  var acHtml = state === 'ac'
    ? '<div class="inline-flex items-center rounded-full bg-emerald-500 shadow-sm overflow-hidden">' +
        '<button type="button" ' + (acCnt > 1 ? '' : 'disabled ') + 'class="w-7 h-7 flex items-center justify-center text-sm font-bold ' + (acCnt > 1 ? 'text-white/90 hover:bg-emerald-600' : 'text-emerald-300 cursor-not-allowed') + '" data-beid="' + id + '" data-student="' + escHtml(student) + '" data-role="remove">−</button>' +
        '<span class="px-1.5 text-[11px] font-bold text-white border-x border-emerald-400/40 min-w-[38px] text-center leading-7">' + acCnt + ' AC</span>' +
        '<button type="button" ' + (acCnt < MAX_AC ? '' : 'disabled ') + 'class="w-7 h-7 flex items-center justify-center text-sm font-bold ' + (acCnt < MAX_AC ? 'text-white/90 hover:bg-emerald-600' : 'text-emerald-300 cursor-not-allowed') + '" data-beid="' + id + '" data-student="' + escHtml(student) + '" data-role="add">+</button>' +
      '</div>' +
      '<button type="button" class="w-7 h-7 flex items-center justify-center rounded-full text-slate-400 hover:bg-red-50 hover:text-red-500" data-beid="' + id + '" data-student="' + escHtml(student) + '" data-role="clear-ac"><svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg></button>'
    : '<button type="button" class="inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-full border border-emerald-200 bg-white text-emerald-600 hover:bg-emerald-500 hover:text-white hover:border-emerald-500 active:scale-95 transition-all" data-beid="' + id + '" data-student="' + escHtml(student) + '" data-role="ac">' +
        '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"/></svg>' +
        'AC</button>';

  var absCls = 'inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-200 ' +
    (state === 'absent' ? 'bg-red-500 text-white shadow-sm border border-red-500' : 'border border-slate-200 bg-white text-slate-400 hover:border-red-300 hover:text-red-500 active:scale-95');

  return '<div class="' + rowCls + '">' +
    '<div class="flex items-center gap-2 min-w-0">' + icon + '<span class="' + nameCls + ' truncate">' + escHtml(student) + '</span></div>' +
    '<div class="flex items-center gap-1.5 flex-shrink-0">' + acHtml +
      '<button type="button" class="' + absCls + '" data-beid="' + id + '" data-student="' + escHtml(student) + '" data-role="absent">Absent</button>' +
    '</div></div>';
}

function toggleEntryStudent(id, student, role) {
  var st   = _bulkStates[id]; if (!st) return;
  var stObj = st.studentStates[student] || { state: null, acCount: 0 };
  if (role === 'ac')       { stObj.state = 'ac'; stObj.acCount = 1; }
  else if (role === 'add') { if (stObj.state === 'ac' && stObj.acCount < 10) stObj.acCount++; }
  else if (role === 'remove') { if (stObj.state === 'ac' && stObj.acCount > 1) stObj.acCount--; }
  else if (role === 'clear-ac') { stObj.state = null; stObj.acCount = 0; }
  else if (role === 'absent') { stObj.state = stObj.state === 'absent' ? null : 'absent'; stObj.acCount = 0; }
  st.studentStates[student] = stObj;
  _renderEntryRoster(id);
}

function markAllEntry(id, role) {
  var st = _bulkStates[id]; if (!st || !st.selectedGroup) return;
  st.selectedGroup.students.forEach(function(s) {
    if (role === 'clear')  st.studentStates[s] = { state: null, acCount: 0 };
    else if (role === 'ac') st.studentStates[s] = { state: 'ac', acCount: 1 };
    else if (role === 'absent') st.studentStates[s] = { state: 'absent', acCount: 0 };
  });
  _renderEntryRoster(id);
}

function _updateEntryRosterSummary(id) {
  var st   = _bulkStates[id]; if (!st) return;
  var vals = Object.values(st.studentStates);
  var acCnt   = vals.filter(function(v){ return v.state === 'ac'; }).length;
  var totalAc = vals.reduce(function(s,v){ return s + (v.state==='ac' ? v.acCount : 0); }, 0);
  var absCnt  = vals.filter(function(v){ return v.state === 'absent'; }).length;
  var el = document.getElementById('bulk-entry-' + id + '-roster-summary'); if (!el) return;
  var parts = [];
  if (acCnt > 0) { var t = acCnt + ' AC'; if (totalAc > acCnt) t += ' (' + totalAc + ' total)'; parts.push('<span class="text-emerald-600 font-semibold">' + t + '</span>'); }
  if (absCnt > 0) parts.push('<span class="text-red-500 font-semibold">' + absCnt + ' Absent</span>');
  el.innerHTML = parts.length ? parts.join(' · ') : '<span class="text-slate-400">No marks yet</span>';
}

/* ─── Tag inputs (manual AC/Absent) ────────────────────────────────── */
function _initBulkTagInput(id, type) {
  var inp = document.getElementById('bulk-entry-' + id + '-' + type + '-input'); if (!inp) return;
  function tryAdd() {
    var val = inp.value.replace(/,/g, '').trim(); if (!val) return;
    var st  = _bulkStates[id]; if (!st) return;
    var arr = type === 'ac' ? st.acTags : st.absentTags;
    if (type === 'absent' && arr.indexOf(val) !== -1) { inp.value = ''; return; }
    arr.push(val); inp.value = ''; _renderEntryTagBox(id, type);
  }
  inp.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); tryAdd(); }
    else if (e.key === ',') { e.preventDefault(); tryAdd(); }
    else if (e.key === 'Backspace' && inp.value === '') {
      var st = _bulkStates[id]; if (!st) return;
      var arr = type === 'ac' ? st.acTags : st.absentTags;
      if (arr.length) { arr.pop(); _renderEntryTagBox(id, type); }
    }
  });
  inp.addEventListener('blur', function(){ if (inp.value.trim()) tryAdd(); });
}

function _renderEntryTagBox(id, type) {
  var box  = document.getElementById('bulk-entry-' + id + '-' + type + '-box');
  var cntEl = document.getElementById('bulk-entry-' + id + '-' + type + '-count');
  var st   = _bulkStates[id]; if (!st || !box) return;
  var arr  = type === 'ac' ? st.acTags : st.absentTags;
  var cls  = type === 'ac' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-600';
  box.innerHTML = arr.map(function(tag, i) {
    return '<span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ' + cls + '">' +
      escHtml(tag) + ' <button type="button" class="ml-0.5 leading-none opacity-60 hover:opacity-100 transition text-sm" data-be-rm-id="' + id + '" data-be-rm-type="' + type + '" data-be-rm-idx="' + i + '">×</button></span>';
  }).join('');
  if (cntEl) cntEl.textContent = arr.length;
  box.querySelectorAll('button[data-be-rm-id]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var bId  = parseInt(btn.getAttribute('data-be-rm-id'));
      var bTyp = btn.getAttribute('data-be-rm-type');
      var bIdx = parseInt(btn.getAttribute('data-be-rm-idx'));
      var bSt  = _bulkStates[bId]; if (!bSt) return;
      var bArr = bTyp === 'ac' ? bSt.acTags : bSt.absentTags;
      bArr.splice(bIdx, 1); _renderEntryTagBox(bId, bTyp);
    });
  });
}

/* ─── Entry init ────────────────────────────────────────────────────── */
function _initBulkEntry(id) {
  setEntrySessionType(id, 'group');
  setEntryMode(id, 'offline');
  _initBulkTagInput(id, 'ac');
  _initBulkTagInput(id, 'absent');

  // Roster click delegation
  var rosterEl = document.getElementById('bulk-entry-' + id + '-roster-students');
  if (rosterEl) {
    rosterEl.addEventListener('click', function(e) {
      var btn = e.target.closest('button');
      if (!btn || btn.disabled) return;
      var beid    = parseInt(btn.getAttribute('data-beid'));
      var student = btn.getAttribute('data-student');
      var role    = btn.getAttribute('data-role');
      if (!isNaN(beid) && student && role) toggleEntryStudent(beid, student, role);
    });
  }

  // Close dropdown on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#bulk-entry-' + id + '-group-wrap')) _hideEntryDropdown(id);
  });
}

/* ─── Collect entry data ────────────────────────────────────────────── */
function _getEntryData(id) {
  var st = _bulkStates[id]; if (!st) return null;
  var inp       = document.getElementById('bulk-entry-' + id + '-class-name');
  var className = inp ? inp.value.trim() : '';
  if (st.selectedGroup) className = st.selectedGroup.group_name;

  var acStudents = [], absentStudents = [];
  if (st.selectedGroup) {
    Object.keys(st.studentStates).forEach(function(s) {
      var stObj = st.studentStates[s];
      if (stObj.state === 'ac')     { for (var i = 0; i < stObj.acCount; i++) acStudents.push(s); }
      else if (stObj.state === 'absent') absentStudents.push(s);
    });
  } else {
    acStudents     = st.acTags.slice();
    absentStudents = st.absentTags.slice();
  }

  var dateEl    = document.getElementById('bulk-entry-' + id + '-date');
  var typeEl    = document.getElementById('bulk-entry-' + id + '-teaching-type');
  var durEl     = document.getElementById('bulk-entry-' + id + '-duration');
  var teacherEl = document.getElementById('bulk-entry-' + id + '-teacher');
  var subjEl    = document.getElementById('bulk-entry-' + id + '-subject');
  var notesEl   = document.getElementById('bulk-entry-' + id + '-notes');
  var piCheck   = document.getElementById('bulk-entry-' + id + '-pi-check');

  return {
    date:                   dateEl    ? dateEl.value    : _bulkToday,
    teaching_type:          typeEl    ? typeEl.value    : '',
    duration:               durEl     ? durEl.value     : '',
    teacher:                teacherEl ? teacherEl.value : '',
    class_name:             className,
    session_type:           st.sessionType,
    session_mode:           st.sessionMode,
    uses_personal_internet: piCheck ? piCheck.checked : false,
    subject:                subjEl  ? subjEl.value.trim()  : '',
    notes:                  notesEl ? notesEl.value.trim() : '',
    ac_students:            acStudents,
    absent_students:        absentStudents,
    competition_groups:     []
  };
}

function _getMainEntryData() {
  var form = document.getElementById('report-form'); if (!form) return null;
  var sessionType = (document.getElementById('session_type_input') || {}).value || 'group';
  var sessionMode = (document.getElementById('session_mode_input') || {}).value || 'offline';
  var className   = '';
  if (sessionType === 'private') {
    var pvInp = document.getElementById('private_name_input');
    className = pvInp ? pvInp.value.trim() : '';
  } else {
    var cnInp = document.getElementById('class_name');
    className = cnInp ? cnInp.value.trim() : '';
  }
  var piCheck    = document.getElementById('personal_internet_check');
  var subjectEl  = document.getElementById('subject');
  var notesEl    = document.getElementById('notes');
  var acHidden   = document.getElementById('ac-hidden');
  var absHidden  = document.getElementById('absent-hidden');
  var compHidden = document.getElementById('competition_groups_hidden');
  var csrfEl     = form.querySelector('[name="_csrf"]');
  var dateEl     = form.querySelector('[name="date"]');
  var typeEl     = form.querySelector('[name="teaching_type"]');
  var durEl      = form.querySelector('[name="duration"]');
  var teacherEl  = form.querySelector('[name="teacher"]');
  return {
    _csrf:                  csrfEl    ? csrfEl.value    : '',
    date:                   dateEl    ? dateEl.value    : '',
    teaching_type:          typeEl    ? typeEl.value    : '',
    duration:               durEl     ? durEl.value     : '',
    teacher:                teacherEl ? teacherEl.value : '',
    class_name:             className,
    session_type:           sessionType,
    session_mode:           sessionMode,
    uses_personal_internet: piCheck ? piCheck.checked : false,
    subject:                subjectEl ? subjectEl.value.trim() : '',
    notes:                  notesEl   ? notesEl.value.trim()   : '',
    ac_students:            acHidden  ? acHidden.value.split(',').map(function(s){return s.trim();}).filter(Boolean) : [],
    absent_students:        absHidden ? absHidden.value.split(',').map(function(s){return s.trim();}).filter(Boolean) : [],
    competition_groups:     compHidden ? compHidden.value.split(',').map(function(s){return s.trim();}).filter(Boolean) : []
  };
}

/* ─── Bulk Submit ───────────────────────────────────────────────────── */
async function submitBulkReports() {
  var bulkBtn  = document.getElementById('btn-submit-bulk');
  var mainBtn  = document.getElementById('btn-main-submit');
  var total    = 1 + _bulkIds.length;
  var saving   = 'Saving\u2026';
  if (bulkBtn) { bulkBtn.disabled = true; document.getElementById('bulk-submit-text').textContent = saving; }
  if (mainBtn) { mainBtn.disabled = true; document.getElementById('btn-submit-text').textContent  = saving; }

  var mainData  = _getMainEntryData();
  var extraData = _bulkIds.map(function(id){ return _getEntryData(id); });
  var errors    = [];

  // Validate main entry
  if (!mainData.class_name)    errors.push('Report 1: Class name is required.');
  if (!mainData.teaching_type) errors.push('Report 1: Teaching type is required.');
  if (!mainData.duration)      errors.push('Report 1: Duration is required.');

  // Validate each extra entry independently
  extraData.forEach(function(d, i) {
    var label = 'Report ' + (i + 2);
    if (!d || !d.class_name)    errors.push(label + ': Class name is required.');
    if (!d || !d.teaching_type) errors.push(label + ': Teaching type is required.');
    if (!d || !d.duration)      errors.push(label + ': Duration is required.');
  });

  if (errors.length) {
    _showBulkErrors(errors);
    if (bulkBtn) { bulkBtn.disabled = false; document.getElementById('bulk-submit-text').textContent = 'Save ' + total + ' Reports'; }
    if (mainBtn) { mainBtn.disabled = false; document.getElementById('btn-submit-text').textContent  = 'Save ' + total + ' Reports'; }
    return;
  }

  // Hide previous errors
  var errEl = document.getElementById('bulk-errors'); if (errEl) errEl.classList.add('hidden');

  try {
    // Each entry carries its own date / teaching_type / duration / teacher
    var res = await fetch('/reports/bulk', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': mainData._csrf },
      body:    JSON.stringify({ entries: [mainData].concat(extraData) })
    });
    var json = await res.json();
    if (json.ok) {
      window.__bulkSubmitting = true;
      window.location.href = '/reports';
    } else {
      _showBulkErrors(json.errors || ['An error occurred. Please try again.']);
      if (bulkBtn) { bulkBtn.disabled = false; document.getElementById('bulk-submit-text').textContent = 'Save ' + total + ' Reports'; }
      if (mainBtn) { mainBtn.disabled = false; document.getElementById('btn-submit-text').textContent  = 'Save ' + total + ' Reports'; }
    }
  } catch (err) {
    _showBulkErrors(['Network error. Please try again.']);
    if (bulkBtn) { bulkBtn.disabled = false; document.getElementById('bulk-submit-text').textContent = 'Save ' + total + ' Reports'; }
    if (mainBtn) { mainBtn.disabled = false; document.getElementById('btn-submit-text').textContent  = 'Save ' + total + ' Reports'; }
  }
}

function _showBulkErrors(errors) {
  var el   = document.getElementById('bulk-errors');
  var list = document.getElementById('bulk-error-list');
  if (!el || !list) return;
  list.innerHTML = errors.map(function(e){ return '<li>' + escHtml(String(e)) + '</li>'; }).join('');
  el.classList.remove('hidden');
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

/* ─── Intercept main form submit when extra entries exist ───────────── */
document.getElementById('report-form').addEventListener('submit', function(e) {
  if (_bulkIds.length > 0) {
    e.preventDefault();
    submitBulkReports();
  }
});

