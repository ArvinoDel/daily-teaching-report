<%
  const _isEdit = typeof isEdit !== 'undefined' ? isEdit : false;
  const _isAdmin = typeof isAdmin !== 'undefined' ? isAdmin : false;
  const _actionUrl = typeof actionUrl !== 'undefined' ? actionUrl : '/reports';
  const _cancelUrl = typeof cancelUrl !== 'undefined' ? cancelUrl : '/reports';
  const _dateValue = typeof dateValue !== 'undefined' ? dateValue : '';
  const _classNameValue = typeof classNameValue !== 'undefined' ? classNameValue : '';
  const _sessionTypeValue = typeof sessionTypeValue !== 'undefined' ? sessionTypeValue : 'group';
  const _sessionModeValue = typeof sessionModeValue !== 'undefined' ? sessionModeValue : 'offline';
  const _usesPersonalInternetValue = typeof usesPersonalInternetValue !== 'undefined' ? usesPersonalInternetValue : false;
  const _competitionGroupsValue = typeof competitionGroupsValue !== 'undefined' ? (Array.isArray(competitionGroupsValue) ? competitionGroupsValue.join(',') : competitionGroupsValue) : '';
  const _subjectValue = typeof subjectValue !== 'undefined' ? subjectValue : '';
  const _teachingTypeValue = typeof teachingTypeValue !== 'undefined' ? teachingTypeValue : '';
  const _durationValue = typeof durationValue !== 'undefined' ? durationValue : (_isEdit ? '' : 60);
  const _notesValue = typeof notesValue !== 'undefined' ? notesValue : '';
  const _acStudentsValue = typeof acStudentsValue !== 'undefined' ? acStudentsValue : '';
  const _acReducedStudentsValue = typeof acReducedStudentsValue !== 'undefined' ? acReducedStudentsValue : '';
  const _absentStudentsValue = typeof absentStudentsValue !== 'undefined' ? absentStudentsValue : '';
  const _submitText = typeof submitText !== 'undefined' ? submitText : (_isEdit ? (_isAdmin ? 'Save Changes' : 'Update the Report') : 'Save Report');
  const _submitColorClass = typeof submitColorClass !== 'undefined' ? submitColorClass : (_isEdit ? (_isAdmin ? 'bg-red-600 hover:bg-red-700' : 'bg-amber-500 hover:bg-amber-600') : 'bg-brand-600 hover:bg-brand-700');
  const _teacherValue = typeof teacherValue !== 'undefined' ? teacherValue : '';
  const _partnerTeacherName = typeof partnerTeacherName !== 'undefined' ? partnerTeacherName : '';
  const _partnerTeacherId   = typeof partnerTeacherId   !== 'undefined' ? partnerTeacherId   : '';
  const _teachersJson = typeof teachersJson !== 'undefined' ? teachersJson : '[]';
  const _materialsJson = typeof materialsJson !== 'undefined' ? materialsJson : '[]';
  const _safeJson = typeof safeJson === 'function' ? safeJson : function(obj) {
    return JSON.stringify(obj)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  };
%>

<!-- Embedded teachers data for partner-teacher autocomplete -->
<script id="teachers-json" type="application/json"><%- _teachersJson %></script>
<script id="current-user-info" type="application/json"><%- _safeJson((typeof currentUser !== 'undefined' && currentUser) ? { id: String(currentUser._id), displayName: currentUser.displayName, username: currentUser.username } : {}) %></script>

<!-- Embedded materials data for material autocomplete -->
<script id="report-form-materials-json" type="application/json"><%- _materialsJson %></script>

<!-- Material autocomplete dropdown styles (scoped to .mat-ac-wrap) -->
<style>
.mat-ac-wrap { position: relative; }
.mat-ac-list {
  position: absolute; left: 0; right: 0; top: 100%;
  z-index: 50; margin-top: 4px;
  background: #fff; border: 1px solid #e2e8f0;
  border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,.10);
  max-height: 220px; overflow-y: auto;
  padding: 4px 0;
  display: none;
}
.mat-ac-list.open { display: block; }
.mat-ac-item {
  padding: 8px 14px; font-size: 13px; cursor: pointer;
  color: #334155; line-height: 1.4;
  transition: background .12s;
}
.mat-ac-item:hover, .mat-ac-item.active { background: #f1f5f9; }
.mat-ac-item-hint { font-size: 11px; color: #94a3b8; margin-left: 6px; }
.mat-ac-empty { padding: 10px 14px; font-size: 12px; color: #94a3b8; }
</style>

<form action="<%= _actionUrl %>" method="POST" class="px-8 py-7 space-y-6"
  id="report-form"
  data-session-type="<%= _sessionTypeValue %>"
  data-session-mode="<%= _sessionModeValue %>"
  data-uses-personal-internet="<%= _usesPersonalInternetValue %>"
  data-class-name="<%= _classNameValue %>"
  data-ac-students="<%= _acStudentsValue %>"
  data-ac-reduced-students="<%= _acReducedStudentsValue %>"
  data-absent-students="<%= _absentStudentsValue %>"
  data-competition-groups="<%= _competitionGroupsValue %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (_isEdit) { %>
    <input type="hidden" name="_method" value="PUT">
  <% } else { %>
    <!-- ── Draft Notification Banner ── -->
    <div id="draft-banner" class="hidden -mt-2 mb-4 bg-amber-50 border border-amber-200/80 rounded-2xl p-4 transition-all">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex-shrink-0 text-base">
            📝
          </span>
          <div>
            <p class="text-xs font-bold text-amber-900">Draft Restored</p>
            <p class="text-xs text-amber-700" id="draft-banner-text">We automatically restored your unsaved progress.</p>
          </div>
        </div>
        <button type="button" data-action="discardDraft"
          class="flex-shrink-0 inline-flex items-center gap-1 text-xs font-bold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-3 py-1.5 rounded-xl border border-rose-200 transition active:scale-95">
          Discard Draft
        </button>
      </div>
    </div>
  <% } %>

  <% if (_isAdmin && typeof teachers !== 'undefined' && teachers && teachers.length > 0) { %>
    <!-- Teacher Selector (Admin only) -->
    <div class="space-y-1.5">
      <label for="teacher" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
        Teacher <span class="text-red-500">*</span>
      </label>
      <div class="relative">
        <select id="teacher" name="teacher" required
          class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-10">
          <option value="" disabled <%= !_teacherValue ? 'selected' : '' %>>— Select teacher —</option>
          <% teachers.forEach(t => { %>
            <option value="<%= t._id %>" <%= String(_teacherValue) === String(t._id) ? 'selected' : '' %>><%= t.displayName %> (@<%= t.username %>)</option>
          <% }) %>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </div>
    </div>
    <div class="border-t border-slate-100"></div>
  <% } %>

  <!-- Row 1: Date & Class Name -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="space-y-1.5">
      <label for="date" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
        Teaching Date <span class="text-red-500">*</span>
      </label>
      <input type="date" id="date" name="date"
        value="<%= _dateValue %>"
        required
        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 font-mono focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
    </div>

    <!-- ── Group/Class Name with Autocomplete (group) / Free-text (private) / Multi-group (competition) ── -->
    <div class="space-y-1.5">
      <label id="class-name-label" for="class_name" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
        Group / Class Name <span class="text-red-500">*</span>
      </label>
      <!-- Group mode: autocomplete wrapper -->
      <div id="group-ac-wrap" class="relative">
        <input type="text" id="class_name" name="class_name"
          value="<%= _classNameValue %>"
          placeholder="Type to search groups…"
          autocomplete="off" required
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-10 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
        <!-- Clear button -->
        <button type="button" id="btn-clear-group"
          data-action="clearGroupSelection"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition"
          title="Clear group selection">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
        <!-- Autocomplete dropdown -->
        <div id="group-dropdown"
          class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-56 overflow-y-auto">
        </div>
      </div>
      <!-- Private mode: autocomplete wrapper (searches PRIVATE groups, also allows free-text) -->
      <div id="private-ac-wrap" class="hidden relative">
        <input type="text" id="private_name_input"
          placeholder="Type to search private students…"
          autocomplete="off"
          class="w-full rounded-xl border border-purple-200 bg-purple-50 px-4 py-2.5 pr-10 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100 transition" />
        <!-- Clear button -->
        <button type="button" id="btn-clear-private"
          data-action="clearPrivateSelection"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition"
          title="Clear private selection">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
        <!-- Autocomplete dropdown -->
        <div id="private-dropdown"
          class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-56 overflow-y-auto">
        </div>
      </div>
      <!-- Competition mode: multi-group picker -->
      <div id="competition-group-wrap" class="hidden">
        <div id="competition-selected-tags" class="flex flex-wrap gap-1.5 mb-2"></div>
        <div class="relative">
          <input type="text" id="competition-search"
            placeholder="Search groups to add…"
            autocomplete="off"
            class="w-full rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 pr-10 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition" />
          <div id="competition-dropdown"
            class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-56 overflow-y-auto">
          </div>
        </div>
        <p class="text-xs text-slate-400 mt-1"><span id="comp-group-count">0</span> group(s) selected — min 2 for competition</p>
        <p id="competition-error" class="hidden text-xs text-red-500 font-semibold mt-1"></p>
      </div>
      <p id="group-hint" class="text-xs text-slate-400">Type a name or select from your groups list.</p>
    </div>
  </div>

  <!-- Row 2: Session Type & Class Mode -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="space-y-2">
      <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Session Type</label>
      <div id="session-type-buttons" class="flex gap-2">
        <button type="button" id="btn-group"       class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" data-action="setSessionType" data-type="group">Group</button>
        <button type="button" id="btn-private"      class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" data-action="setSessionType" data-type="private">Private</button>
        <button type="button" id="btn-competition"   class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" data-action="setSessionType" data-type="competition">Competition</button>
      </div>
      <input type="hidden" name="session_type" id="session_type_input" value="<%= _sessionTypeValue %>">
      <input type="hidden" name="competition_groups" id="competition_groups_hidden" value="<%= _competitionGroupsValue %>">
    </div>
    <div class="space-y-2">
      <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Class Mode</label>
      <div class="flex gap-2">
        <button type="button" id="btn-offline" class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" data-action="setMode" data-mode="offline">Offline</button>
        <button type="button" id="btn-online"  class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" data-action="setMode" data-mode="online">Online</button>
      </div>
      <input type="hidden" name="session_mode" id="session_mode_input" value="<%= _sessionModeValue %>">
      <div id="personal-internet-wrapper" class="hidden">
        <label class="flex items-center gap-3 cursor-pointer bg-blue-50 border border-blue-100 rounded-xl px-4 py-3 mt-1">
          <input type="checkbox" name="uses_personal_internet" value="true" id="personal_internet_check"
            class="w-4 h-4 rounded border-blue-300 text-blue-600 focus:ring-blue-200 flex-shrink-0"
            <%= _usesPersonalInternetValue ? 'checked' : '' %>>
          <div>
            <p class="text-sm font-semibold text-blue-700">Personal Internet</p>
            <p class="text-xs text-blue-400 mt-0.5">Using own data / wifi</p>
          </div>
        </label>
      </div>
    </div>
  </div>

  <!-- Material (optional) -->
  <div class="space-y-1.5">
    <label for="subject" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
      Material <span class="ml-1 font-normal normal-case text-slate-400">— optional</span>
    </label>
    <div class="mat-ac-wrap">
      <input type="text" id="subject" name="subject"
        value="<%= _subjectValue %>"
        placeholder="e.g: Folder AA-BB"
        autocomplete="off"
        maxlength="100"
        class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
      <div id="subject-mat-ac-list" class="mat-ac-list" role="listbox" aria-label="Material suggestions"></div>
    </div>
    <%
      const _linkedMat = typeof report !== 'undefined' && report && report.material ? report.material : null;
      const _initialMatId = _linkedMat ? String(_linkedMat._id || _linkedMat) : '';
      const _initialHasContent = Boolean(_linkedMat && _linkedMat.hasContent);
    %>
    <!-- Open Material link — shown when selected or matching suggestion exists -->
    <div id="open-material-wrap"
      data-initial-material-id="<%= _initialMatId %>"
      data-initial-has-content="<%= _initialHasContent ? 'true' : 'false' %>"
      data-initial-subject="<%= _subjectValue %>"
      class="<%= _initialMatId ? '' : 'hidden' %> mt-1.5">
      <a id="open-material-link"
        href="<%= _initialMatId ? (_initialHasContent ? '/materials/' + _initialMatId : '/materials/' + _initialMatId + '/edit') : '#' %>"
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        <span id="open-material-text"><%= _initialHasContent ? 'Open material' : '+ Add material content' %></span>
      </a>
    </div>
  </div>

  <!-- Teaching Type & Duration -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="space-y-1.5">
      <label for="teaching_type" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Type <span class="text-red-500">*</span></label>
      <div class="relative">
        <select id="teaching_type" name="teaching_type" required
          class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-10">
          <option value="" disabled <%= !_teachingTypeValue ? 'selected' : '' %>>— Select type —</option>
          <% teachingTypes.forEach(type => { %>
          <option value="<%= type %>" <%= _teachingTypeValue === type ? 'selected' : '' %>><%= type %></option>
          <% }) %>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </div>
    </div>
    <div class="space-y-1.5">
      <label for="duration" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Duration (minute) <span class="text-red-500">*</span></label>
      <div class="relative">
        <input type="number" id="duration" name="duration"
          value="<%= _durationValue %>"
          placeholder="e.g: 60" min="1" required
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-16 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition font-mono" />
        <span class="absolute inset-y-0 right-4 flex items-center text-xs text-slate-400 font-medium pointer-events-none">minutes</span>
      </div>
      <p id="duration-hint" class="text-xs text-slate-400"></p>
    </div>
  </div>

  <!-- ── Partner Teacher (Assistant Teacher & 1/2 Prime Teacher) ── -->
  <div id="partner-teacher-section" class="hidden">
    <div class="rounded-2xl border border-sky-200 bg-sky-50/40 p-4 space-y-3">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
        <label id="partner-teacher-label" class="block text-xs font-semibold text-sky-700 uppercase tracking-wider"><%= _teachingTypeValue === '1/2 Prime Teacher' ? '1/2 Partner Teacher' : 'Prime Teacher' %> <span class="text-red-500">*</span></label>
      </div>
      <p id="partner-teacher-subtext" class="text-xs text-sky-500 -mt-1"><%= _teachingTypeValue === '1/2 Prime Teacher' ? 'Tag the partner 1/2 Prime Teacher for this split class. Search by name or type manually if not registered.' : 'Tag the Prime Teacher for this assisted class. Search by name or type manually if not registered.' %></p>

      <!-- Autocomplete input -->
      <div class="relative" id="partner-teacher-ac-wrap">
        <input type="text" id="partner_teacher_display"
          placeholder="Search registered teachers…"
          autocomplete="off"
          class="w-full rounded-xl border border-sky-200 bg-white px-4 py-2.5 pr-10 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-sky-400 focus:ring-2 focus:ring-sky-100 transition"
          value="<%= _partnerTeacherName %>" />
        <!-- Clear button -->
        <button type="button" id="btn-clear-partner"
          data-action="clearPartnerTeacher"
          class="<%= _partnerTeacherName ? '' : 'hidden' %> absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition"
          title="Clear partner teacher">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
        <!-- Dropdown -->
        <div id="partner-teacher-dropdown"
          class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-52 overflow-y-auto">
        </div>
      </div>

      <!-- Selected registered teacher pill -->
      <div id="partner-teacher-selected" class="<%= _partnerTeacherId ? '' : 'hidden' %>">
        <div class="inline-flex items-center gap-2 text-xs font-semibold bg-sky-100 text-sky-700 px-3 py-1.5 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
          <span id="partner-teacher-pill-name"><%= _partnerTeacherName %></span>
          <span class="text-sky-400 text-[10px] font-normal">· Registered</span>
        </div>
      </div>
      <p class="text-xs text-slate-400" id="partner-teacher-hint">
        <% if (!_partnerTeacherId && _partnerTeacherName) { %>Name saved manually — not linked to a registered account.<% } else if (!_partnerTeacherName) { %>Start typing to search. If not registered, the name will be saved as text.<% } %>
      </p>
    </div>
  </div>

  <!-- Hidden inputs for partner teacher data -->
  <input type="hidden" name="partner_teacher"      id="partner_teacher_hidden" value="<%= _partnerTeacherId %>">
  <input type="hidden" name="partner_teacher_name" id="partner_teacher_name_hidden" value="<%= _partnerTeacherName %>">

  <!-- Notes -->
  <div class="space-y-1.5">
    <label for="notes" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Notes</label>
    <textarea id="notes" name="notes" rows="3"
      placeholder="Notes for the class or student(s)"
      class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition resize-none"
    ><%= _notesValue %></textarea>
    <p class="text-xs text-slate-400 text-right"><span id="char-count">0</span>/1000</p>
  </div>

  <div class="border-t border-slate-100"></div>

  <!-- ══ STUDENT ROSTER (shown when a group is selected) ══ -->
  <div id="student-roster" class="hidden">
    <div class="rounded-2xl border border-brand-200 bg-brand-50/30 overflow-hidden">
      <!-- Roster Header -->
      <div class="px-5 py-3.5 border-b border-brand-100 flex items-center justify-between flex-wrap gap-2">
        <div>
          <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Students from</p>
          <h3 id="roster-group-name" class="text-sm font-bold text-slate-800 mt-0.5"></h3>
        </div>
        <div id="global-roster-actions" class="flex items-center gap-1.5 flex-wrap">
          <span id="roster-summary" class="text-xs text-slate-500 mr-1"></span>
          <button type="button" data-action="markAll" data-status="ac"
            class="text-xs font-semibold bg-emerald-100 hover:bg-emerald-200 text-emerald-700 px-2.5 py-1.5 rounded-lg transition">
            All AC
          </button>
          <button type="button" data-action="markAll" data-status="absent"
            class="text-xs font-semibold bg-red-100 hover:bg-red-200 text-red-600 px-2.5 py-1.5 rounded-lg transition">
            All Absent
          </button>
          <button type="button" data-action="markAll" data-status="clear"
            class="text-xs font-semibold bg-white hover:bg-slate-100 text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg transition">
            Clear
          </button>
        </div>
      </div>
      <!-- Student rows -->
      <div id="roster-students" class="px-4 py-3 space-y-1.5 max-h-72 overflow-y-auto">
      </div>
    </div>
  </div>

  <!-- ══ MANUAL INPUT (shown when no group selected) ══ -->
  <div id="manual-students-section">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-emerald-700 uppercase tracking-wider">Achievement Card (+AC)</label>
        <p class="text-xs text-slate-400 -mt-1">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd></p>
        <div id="ac-tag-box"
          class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-100 transition"
          data-action="focusInput" data-target="ac-input"></div>
        <input type="text" id="ac-input" placeholder="e.g: Darren" autocomplete="off"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 transition" />
        <p class="text-xs text-slate-400"><span id="ac-count">0</span> student(s) added</p>
      </div>
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-rose-700 uppercase tracking-wider">Deduct Card (−AC)</label>
        <p class="text-xs text-slate-400 -mt-1">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd></p>
        <div id="ac-reduced-tag-box"
          class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-rose-500 focus-within:ring-2 focus-within:ring-rose-100 transition"
          data-action="focusInput" data-target="ac-reduced-input"></div>
        <input type="text" id="ac-reduced-input" placeholder="e.g: Sarah" autocomplete="off"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition" />
        <p class="text-xs text-slate-400"><span id="ac-reduced-count">0</span> student(s) deducted</p>
      </div>
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Absent</label>
        <p class="text-xs text-slate-400 -mt-1">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd></p>
        <div id="absent-tag-box"
          class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-100 transition"
          data-action="focusInput" data-target="absent-input"></div>
        <input type="text" id="absent-input" placeholder="e.g: Michael" autocomplete="off"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition" />
        <p class="text-xs text-slate-400"><span id="absent-count">0</span> student(s) added</p>
      </div>
    </div>
  </div>

  <!-- Shared hidden inputs — always submitted -->
  <input type="hidden" name="ac_students"         id="ac-hidden"         value="<%= _acStudentsValue %>">
  <input type="hidden" name="ac_reduced_students" id="ac-reduced-hidden" value="<%= _acReducedStudentsValue %>">
  <input type="hidden" name="absent_students"     id="absent-hidden"     value="<%= _absentStudentsValue %>">

  <!-- Actions -->
  <div class="flex items-center justify-between pt-2">
    <a href="<%= _cancelUrl %>" id="cancel-btn" class="text-sm font-semibold text-slate-400 hover:text-slate-600 transition">Cancel</a>
    <button type="submit" id="btn-main-submit"
      class="inline-flex items-center gap-2 <%= _submitColorClass %> active:scale-95 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
      <% if (_isEdit) { %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      <% } else { %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
      <% } %>
      <span id="btn-submit-text"><%= _submitText %></span>
    </button>
  </div>
</form>

<% if (!_isEdit) { %>
<!-- ═══════════════════════════════════════════════════════════════
     BULK ADD: Additional Class Entries
     ═══════════════════════════════════════════════════════════════ -->

<!-- Bulk error display -->
<div id="bulk-errors" class="hidden mt-4">
  <div class="bg-red-50 border border-red-200 rounded-xl p-4">
    <div class="flex items-start gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
      </svg>
      <ul id="bulk-error-list" class="text-sm text-red-700 space-y-0.5"></ul>
    </div>
  </div>
</div>

<!-- Extra class entries container -->
<div id="bulk-extra-entries" class="space-y-4 mt-2"></div>

<!-- Add Another Class button -->
<div class="mt-4">
  <button type="button" id="btn-add-class"
    data-action="addBulkEntry"
    class="w-full inline-flex items-center justify-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 bg-white hover:bg-brand-50 border-2 border-dashed border-brand-200 hover:border-brand-400 px-6 py-3.5 rounded-2xl transition-all active:scale-[0.98] group">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    Add Another Class
  </button>
</div>

<!-- Bulk submit bar (shown when extra entries exist) -->
<div id="bulk-submit-bar" class="hidden mt-4">
  <div class="bg-gradient-to-r from-brand-600 to-brand-700 rounded-2xl px-6 py-4 flex items-center justify-between gap-4 shadow-lg shadow-brand-200/50">
    <div>
      <p class="text-white font-semibold text-sm"><span id="bulk-total-count">2</span> reports ready to save</p>
      <p class="text-brand-200 text-xs mt-0.5">Each class is saved as a separate, independent report</p>
    </div>
    <button type="button" id="btn-submit-bulk"
      data-action="submitBulkReports"
      class="inline-flex items-center gap-2 bg-white text-brand-700 font-semibold text-sm px-5 py-2.5 rounded-xl shadow transition hover:bg-brand-50 active:scale-95 flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
      </svg>
      <span id="bulk-submit-text">Save 2 Reports</span>
    </button>
  </div>
</div>
<% } %>

<script id="report-form-config" type="application/json"><%- _safeJson({ today: new Date().toISOString().substring(0,10), submitText: _submitText, cancelUrl: _cancelUrl }) %></script>
<script src="/js/pages/report-form.js"></script>

<% if (!_isEdit) { %>
<script id="bulk-teaching-types-json" type="application/json"><%- _safeJson(typeof teachingTypes !== 'undefined' ? teachingTypes : []) %></script>
<script id="bulk-is-admin-json" type="application/json"><%- _safeJson((_isAdmin) || false) %></script>
<script id="bulk-teachers-json" type="application/json"><%- _safeJson((typeof teachers !== 'undefined' && Array.isArray(teachers) && teachers.length > 0) ? teachers.map(function(t){ return { _id: String(t._id), displayName: t.displayName, username: t.username }; }) : []) %></script>
<script src="/js/pages/report-form-bulk.js"></script>
<% } %>
