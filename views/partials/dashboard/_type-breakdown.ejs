<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
  <div class="bg-emerald-50 rounded-xl border border-emerald-100 shadow-sm p-4">
    <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-1 truncate">Prime (Full)</p>
    <p class="text-2xl font-bold text-emerald-700"><%= stats.primeCount %> <span class="text-sm font-medium text-emerald-400">session(s)</span></p>
  </div>
  <div class="bg-purple-50 rounded-xl border border-purple-100 shadow-sm p-4">
    <p class="text-xs font-semibold text-purple-600 uppercase tracking-wider mb-1 truncate">Prime (Assisted)</p>
    <p class="text-2xl font-bold text-purple-700"><%= stats.primeAssistedCount %> <span class="text-sm font-medium text-purple-400">session(s)</span></p>
  </div>
  <div class="bg-sky-50 rounded-xl border border-sky-100 shadow-sm p-4">
    <p class="text-xs font-semibold text-sky-600 uppercase tracking-wider mb-1 truncate">Assistant</p>
    <p class="text-2xl font-bold text-sky-700"><%= stats.assistCount %> <span class="text-sm font-medium text-sky-400">session(s)</span></p>
  </div>
  <div class="bg-amber-50 rounded-xl border border-amber-100 shadow-sm p-4">
    <p class="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1 truncate">½ Prime</p>
    <p class="text-2xl font-bold text-amber-700"><%= stats.halfCount %> <span class="text-sm font-medium text-amber-400">session(s)</span></p>
  </div>
</div>
