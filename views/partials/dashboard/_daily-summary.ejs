<div data-live-section="dashboard-daily-summary" class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-6">
  <div class="px-4 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-sm font-bold text-slate-800">Daily Summary</h2>
      <p class="text-xs text-slate-400 mt-0.5">Click a row to view session details</p>
    </div>
    <span class="text-xs font-semibold text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full"><%= monthLabel %></span>
  </div>

  <% if (dailySummary.length === 0) { %>
    <div class="py-12 px-4 text-center flex flex-col items-center justify-center">
      <p class="text-slate-400 text-sm font-medium mb-3">No sessions recorded for <%= monthLabel %>.</p>
      <a href="/reports/new"
        class="min-h-[44px] inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs sm:text-sm font-semibold shadow-sm focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition active:scale-[0.98]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add report
      </a>
    </div>
  <% } else { %>

    <!-- Summary rows -->
    <div id="daily-table-view" class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
            <th class="px-4 sm:px-6 py-3 text-left whitespace-nowrap">Date</th>
            <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">Full</span><span class="sm:hidden">PF</span></th>
            <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">Prime</span><span class="sm:hidden">PA</span></th>
            <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">Assistant</span><span class="sm:hidden">AT</span></th>
            <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">½ Prime</span><span class="sm:hidden">½P</span></th>
            <th class="px-3 sm:px-6 py-3 text-center">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <%
            function countBadge(count, colorClass) {
              if (count > 0) {
                return '<span class="inline-flex items-center justify-center w-6 h-6 rounded-full ' + colorClass + ' text-xs font-bold">' + count + '</span>';
              }
              return '<span class="text-slate-200 text-xs">—</span>';
            }
          %>
          <% dailySummary.forEach(function(day, idx) { %>
            <tr class="hover:bg-brand-50 transition cursor-pointer group" onclick="showDayDetail('<%= idx %>')">
              <td class="px-4 sm:px-6 py-3.5 font-mono text-xs text-slate-700 whitespace-nowrap font-semibold">
                <%= new Date(day.date).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-3 sm:px-6 py-3.5 text-center"><%- countBadge(day.counts['Prime Teacher (Full)'],     'bg-emerald-100 text-emerald-700') %></td>
              <td class="px-3 sm:px-6 py-3.5 text-center"><%- countBadge(day.counts['Prime Teacher (Assisted)'], 'bg-purple-100 text-purple-700')  %></td>
              <td class="px-3 sm:px-6 py-3.5 text-center"><%- countBadge(day.counts['Assistant Teacher'],        'bg-sky-100 text-sky-700')         %></td>
              <td class="px-3 sm:px-6 py-3.5 text-center"><%- countBadge(day.counts['1/2 Prime Teacher'],        'bg-amber-100 text-amber-700')     %></td>
              <td class="px-3 sm:px-6 py-3.5 text-center">
                <span class="text-xs font-bold text-slate-600"><%= day.reports.length %></span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Detail view -->
    <div id="daily-detail-view" class="hidden">
      <div class="px-4 sm:px-6 py-3 border-b border-slate-100 flex items-center gap-3 flex-wrap">
        <button onclick="hideDayDetail()"
          class="flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-slate-800 transition px-3 py-1.5 rounded-lg hover:bg-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Back
        </button>
        <span id="detail-date-label" class="text-sm font-bold text-slate-800"></span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="w-10 sm:w-12 px-2 sm:px-3 py-3 text-center">#</th>
              <th class="px-3 sm:px-5 py-3 text-left">Class</th>
              <th class="px-3 sm:px-5 py-3 text-left hidden sm:table-cell">Subject</th>
              <th class="px-3 sm:px-5 py-3 text-left hidden sm:table-cell">Type</th>
              <th class="px-3 sm:px-5 py-3 text-left hidden md:table-cell">Duration</th>
              <th class="px-3 sm:px-5 py-3 text-left w-20">Action</th>
            </tr>
          </thead>
          <tbody id="detail-tbody" class="divide-y divide-slate-50"></tbody>
        </table>
      </div>
    </div>

  <% } %>
  <%# JSON data block: scripts cannot re-execute after innerHTML swap, so _scripts.ejs
      re-reads this element's textContent via the live:refreshed event handler. %>
  <script type="application/json" id="daily-data-json">
    <%- JSON.stringify(dailySummary.map(function (day) {
      return {
        dateLabel: new Date(day.date).toLocaleDateString('en-US', {
          weekday: 'long', day: '2-digit', month: 'long', year: 'numeric'
        }),
        reports: day.reports.map(function (r) {
          return {
            _id:                   String(r._id),
            createdAt:             r.createdAt ? r.createdAt : null,
            subject:               r.subject,
            materialId:            (r.material && (r.material._id || r.material)) ? String(r.material._id || r.material) : null,
            materialHasContent:    Boolean(r.material && r.material.hasContent),
            class_name:            (r.session_type === 'competition' && r.competition_groups && r.competition_groups.length > 0)
                                     ? r.competition_groups.join(' vs ')
                                     : r.class_name,
            teaching_type:         r.teaching_type,
            durationFormatted:     r.durationFormatted,
            session_mode:          r.session_mode          || 'offline',
            session_type:          r.session_type          || 'group',
            uses_personal_internet: r.uses_personal_internet || false,
          };
        }),
      };
    })) %>
  </script>
</div>
