<% if (typeof onboardingState !== 'undefined' && onboardingState && onboardingState.visible && !onboardingState.isComplete) { %>
  <!-- Onboarding Dashboard Card -->
  <section id="onboarding-card"
    data-done-count="<%= onboardingState.doneCount %>"
    data-total-count="<%= onboardingState.totalCount %>"
    class="mb-6 bg-white rounded-2xl border border-slate-100 shadow-sm p-5 sm:p-6 transition-all duration-300">

    <!-- Screen reader live announcement region -->
    <div id="onboarding-live-region" aria-live="polite" class="sr-only"></div>

    <!-- Card Header -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <h2 class="text-base font-bold text-slate-900">Getting started</h2>
        <span class="text-xs font-semibold text-brand-700 bg-brand-50 px-2.5 py-0.5 rounded-full border border-brand-200">
          <%= onboardingState.doneCount %> of <%= onboardingState.totalCount %> done
        </span>
      </div>
      <div class="flex items-center gap-2">
        <a href="/getting-started" class="text-xs font-semibold text-brand-600 hover:text-brand-700 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none rounded-lg px-2 py-1.5 transition">
          Open checklist
        </a>
      </div>
    </div>

      <!-- Accessible Progress Bar -->
      <div class="w-full bg-slate-100 rounded-full h-2 mb-5 overflow-hidden"
        role="progressbar"
        aria-valuenow="<%= onboardingState.percent %>"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-label="Getting started progress">
        <div class="bg-brand-600 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
      </div>

      <!-- Next Step Spotlight -->
      <% if (onboardingState.nextStep) { %>
        <div class="bg-brand-50/60 border border-brand-100 rounded-xl p-4 mb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="min-w-0">
            <span class="text-xs font-semibold text-brand-700">Next step</span>
            <p class="text-sm font-bold text-slate-900 mt-0.5"><%= onboardingState.nextStep.title %></p>
            <p class="text-xs text-slate-500 mt-0.5"><%= onboardingState.nextStep.why %></p>
          </div>
          <div class="flex items-center gap-2 self-stretch sm:self-auto flex-shrink-0">
            <% if (onboardingState.nextStep.optional) { %>
              <button type="button"
                data-onboarding-action="skip"
                data-step-key="<%= onboardingState.nextStep.key %>"
                class="min-h-[44px] px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-700 hover:bg-white focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition">
                Skip
              </button>
            <% } %>
            <a href="<%= onboardingState.nextStep.cta.href %>"
              class="min-h-[44px] flex-1 sm:flex-none inline-flex items-center justify-center px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition active:scale-[0.98]">
              <%= onboardingState.nextStep.cta.label %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </a>
          </div>
        </div>
      <% } %>

      <!-- Collapsible Steps List Toggle -->
      <div>
        <button type="button"
          id="onboarding-toggle-steps"
          aria-expanded="false"
          aria-controls="onboarding-steps-list"
          class="w-full flex items-center justify-between py-2 text-xs font-semibold text-slate-500 hover:text-slate-700 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none rounded-lg transition">
          <span id="onboarding-toggle-label">Show all steps (<%= onboardingState.steps.length %>)</span>
          <svg id="onboarding-toggle-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <!-- Steps List (collapsed by default) -->
        <div id="onboarding-steps-list" class="hidden divide-y divide-slate-100 pt-2 border-t border-slate-100 mt-1">
          <% onboardingState.steps.forEach(function(s, idx) { %>
            <div class="py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5">
              <div class="flex items-start gap-3 min-w-0">
                <!-- Status Icon -->
                <div class="mt-0.5 flex-shrink-0">
                  <% if (s.status === 'done') { %>
                    <span class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                    </span>
                  <% } else if (s.status === 'skipped') { %>
                    <span class="w-5 h-5 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center font-bold text-xs" title="Skipped">
                      –
                    </span>
                  <% } else { %>
                    <span class="w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center text-xs font-bold text-slate-400">
                      <%= idx + 1 %>
                    </span>
                  <% } %>
                </div>

                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <p class="text-sm font-semibold <%= s.status === 'done' ? 'text-slate-400 line-through' : 'text-slate-800' %> truncate">
                      <%= s.title %>
                    </p>
                    <% if (s.optional) { %>
                      <span class="text-[11px] font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Optional</span>
                    <% } %>
                    <% if (s.status === 'skipped') { %>
                      <span class="text-[11px] font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Skipped</span>
                    <% } %>
                  </div>
                  <p class="text-xs text-slate-500 mt-0.5"><%= s.why %></p>
                </div>
              </div>

              <!-- Step CTA & Action -->
              <div class="flex items-center gap-2 self-end sm:self-auto flex-shrink-0">
                <% if (s.status === 'todo') { %>
                  <% if (s.optional) { %>
                    <button type="button"
                      data-onboarding-action="skip"
                      data-step-key="<%= s.key %>"
                      class="min-h-[44px] px-3 py-2 text-xs font-semibold text-slate-400 hover:text-slate-600 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none rounded-lg transition">
                      Skip
                    </button>
                  <% } %>
                  <a href="<%= s.cta.href %>"
                    class="min-h-[44px] inline-flex items-center justify-center px-3.5 py-2 text-xs font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 rounded-xl focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none transition">
                    <%= s.cta.label %>
                  </a>
                <% } else if (s.status === 'done') { %>
                  <span class="text-xs font-semibold text-brand-600 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                    Done
                  </span>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

  </section>
  <script src="/js/onboarding.js" defer></script>
<% } %>
