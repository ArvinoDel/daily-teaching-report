<%
  const _isEdit = typeof isEdit !== 'undefined' ? isEdit : false;
  const _groupName = typeof groupName !== 'undefined' ? groupName : '';
  const _students = typeof students !== 'undefined' ? students : '';
  const _type = typeof type !== 'undefined' ? type : 'GROUP';
  const _level = typeof level !== 'undefined' ? level : '';
  const _LEVELS = typeof LEVELS !== 'undefined' ? LEVELS : [];
%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Left col: main fields -->
  <div class="lg:col-span-2 space-y-5">

    <!-- Group Name -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
      <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="group_name">
        Group Name <span class="text-red-500">*</span>
      </label>
      <input type="text" id="group_name" name="group_name"
        value="<%= _groupName %>" maxlength="100" required
        placeholder="e.g. Annisa's Group"
        class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-300 transition">
      <p class="text-xs text-slate-400 mt-1.5">Max 100 characters.</p>
    </div>

    <!-- Students -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
      <div class="flex items-center justify-between mb-1.5">
        <label class="block text-sm font-semibold text-slate-700" for="students">
          Students
          <span class="font-normal text-slate-400 ml-1">(<span id="student-count"><%= _students ? _students.split('\n').filter(l => l.trim().length > 0).length : 0 %></span>)</span>
        </label>
        <span class="text-xs text-slate-400">one name per line · max 200</span>
      </div>
      <textarea id="students" name="students" rows="<%= _isEdit ? 12 : 10 %>"
        placeholder="Annisa 11 N2&#10;Rafael B 11 CS&#10;Vivian 11 SM&#10;Callista 11 CS&#10;Roy 9 CS"
        oninput="updateCount(this)"
        class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-300 transition resize-y font-mono leading-relaxed"><%= _students %></textarea>
      <p class="text-xs text-slate-400 mt-1.5">Each non-empty line is treated as one student name.</p>
    </div>

  </div>

  <!-- Right col: type, level, actions -->
  <div class="space-y-5">

    <!-- Type -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
      <p class="text-sm font-semibold text-slate-700 mb-3">
        Type <span class="text-red-500">*</span>
      </p>
      <div class="space-y-2.5">
        <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl border-2 transition
          <%= (_type === 'GROUP') ? 'border-emerald-400 bg-emerald-50' : 'border-slate-100 hover:border-slate-200' %>">
          <input type="radio" name="type" value="GROUP"
            <%= (_type === 'GROUP') ? 'checked' : '' %>
            class="w-4 h-4 text-emerald-500 focus:ring-emerald-400" onchange="updateTypeCard()">
          <div>
            <p class="text-sm font-semibold text-slate-800">Group</p>
            <p class="text-xs text-slate-400">Multiple students in one class</p>
          </div>
        </label>
        <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl border-2 transition
          <%= (_type === 'PRIVATE') ? 'border-purple-400 bg-purple-50' : 'border-slate-100 hover:border-slate-200' %>">
          <input type="radio" name="type" value="PRIVATE"
            <%= (_type === 'PRIVATE') ? 'checked' : '' %>
            class="w-4 h-4 text-purple-500 focus:ring-purple-400" onchange="updateTypeCard()">
          <div>
            <p class="text-sm font-semibold text-slate-800">Private</p>
            <p class="text-xs text-slate-400">One-on-one or exclusive class</p>
          </div>
        </label>
      </div>
    </div>

    <!-- Level -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
      <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="level">Level</label>
      <input type="text" id="level" name="level" list="levels-list"
        value="<%= _level %>" maxlength="50"
        placeholder="e.g. PA, I1, B2…"
        class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-300 transition">
      <datalist id="levels-list">
        <% _LEVELS.forEach(function(l) { %><option value="<%= l %>"><% }) %>
      </datalist>
      <div class="mt-2 flex flex-wrap gap-1">
        <% _LEVELS.forEach(function(l) { %>
          <button type="button" onclick="document.getElementById('level').value='<%= l %>'"
            class="text-[11px] font-mono bg-slate-100 hover:bg-brand-100 hover:text-brand-700 text-slate-500 px-1.5 py-0.5 rounded transition
              <%= (_isEdit && _level === l) ? 'ring-1 ring-brand-400 bg-brand-50 text-brand-700' : '' %>">
            <%= l %>
          </button>
        <% }) %>
      </div>
      <% if (_isEdit && typeof LEVEL_LABELS !== 'undefined' && LEVEL_LABELS[_level]) { %>
        <p class="text-xs text-slate-400 mt-2">
          Category: <span class="font-semibold text-slate-600"><%= LEVEL_LABELS[_level] %></span>
        </p>
      <% } %>
      <p class="text-xs text-slate-400 mt-2">Click a chip or type any value.</p>
    </div>

    <!-- Meta Info Box (for Edit view) -->
    <% if (_isEdit && typeof group !== 'undefined') { %>
      <div class="bg-slate-50 rounded-2xl border border-slate-100 p-5 space-y-2">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Info</p>
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-500">Created</span>
          <span class="font-mono text-slate-600">
            <%= group.createdAt.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
          </span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-500">Last updated</span>
          <span class="font-mono text-slate-600">
            <%= group.updatedAt.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>
          </span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-500">Group ID</span>
          <span class="font-mono text-slate-400 text-[10px] truncate max-w-[120px]"><%= group._id %></span>
        </div>
      </div>
    <% } %>

    <!-- Submit/Cancel Actions -->
    <div class="flex flex-col gap-2">
      <button type="submit"
        class="w-full inline-flex items-center justify-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold px-5 py-3 rounded-xl shadow transition">
        <% if (_isEdit) { %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          Save Changes
        <% } else { %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Create Group
        <% } %>
      </button>
      <a href="/admin/groups"
        class="w-full text-center text-sm font-semibold text-slate-500 hover:text-slate-700 transition py-2.5 rounded-xl hover:bg-slate-100">
        Cancel
      </a>
      <% if (_isEdit && typeof group !== 'undefined') { %>
        <div class="border-t border-slate-100 pt-2 mt-1">
          <button type="button"
            data-delete-id="<%= group._id %>"
            data-name="<%= group.group_name.replace(/"/g, '&quot;') %>"
            onclick="deleteGroup(this)"
            class="w-full inline-flex items-center justify-center gap-2 text-red-500 hover:text-red-700 hover:bg-red-50 text-sm font-semibold px-5 py-2.5 rounded-xl transition border border-transparent hover:border-red-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Delete This Group
          </button>
        </div>
      <% } %>
    </div>

  </div>
</div>

<script>
  /* Live student count */
  function updateCount(textarea) {
    var lines = textarea.value.split('\n').filter(function (l) { return l.trim().length > 0; });
    var el = document.getElementById('student-count');
    if (el) el.textContent = lines.length;
  }

  /* Highlight active type card on radio change */
  function updateTypeCard() {
    document.querySelectorAll('input[name="type"]').forEach(function (radio) {
      var card = radio.closest('label');
      if (!card) return;
      if (radio.value === 'GROUP') {
        card.className = card.className.replace(/border-(purple|slate)-\S+\s?/g, '').replace(/bg-(purple|emerald)-50/g, '');
        card.classList.add(radio.checked ? 'border-emerald-400' : 'border-slate-100', radio.checked ? 'bg-emerald-50' : '');
      } else {
        card.className = card.className.replace(/border-(emerald|slate)-\S+\s?/g, '').replace(/bg-(emerald|purple)-50/g, '');
        card.classList.add(radio.checked ? 'border-purple-400' : 'border-slate-100', radio.checked ? 'bg-purple-50' : '');
      }
    });
  }
</script>
