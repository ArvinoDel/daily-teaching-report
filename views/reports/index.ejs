<%- include('../partials/header', { title: 'Dashboard' }) %>

  <!-- Success Toast -->
  <% if (successMessage) { %>
    <div id="toast"
      class="fixed top-20 right-4 z-50 bg-brand-600 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 transition-all duration-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <%= successMessage %>
    </div>
    <script>setTimeout(() => { const t = document.getElementById('toast'); if (t) { t.style.opacity='0'; t.style.transform='translateX(16px)'; } }, 3000);</script>
  <% } %>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
    <p class="text-slate-500 mt-1 text-sm">Summary of your teaching activities.</p>
  </div>

  <!-- All-time Stats Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 md:p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Reports</p>
      <p class="text-2xl md:text-3xl font-bold text-slate-900"><%= stats.totalReports %></p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 md:p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Total Hours</p>
      <p class="text-2xl md:text-3xl font-bold text-brand-600">
        <%= stats.totalHours %> <span class="text-sm font-medium text-slate-400">hr</span>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 md:p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">This Month</p>
      <p class="text-2xl md:text-3xl font-bold text-slate-900">
        <%= stats.monthlyReports %> <span class="text-sm font-medium text-slate-400">session(s)</span>
      </p>
    </div>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 md:p-5">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Hours This Month</p>
      <p class="text-2xl md:text-3xl font-bold text-slate-900">
        <%= stats.monthlyHours %> <span class="text-sm font-medium text-slate-400">hr</span>
      </p>
    </div>
  </div>

  <!-- Month Navigator -->
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-base font-bold text-slate-800">Monthly Overview</h2>
    <div class="flex items-center gap-2">
      <a href="/reports?month=<%= prevMonth %><%= selectedType ? '&teaching_type=' + encodeURIComponent(selectedType) : '' %>"
        class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-slate-800 transition shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
      </a>
      <span class="text-sm font-semibold text-slate-700 min-w-[130px] text-center"><%= monthLabel %></span>
      <% if (!isCurrentMonth) { %>
        <a href="/reports?month=<%= nextMonth %><%= selectedType ? '&teaching_type=' + encodeURIComponent(selectedType) : '' %>"
          class="w-8 h-8 flex items-center justify-center rounded-lg bg-white border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-slate-800 transition shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      <% } else { %>
        <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-50 border border-slate-100 text-slate-300 cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </span>
      <% } %>
    </div>
  </div>

  <!-- Teaching Type Breakdown -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
    <div class="bg-emerald-50 rounded-xl border border-emerald-100 shadow-sm p-4">
      <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-1 truncate">Prime (Full)</p>
      <p class="text-2xl font-bold text-emerald-700"><%= stats.primeCount %> <span class="text-sm font-medium text-emerald-400">session(s)</span></p>
    </div>
    <div class="bg-purple-50 rounded-xl border border-purple-100 shadow-sm p-4">
      <p class="text-xs font-semibold text-purple-600 uppercase tracking-wider mb-1 truncate">Prime (Assisted)</p>
      <p class="text-2xl font-bold text-purple-700"><%= stats.primeAssistedCount %> <span class="text-sm font-medium text-purple-400">session(s)</span></p>
    </div>
    <div class="bg-sky-50 rounded-xl border border-sky-100 shadow-sm p-4">
      <p class="text-xs font-semibold text-sky-600 uppercase tracking-wider mb-1 truncate">Assistant</p>
      <p class="text-2xl font-bold text-sky-700"><%= stats.assistCount %> <span class="text-sm font-medium text-sky-400">session(s)</span></p>
    </div>
    <div class="bg-amber-50 rounded-xl border border-amber-100 shadow-sm p-4">
      <p class="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1 truncate">½ Prime</p>
      <p class="text-2xl font-bold text-amber-700"><%= stats.halfCount %> <span class="text-sm font-medium text-amber-400">session(s)</span></p>
    </div>
  </div>

  <!-- Daily Summary Table -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-6">
    <div class="px-4 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-sm font-bold text-slate-800">Daily Summary</h2>
        <p class="text-xs text-slate-400 mt-0.5">Click a row to view session details</p>
      </div>
      <span class="text-xs font-semibold text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full"><%= monthLabel %></span>
    </div>

    <% if (dailySummary.length === 0) { %>
      <div class="py-12 text-center">
        <p class="text-slate-400 text-sm font-medium">No sessions recorded for <%= monthLabel %>.</p>
      </div>
    <% } else { %>
      <!-- Summary rows -->
      <div id="daily-table-view" class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-4 sm:px-6 py-3 text-left whitespace-nowrap">Date</th>
              <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">Prime (Full)</span><span class="sm:hidden">PF</span></th>
              <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">Prime (Assisted)</span><span class="sm:hidden">PA</span></th>
              <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">Assistant</span><span class="sm:hidden">AT</span></th>
              <th class="px-3 sm:px-6 py-3 text-center"><span class="hidden sm:inline">½ Prime</span><span class="sm:hidden">½P</span></th>
              <th class="px-3 sm:px-6 py-3 text-center">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% dailySummary.forEach(function(day, idx) { %>
              <tr class="hover:bg-brand-50 transition cursor-pointer group" onclick="showDayDetail(<%= idx %>)">
                <td class="px-4 sm:px-6 py-3.5 font-mono text-xs text-slate-700 whitespace-nowrap font-semibold">
                  <%= new Date(day.date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="px-3 sm:px-6 py-3.5 text-center">
                  <% if (day.counts['Prime Teacher (Full)'] > 0) { %><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold"><%= day.counts['Prime Teacher (Full)'] %></span><% } else { %><span class="text-slate-200 text-xs">—</span><% } %>
                </td>
                <td class="px-3 sm:px-6 py-3.5 text-center">
                  <% if (day.counts['Prime Teacher (Assisted)'] > 0) { %><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-purple-100 text-purple-700 text-xs font-bold"><%= day.counts['Prime Teacher (Assisted)'] %></span><% } else { %><span class="text-slate-200 text-xs">—</span><% } %>
                </td>
                <td class="px-3 sm:px-6 py-3.5 text-center">
                  <% if (day.counts['Assistant Teacher'] > 0) { %><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-sky-100 text-sky-700 text-xs font-bold"><%= day.counts['Assistant Teacher'] %></span><% } else { %><span class="text-slate-200 text-xs">—</span><% } %>
                </td>
                <td class="px-3 sm:px-6 py-3.5 text-center">
                  <% if (day.counts['1/2 Prime Teacher'] > 0) { %><span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-700 text-xs font-bold"><%= day.counts['1/2 Prime Teacher'] %></span><% } else { %><span class="text-slate-200 text-xs">—</span><% } %>
                </td>
                <td class="px-3 sm:px-6 py-3.5 text-center">
                  <span class="text-xs font-bold text-slate-600"><%= day.reports.length %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Detail view -->
      <div id="daily-detail-view" class="hidden">
        <div class="px-4 sm:px-6 py-3 border-b border-slate-100 flex items-center gap-3 flex-wrap">
          <button onclick="hideDayDetail()"
            class="flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-slate-800 transition px-3 py-1.5 rounded-lg hover:bg-slate-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            Back
          </button>
          <span id="detail-date-label" class="text-sm font-bold text-slate-800"></span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
                <th class="px-4 sm:px-6 py-3 text-left">Subject</th>
                <th class="px-4 sm:px-6 py-3 text-left hidden sm:table-cell">Class</th>
                <th class="px-4 sm:px-6 py-3 text-left hidden sm:table-cell">Type</th>
                <th class="px-4 sm:px-6 py-3 text-left hidden md:table-cell">Duration</th>
                <th class="px-4 sm:px-6 py-3 text-left">Action</th>
              </tr>
            </thead>
            <tbody id="detail-tbody" class="divide-y divide-slate-50"></tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <!-- All Reports List -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-4 sm:px-6 py-4 border-b border-slate-100 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold text-slate-600 mr-1 w-full sm:w-auto">Type Filter:</span>
      <a href="/reports<%= !isCurrentMonth ? '?month=' + selectedMonthStr : '' %>"
        class="text-xs font-semibold px-3 py-1.5 rounded-full transition <%= selectedType === '' ? 'bg-brand-600 text-white shadow' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
        All
      </a>
      <% teachingTypes.forEach(function(type) { %>
        <a href="/reports?<%= !isCurrentMonth ? 'month=' + selectedMonthStr + '&' : '' %>teaching_type=<%= encodeURIComponent(type) %>"
          class="text-xs font-semibold px-3 py-1.5 rounded-full transition <%= selectedType === type ? 'bg-brand-600 text-white shadow' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
          <%= type %>
        </a>
      <% }) %>
    </div>

    <% if (reports.length === 0) { %>
      <div class="py-20 text-center">
        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <p class="text-slate-400 font-medium">No reports found.</p>
        <a href="/reports/new" class="mt-3 inline-block text-brand-600 text-sm font-semibold hover:underline">+ Add your first report</a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-4 sm:px-6 py-3 text-left whitespace-nowrap">Date</th>
              <th class="px-4 sm:px-6 py-3 text-left">Subject</th>
              <th class="px-4 sm:px-6 py-3 text-left hidden md:table-cell">Class</th>
              <th class="px-4 sm:px-6 py-3 text-left hidden sm:table-cell">Type</th>
              <th class="px-4 sm:px-6 py-3 text-left hidden md:table-cell">Duration</th>
              <th class="px-4 sm:px-6 py-3 text-left">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% reports.forEach(function(report) { %>
              <tr class="hover:bg-slate-50 transition group">
                <td class="px-4 sm:px-6 py-4 font-mono text-xs text-slate-500 whitespace-nowrap">
                  <%= new Date(report.date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="px-4 sm:px-6 py-4 font-semibold text-slate-800 max-w-[140px] sm:max-w-none truncate">
                  <%= report.subject %>
                </td>
                <td class="px-4 sm:px-6 py-4 text-slate-600 hidden md:table-cell"><%= report.class_name %></td>
                <td class="px-4 sm:px-6 py-4 hidden sm:table-cell">
                  <% const color = typeBadgeColor[report.teaching_type] || 'slate'; %>
                  <span class="badge-<%= color %> text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap"><%= report.teaching_type %></span>
                </td>
                <td class="px-4 sm:px-6 py-4 font-mono text-xs text-slate-500 hidden md:table-cell whitespace-nowrap"><%= report.durationFormatted %></td>
                <td class="px-4 sm:px-6 py-4">
                  <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition">
                    <a href="/reports/<%= report._id %>" class="text-slate-400 hover:text-brand-600 transition" title="Detail">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                    </a>
                    <a href="/reports/<%= report._id %>/edit" class="text-slate-400 hover:text-amber-500 transition" title="Edit">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                    </a>
                    <button type="button" onclick="openDeleteModal('/reports/<%= report._id %>')" class="text-slate-400 hover:text-red-500 transition" title="Delete">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Delete Modal -->
  <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center px-4">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-xl p-7 w-full max-w-sm z-10">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-11 h-11 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
        </div>
        <div>
          <h3 class="font-bold text-slate-900">Delete this report?</h3>
          <p class="text-sm text-slate-400 mt-0.5">This action cannot be undone.</p>
        </div>
      </div>
      <div class="flex gap-3 mt-6">
        <button type="button" onclick="closeDeleteModal()" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
        <button type="button" id="confirm-delete-btn" class="flex-1 py-2.5 px-6 rounded-xl bg-red-500 hover:bg-red-600 text-white text-sm font-semibold transition">Delete</button>
      </div>
    </div>
  </div>

  <script>
    // ─── Daily detail data ───────────────────────────────────────────────
    const dailyData = <%- JSON.stringify(dailySummary.map(function(day) { return {
      dateLabel: new Date(day.date).toLocaleDateString('id-ID', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }),
      reports: day.reports.map(function(r) { return {
        _id: r._id,
        subject: r.subject,
        class_name: r.class_name,
        teaching_type: r.teaching_type,
        durationFormatted: r.durationFormatted,
      }; })
    }; })) %>;

    const badgeMap = {
      'Prime Teacher (Full)':     'badge-emerald',
      'Prime Teacher (Assisted)': 'badge-purple',
      'Assistant Teacher':        'badge-sky',
      '1/2 Prime Teacher':        'badge-amber',
    };

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function showDayDetail(idx) {
      const day = dailyData[idx];
      if (!day) return;
      document.getElementById('detail-date-label').textContent = day.dateLabel;
      document.getElementById('detail-tbody').innerHTML = day.reports.map(function(r) {
        return '<tr class="hover:bg-slate-50 transition group">' +
          '<td class="px-4 sm:px-6 py-4 font-semibold text-slate-800">' + escHtml(r.subject) + '</td>' +
          '<td class="px-4 sm:px-6 py-4 text-slate-600 hidden sm:table-cell">' + escHtml(r.class_name) + '</td>' +
          '<td class="px-4 sm:px-6 py-4 hidden sm:table-cell"><span class="' + (badgeMap[r.teaching_type]||'') + ' text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap">' + escHtml(r.teaching_type) + '</span></td>' +
          '<td class="px-4 sm:px-6 py-4 font-mono text-xs text-slate-500 hidden md:table-cell whitespace-nowrap">' + escHtml(r.durationFormatted) + '</td>' +
          '<td class="px-4 sm:px-6 py-4"><div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition">' +
          '<a href="/reports/' + r._id + '" class="text-slate-400 hover:text-brand-600 transition" title="Detail"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.573-3.007-9.964-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg></a>' +
          '<a href="/reports/' + r._id + '/edit" class="text-slate-400 hover:text-amber-500 transition" title="Edit"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg></a>' +
          '<button onclick="openDeleteModal(\'/reports/' + r._id + '\')" class="text-slate-400 hover:text-red-500 transition" title="Delete"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg></button>' +
          '</div></td></tr>';
      }).join('');
      document.getElementById('daily-table-view').classList.add('hidden');
      document.getElementById('daily-detail-view').classList.remove('hidden');
    }

    function hideDayDetail() {
      document.getElementById('daily-table-view').classList.remove('hidden');
      document.getElementById('daily-detail-view').classList.add('hidden');
    }

    // ─── Delete modal ────────────────────────────────────────────────────
    let deleteTargetUrl = null;

    function openDeleteModal(url) {
      deleteTargetUrl = url;
      document.getElementById('delete-modal').classList.remove('hidden');
    }

    function closeDeleteModal() {
      deleteTargetUrl = null;
      document.getElementById('delete-modal').classList.add('hidden');
    }

    document.getElementById('confirm-delete-btn').addEventListener('click', async function () {
      if (!deleteTargetUrl) return;
      this.disabled = true;
      this.textContent = 'Deleting...';
      try {
        const res = await fetch(deleteTargetUrl, { method: 'DELETE', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (res.ok || res.redirected) {
          window.location.href = '/reports';
        } else {
          alert('Failed to delete. Please try again.');
          this.disabled = false;
          this.textContent = 'Delete';
        }
      } catch (err) {
        alert('Network error. Please try again.');
        this.disabled = false;
        this.textContent = 'Delete';
      }
    });

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDeleteModal(); });
  </script>

