<%- include('../partials/header', { title: 'Dashboard' }) %>

  <!-- Success Toast -->
  <% if (successMessage) { %>
    <div id="toast"
      class="fixed top-20 right-4 z-50 bg-brand-600 text-white text-sm font-medium px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
      <%= successMessage %>
    </div>
    <script>setTimeout(() => { const t = document.getElementById('toast'); if (t) t.style.opacity = '0'; }, 3000);</script>
    <% } %>

      <!-- Page Header -->
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
        <p class="text-slate-500 mt-1 text-sm">Summary of your teaching activities.</p>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Reports Total</p>
          <p class="text-3xl font-bold text-slate-900">
            <%= stats.totalReports %>
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Teaching Hours Total</p>
          <p class="text-3xl font-bold text-brand-600">
            <%= stats.totalHours %> <span class="text-base font-medium text-slate-400">jam</span>
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">This Month</p>
          <p class="text-3xl font-bold text-slate-900">
            <%= stats.monthlyReports %> <span class="text-base font-medium text-slate-400">sesi</span>
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Teaching Hour in This Month</p>
          <p class="text-3xl font-bold text-slate-900">
            <%= stats.monthlyHours %> <span class="text-base font-medium text-slate-400">jam</span>
          </p>
        </div>
      </div>

      <!-- Tambahkan setelah baris penutup </div> dari grid stats sebelumnya -->
      <div class="grid grid-cols-3 gap-4 mb-8">
        <div class="bg-emerald-50 rounded-2xl border border-emerald-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-1">Prime Teacher</p>
          <p class="text-3xl font-bold text-emerald-700">
            <%= stats.primeCount %> <span class="text-base font-medium text-emerald-400">sesi</span>
          </p>
        </div>
        <div class="bg-sky-50 rounded-2xl border border-sky-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-sky-600 uppercase tracking-wider mb-1">Assistant Teacher</p>
          <p class="text-3xl font-bold text-sky-700">
            <%= stats.assistCount %> <span class="text-base font-medium text-sky-400">sesi</span>
          </p>
        </div>
        <div class="bg-amber-50 rounded-2xl border border-amber-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1">½ Prime Teacher</p>
          <p class="text-3xl font-bold text-amber-700">
            <%= stats.halfCount %> <span class="text-base font-medium text-amber-400">sesi</span>
          </p>
        </div>
      </div>

      <!-- Filter & List -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <!-- Filter Bar -->
        <div class="px-6 py-4 border-b border-slate-100 flex flex-wrap items-center gap-3">
          <span class="text-sm font-semibold text-slate-600">Type Filter:</span>
          <a href="/reports"
            class="text-xs font-semibold px-3 py-1.5 rounded-full transition <%= selectedType === '' ? 'bg-brand-600 text-white shadow' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            All
          </a>
          <% teachingTypes.forEach(type=> { %>
            <a href="/reports?teaching_type=<%= encodeURIComponent(type) %>"
              class="text-xs font-semibold px-3 py-1.5 rounded-full transition <%= selectedType === type ? 'bg-brand-600 text-white shadow' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
              <%= type %>
            </a>
            <% }) %>
        </div>

        <!-- Table -->
        <% if (reports.length===0) { %>
          <div class="py-20 text-center">
            <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
              </svg>
            </div>
            <p class="text-slate-400 font-medium">The report is still empty.</p>
            <a href="/reports/new" class="mt-3 inline-block text-brand-600 text-sm font-semibold hover:underline">+ Add
              your first summary</a>
          </div>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
                    <th class="px-6 py-3 text-left">Date</th>
                    <th class="px-6 py-3 text-left">Material</th>
                    <th class="px-6 py-3 text-left">Group/Private</th>
                    <th class="px-6 py-3 text-left">Type</th>
                    <th class="px-6 py-3 text-left">Duration</th>
                    <th class="px-6 py-3 text-left">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                  <% reports.forEach(report=> { %>
                    <tr class="hover:bg-slate-50 transition group">
                      <td class="px-6 py-4 font-mono text-xs text-slate-500 whitespace-nowrap">
                        <%= new Date(report.date).toLocaleDateString('id-ID', { day: '2-digit' , month: 'short' ,
                          year: 'numeric' }) %>
                      </td>
                      <td class="px-6 py-4 font-semibold text-slate-800">
                        <%= report.subject %>
                      </td>
                      <td class="px-6 py-4 text-slate-600">
                        <%= report.class_name %>
                      </td>
                      <td class="px-6 py-4">
                        <% const color=typeBadgeColor[report.teaching_type] || 'slate' ; %>
                          <span class="badge-<%= color %> text-xs font-semibold px-2.5 py-1 rounded-full">
                            <%= report.teaching_type %>
                          </span>
                      </td>
                      <td class="px-6 py-4 font-mono text-xs text-slate-500">
                        <%= report.durationFormatted %>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition">
                          <a href="/reports/<%= report._id %>" class="text-slate-400 hover:text-brand-600 transition"
                            title="Detail">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                              stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.573-3.007-9.964-7.178Z" />
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                          </a>
                          <a href="/reports/<%= report._id %>/edit"
                            class="text-slate-400 hover:text-amber-500 transition" title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                              stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                            </svg>
                          </a>
                          <button type="button" onclick="openDeleteModal('/reports/<%= report._id %>?_method=DELETE')"
                            class="text-slate-400 hover:text-red-500 transition" title="Hapus">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                              stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
      </div>

      <!-- Delete Confirmation Modal -->
      <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeDeleteModal()"></div>

        <!-- Dialog -->
        <div class="relative bg-white rounded-2xl shadow-xl p-7 w-full max-w-sm mx-4 z-10">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-11 h-11 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900">Delete this summary?</h3>
              <p class="text-sm text-slate-400 mt-0.5">This action can't be changed.</p>
            </div>
          </div>

          <div class="flex gap-3 mt-6">
            <button onclick="closeDeleteModal()"
              class="flex-1 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
              Cancel
            </button>
            <form id="delete-form" method="POST">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit"
                class="flex-1 py-2.5 px-6 rounded-xl bg-red-500 hover:bg-red-600 text-white text-sm font-semibold transition">
                Delete
              </button>
            </form>
          </div>
        </div>
      </div>

      <script>
        function openDeleteModal(action) {
          document.getElementById('delete-form').action = action;
          document.getElementById('delete-modal').classList.remove('hidden');
        }
        function closeDeleteModal() {
          document.getElementById('delete-modal').classList.add('hidden');
        }
        // Close on Escape key
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDeleteModal(); });
      </script>
      <%- include('../partials/footer') %>