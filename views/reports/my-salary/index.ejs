<%- include('../../partials/header', { title: 'My Salary' }) %>

<!-- ── Page Header ── -->
<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-900">My Salary</h1>
  <p class="text-slate-500 text-sm mt-0.5">CV Fond of English — Your salary slips, published by admin.</p>
</div>

<% if (!rows || rows.length === 0) { %>
  <!-- Empty state -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm py-20 text-center">
    <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
      </svg>
    </div>
    <p class="text-slate-500 font-medium text-sm mb-1">No salary slips yet</p>
    <p class="text-slate-400 text-xs">Your salary slips will appear here once admin publishes them.</p>
  </div>

<% } else { %>

  <!-- Salary Slip Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% rows.forEach(function(s) { %>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 overflow-hidden">

        <!-- Card Header -->
        <div class="bg-gradient-to-r from-brand-600 to-brand-800 px-5 py-4">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-xs font-semibold text-brand-200 uppercase tracking-wider mb-0.5">Payslip</p>
              <p class="text-white font-bold text-base"><%= s.monthLabel %></p>
              <p class="text-brand-200 text-xs mt-0.5"><%= s.periodLabel || '—' %></p>
            </div>
            <span class="text-xs font-bold px-2 py-1 rounded-full mt-0.5
              <%= s.status === 'paid' ? 'bg-sky-400/20 text-sky-100' : 'bg-emerald-400/20 text-emerald-100' %>">
              <%= s.status === 'paid' ? 'Paid' : 'Sent' %>
            </span>
          </div>
        </div>

        <!-- Card Body -->
        <div class="px-5 py-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs text-slate-400 font-medium">Take-Home Pay</span>
            <% if (s.payDateLabel) { %>
              <span class="text-xs text-slate-400">Pay: <%= s.payDateLabel %></span>
            <% } %>
          </div>
          <p class="text-2xl font-extrabold text-brand-700 font-mono tracking-tight"><%= s.totalSalaryFormatted %></p>

          <% if (s.teacherTenureAtPeriod) { %>
            <p class="text-xs text-slate-400 mt-2">Tenure: <span class="font-semibold text-slate-600"><%= s.teacherTenureAtPeriod %></span></p>
          <% } %>

          <!-- Mini breakdown -->
          <div class="mt-3 pt-3 border-t border-slate-100 grid grid-cols-2 gap-2 text-xs">
            <div>
              <p class="text-slate-400">Gross</p>
              <p class="font-semibold text-emerald-600 font-mono">
                Rp&nbsp;<%= Number(s.subtotalIncomes || 0).toLocaleString('en-US') %>
              </p>
            </div>
            <div>
              <p class="text-slate-400">Deductions</p>
              <p class="font-semibold text-red-500 font-mono">
                - Rp&nbsp;<%= Number(s.subtotalDeductions || 0).toLocaleString('en-US') %>
              </p>
            </div>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="px-5 pb-4">
          <a href="/reports/my-salary/<%= s._id %>/slip"
            class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-brand-50 hover:border-brand-200 hover:text-brand-700 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            View &amp; Print Slip
          </a>
        </div>
      </div>
    <% }); %>
  </div>

<% } %>

<%- include('../../partials/footer') %>
