<%- include('../../partials/header', { title: 'Payslip — ' + teacher.displayName }) %>

<%
  function fmtIDR(n) {
    if (!n || n === 0) return 'Rp\u00a00';
    return 'Rp\u00a0' + Number(n).toLocaleString('en-US');
  }
  const sp = salary;
  const t  = teacher;

  const earningLines = [
    { label: '1. Basic Salary',                                                    value: sp.basicSalary },
    { label: '2. Meal (Full) ' + (sp.mealFullDays||0) + '\u00d7' + fmtIDR(sp.mealFullRate),   value: sp.mealFullTotal },
    { label: '3. Meal (Half) ' + (sp.mealHalfDays||0) + '\u00d7' + fmtIDR(sp.mealHalfRate),   value: sp.mealHalfTotal },
    { label: '4. Transport ' + (sp.transportDays||0) + '\u00d7' + fmtIDR(sp.transportRate),    value: sp.transportTotal },
    { label: '5. Monthly Incentive',                                               value: sp.monthlyIncentive },
    { label: '6. Health Allowance',                                                value: sp.healthAllowance },
    { label: '7. Position Allowance',                                              value: sp.positionAllowance },
    { label: '8. Loyalty Allowance',                                               value: sp.loyaltyAllowance },
    { label: '9. Wife / Child Allowance',                                          value: sp.wifeChildAllowance },
    { label: '10. Teaching Reward',                                                value: sp.teachingReward },
    { label: '11. Game Reward',                                                    value: sp.gameReward },
    { label: '12. Student Commission',                                             value: sp.studentCommission },
    { label: '13. Internet / Electricity Compensation',                            value: sp.internetCompensation },
    { label: '14. Overtime',                                                       value: sp.overtime },
    ...(sp.otherIncomes || []).map(function(i, idx) {
      return { label: (15 + idx) + '. ' + (i.label || 'Other Income'), value: i.amount };
    }),
  ];

  const deductLines = [
    { label: '1. Installment',               value: sp.instalment },
    { label: '2. Miscellaneous Deduction',   value: sp.miscellaneousDeduction },
    { label: '3. BPJS Employment',           value: sp.bpjsKetenagakerjaan },
    { label: '4. Last Month\'s Tax (PPH)',   value: sp.tax },
    ...(sp.otherDeductions || []).map(function(i, idx) {
      return { label: (5 + idx) + '. ' + (i.label || 'Other Deduction'), value: i.amount };
    }),
  ];
%>

<!-- ── Screen-only top bar ── -->
<div class="no-print mb-6 flex items-center gap-3">
  <a href="/reports/my-salary"
    class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
    </svg>
  </a>
  <div>
    <h1 class="text-xl font-bold text-slate-900">Payslip</h1>
    <p class="text-slate-500 text-sm"><%= sp.periodLabel || (sp.month + '/' + sp.year) %></p>
  </div>
  <button onclick="window.print()"
    class="ml-auto no-print inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z"/>
    </svg>
    Print / Save PDF
  </button>
</div>

<!-- ═══════════════════════════════════════════════
     PAYSLIP DOCUMENT
═══════════════════════════════════════════════ -->
<div id="payslip" class="bg-white rounded-2xl shadow-lg border border-slate-100 max-w-2xl mx-auto overflow-hidden print-page">

  <!-- Company Header -->
  <div class="bg-gradient-to-r from-brand-700 to-brand-900 px-8 py-6 text-white">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-brand-300 mb-1">Payslip</p>
        <h1 class="text-2xl font-extrabold tracking-tight">CV Fond of English</h1>
        <p class="text-brand-200 text-sm mt-0.5">Lembaga Bimbingan Belajar</p>
      </div>
      <div class="text-right">
        <p class="text-xs text-brand-300 font-semibold uppercase tracking-wide">Pay Date</p>
        <p class="text-lg font-bold text-white"><%= sp.payDateLabel || (sp.payDate ? new Date(sp.payDate).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) : '—') %></p>
      </div>
    </div>
  </div>

  <!-- Employee Info -->
  <div class="px-8 py-5 border-b border-slate-100 bg-slate-50/60">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Employee</p>
        <p class="font-bold text-slate-900 text-lg"><%= t.displayName %></p>
        <p class="text-slate-500 text-sm">@<%= t.username %></p>
      </div>
      <div class="text-right">
        <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold mb-0.5">Period</p>
        <p class="font-semibold text-slate-700 text-sm"><%= sp.periodLabel || (sp.month + '/' + sp.year) %></p>
        <% if (sp.teacherTenureAtPeriod) { %>
          <p class="text-xs text-slate-400 mt-0.5">Tenure: <span class="font-semibold text-slate-600"><%= sp.teacherTenureAtPeriod %></span></p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Earnings + Deductions -->
  <div class="px-8 py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- Earnings -->
      <div>
        <h3 class="text-xs font-bold text-emerald-700 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Earnings
        </h3>
        <div class="space-y-1.5">
          <% earningLines.forEach(function(line) { %>
            <div class="flex justify-between items-start py-1 border-b border-slate-50 <%= line.value > 0 ? '' : 'opacity-30' %>">
              <span class="text-xs text-slate-600 pr-2 leading-relaxed"><%= line.label %></span>
              <span class="text-xs font-mono font-semibold <%= line.value > 0 ? 'text-slate-800' : 'text-slate-300' %> whitespace-nowrap">
                <%= line.value > 0 ? fmtIDR(line.value) : '—' %>
              </span>
            </div>
          <% }); %>
        </div>
        <div class="flex justify-between items-center mt-3 pt-3 border-t-2 border-emerald-200">
          <span class="text-sm font-bold text-slate-700">Subtotal</span>
          <span class="font-mono font-bold text-emerald-700 text-sm"><%= fmtIDR(sp.subtotalIncomes) %></span>
        </div>
      </div>

      <!-- Deductions -->
      <div>
        <h3 class="text-xs font-bold text-red-600 uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15"/></svg>
          Deductions
        </h3>
        <div class="space-y-1.5">
          <% deductLines.forEach(function(line) { %>
            <div class="flex justify-between items-start py-1 border-b border-slate-50 <%= line.value > 0 ? '' : 'opacity-30' %>">
              <span class="text-xs text-slate-600 pr-2 leading-relaxed"><%= line.label %></span>
              <span class="text-xs font-mono font-semibold <%= line.value > 0 ? 'text-red-600' : 'text-slate-300' %> whitespace-nowrap">
                <%= line.value > 0 ? fmtIDR(line.value) : '—' %>
              </span>
            </div>
          <% }); %>
        </div>
        <div class="flex justify-between items-center mt-3 pt-3 border-t-2 border-red-200">
          <span class="text-sm font-bold text-slate-700">Subtotal</span>
          <span class="font-mono font-bold text-red-600 text-sm"><%= fmtIDR(sp.subtotalDeductions) %></span>
        </div>
      </div>
    </div>

    <!-- Net Total -->
    <div class="mt-6 bg-gradient-to-r from-brand-600 to-brand-800 rounded-xl px-6 py-4 flex items-center justify-between">
      <span class="text-white font-bold text-sm uppercase tracking-wider">Total Take-Home Pay</span>
      <span class="font-mono font-extrabold text-white text-xl"><%= fmtIDR(sp.totalSalary) %></span>
    </div>

    <% if (sp.notes) { %>
    <div class="mt-4 bg-amber-50 border border-amber-100 rounded-xl px-4 py-3">
      <p class="text-xs font-semibold text-amber-700 mb-0.5">Notes</p>
      <p class="text-xs text-amber-800"><%= sp.notes %></p>
    </div>
    <% } %>
  </div>

  <!-- Signature Section -->
  <div class="px-8 pb-8 pt-2">
    <div class="grid grid-cols-2 gap-12 mt-4">
      <div class="text-center">
        <p class="text-xs text-slate-500 mb-12">Received by,</p>
        <div class="border-b border-slate-300 mb-1"></div>
        <p class="text-xs font-semibold text-slate-700"><%= t.displayName %></p>
        <p class="text-xs text-slate-400">Employee</p>
      </div>
      <div class="text-center">
        <p class="text-xs text-slate-500 mb-12">Approved by,</p>
        <div class="border-b border-slate-300 mb-1"></div>
        <p class="text-xs font-semibold text-slate-700">CV Fond of English</p>
        <p class="text-xs text-slate-400">Management</p>
      </div>
    </div>
    <p class="text-center text-xs text-slate-300 mt-6">
      This payslip is generated electronically by CV Fond of English Payroll System.
    </p>
  </div>
</div>

<style>
  @media print {
    body { background: white !important; }
    .no-print { display: none !important; }
    nav, footer, main > *:not(#payslip) { display: none !important; }
    #payslip {
      box-shadow: none !important;
      border: none !important;
      border-radius: 0 !important;
      max-width: 100% !important;
      margin: 0 !important;
    }
    .print-page { page-break-after: avoid; }
    main { padding: 0 !important; max-width: 100% !important; }
  }
</style>

<%- include('../../partials/footer') %>
