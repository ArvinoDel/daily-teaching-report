<%- include('../partials/header', { title: report.subject }) %>

<div class="max-w-2xl mx-auto">
  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Kembali ke Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <!-- Header -->
    <div class="px-8 pt-7 pb-6 border-b border-slate-100 flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-mono text-slate-400 mb-1"><%= report.dateFormatted %></p>
        <h1 class="text-xl font-bold text-slate-900"><%= report.subject %></h1>
        <p class="text-slate-500 text-sm mt-1"><%= report.class_name %></p>
      </div>
      <% const color = typeBadgeColor[report.teaching_type] || 'slate'; %>
      <span class="badge-<%= color %> text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap flex-shrink-0">
        <%= report.teaching_type %>
      </span>
    </div>

    <!-- Details -->
    <div class="px-8 py-7 space-y-5">
      <div class="grid grid-cols-2 gap-5">
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Durasi</p>
          <p class="text-lg font-bold text-slate-900"><%= report.durationFormatted %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Kelas</p>
          <p class="text-lg font-bold text-slate-900"><%= report.class_name %></p>
        </div>
      </div>

      <% if (report.notes) { %>
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Catatan Kegiatan</p>
        <div class="bg-slate-50 rounded-xl p-4 text-sm text-slate-700 leading-relaxed whitespace-pre-wrap"><%= report.notes %></div>
      </div>
      <% } %>

      <p class="text-xs text-slate-300 font-mono">Dibuat: <%= report.createdAt.toLocaleString('id-ID') %></p>
    </div>

    <!-- Actions -->
    <div class="px-8 py-5 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
      <form action="/reports/<%= report._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Hapus laporan ini secara permanen?')">
        <button type="submit" class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-500 hover:text-red-700 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
          Hapus Laporan
        </button>
      </form>
      <a href="/reports/<%= report._id %>/edit"
        class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold text-sm px-5 py-2 rounded-xl shadow transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
        Edit Laporan
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
