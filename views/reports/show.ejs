<%- include('../partials/header', { title: report.subject }) %>

<div class="max-w-2xl mx-auto">
  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <!-- Header -->
    <div class="px-8 pt-7 pb-6 border-b border-slate-100 flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-mono text-slate-400 mb-1"><%= report.dateFormatted %></p>
        <h1 class="text-xl font-bold text-slate-900"><%= report.subject %></h1>
        <p class="text-slate-500 text-sm mt-1"><%= report.class_name %></p>
      </div>
      <% const color = typeBadgeColor[report.teaching_type] || 'slate'; %>
      <span class="badge-<%= color %> text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap flex-shrink-0">
        <%= report.teaching_type %>
      </span>
    </div>

    <!-- Details -->
    <div class="px-8 py-7 space-y-5">
      <div class="grid grid-cols-2 gap-5">
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Durasi</p>
          <p class="text-lg font-bold text-slate-900"><%= report.durationFormatted %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Kelas</p>
          <p class="text-lg font-bold text-slate-900"><%= report.class_name %></p>
        </div>
      </div>

      <!-- Achievement Card -->
      <% if (report.ac_students && report.ac_students.length > 0) { %>
      <div>
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
          </svg>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Achievement Card</p>
          <span class="text-xs font-bold bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full"><%= report.ac_students.length %></span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <% report.ac_students.forEach(s => { %>
            <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-700 text-xs font-semibold px-2.5 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              <%= s %>
            </span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Absent -->
      <% if (report.absent_students && report.absent_students.length > 0) { %>
      <div>
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Absent</p>
          <span class="text-xs font-bold bg-red-100 text-red-600 px-2 py-0.5 rounded-full"><%= report.absent_students.length %></span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <% report.absent_students.forEach(s => { %>
            <span class="inline-flex items-center gap-1 bg-red-100 text-red-600 text-xs font-semibold px-2.5 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
              <%= s %>
            </span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (report.notes) { %>
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Catatan Kegiatan</p>
        <div class="bg-slate-50 rounded-xl p-4 text-sm text-slate-700 leading-relaxed whitespace-pre-wrap"><%= report.notes %></div>
      </div>
      <% } %>

      <p class="text-xs text-slate-300 font-mono">Dibuat: <%= report.createdAt.toLocaleString('id-ID') %></p>
    </div>

    <!-- Actions -->
    <div class="px-8 py-5 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
      <form action="/reports/<%= report._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Do you want to delete this?')">
        <button type="submit" class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-500 hover:text-red-700 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
          Delete Report
        </button>
      </form>
      <a href="/reports/<%= report._id %>/edit"
        class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold text-sm px-5 py-2 rounded-xl shadow transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
        Edit Report
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
