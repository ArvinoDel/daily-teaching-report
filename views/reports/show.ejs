<%- include('../partials/header', { title: report.subject || report.class_name }) %>

<div class="max-w-2xl mx-auto">
  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">

    <!-- Header — blue tint when online -->
    <div class="px-8 pt-7 pb-6 border-b flex items-start justify-between gap-4
      <%= report.session_mode === 'online' ? 'bg-blue-50 border-blue-100' : 'border-slate-100' %>">
      <div>
        <p class="text-xs font-mono text-slate-400 mb-1"><%= report.dateFormatted %></p>
        <h1 class="text-xl font-bold text-slate-900">
          <%= report.subject ? report.subject : report.class_name %>
        </h1>
        <% if (report.subject) { %>
          <p class="text-slate-500 text-sm mt-1"><%= report.class_name %></p>
        <% } %>

        <!-- Mode & Type badges row -->
        <div class="flex flex-wrap items-center gap-2 mt-3">
          <!-- Online / Offline -->
          <% if (report.session_mode === 'online') { %>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-100 text-blue-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 0 1 1.06 0Z" />
              </svg>
              Online
            </span>
            <% if (report.uses_personal_internet) { %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-50 text-blue-500 border border-blue-200">
                Personal Internet
              </span>
            <% } %>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              Offline
            </span>
          <% } %>

          <!-- Group / Private -->
          <% if (report.session_type === 'private') { %>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-purple-100 text-purple-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
              Private
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-100 text-brand-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
              </svg>
              Group
            </span>
          <% } %>
        </div>
      </div>

      <!-- Teaching type badge -->
      <% const color = typeBadgeColor[report.teaching_type] || 'slate'; %>
      <span class="badge-<%= color %> text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap flex-shrink-0">
        <%= report.teaching_type %>
      </span>
    </div>

    <!-- Details -->
    <div class="px-8 py-7 space-y-5">
      <div class="grid grid-cols-2 gap-5">
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Duration(s)</p>
          <p class="text-lg font-bold text-slate-900"><%= report.durationFormatted %></p>
        </div>
        <div class="bg-slate-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Class</p>
          <p class="text-lg font-bold text-slate-900"><%= report.class_name %></p>
        </div>
      </div>

      <!-- Achievement Card -->
      <% if (report.ac_students && report.ac_students.length > 0) { %>
      <div>
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0" />
          </svg>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Achievement Card</p>
          <span class="text-xs font-bold bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full"><%= report.ac_students.length %></span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <% report.ac_students.forEach(s => { %>
            <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-700 text-xs font-semibold px-2.5 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              <%= s %>
            </span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Absent -->
      <% if (report.absent_students && report.absent_students.length > 0) { %>
      <div>
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Absent</p>
          <span class="text-xs font-bold bg-red-100 text-red-600 px-2 py-0.5 rounded-full"><%= report.absent_students.length %></span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <% report.absent_students.forEach(s => { %>
            <span class="inline-flex items-center gap-1 bg-red-100 text-red-600 text-xs font-semibold px-2.5 py-1 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              <%= s %>
            </span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (report.notes) { %>
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Catatan Kegiatan</p>
        <div class="bg-slate-50 rounded-xl p-4 text-sm text-slate-700 leading-relaxed whitespace-pre-wrap"><%= report.notes %></div>
      </div>
      <% } %>

      <p class="text-xs text-slate-300 font-mono">Dibuat: <%= report.createdAt.toLocaleString('id-ID') %></p>
    </div>

    <!-- Actions -->
    <div class="px-8 py-5 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
      <button type="button" id="btn-delete-report"
        data-delete-url="/reports/<%= report._id %>"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-500 hover:text-red-700 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
        Delete Report
      </button>
      <a href="/reports/<%= report._id %>/edit"
        class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold text-sm px-5 py-2 rounded-xl shadow transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
        Edit Report
      </a>
    </div>
  </div>
</div>

<script>
  document.getElementById('btn-delete-report').addEventListener('click', function () {
    var deleteUrl = this.dataset.deleteUrl;
    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    csrfToken = csrfToken ? csrfToken.getAttribute('content') : '';

    Swal.fire({
      title: 'Delete this report?',
      text: 'This action cannot be undone.',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Yes, delete it!',
      cancelButtonText: 'Cancel',
      reverseButtons: true,
      focusCancel: true,
      customClass: {
        popup: 'rounded-2xl',
        confirmButton: 'rounded-xl',
        cancelButton: 'rounded-xl',
      },
    }).then(function (result) {
      if (!result.isConfirmed) return;

      Swal.fire({
        title: 'Deleting…',
        text: 'Please wait.',
        allowOutsideClick: false,
        allowEscapeKey: false,
        showConfirmButton: false,
        didOpen: function () { Swal.showLoading(); },
      });

      fetch(deleteUrl, {
        method: 'DELETE',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'x-csrf-token': csrfToken,
        },
      })
        .then(function (res) {
          if (res.ok || res.redirected) {
            Swal.fire({
              title: 'Deleted!',
              text: 'The report has been removed.',
              icon: 'success',
              confirmButtonColor: '#16a34a',
              customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' },
              timer: 1500,
              showConfirmButton: false,
            }).then(function () {
              window.location.href = '/reports';
            });
          } else {
            Swal.fire({
              title: 'Error',
              text: 'Failed to delete. Please try again.',
              icon: 'error',
              confirmButtonColor: '#ef4444',
              customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' },
            });
          }
        })
        .catch(function () {
          Swal.fire({
            title: 'Network Error',
            text: 'Could not reach the server. Please try again.',
            icon: 'error',
            confirmButtonColor: '#ef4444',
            customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl' },
          });
        });
    });
  });
</script>

<%- include('../partials/footer') %>
