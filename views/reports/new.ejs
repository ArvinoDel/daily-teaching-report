<%- include('../partials/header', { title: 'Add Report' }) %>

<!-- Embedded groups data for autocomplete -->
<script id="groups-json" type="application/json"><%- groupsJson %></script>

<div class="max-w-2xl mx-auto">

  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-8 pt-7 pb-6 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold text-slate-900">Add Teaching Report</h1>
          <p class="text-slate-400 text-xs mt-0.5">Required fill all fields marked with *</p>
        </div>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="mx-8 mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
        <ul class="text-sm text-red-700 space-y-0.5">
          <% errors.forEach(err => { %><li><%= err %></li><% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <form action="/reports" method="POST" class="px-8 py-7 space-y-6"
      id="report-form"
      data-session-type="<%= formData.session_type || 'group' %>"
      data-session-mode="<%= formData.session_mode || 'offline' %>"
      data-uses-personal-internet="<%= formData.uses_personal_internet === 'true' %>"
      data-competition-groups="<%= formData.competition_groups || '' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Row 1: Date & Class Name -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label for="date" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
            Date <span class="text-red-500">*</span>
          </label>
          <input type="date" id="date" name="date"
            value="<%= formData.date || new Date().toISOString().substring(0,10) %>"
            required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 font-mono focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
        </div>

        <!-- ── Group/Class Name with Autocomplete (group) / Free-text (private) ── -->
        <div class="space-y-1.5">
          <label id="class-name-label" for="class_name" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
            Group / Class Name <span class="text-red-500">*</span>
          </label>
          <!-- Group mode: autocomplete wrapper -->
          <div id="group-ac-wrap" class="relative">
            <input type="text" id="class_name" name="class_name"
              value="<%= formData.class_name || '' %>"
              placeholder="Type to search groups…"
              autocomplete="off" required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-10 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
            <!-- Clear button: shown when a group is selected -->
            <button type="button" id="btn-clear-group"
              onclick="clearGroupSelection()"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition"
              title="Clear group selection">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
            <!-- Autocomplete dropdown -->
            <div id="group-dropdown"
              class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-56 overflow-y-auto">
            </div>
          </div>
          <!-- Private mode: plain free-text input (shares the same name="class_name" via JS swap) -->
          <input type="text" id="private_name_input"
            placeholder="e.g: John Doe"
            autocomplete="off"
            class="hidden w-full rounded-xl border border-purple-200 bg-purple-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100 transition" />
          <!-- Competition mode: multi-group picker (hidden by default) -->
          <div id="competition-group-wrap" class="hidden">
            <div id="competition-selected-tags" class="flex flex-wrap gap-1.5 mb-2"></div>
            <div class="relative">
              <input type="text" id="competition-search"
                placeholder="Search groups to add…"
                autocomplete="off"
                class="w-full rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 pr-10 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition" />
              <div id="competition-dropdown"
                class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-56 overflow-y-auto">
              </div>
            </div>
            <p class="text-xs text-slate-400 mt-1"><span id="comp-group-count">0</span> group(s) selected — min 2 for competition</p>
          </div>
          <p id="group-hint" class="text-xs text-slate-400">Type a name or select from your groups list.</p>
        </div>
      </div>

      <!-- Row 2: Session Type & Class Mode -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-2">
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Session Type</label>
          <div class="flex gap-2">
            <button type="button" id="btn-group"       class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setSessionType('group')">Group</button>
            <button type="button" id="btn-private"      class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setSessionType('private')">Private</button>
            <button type="button" id="btn-competition"   class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setSessionType('competition')">Competition</button>
          </div>
          <input type="hidden" name="session_type" id="session_type_input" value="<%= formData.session_type || 'group' %>">
          <input type="hidden" name="competition_groups" id="competition_groups_hidden" value="<%= formData.competition_groups || '' %>">
        </div>
        <div class="space-y-2">
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Class Mode</label>
          <div class="flex gap-2">
            <button type="button" id="btn-offline" class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setMode('offline')">Offline</button>
            <button type="button" id="btn-online"  class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setMode('online')">Online</button>
          </div>
          <input type="hidden" name="session_mode" id="session_mode_input" value="<%= formData.session_mode || 'offline' %>">
          <div id="personal-internet-wrapper" class="hidden">
            <label class="flex items-center gap-3 cursor-pointer bg-blue-50 border border-blue-100 rounded-xl px-4 py-3 mt-1">
              <input type="checkbox" name="uses_personal_internet" value="true" id="personal_internet_check"
                class="w-4 h-4 rounded border-blue-300 text-blue-600 focus:ring-blue-200 flex-shrink-0"
                <%= formData.uses_personal_internet === 'true' ? 'checked' : '' %>>
              <div>
                <p class="text-sm font-semibold text-blue-700">Personal Internet</p>
                <p class="text-xs text-blue-400 mt-0.5">Using own data / wifi</p>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Material (optional) -->
      <div class="space-y-1.5">
        <label for="subject" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
          Material <span class="ml-1 font-normal normal-case text-slate-400">— optional</span>
        </label>
        <input type="text" id="subject" name="subject"
          value="<%= formData.subject || '' %>"
          placeholder="e.g: Folder AA-BB"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
      </div>

      <!-- Teaching Type & Duration -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label for="teaching_type" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Type <span class="text-red-500">*</span></label>
          <div class="relative">
            <select id="teaching_type" name="teaching_type" required
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-10">
              <option value="" disabled <%= !formData.teaching_type ? 'selected' : '' %>>— Select type —</option>
              <% teachingTypes.forEach(type => { %>
              <option value="<%= type %>" <%= formData.teaching_type === type ? 'selected' : '' %>><%= type %></option>
              <% }) %>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
        </div>
        <div class="space-y-1.5">
          <label for="duration" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Duration (minute) <span class="text-red-500">*</span></label>
          <div class="relative">
            <input type="number" id="duration" name="duration"
              value="<%= formData.duration || '' %>"
              placeholder="e.g: 60" min="1" required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-16 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition font-mono" />
            <span class="absolute inset-y-0 right-4 flex items-center text-xs text-slate-400 font-medium pointer-events-none">minutes</span>
          </div>
          <p id="duration-hint" class="text-xs text-slate-400"></p>
        </div>
      </div>

      <!-- Notes -->
      <div class="space-y-1.5">
        <label for="notes" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Notes</label>
        <textarea id="notes" name="notes" rows="3"
          placeholder="Notes for the class or student(s)"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition resize-none"
        ><%= formData.notes || '' %></textarea>
        <p class="text-xs text-slate-400 text-right"><span id="char-count">0</span>/1000</p>
      </div>

      <div class="border-t border-slate-100"></div>

      <!-- ══ STUDENT ROSTER (shown when a group is selected) ══ -->
      <div id="student-roster" class="hidden">
        <div class="rounded-2xl border border-brand-200 bg-brand-50/30 overflow-hidden">
          <!-- Roster Header -->
          <div class="px-5 py-3.5 border-b border-brand-100 flex items-center justify-between flex-wrap gap-2">
            <div>
              <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Students from</p>
              <h3 id="roster-group-name" class="text-sm font-bold text-slate-800 mt-0.5"></h3>
            </div>
            <div id="global-roster-actions" class="flex items-center gap-1.5 flex-wrap">
              <span id="roster-summary" class="text-xs text-slate-500 mr-1"></span>
              <button type="button" onclick="markAll('ac')"
                class="text-xs font-semibold bg-emerald-100 hover:bg-emerald-200 text-emerald-700 px-2.5 py-1.5 rounded-lg transition">
                All AC
              </button>
              <button type="button" onclick="markAll('absent')"
                class="text-xs font-semibold bg-red-100 hover:bg-red-200 text-red-600 px-2.5 py-1.5 rounded-lg transition">
                All Absent
              </button>
              <button type="button" onclick="markAll('clear')"
                class="text-xs font-semibold bg-white hover:bg-slate-100 text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg transition">
                Clear
              </button>
            </div>
          </div>
          <!-- Student rows -->
          <div id="roster-students" class="px-4 py-3 space-y-1.5 max-h-72 overflow-y-auto">
          </div>
        </div>
        <!-- Hidden inputs are still submitted -->
      </div>

      <!-- ══ MANUAL INPUT (shown when no group selected) ══ -->
      <div id="manual-students-section">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Achievement Card (AC)</label>
            <p class="text-xs text-slate-400 -mt-1">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd> to add</p>
            <div id="ac-tag-box"
              class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-100 transition"
              onclick="document.getElementById('ac-input').focus()"></div>
            <input type="text" id="ac-input" placeholder="e.g: Darren" autocomplete="off"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 transition" />
            <p class="text-xs text-slate-400"><span id="ac-count">0</span> student(s) added</p>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Absent</label>
            <p class="text-xs text-slate-400 -mt-1">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd> to add</p>
            <div id="absent-tag-box"
              class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-100 transition"
              onclick="document.getElementById('absent-input').focus()"></div>
            <input type="text" id="absent-input" placeholder="e.g: Michael" autocomplete="off"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition" />
            <p class="text-xs text-slate-400"><span id="absent-count">0</span> student(s) added</p>
          </div>
        </div>
      </div>

      <!-- Shared hidden inputs — always submitted -->
      <input type="hidden" name="ac_students"     id="ac-hidden"     value="<%= formData.ac_students || '' %>">
      <input type="hidden" name="absent_students" id="absent-hidden" value="<%= formData.absent_students || '' %>">

      <!-- Actions -->
      <div class="flex items-center justify-between pt-2">
        <a href="/reports" class="text-sm font-semibold text-slate-400 hover:text-slate-600 transition">Cancel</a>
        <button type="submit"
          class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 active:scale-95 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Save Report
        </button>
      </div>
    </form>
  </div>
</div>

<script>
/* ═══════════════════════════════════════════════════════════════
   Shared helpers
═══════════════════════════════════════════════════════════════ */
function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

var MAX_AC_COUNT = 5;

/* ═══════════════════════════════════════════════════════════════
   Session type & mode toggles
═══════════════════════════════════════════════════════════════ */
function setSessionType(type) {
  document.getElementById('session_type_input').value = type;
  var bG = document.getElementById('btn-group'), bP = document.getElementById('btn-private'), bC = document.getElementById('btn-competition');
  var classInput      = document.getElementById('class_name');
  var privateInput    = document.getElementById('private_name_input');
  var groupAcWrap     = document.getElementById('group-ac-wrap');
  var compWrap        = document.getElementById('competition-group-wrap');
  var groupHint       = document.getElementById('group-hint');
  var classNameLabel  = document.getElementById('class-name-label');

  var inactiveCls = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';

  if (type === 'group') {
    bG.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-brand-500 bg-brand-50 text-brand-700';
    bP.className = inactiveCls;
    bC.className = inactiveCls;
    groupAcWrap.classList.remove('hidden');
    privateInput.classList.add('hidden');
    compWrap.classList.add('hidden');
    privateInput.removeAttribute('name');
    classInput.setAttribute('name', 'class_name');
    classInput.required = true;
    groupHint.classList.remove('hidden');
    classNameLabel.innerHTML = 'Group / Class Name <span class="text-red-500">*</span>';
  } else if (type === 'private') {
    bG.className = inactiveCls;
    bP.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-purple-400 bg-purple-50 text-purple-700';
    bC.className = inactiveCls;
    if (selectedGroup) { clearGroupSelection(); }
    groupAcWrap.classList.add('hidden');
    compWrap.classList.add('hidden');
    classInput.removeAttribute('name');
    classInput.required = false;
    privateInput.classList.remove('hidden');
    privateInput.setAttribute('name', 'class_name');
    privateInput.required = true;
    if (!privateInput.value && classInput.value) privateInput.value = classInput.value;
    groupHint.classList.add('hidden');
    classNameLabel.innerHTML = 'Student Name <span class="text-red-500">*</span>';
    // Clear competition state
    competitionSelectedIds = [];
    renderCompetitionTags();
  } else if (type === 'competition') {
    bG.className = inactiveCls;
    bP.className = inactiveCls;
    bC.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-orange-500 bg-orange-50 text-orange-700';
    if (selectedGroup) { clearGroupSelection(); }
    groupAcWrap.classList.add('hidden');
    privateInput.classList.add('hidden');
    compWrap.classList.remove('hidden');
    classInput.removeAttribute('name');
    classInput.required = false;
    privateInput.removeAttribute('name');
    privateInput.required = false;
    groupHint.classList.remove('hidden');
    classNameLabel.innerHTML = 'Competition Groups <span class="text-red-500">*</span>';
    groupHint.innerHTML = '<span class="inline-flex items-center gap-1 text-orange-600 font-semibold">' +
      '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0"/></svg>' +
      'Select 2 or more groups for the competition</span>';
    groupHint.className = 'text-xs';
    // Rebuild competition roster if groups already selected
    renderCompetitionRoster();
  }
}
function setMode(mode) {
  document.getElementById('session_mode_input').value = mode;
  var bOff = document.getElementById('btn-offline'), bOn = document.getElementById('btn-online');
  var piW  = document.getElementById('personal-internet-wrapper');
  if (mode === 'online') {
    bOn.className  = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-blue-500 bg-blue-50 text-blue-700';
    bOff.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
    piW.classList.remove('hidden');
  } else {
