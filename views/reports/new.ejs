<%- include('../partials/header', { title: 'Add Report' }) %>

<!-- Embedded groups data for autocomplete -->
<script id="groups-json" type="application/json"><%- groupsJson %></script>

<div class="max-w-2xl mx-auto">

  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-8 pt-7 pb-6 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold text-slate-900">Add Teaching Report</h1>
          <p class="text-slate-400 text-xs mt-0.5">Required fill all fields marked with *</p>
        </div>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="mx-8 mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
        <ul class="text-sm text-red-700 space-y-0.5">
          <% errors.forEach(err => { %><li><%= err %></li><% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <%- include('../partials/reports/report-form', {
      isEdit: false,
      isAdmin: (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'superadmin')),
      actionUrl: '/reports',
      cancelUrl: '/reports',
      dateValue: formData.date || new Date().toISOString().substring(0, 10),
      classNameValue: formData.class_name || '',
      sessionTypeValue: formData.session_type || 'group',
      sessionModeValue: formData.session_mode || 'offline',
      usesPersonalInternetValue: formData.uses_personal_internet === 'true',
      competitionGroupsValue: formData.competition_groups || '',
      subjectValue: formData.subject || '',
      teachingTypeValue: formData.teaching_type || '',
      durationValue: formData.duration || '',
      notesValue: formData.notes || '',
      acStudentsValue: formData.ac_students || '',
      absentStudentsValue: formData.absent_students || '',
      teachingTypes: teachingTypes,
      teacherValue: formData.teacher || (typeof currentUser !== 'undefined' && currentUser ? currentUser._id : ''),
      teachers: typeof teachers !== 'undefined' ? teachers : []
    }) %>

  </div>
</div>

<%- include('../partials/footer') %>
