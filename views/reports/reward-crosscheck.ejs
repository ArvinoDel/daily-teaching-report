<%- include('../partials/header', { title: 'Reward Crosscheck' }) %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">

  <!-- ═══ PAGE HEADER ═══ -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-amber-100 text-amber-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 4.556-4.03 8.25-9 8.25S3 16.556 3 12 7.03 3.75 12 3.75 21 7.444 21 12Z" />
          </svg>
        </span>
        <h1 class="text-xl font-bold text-slate-800">Teaching Reward Crosscheck</h1>
      </div>
      <p class="text-xs text-slate-400 ml-10">Upload your supervisor's reward sheet image to compare against your recorded sessions.</p>
    </div>
    <a href="/reports" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-700 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 transition self-start sm:self-auto">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
      Back to Dashboard
    </a>
  </div>

  <!-- ═══ COMMISSION WARNING ═══ -->
  <% if (!hasCommission) { %>
  <div class="flex items-start gap-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <span>Commission prices not set. <a href="/profile/edit" class="font-bold underline">Set them in Edit Profile</a> to enable Rupiah discrepancy calculation.</span>
  </div>
  <% } %>

  <!-- ═══ STEP 1: PERIOD SELECTOR ═══ -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
      <span class="w-5 h-5 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center flex-shrink-0">1</span>
      <h2 class="text-sm font-bold text-slate-800">Select Period</h2>
    </div>
    <div class="px-5 py-4 flex flex-wrap items-end gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Month</label>
        <select id="sel-month" class="text-sm font-semibold text-slate-700 border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-400 bg-white">
          <% const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
             for (let mi = 0; mi < 12; mi++) { %>
            <option value="<%= mi + 1 %>" <%= selectedMonth === mi + 1 ? 'selected' : '' %>><%= monthNames[mi] %></option>
          <% } %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Year</label>
        <select id="sel-year" class="text-sm font-semibold text-slate-700 border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-400 bg-white">
          <% const cyear = new Date().getFullYear(); for (let yi = cyear - 2; yi <= cyear + 1; yi++) { %>
            <option value="<%= yi %>" <%= selectedYear === yi ? 'selected' : '' %>><%= yi %></option>
          <% } %>
        </select>
      </div>
      <button id="btn-load-period" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-sm transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
        Load My Reports
      </button>
      <div id="period-status" class="text-xs text-slate-400 font-medium hidden">
        <span id="period-status-text"></span>
      </div>
    </div>
  </div>

  <!-- ═══ STEP 2: IMAGE UPLOAD ═══ -->
  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
      <span class="w-5 h-5 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center flex-shrink-0">2</span>
      <h2 class="text-sm font-bold text-slate-800">Upload Supervisor's Reward Sheet</h2>
    </div>
    <div class="px-5 py-5">
      <!-- Dropzone -->
      <div id="dropzone"
        class="relative border-2 border-dashed border-slate-200 rounded-xl p-8 text-center cursor-pointer hover:border-brand-400 hover:bg-brand-50/30 transition group"
        onclick="document.getElementById('img-upload').click()"
        ondragover="event.preventDefault(); this.classList.add('border-brand-400','bg-brand-50/40')"
        ondragleave="this.classList.remove('border-brand-400','bg-brand-50/40')"
        ondrop="handleDrop(event)">
        <input type="file" id="img-upload" accept="image/*" class="hidden" onchange="handleFileSelect(event)">
        <div class="flex flex-col items-center gap-3">
          <div class="w-14 h-14 rounded-full bg-slate-100 group-hover:bg-brand-100 flex items-center justify-center transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-slate-300 group-hover:text-brand-500 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-600 group-hover:text-brand-700 transition">Drop image here or <span class="text-brand-600">browse</span></p>
            <p class="text-xs text-slate-400 mt-1">Or press <kbd class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">Ctrl+V</kbd> to paste from clipboard</p>
          </div>
        </div>
      </div>

      <!-- Image preview -->
      <div id="img-preview-wrap" class="hidden mt-4">
        <div class="flex items-start gap-4">
          <img id="img-preview" src="" alt="Preview" class="rounded-xl border border-slate-200 max-h-48 object-contain shadow-sm cursor-pointer" onclick="openImgModal()">
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-slate-600 truncate" id="img-name"></p>
            <p class="text-xs text-slate-400 mt-0.5" id="img-size"></p>
            <button id="btn-run-ocr" class="mt-3 inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold px-4 py-2 rounded-lg shadow-sm transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
              Extract Data (OCR)
            </button>
            <button onclick="resetImage()" class="mt-2 ml-2 text-xs font-semibold text-slate-400 hover:text-red-500 transition">✕ Remove</button>
          </div>
        </div>

        <!-- OCR Progress -->
        <div id="ocr-progress-wrap" class="hidden mt-4 bg-slate-50 rounded-xl px-4 py-3">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-4 h-4 border-2 border-brand-400 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-xs font-semibold text-slate-600" id="ocr-status-text">Initializing OCR engine...</span>
          </div>
          <div class="w-full bg-slate-200 rounded-full h-1.5">
            <div id="ocr-progress-bar" class="bg-brand-500 h-1.5 rounded-full transition-all duration-300" style="width:0%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ STEP 3: EDITABLE SUPERVISOR TABLE ═══ -->
  <div id="supervisor-table-section" class="hidden bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center flex-shrink-0">3</span>
        <h2 class="text-sm font-bold text-slate-800">Review &amp; Edit Extracted Data</h2>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="addSupervisorRow()" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-800 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-lg transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          Add Row
        </button>
        <button id="btn-run-crosscheck" onclick="runCrosscheck()" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 px-3 py-1.5 rounded-lg shadow-sm transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          Run Crosscheck
        </button>
      </div>
    </div>
    <div class="px-5 py-3">
      <p class="text-xs text-slate-400 mb-3">Verify the values below — click any cell to edit. <strong class="text-slate-500">F</strong> = Prime Full, <strong class="text-slate-500">P</strong> = Prime Assisted, <strong class="text-slate-500">H</strong> = ½ Prime, <strong class="text-slate-500">A</strong> = Assistant</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="supervisor-table">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-4 py-3 text-left">Date</th>
              <th class="px-4 py-3 text-center">F</th>
              <th class="px-4 py-3 text-center">P</th>
              <th class="px-4 py-3 text-center">H</th>
              <th class="px-4 py-3 text-center">A</th>
              <th class="px-4 py-3 text-center w-10"></th>
            </tr>
          </thead>
          <tbody id="supervisor-tbody" class="divide-y divide-slate-50">
          </tbody>
        </table>
      </div>
      <!-- Manual entry fallback -->
      <p class="text-xs text-slate-400 mt-3 italic">No OCR? Use "Add Row" to enter data manually.</p>
    </div>
  </div>

  <!-- ═══ STEP 4: CROSSCHECK RESULTS ═══ -->
  <div id="results-section" class="hidden space-y-5">

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" id="kpi-cards">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 text-center">
        <p class="text-xs font-semibold text-slate-400 mb-1">Total Days</p>
        <p id="kpi-total" class="text-2xl font-bold text-slate-800">—</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 text-center">
        <p class="text-xs font-semibold text-slate-400 mb-1">✓ Matched</p>
        <p id="kpi-match" class="text-2xl font-bold text-emerald-600">—</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 text-center">
        <p class="text-xs font-semibold text-slate-400 mb-1">⚠ Mismatch</p>
        <p id="kpi-mismatch" class="text-2xl font-bold text-red-500">—</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm px-5 py-4 text-center">
        <p class="text-xs font-semibold text-slate-400 mb-1">IDR Diff</p>
        <p id="kpi-idr" class="text-lg font-bold text-slate-700">—</p>
      </div>
    </div>

    <!-- Session Type Net Diff -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100">
        <h2 class="text-sm font-bold text-slate-800">Net Session Difference</h2>
        <p class="text-xs text-slate-400 mt-0.5">Supervisor total minus your database total (negative = you recorded more)</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-slate-50">
        <% [['F','Prime Full','emerald'],['P','Prime Assisted','purple'],['H','½ Prime','amber'],['A','Assistant','sky']].forEach(function(col){ %>
        <div class="px-5 py-4 text-center">
          <p class="text-xs font-bold text-<%= col[2] %>-600 mb-1"><%= col[1] %> (<%= col[0] %>)</p>
          <p id="net-diff-<%= col[0] %>" class="text-xl font-bold text-slate-700">—</p>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Side-by-Side Comparison Table -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-slate-800">Day-by-Day Comparison</h2>
          <p class="text-xs text-slate-400 mt-0.5">Click a row to see your actual sessions for that day</p>
        </div>
        <button id="btn-dispute" onclick="generateDispute()" class="hidden inline-flex items-center gap-1.5 text-xs font-semibold text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" /></svg>
          Copy Dispute Message
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs font-semibold text-slate-400 uppercase tracking-wider bg-slate-50">
              <th class="px-4 py-3 text-left whitespace-nowrap">Date</th>
              <th class="px-3 py-3 text-center" colspan="4">Supervisor (F / P / H / A)</th>
              <th class="px-3 py-3 text-center" colspan="4">Database (F / P / H / A)</th>
              <th class="px-3 py-3 text-center">Status</th>
              <th class="px-3 py-3 text-center hidden sm:table-cell">IDR Diff</th>
            </tr>
          </thead>
          <tbody id="comparison-tbody" class="divide-y divide-slate-50">
          </tbody>
        </table>
      </div>
    </div>

    <!-- Session Drilldown Panel -->
    <div id="drilldown-panel" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-800">Sessions on <span id="drilldown-date-label" class="text-brand-700"></span></h2>
        <button onclick="closeDrilldown()" class="text-xs text-slate-400 hover:text-slate-700 font-semibold transition">✕ Close</button>
      </div>
      <div id="drilldown-content" class="px-5 py-4 space-y-2"></div>
    </div>

  </div>

  <!-- Spacer -->
  <div class="h-8"></div>
</div>

<!-- ═══ IMAGE ZOOM MODAL ═══ -->
<div id="img-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4" onclick="closeImgModal()">
  <img id="img-modal-img" src="" alt="Full Preview" class="max-w-full max-h-[90vh] rounded-xl shadow-2xl object-contain">
</div>

<!-- ═══ DISPUTE MODAL ═══ -->
<div id="dispute-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <h3 class="text-sm font-bold text-slate-800">Dispute Message</h3>
      <button onclick="closeDisputeModal()" class="text-slate-400 hover:text-slate-700 transition text-lg leading-none">✕</button>
    </div>
    <div class="px-5 py-4">
      <textarea id="dispute-text" rows="12" class="w-full text-xs font-mono text-slate-700 border border-slate-200 rounded-xl p-3 resize-none focus:outline-none focus:ring-2 focus:ring-brand-400 bg-slate-50"></textarea>
    </div>
    <div class="px-5 pb-4 flex gap-3">
      <button onclick="copyDispute()" class="flex-1 bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold px-4 py-2 rounded-lg shadow-sm transition">📋 Copy to Clipboard</button>
      <button onclick="closeDisputeModal()" class="text-xs font-semibold text-slate-500 hover:text-slate-700 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 transition">Cancel</button>
    </div>
  </div>
</div>

<!-- Embedded Server Config Data -->
<script id="rc-config-json" type="application/json"><%- rcConfigJson %></script>

<!-- Tesseract.js -->
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<script src="/js/reward-crosscheck.js"></script>

<%- include('../partials/footer') %>
