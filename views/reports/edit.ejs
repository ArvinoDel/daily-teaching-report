<%- include('../partials/header', { title: 'Edit Report' }) %>

<!-- Embedded groups data for autocomplete -->
<script id="groups-json" type="application/json"><%- groupsJson %></script>

<div class="max-w-2xl mx-auto">
  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-8 pt-7 pb-6 border-b border-slate-100 flex items-center gap-3">
      <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold text-slate-900">Edit Report</h1>
        <p class="text-slate-400 text-xs mt-0.5 font-mono">ID: <%= report._id %></p>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="mx-8 mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="text-sm text-red-700 space-y-0.5">
        <% errors.forEach(err => { %><li>• <%= err %></li><% }) %>
      </ul>
    </div>
    <% } %>

    <form action="/reports/<%= report._id %>" method="POST" class="px-8 py-7 space-y-6"
      id="report-form"
      data-session-type="<%= report.session_type || 'group' %>"
      data-session-mode="<%= report.session_mode || 'offline' %>"
      data-uses-personal-internet="<%= report.uses_personal_internet %>"
      data-class-name="<%= report.class_name %>"
      data-ac-students="<%= (report.ac_students || []).join(',') %>"
      data-absent-students="<%= (report.absent_students || []).join(',') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="PUT">

      <!-- Row 1: Date & Class Name -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label for="date" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Teaching Date <span class="text-red-500">*</span></label>
          <input type="date" id="date" name="date" value="<%= report.dateInputFormat %>" required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-mono focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
        </div>

        <!-- ── Group/Class Name with Autocomplete (group) / Free-text (private) ── -->
        <div class="space-y-1.5">
          <label id="class-name-label" for="class_name" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Group / Class Name <span class="text-red-500">*</span></label>
          <!-- Group mode: autocomplete wrapper -->
          <div id="group-ac-wrap" class="relative">
            <input type="text" id="class_name" name="class_name"
              value="<%= report.class_name %>"
              autocomplete="off" required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-10 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
            <!-- Clear group button -->
            <button type="button" id="btn-clear-group"
              onclick="clearGroupSelection()"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition"
              title="Clear group selection">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
            <!-- Dropdown -->
            <div id="group-dropdown"
              class="hidden absolute z-30 left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden divide-y divide-slate-50 max-h-56 overflow-y-auto">
            </div>
          </div>
          <!-- Private mode: plain free-text input -->
          <input type="text" id="private_name_input"
            placeholder="e.g: John Doe"
            autocomplete="off"
            class="hidden w-full rounded-xl border border-purple-200 bg-purple-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-100 transition" />
          <p id="group-hint" class="text-xs text-slate-400">Type a name or select from your groups list.</p>
        </div>
      </div>

      <!-- Row 2: Session Type & Class Mode -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-2">
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Session Type</label>
          <div class="flex gap-2">
            <button type="button" id="btn-group"   class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setSessionType('group')">Group</button>
            <button type="button" id="btn-private" class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setSessionType('private')">Private</button>
          </div>
          <input type="hidden" name="session_type" id="session_type_input" value="<%= report.session_type || 'group' %>">
        </div>
        <div class="space-y-2">
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Class Mode</label>
          <div class="flex gap-2">
            <button type="button" id="btn-offline" class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setMode('offline')">Offline</button>
            <button type="button" id="btn-online"  class="flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition" onclick="setMode('online')">Online</button>
          </div>
          <input type="hidden" name="session_mode" id="session_mode_input" value="<%= report.session_mode || 'offline' %>">
          <div id="personal-internet-wrapper" class="hidden">
            <label class="flex items-center gap-3 cursor-pointer bg-blue-50 border border-blue-100 rounded-xl px-4 py-3 mt-1">
              <input type="checkbox" name="uses_personal_internet" value="true" id="personal_internet_check"
                class="w-4 h-4 rounded border-blue-300 text-blue-600 focus:ring-blue-200 flex-shrink-0"
                <%= report.uses_personal_internet ? 'checked' : '' %>>
              <div>
                <p class="text-sm font-semibold text-blue-700">Personal Internet</p>
                <p class="text-xs text-blue-400 mt-0.5">Using own data / wifi</p>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Material (optional) -->
      <div class="space-y-1.5">
        <label for="subject" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
          Material <span class="ml-1 font-normal normal-case text-slate-400">— optional</span>
        </label>
        <input type="text" id="subject" name="subject" value="<%= report.subject %>"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
      </div>

      <!-- Teaching Type & Duration -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label for="teaching_type" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Type <span class="text-red-500">*</span></label>
          <div class="relative">
            <select id="teaching_type" name="teaching_type" required
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-10">
              <% teachingTypes.forEach(type => { %>
              <option value="<%= type %>" <%= report.teaching_type === type ? 'selected' : '' %>><%= type %></option>
              <% }) %>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </div>
          </div>
        </div>
        <div class="space-y-1.5">
          <label for="duration" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Duration <span class="text-red-500">*</span></label>
          <div class="relative">
            <input type="number" id="duration" name="duration" value="<%= report.duration %>" min="1" required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-16 text-sm font-mono focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
            <span class="absolute inset-y-0 right-4 flex items-center text-xs text-slate-400 pointer-events-none">minute(s)</span>
          </div>
        </div>
      </div>

      <!-- Notes -->
      <div class="space-y-1.5">
        <label for="notes" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Note(s)</label>
        <textarea id="notes" name="notes" rows="3"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition resize-none"><%= report.notes %></textarea>
      </div>

      <div class="border-t border-slate-100"></div>

      <!-- ══ STUDENT ROSTER (shown when a group is matched/selected) ══ -->
      <div id="student-roster" class="hidden">
        <div class="rounded-2xl border border-brand-200 bg-brand-50/30 overflow-hidden">
          <!-- Roster Header -->
          <div class="px-5 py-3.5 border-b border-brand-100 flex items-center justify-between flex-wrap gap-2">
            <div>
              <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider">Students from</p>
              <h3 id="roster-group-name" class="text-sm font-bold text-slate-800 mt-0.5"></h3>
            </div>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span id="roster-summary" class="text-xs text-slate-500 mr-1"></span>
              <button type="button" onclick="markAll('ac')"
                class="text-xs font-semibold bg-emerald-100 hover:bg-emerald-200 text-emerald-700 px-2.5 py-1.5 rounded-lg transition">
                All AC
              </button>
              <button type="button" onclick="markAll('absent')"
                class="text-xs font-semibold bg-red-100 hover:bg-red-200 text-red-600 px-2.5 py-1.5 rounded-lg transition">
                All Absent
              </button>
              <button type="button" onclick="markAll('clear')"
                class="text-xs font-semibold bg-white hover:bg-slate-100 text-slate-500 border border-slate-200 px-2.5 py-1.5 rounded-lg transition">
                Clear
              </button>
            </div>
          </div>
          <!-- Student rows -->
          <div id="roster-students" class="px-4 py-3 space-y-1.5 max-h-72 overflow-y-auto">
          </div>
        </div>
      </div>

      <!-- ══ MANUAL INPUT (shown when no group selected) ══ -->
      <div id="manual-students-section">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Achievement Card (AC)</label>
            <p class="text-xs text-slate-400 -mt-1">Type name then press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd></p>
            <div id="ac-tag-box"
              class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-100 transition"
              onclick="document.getElementById('ac-input').focus()"></div>
            <input type="text" id="ac-input" placeholder="e.g: Darren" autocomplete="off"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 transition" />
            <p class="text-xs text-slate-400"><span id="ac-count">0</span> student(s)</p>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Absent</label>
            <p class="text-xs text-slate-400 -mt-1">Type name then press <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">Enter</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-500 font-mono text-xs">,</kbd></p>
            <div id="absent-tag-box"
              class="min-h-[44px] flex flex-wrap gap-1.5 items-center rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 cursor-text focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-100 transition"
              onclick="document.getElementById('absent-input').focus()"></div>
            <input type="text" id="absent-input" placeholder="e.g: Michael" autocomplete="off"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder-slate-300 focus:outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 transition" />
            <p class="text-xs text-slate-400"><span id="absent-count">0</span> student(s)</p>
          </div>
        </div>
      </div>

      <!-- Shared hidden inputs — always submitted -->
      <input type="hidden" name="ac_students"     id="ac-hidden"     value="<%= (report.ac_students || []).join(',') %>">
      <input type="hidden" name="absent_students" id="absent-hidden" value="<%= (report.absent_students || []).join(',') %>">

      <div class="flex items-center justify-between pt-2">
        <a href="/reports" class="text-sm font-semibold text-slate-400 hover:text-slate-600 transition">Cancel</a>
        <button type="submit"
          class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 active:scale-95 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          Update the Report
        </button>
      </div>
    </form>
  </div>
</div>

<script>
/* ═══════════════════════════════════════════════════════════════
   Helpers
═══════════════════════════════════════════════════════════════ */
function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ═══════════════════════════════════════════════════════════════
   Session type & mode toggles
═══════════════════════════════════════════════════════════════ */
function setSessionType(type) {
  document.getElementById('session_type_input').value = type;
  var bG = document.getElementById('btn-group'), bP = document.getElementById('btn-private');
  var classInput      = document.getElementById('class_name');
  var privateInput    = document.getElementById('private_name_input');
  var groupAcWrap     = document.getElementById('group-ac-wrap');
  var groupHint       = document.getElementById('group-hint');
  var classNameLabel  = document.getElementById('class-name-label');

  if (type === 'group') {
    bG.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-brand-500 bg-brand-50 text-brand-700';
    bP.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
    // Show group autocomplete, hide private free-text
    groupAcWrap.classList.remove('hidden');
    privateInput.classList.add('hidden');
    privateInput.removeAttribute('name');
    classInput.setAttribute('name', 'class_name');
    classInput.required = true;
    groupHint.classList.remove('hidden');
    classNameLabel.innerHTML = 'Group / Class Name <span class="text-red-500">*</span>';
  } else {
    bG.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
    bP.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-purple-400 bg-purple-50 text-purple-700';
    // Hide group autocomplete, show private free-text
    if (selectedGroup) { clearGroupSelection(); }
    groupAcWrap.classList.add('hidden');
    classInput.removeAttribute('name');
    classInput.required = false;
    privateInput.classList.remove('hidden');
    privateInput.setAttribute('name', 'class_name');
    privateInput.required = true;
    if (!privateInput.value && classInput.value) privateInput.value = classInput.value;
    groupHint.classList.add('hidden');
    classNameLabel.innerHTML = 'Student Name <span class="text-red-500">*</span>';
  }
}
function setMode(mode) {
  document.getElementById('session_mode_input').value = mode;
  var bOff = document.getElementById('btn-offline'), bOn = document.getElementById('btn-online');
  var piW  = document.getElementById('personal-internet-wrapper');
  if (mode === 'online') {
    bOn.className  = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-blue-500 bg-blue-50 text-blue-700';
    bOff.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
    piW.classList.remove('hidden');
  } else {
    bOff.className = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-700 bg-slate-700 text-white';
    bOn.className  = 'flex-1 py-2.5 rounded-xl border-2 text-sm font-semibold transition border-slate-200 bg-white text-slate-400 hover:border-slate-300';
    piW.classList.add('hidden');
    document.getElementById('personal_internet_check').checked = false;
  }
}
var formEl = document.getElementById('report-form');
setSessionType(formEl.dataset.sessionType);
setMode(formEl.dataset.sessionMode);
if (formEl.dataset.usesPersonalInternet === 'true') document.getElementById('personal_internet_check').checked = true;

/* ═══════════════════════════════════════════════════════════════
   Tag input — returns controller { reset, getTags }
═══════════════════════════════════════════════════════════════ */
function initTagInput({ inputId, boxId, hiddenId, countId, tagCls }) {
  var input   = document.getElementById(inputId);
  var box     = document.getElementById(boxId);
  var hidden  = document.getElementById(hiddenId);
  var countEl = document.getElementById(countId);
  var tags    = hidden.value ? hidden.value.split(',').map(function(s){return s.trim();}).filter(Boolean) : [];

  function render() {
    box.innerHTML = '';
    tags.forEach(function(tag, i) {
      var pill = document.createElement('span');
      pill.className = 'inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ' + tagCls;
      pill.innerHTML = escHtml(tag) + ' <button type="button" class="ml-0.5 leading-none opacity-60 hover:opacity-100 transition text-sm" data-i="'+i+'">×</button>';
      pill.querySelector('button').addEventListener('click', function() { tags.splice(i, 1); render(); });
      box.appendChild(pill);
    });
    countEl.textContent = tags.length;
    hidden.value = tags.join(',');
  }
  function tryAdd() {
    var val = input.value.replace(/,/g,'').trim();
    if (val && !tags.includes(val)) tags.push(val);
    input.value = ''; render();
  }
  input.addEventListener('keydown', function(e) {
    if (e.key==='Enter')     { e.preventDefault(); tryAdd(); }
    else if (e.key===',')    { e.preventDefault(); tryAdd(); }
    else if (e.key==='Backspace' && input.value==='' && tags.length) { tags.pop(); render(); }
  });
  input.addEventListener('blur', function() { if (input.value.trim()) tryAdd(); });
  render();

  return {
    reset: function(newTags) { tags = newTags.slice(); render(); },
    getTags: function() { return tags.slice(); }
  };
}

var acCtrl, absentCtrl;

/* ═══════════════════════════════════════════════════════════════
   Groups Autocomplete
═══════════════════════════════════════════════════════════════ */
var groupsData    = JSON.parse(document.getElementById('groups-json').textContent);
var selectedGroup = null;
var studentStates = {};

var classInput    = document.getElementById('class_name');
var groupDropdown = document.getElementById('group-dropdown');
var clearBtn      = document.getElementById('btn-clear-group');
var groupHint     = document.getElementById('group-hint');
var rosterPanel   = document.getElementById('student-roster');
var manualSection = document.getElementById('manual-students-section');

function renderDropdown(groups) {
  groupDropdown.innerHTML = groups.slice(0, 8).map(function(g) {
    var tcls = g.type === 'GROUP' ? 'bg-emerald-100 text-emerald-700' : 'bg-purple-100 text-purple-700';
    var tlbl = g.type === 'GROUP' ? 'Group' : 'Private';
    return '<button type="button" onclick="selectGroup(\''+escHtml(g._id)+'\')" '+
      'class="w-full text-left px-4 py-3 hover:bg-brand-50 transition flex items-center justify-between gap-3">' +
      '<div class="flex-1 min-w-0">' +
        '<p class="text-sm font-semibold text-slate-800 truncate">' + escHtml(g.group_name) + '</p>' +
        '<div class="flex items-center gap-1.5 mt-0.5">' +
          '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full '+tcls+'">' + tlbl + '</span>' +
          (g.level ? '<span class="text-[10px] font-mono text-slate-400">'+escHtml(g.level)+'</span>' : '') +
        '</div>' +
      '</div>' +
      '<span class="text-xs text-slate-400 flex-shrink-0">'+g.students.length+' siswa</span>' +
    '</button>';
  }).join('');
  groupDropdown.classList.remove('hidden');
}

function hideDropdown() { groupDropdown.classList.add('hidden'); }

classInput.addEventListener('focus', function() {
  var q = this.value.trim().toLowerCase();
  var list = q ? groupsData.filter(function(g){return g.group_name.toLowerCase().includes(q);}) : groupsData;
  if (list.length) renderDropdown(list);
});

classInput.addEventListener('input', function() {
  var q = this.value.trim().toLowerCase();
  if (selectedGroup && this.value !== selectedGroup.group_name) {
    selectedGroup = null; studentStates = {};
    hideRoster(); clearBtn.classList.add('hidden');
    setGroupHintDefault();
  }
  if (!q) { hideDropdown(); return; }
  var list = groupsData.filter(function(g){return g.group_name.toLowerCase().includes(q);});
  list.length ? renderDropdown(list) : hideDropdown();
});

classInput.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' || e.key === 'Tab') hideDropdown();
});

document.addEventListener('click', function(e) {
  if (!e.target.closest('#group-ac-wrap')) hideDropdown();
});

function setGroupHintDefault() {
  groupHint.textContent = 'Type a name or select from your groups list.';
  groupHint.className = 'text-xs text-slate-400';
}
function setGroupHintSelected() {
  groupHint.innerHTML = '<span class="inline-flex items-center gap-1 text-brand-600 font-semibold">' +
    '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>' +
    'Group selected — mark students below</span>';
  groupHint.className = 'text-xs';
}

/* ═══════════════════════════════════════════════════════════════
   Group Selection
═══════════════════════════════════════════════════════════════ */
function selectGroup(id, opts) {
  selectedGroup = groupsData.find(function(g){return g._id === id;});
  if (!selectedGroup) return;

  classInput.value = selectedGroup.group_name;
  hideDropdown();

  setSessionType(selectedGroup.type === 'PRIVATE' ? 'private' : 'group');

  // Reset states
  studentStates = {};
  selectedGroup.students.forEach(function(s) { studentStates[s] = null; });

  // Pre-fill from existing report ac/absent data
  if (opts && opts.preAc) {
    opts.preAc.forEach(function(s) {
      if (Object.prototype.hasOwnProperty.call(studentStates, s)) studentStates[s] = 'ac';
    });
  }
  if (opts && opts.preAbsent) {
    opts.preAbsent.forEach(function(s) {
      if (Object.prototype.hasOwnProperty.call(studentStates, s)) studentStates[s] = 'absent';
    });
  }

  document.getElementById('roster-group-name').textContent = selectedGroup.group_name;
  renderRoster();
  rosterPanel.classList.remove('hidden');
  manualSection.classList.add('hidden');
  clearBtn.classList.remove('hidden');
  setGroupHintSelected();
  updateHiddenInputs();
}

function clearGroupSelection() {
  selectedGroup = null; studentStates = {};
  classInput.value = ''; classInput.focus();
  hideRoster();
  clearBtn.classList.add('hidden');
  acCtrl.reset([]); absentCtrl.reset([]);
  setGroupHintDefault();
}

/* ═══════════════════════════════════════════════════════════════
   Student Roster
═══════════════════════════════════════════════════════════════ */
function hideRoster()  { rosterPanel.classList.add('hidden'); manualSection.classList.remove('hidden'); }

function renderRoster() {
  var container = document.getElementById('roster-students');
  if (!selectedGroup || selectedGroup.students.length === 0) {
    container.innerHTML = '<p class="text-sm text-slate-400 italic py-2 text-center">No students in this group.</p>';
    return;
  }
  container.innerHTML = selectedGroup.students.map(function(student) {
    var state  = studentStates[student];
    var rowCls = 'flex items-center justify-between py-2.5 px-3 rounded-xl border transition ';
    rowCls += state === 'ac'     ? 'bg-emerald-50 border-emerald-200' :
              state === 'absent' ? 'bg-red-50 border-red-200'         :
              'bg-white border-slate-100 hover:border-slate-200';

    var acCls  = 'text-xs font-semibold px-2.5 py-1.5 rounded-lg transition ' +
      (state === 'ac'     ? 'bg-emerald-500 text-white shadow-sm' :
       'bg-white border border-slate-200 text-slate-500 hover:border-emerald-300 hover:text-emerald-600');
    var absCls = 'text-xs font-semibold px-2.5 py-1.5 rounded-lg transition ' +
      (state === 'absent' ? 'bg-red-500 text-white shadow-sm' :
       'bg-white border border-slate-200 text-slate-500 hover:border-red-300 hover:text-red-500');

    var nameCls = 'text-sm ' + (state === 'ac' ? 'text-emerald-800 font-medium' : state === 'absent' ? 'text-red-700 font-medium' : 'text-slate-700');

    return '<div class="'+rowCls+'">' +
      '<div class="flex items-center gap-2">' +
        '<span class="'+nameCls+'">' + escHtml(student) + '</span>' +
        (state === 'ac'     ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700">AC</span>'     : '') +
        (state === 'absent' ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-red-100 text-red-600">Absent</span>' : '') +
      '</div>' +
      '<div class="flex gap-1.5">' +
        '<button type="button" class="'+acCls+'"  onclick="toggleStudent('+JSON.stringify(student)+',\'ac\')">AC</button>' +
        '<button type="button" class="'+absCls+'" onclick="toggleStudent('+JSON.stringify(student)+',\'absent\')">Absent</button>' +
      '</div>' +
    '</div>';
  }).join('');

  updateRosterSummary();
}

function toggleStudent(name, role) {
  studentStates[name] = (studentStates[name] === role) ? null : role;
  renderRoster();
  updateHiddenInputs();
}

function markAll(role) {
  if (!selectedGroup) return;
  selectedGroup.students.forEach(function(s) { studentStates[s] = (role === 'clear') ? null : role; });
  renderRoster();
  updateHiddenInputs();
}

function updateRosterSummary() {
  var vals   = Object.values(studentStates);
  var acCnt  = vals.filter(function(v){return v==='ac';}).length;
  var absCnt = vals.filter(function(v){return v==='absent';}).length;
  var el     = document.getElementById('roster-summary');
  if (!el) return;
  var parts  = [];
  if (acCnt  > 0) parts.push('<span class="text-emerald-600 font-semibold">'+acCnt+' AC</span>');
  if (absCnt > 0) parts.push('<span class="text-red-500 font-semibold">'+absCnt+' Absent</span>');
  el.innerHTML = parts.length ? parts.join(' · ') : '<span class="text-slate-400">No marks yet</span>';
}

function updateHiddenInputs() {
  var acList = [], absList = [];
  Object.keys(studentStates).forEach(function(s) {
    if (studentStates[s] === 'ac')     acList.push(s);
    if (studentStates[s] === 'absent') absList.push(s);
  });
  if (acCtrl)     acCtrl.reset(acList);
  if (absentCtrl) absentCtrl.reset(absList);
}

/* ═══════════════════════════════════════════════════════════════
   Init tag inputs
═══════════════════════════════════════════════════════════════ */
acCtrl     = initTagInput({ inputId:'ac-input',     boxId:'ac-tag-box',     hiddenId:'ac-hidden',     countId:'ac-count',     tagCls:'bg-emerald-100 text-emerald-700' });
absentCtrl = initTagInput({ inputId:'absent-input', boxId:'absent-tag-box', hiddenId:'absent-hidden', countId:'absent-count', tagCls:'bg-red-100 text-red-600' });

/* ═══════════════════════════════════════════════════════════════
   ★ EDIT-ONLY: Auto-detect & pre-select group on page load
   Matches the report's class_name against group list.
   Pre-fills roster states from existing ac_students / absent_students.
═══════════════════════════════════════════════════════════════ */
(function autoSelectGroup() {
  var formEl = document.getElementById('report-form');
  var initSessionType = formEl.dataset.sessionType || 'group';
  var initClassName   = formEl.dataset.className || '';
  var initAc          = formEl.dataset.acStudents ? formEl.dataset.acStudents.split(',').filter(Boolean) : [];
  var initAbsent      = formEl.dataset.absentStudents ? formEl.dataset.absentStudents.split(',').filter(Boolean) : [];

  if (initSessionType === 'private') {
    // Private: pre-fill the free-text input; setSessionType already set the UI
    var privateInput = document.getElementById('private_name_input');
    if (privateInput) privateInput.value = initClassName;
    return;
  }

  var match = groupsData.find(function(g) { return g.group_name === initClassName; });
  if (match) {
    selectGroup(match._id, { preAc: initAc, preAbsent: initAbsent });
  }
  // If no match: manual inputs already show with existing tag values.
})();
</script>

