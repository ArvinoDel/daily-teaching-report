<%- include('../partials/header', { title: 'Edit Report' }) %>

<div class="max-w-2xl mx-auto">
  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-8 pt-7 pb-6 border-b border-slate-100 flex items-center gap-3">
      <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold text-slate-900">Edit Report</h1>
        <p class="text-slate-400 text-xs mt-0.5 font-mono">ID: <%= report._id %></p>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="mx-8 mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="text-sm text-red-700 space-y-0.5">
        <% errors.forEach(err => { %><li>• <%= err %></li><% }) %>
      </ul>
    </div>
    <% } %>

    <form action="/reports/<%= report._id %>?_method=PUT" method="POST" class="px-8 py-7 space-y-6">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label for="date" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Tanggal Mengajar <span class="text-red-500">*</span></label>
          <input type="date" id="date" name="date" value="<%= report.dateInputFormat %>" required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-mono focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
        </div>
        <div class="space-y-1.5">
          <label for="class_name" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Nama Kelas <span class="text-red-500">*</span></label>
          <input type="text" id="class_name" name="class_name" value="<%= report.class_name %>" required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="subject" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Mata Pelajaran <span class="text-red-500">*</span></label>
        <input type="text" id="subject" name="subject" value="<%= report.subject %>" required
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
          <label for="teaching_type" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Tipe Pengajar <span class="text-red-500">*</span></label>
          <div class="relative">
            <select id="teaching_type" name="teaching_type" required
              class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition cursor-pointer pr-10">
              <% teachingTypes.forEach(type => { %>
              <option value="<%= type %>" <%= report.teaching_type === type ? 'selected' : '' %>><%= type %></option>
              <% }) %>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </div>
          </div>
        </div>
        <div class="space-y-1.5">
          <label for="duration" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Durasi (menit) <span class="text-red-500">*</span></label>
          <div class="relative">
            <input type="number" id="duration" name="duration" value="<%= report.duration %>" min="1" required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 pr-16 text-sm font-mono focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition" />
            <span class="absolute inset-y-0 right-4 flex items-center text-xs text-slate-400 pointer-events-none">menit</span>
          </div>
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="notes" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">Catatan Kegiatan</label>
        <textarea id="notes" name="notes" rows="4"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 transition resize-none"><%= report.notes %></textarea>
      </div>

      <div class="flex items-center justify-between pt-2">
        <a href="/reports" class="text-sm font-semibold text-slate-400 hover:text-slate-600 transition">Batal</a>
        <button type="submit"
          class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 active:scale-95 text-white font-semibold text-sm px-6 py-2.5 rounded-xl shadow transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          Update the Report
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
