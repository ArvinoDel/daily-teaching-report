<%- include('../partials/header', { title: 'Edit Report' }) %>

<!-- Embedded groups data for autocomplete -->
<script id="groups-json" type="application/json"><%- groupsJson %></script>
<!-- Embedded materials data for autocomplete -->
<script id="materials-json" type="application/json"><%- typeof materialsJson !== 'undefined' ? materialsJson : '[]' %></script>

<div class="max-w-2xl mx-auto">
  <a href="/reports" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-brand-600 mb-6 transition font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to Dashboard
  </a>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-8 pt-7 pb-6 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold text-slate-900">Edit Report</h1>
          <p class="text-slate-400 text-xs mt-0.5 font-mono">ID: <%= report._id %></p>
        </div>
      </div>
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'teacher') { %>
        <button type="button" id="tour-help-btn"
          class="w-9 h-9 rounded-xl border border-slate-200 text-slate-500 hover:text-brand-600 hover:border-brand-200 hover:bg-brand-50 flex items-center justify-center font-bold text-sm transition focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none"
          title="Take a tour of the form" aria-label="Take a tour of the form">
          ?
        </button>
      <% } %>
    </div>

    <% if (errors && errors.length > 0) { %>
    <div class="mx-8 mt-6 bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="text-sm text-red-700 space-y-0.5">
        <% errors.forEach(err => { %><li>• <%= err %></li><% }) %>
      </ul>
    </div>
    <% } %>

    <%- include('../partials/reports/report-form', {
      isEdit: true,
      isAdmin: false,
      actionUrl: `/reports/${report._id}`,
      cancelUrl: '/reports',
      dateValue: report.dateInputFormat || '',
      classNameValue: (typeof formData !== 'undefined' && formData && formData.class_name !== undefined) ? formData.class_name : (report.class_name || ''),
      sessionTypeValue: (typeof formData !== 'undefined' && formData && formData.session_type) ? formData.session_type : (report.session_type || 'group'),
      sessionModeValue: (typeof formData !== 'undefined' && formData && formData.session_mode) ? formData.session_mode : (report.session_mode || 'offline'),
      usesPersonalInternetValue: (typeof formData !== 'undefined' && formData && formData.uses_personal_internet !== undefined) ? (formData.uses_personal_internet === 'true' || formData.uses_personal_internet === true) : report.uses_personal_internet,
      competitionGroupsValue: (typeof formData !== 'undefined' && formData && formData.competition_groups !== undefined) ? (Array.isArray(formData.competition_groups) ? formData.competition_groups.join(',') : formData.competition_groups) : (report.competition_groups || []).join(','),
      subjectValue: report.subject || '',
      teachingTypeValue: report.teaching_type || '',
      durationValue: report.duration || '',
      notesValue: report.notes || '',
      acStudentsValue: (report.ac_students || []).join(','),
      absentStudentsValue: (report.absent_students || []).join(','),
      acReducedStudentsValue: (report.ac_reduced_students || []).join(','),
      teachingTypes: teachingTypes,
      teachersJson: typeof teachersJson !== 'undefined' ? teachersJson : '[]',
      partnerTeacherName: report.partner_teacher_name || '',
      partnerTeacherId: report.partner_teacher ? String(report.partner_teacher) : '',
      materialsJson: typeof materialsJson !== 'undefined' ? materialsJson : '[]',
    }) %>

  </div>
</div>

<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'teacher') { %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css" integrity="sha384-eyrYgcjChmzD338JTHFZssgJHOqqOZbajet8yZpCw8ESroLDi28BarMEKCImNGHC" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js" integrity="sha384-BhR06AMz62Xn0o53z8itVS1vw4JslNckRFgOTa6/Dob0Agdmbbh8Dr9sDO2h18TO" crossorigin="anonymous"></script>
  <script src="/js/tours/report-form-tour.js"></script>
  <script src="/js/tours/tour-runner.js" data-should-offer="false"></script>
<% } %>

<%- include('../partials/footer') %>
