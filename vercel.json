{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 17 * * 6"
    },
    {
      "path": "/api/cron/backup-cleanup",
      "schedule": "30 18 * * *"
    }
  ]
}
